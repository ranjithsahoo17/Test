import java.util.Map;
import java.util.Set;
import java.util.UUID;

import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;
import org.joda.time.Duration;

import com.eurocopter.mgs.configuration.datacollection.useractions.Type;
import com.eurocopter.mgs.datamodel.aircraft.Aircraft;
import com.eurocopter.mgs.datamodel.aircraft.AircraftState;
import com.eurocopter.mgs.datamodel.aircraft.configuration.AircraftHistory;
import com.eurocopter.mgs.datamodel.alarm.Acknowledgement;
