/**
 * Acknowledge Management Composite.
 * <P>
 *
 * Acknowledge Alarm Through Health Node.
 * <P>
 *
 */
public class AcknowledgeHealthNodeComposite extends AcknowledgeAlarmComposite {

   private static final Logger LOGGER = LogManager.getLogger(AcknowledgeHealthNodeComposite.class);

   /** Relearning Description Label. */
   private Group relearningDescriptionSection;

   /** Relearning Description Text. */
   private StyledText relearningDescriptionText;

   private LearningPastHoursSelectionComposite pastHoursSelectionComposite;

   /** Check button. */
   private Button checkButton;

   /** Relearning dedicated composite. */
   private Composite relearningComposite;

   /** Empty field validator for relearning description. */
   private ValidateFieldSize relearningEmptyFieldValidator;

   private DataBindingContext bindingContext;

   /**
    * Create the composite.
    *
    * @param parent
    *           the parent
    * @param style
    *           the style
    * @param model
    *           the view model.
    */
   public AcknowledgeHealthNodeComposite(Composite parent, AcknowledgeHealthNodeModel model) {
      super(parent, model);
   }

   /**
    * {@inheritDoc}
    *
    * @see com.eurocopter.mgs.alarm.presentation.acknowledgement.maintenancereport.composite.AcknowledgeAlarmComposite# createCloseMonitoringComposite()
    */
   @Override
   protected void createCloseMonitoringComposite() {
      createCloseMonitoringSection(getCompositeAckManagement());

      checkButton = new Button(getCompositeAckManagement(), SWT.CHECK);
      checkButton.addListener(SWT.Selection, new Listener() {
         /**
          * {@inheritDoc}
          *
          * @see org.eclipse.swt.widgets.Listener#handleEvent(org.eclipse.swt.widgets.Event)
          */
         @Override
         public void handleEvent(Event arg0) {
            doSelection();
         }
      });

      // Re-learning composite
      relearningComposite = new Composite(getCompositeAckManagement(), SWT.NONE);
      GridData relearningCompositeLayoutData = new GridData(SWT.FILL, SWT.FILL, false, false, 2, 1);
      relearningComposite.setLayoutData(relearningCompositeLayoutData);
      GridLayout relearningCompositeLayout = new GridLayout(3, false);
      relearningCompositeLayout.marginWidth = 0;
      relearningComposite.setLayout(relearningCompositeLayout);

      /**
       * Relearning Description
       */
      relearningDescriptionSection = new Group(this, ExpandableComposite.TITLE_BAR);
      relearningDescriptionSection.setLayout(new GridLayout());
      GridData gdRelearningDescriptionSection = new GridData(SWT.FILL, SWT.FILL, false, false, 3, 1);
      gdRelearningDescriptionSection.heightHint = 0; // Trac#1711: Alarm : Fenêtre Acknowledge
      gdRelearningDescriptionSection.widthHint = 494;
      relearningDescriptionSection.setLayoutData(gdRelearningDescriptionSection);
      relearningDescriptionSection.setText(Messages.CORE.getMnemonicEscapedString("AcknowledgeAlarmThroughHealthNodeComposite_6"));
      relearningDescriptionSection.setVisible(false);

      relearningDescriptionText = new StyledText(relearningDescriptionSection, SWT.V_SCROLL
            | SWT.MULTI | SWT.WRAP);
      GridData relearningDescriptionTextData = new GridData(SWT.FILL, SWT.FILL, true, true);
      relearningDescriptionText.setLayoutData(relearningDescriptionTextData);

      // Search max learning time for initialization
      pastHoursSelectionComposite = new LearningPastHoursSelectionComposite(this, computeLearningTime());
      pastHoursSelectionComposite.setLayoutData(gdRelearningDescriptionSection);
   }

   /**
    * {@inheritDoc}
    *
    * @see com.eurocopter.mgs.alarm.presentation.acknowledgement.maintenancereport.composite.AcknowledgeAlarmComposite# registerListeners()
    */
   @Override
   protected void registerListeners() {
      super.registerListeners();

      IValidatorListener<String> dialogOKButtonManager = source -> manageAcknowledgmentHealthNodeDialogOKButton();
      this.relearningEmptyFieldValidator.addValidatorListener(dialogOKButtonManager);
   }

   @Override
   protected void processCompositeVisibilityAfterSelection() {
      super.processCompositeVisibilityAfterSelection();
      if (isAcknowledgeSelected()) {
         // Trac#1711: Alarm : Fenêtre Acknowledge
         GridData gdRelearningDescriptionSection = new GridData(SWT.FILL, SWT.FILL, false, false,
               3, 1);
         gdRelearningDescriptionSection.heightHint = checkButton.getSelection() ? 113 : 0;
         gdRelearningDescriptionSection.widthHint = 494;
         relearningDescriptionSection.setLayoutData(gdRelearningDescriptionSection);
         relearningDescriptionSection.setVisible(checkButton.getSelection());
         pastHoursSelectionComposite.setLayoutData(gdRelearningDescriptionSection);
         pastHoursSelectionComposite.setVisible(checkButton.getSelection());
         checkButton.setEnabled(true);
         // Trac#1711: Alarm : Fenêtre Acknowledge
         this.pack();
         ((ScrolledComposite) this.getParent()).setMinSize(computeSize(SWT.DEFAULT, SWT.DEFAULT));
      } else if (isCloseMonitoringSelected()) {
         checkButton.setSelection(false); // bug#1471
         checkButton.setEnabled(false);
         // Trac#1711: Alarm : Fenêtre Acknowledge
         GridData gdRelearningDescriptionSection = new GridData(SWT.FILL, SWT.FILL, false, false, 3, 1);
         gdRelearningDescriptionSection.heightHint = 0;
         gdRelearningDescriptionSection.widthHint = 494;
         relearningDescriptionSection.setLayoutData(gdRelearningDescriptionSection);
         relearningDescriptionSection.setVisible(false);
         pastHoursSelectionComposite.setLayoutData(gdRelearningDescriptionSection);
         pastHoursSelectionComposite.setVisible(checkButton.getSelection());
         // Trac#1711: Alarm : Fenêtre Acknowledge
         this.pack();
         ((ScrolledComposite) this.getParent()).setMinSize(computeSize(SWT.DEFAULT, SWT.DEFAULT));
      }
   }

   @Override
   protected String getDialogTitle() {
      return Messages.CORE.getString("AcknowledgeManagement");
   }

   @Override
   protected String getCompositeTitle() {
      return getModel().getTitle();
   }

   @Override
   protected String getDescriptionText() {
      return Messages.CORE.getMnemonicEscapedString("AcknowledgeAlarmThroughHealthNodeComposite_5");
   }

   @Override
   protected boolean isCloseMonitoringRadioButtonVisible() {
      return true;
   }

   @Override
   protected boolean isAutomaticMarkerCreationVisible() {
      return true;
   }

   /**
    * Initialize data binding.
    *
    * @return DataBindingContext.
    */
   @Override
   protected DataBindingContext initializeDataBindings() {
      bindingContext = super.initializeDataBindings();

      AcknowledgeHealthNodeModel healthAlarmAckThroughHealthNodeModel = (AcknowledgeHealthNodeModel) this.getModel();
      final boolean checkBoxVisibility;
      final String checkboxText;
      IHealthTreeViewNodeModel healthNode = healthAlarmAckThroughHealthNodeModel.getHealthNode();

      final BundleContext healthBundleContext = FrameworkUtil.getBundle(IHealthCommonBusiness.class).getBundleContext();
      final IHealthCommonBusiness healthBusiness = healthBundleContext.getService(healthBundleContext.getServiceReference(IHealthCommonBusiness.class));

      if (MgsSession.getInstance().getUser().getProfile().canRunThresholdRelearning()) {
         if (healthNode.isIndicatorNode()) {
            String indicatorId = ((IndicatorHmcModel) healthNode.getObject()).getIndicator().getId();
            Accelerometer accelerometer = healthBusiness.getAccelerometer(indicatorId, MgsSession.getInstance().getAircraft().getId());
            if (accelerometer == null) {
               // MARMS indicators have no accelerometers => do not display checkbox
               checkBoxVisibility = false;
               checkboxText = "";
            } else {
               // CIGALHE indicators have accelerometer
               checkBoxVisibility = true;
               checkboxText = healthAlarmAckThroughHealthNodeModel.getComponentToBeChanged();
            }
         } else {
            checkBoxVisibility = !healthAlarmAckThroughHealthNodeModel.isHealthRootNode();
            checkboxText = healthAlarmAckThroughHealthNodeModel.getComponentToBeChanged();
         }
      } else {
         // Non authorized users shall not see the checkbox
         checkBoxVisibility = false;
         checkboxText = "";
      }
      checkButton.setText(checkboxText);
      checkButton.setVisible(checkBoxVisibility);

      // Bind checkButton with model.componentOrSensorChanged
      IObservableValue<Boolean> checkButtonObserveSelectionObserveWidget = WidgetProperties.buttonSelection().observe(checkButton);
      IObservableValue<Boolean> modelComponentOrSensorChangedObserveValue = PojoProperties.value("componentOrSensorChanged", boolean.class).observe(healthAlarmAckThroughHealthNodeModel);
      bindingContext.bindValue(checkButtonObserveSelectionObserveWidget,
            modelComponentOrSensorChangedObserveValue, null, null);

      // RelearningComposite with checkButton
      IObservableValue<Boolean> checkButtonObserveVisibilityObserveWidget = WidgetProperties.visible().observe(checkButton);
      IObservableValue<Boolean> relearningCompositeObserveSelectionObserveWidget = WidgetProperties.visible().observe(relearningComposite);
      bindingContext.bindValue(relearningCompositeObserveSelectionObserveWidget,
            checkButtonObserveVisibilityObserveWidget, null, null);

      IObservableValue<Boolean> relearningDescriptionSectionObserveSelectionObserveWidget = WidgetProperties.visible().observe(relearningDescriptionSection);
      bindingContext.bindValue(relearningDescriptionSectionObserveSelectionObserveWidget,
            checkButtonObserveSelectionObserveWidget, null, null);

      // Bind relearningDescriptionText with model.relearningReason
      bindRelearningPart();

      return bindingContext;
   }

   /**
    *
    * Bind relearningDescriptionText with model.model.relearningReason
    */
   private void bindRelearningPart() {
      AcknowledgeHealthNodeModel healthAlarmAckThroughHealthNodeModel = (AcknowledgeHealthNodeModel) this.getModel();
      // Bind relearningDescriptionText with model.relearningReason
      ControlDecoration descriptionTextDecoration = HealthMonitoringUtil.createDecorator(
            relearningDescriptionText, "");
      UpdateValueStrategy<String, String> updateDescription = new UpdateValueStrategy<>();
      relearningEmptyFieldValidator = new ValidateFieldSize(descriptionTextDecoration);
      descriptionTextDecoration.setDescriptionText(relearningEmptyFieldValidator.getMessage());
      updateDescription.setAfterConvertValidator(relearningEmptyFieldValidator);

      IObservableValue<String> descriptionTextObserveSelectionObserveWidget = WidgetProperties.text(SWT.FocusOut, SWT.Modify).observe(relearningDescriptionText);
      IObservableValue<String> relearningReasonObserveValue = PojoProperties.value("relearningReason", String.class).observe(healthAlarmAckThroughHealthNodeModel);
      bindingContext.bindValue(descriptionTextObserveSelectionObserveWidget,
            relearningReasonObserveValue, updateDescription, null);

      bindingContext.bindValue(BeanProperties.value("selectedTime").observe(pastHoursSelectionComposite),
            PojoProperties.value("historyLearningTime").observe(healthAlarmAckThroughHealthNodeModel));
   }

   /**
    * Manages acknowledgment dialog OK button activation/desactivation.
    */
   private void manageAcknowledgmentHealthNodeDialogOKButton() {
      IStatus alarmDescriptionTextStatus = getAlarmEmptyFieldValidator().getStatus();
      IStatus relearningDescriptionTextStatus = relearningEmptyFieldValidator.getStatus();
      IStatus durationTimeStatus = isCloseMonitoringSelected() ? getCloseMonitoringDurationValidator().getStatus() : Status.OK_STATUS;
      setOkButtonEnabled(alarmDescriptionTextStatus.isOK() && durationTimeStatus.isOK()
            && (!checkButton.getSelection() || relearningDescriptionTextStatus.isOK()));
   }

   private long computeLearningTime() {
      long maxLearningTime = 0L;
      if (getModel() instanceof AcknowledgeHealthNodeModel) {
         IHealthTreeViewNodeModel node = ((AcknowledgeHealthNodeModel) getModel()).getHealthNode();
         List<LearnedThresholdConfiguration> learnedThresholds = new ArrayList<>();
         if (node.isIndicatorNode()) {
            learnedThresholds = getLearnedThresholdConfs(((IndicatorHmcModel) node.getObject()).getIndicator());
         } else if (!(node instanceof HealthRootNodeModel)) {
            learnedThresholds = getLearnedThresholdConfs((MechanicalComponentModel) node.getObject());
         }
         for (LearnedThresholdConfiguration threshold : learnedThresholds) {
            if (maxLearningTime < threshold.getLearningTime()) {
               maxLearningTime = threshold.getLearningTime();
            }
         }
      }
      return maxLearningTime;
   }

   /**
    * Return the learned thresholds of a mechanical component.
    *
    * @param mechanicalComponent
    *           the mechanical component
    * @return the learned thresholds of the mechanical component
    */
   private List<LearnedThresholdConfiguration> getLearnedThresholdConfs(MechanicalComponentModel mechanicalComponent) {
      List<LearnedThresholdConfiguration> learnedThresholds = new ArrayList<>();

      if (mechanicalComponent instanceof HealthMechanicalComponentModel healthMechanicalComponent) {

         // get the thresholds of the current mechanical component
         Map<String, Indicator> indicators = healthMechanicalComponent.getHealthComponent().getIndicators();
         if (indicators != null) {
            for (Indicator indicator : indicators.values()) {
               learnedThresholds.addAll(getLearnedThresholdConfs(indicator));
            }
         }
      }

      // get the thresholds for the sub-components
      List<MechanicalComponentModel> subComponents = mechanicalComponent.getSubComponents();
      if (subComponents != null) {
         for (MechanicalComponentModel subComponent : subComponents) {
            learnedThresholds.addAll(getLearnedThresholdConfs(subComponent));
         }
      }

      return learnedThresholds;
   }

   /**
    * Get the learned thresholds of an indicator.
    *
    * @param indicator
    *           the indicator
    * @param model
    * @return the learned thresholds of the indicator
    */
   private List<LearnedThresholdConfiguration> getLearnedThresholdConfs(Indicator indicator) {
      final BundleContext healthMonitoringBundleContext = FrameworkUtil.getBundle(IHealthCommonBusiness.class).getBundleContext();
      IHealthCommonBusiness healthBusiness = healthMonitoringBundleContext.getService(healthMonitoringBundleContext.getServiceReference(IHealthCommonBusiness.class));
      // Get the latest threshold of the indicator
      try {
         return healthBusiness.getIndicatorLatestLearnedThresholds(MgsSession.getInstance().getAircraft().getId(), indicator.getId());
      } catch (EntityNotFoundException e) {
         LOGGER.warn("Unable to retrieve learned thresholds", e);
      }
      return Collections.emptyList();

   }
}

