            false), AIRCRAFT_DELETION(false), RAW_DATA_FILTERING(false);

      private final boolean exclusive;

      Operation(boolean exclusive) {
         this.exclusive = exclusive;
      }

      public boolean isExclusive() {
         return exclusive;
      }
   }

