   /**
    * Update the trend display.
    * 
    * @param flightModels
    * 
    * @param newIndicators
    *           the list of indicators to be added to the display.
    * @param successRateChartModel
    *           the success rate chart model or <code>null</code> if none.
    */
   public void update(final List<FlightModel> flightModels, final List<ChartElementModel<Double>> newIndicators, final ChartElementModel<Double> successRateChartModel) {
      BusyIndicator.showWhile(Display.getCurrent(), () -> {
         try {
            if (!isDisposed()) {
               boolean init = chart == null;

               // compute indicator chart to be removed here
               final List<ChartElementModel<Double>> removed = retrieveModelToRemove(newIndicators);
               final List<ChartElementModel<Double>> added = retrieveModelToAdd(newIndicators);

               // Restore thresholds of added curves if missing (bug fix)
               restoreSubCurves(added);

               // call the chart component to update
               SwingUtilities.invokeAndWait(() -> {
                  if (!added.isEmpty() || !removed.isEmpty()) {
                     updateChart(flightModels, added, removed);
                  } else {
                     refreshMarkers(newIndicators);
                  }
               });

               // store indicators model
               indicators = newIndicators;

               /** success rate **/
               if (successRateChartModel == null && !isDisposed()) {
                  btnShowSuccessRate.setSelection(false);
               }
               btnShowSuccessRate.setEnabled(successRateChartModel != null);
               showSuccessRate(false);
               // store success rate
               IndicatorTrendComposite.this.successRateModel = successRateChartModel;
               showSuccessRate(btnShowSuccessRate.getSelection());

               if (init) {
                  initDataBindings();
               }
               // update Fdcr graph model if available
               if (fdcrDataAvailable) {
                  if (deselectAllIndicatorNodesAction != null && !deselectAllIndicatorNodesAction.isEnabled()) {
                     return;
                  }
                  updateFdcrGraphModel();
               }

               if (contextualDataAvailable == null) {
                  // Lazy initialization of the contextual data
                  contextualDataAvailable = areContextualDataAvailable();
                  if (contextualDataAvailable) {
                     initContextualParameters();
                  }
               }
               btnSelectContextualData.setVisible(contextualDataAvailable);
            }
         } catch (InterruptedException e) {
            LOGGER.error(e.getMessage(), e);
            MgsDetailsLogException detailsLogException = new MgsDetailsLogException(Messages.CORE.getString("Details_log")); // #1687
            Thread.currentThread().interrupt();
            StatusManager.getManager().handle(new Status(IStatus.ERROR, Activator.PLUGIN_ID, Messages.CORE.getString("IndicatorTrendComposite_7"), detailsLogException), StatusManager.SHOW);
         } catch (InvocationTargetException e) {
            LOGGER.error(e.getMessage(), e);
            MgsDetailsLogException detailsLogException = new MgsDetailsLogException(Messages.CORE.getString("Details_log")); // #1687
            StatusManager.getManager().handle(new Status(IStatus.ERROR, Activator.PLUGIN_ID, Messages.CORE.getString("IndicatorTrendComposite_8"), detailsLogException), StatusManager.SHOW);
         }
      });
   }

