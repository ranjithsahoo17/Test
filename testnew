import jakarta.ejb.Stateless;
import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;

/**
 * Implementation of the IAircraftConfigurationService interface.
 */
@Remote(IAircraftService.class)
@Stateless(mappedName = IAircraftService.EJB_NAME)
public class AircraftService implements IAircraftService {

   /** LOGGER. */
   private static final Logger LOGGER = LogManager.getLogger(AircraftService.class);

   @EJB
   private AircraftDao aircraftDao;

   @EJB
   private AircraftTypeDao aircraftTypeDao;

   @EJB
   private ConfigurationDao configurationDao;

   @EJB
   private INotificationService notificationService;

   @EJB
   private AircraftLockManager aircraftLockManager;

   @EJB
   private AircraftConfigurationManager aircraftConfigurationManager;

   @PersistenceContext
   private EntityManager manager;

   @EJB
   private ParameterManager parameterManager;

   private SynchronizationManager synchronizationManager;

   private final HealthDelegate healthDelegate = new HealthDelegate();

   private final UsageDelegate usageDelegate = new UsageDelegate();

   public AircraftService() {
      // Nothing to do
   }

   @PostConstruct
   public void initialize() {
      synchronizationManager = new SynchronizationManager();
      synchronizationManager.setEntityManager(manager);
   }

   @Override
   public Set<Aircraft> getAircrafts() {
      return new HashSet<>(aircraftDao.findAll());
   }

   @Override
   public Set<AircraftType> getAircraftTypes() {
      Set<AircraftType> aircraftTypes = new HashSet<>(aircraftTypeDao.findAll());
      for (AircraftType aircraftType : aircraftTypes) {
         // Force initialization of lazy collections
         for (AvionicVersion avionicVersion : aircraftType.getAvionicVersions().values()) {
            avionicVersion.getHealthVersions().size();
            avionicVersion.getFeatures().size();
         }
      }
      return aircraftTypes;
   }

   @Override
   public List<DmauVersion> getDmauVersions() {
      return manager.createNamedQuery("findAllDmauVersions", DmauVersion.class).getResultList();
   }

   @Override
   public List<UsageFormat> getUsageFormats() {
      return manager.createNamedQuery("findAllUsageFormats", UsageFormat.class).getResultList();
   }

   @Override
   public Aircraft getAircraft(String aircraftId) throws EntityNotFoundException {
      return aircraftDao.findById(aircraftId);
   }

   @Override
   public Set<AircraftConfiguration> getAircraftConfigurations(String aircraftId) {
      Set<AircraftConfiguration> configurations = new HashSet<>();
      Map<Object, Object> entityMap = new HashMap<>();
      for (AircraftConfiguration serverConfiguration : configurationDao.findConfigurations(aircraftId)) {
         Aircraft aircraft = serverConfiguration.getAircraft();
         entityMap.put(aircraft, aircraft);
         AvionicVersion avionicVersion = serverConfiguration.getAvionicVersion();
         entityMap.put(avionicVersion, avionicVersion);
         DmauVersion dmauVersion = serverConfiguration.getDmauVersion();
         entityMap.put(dmauVersion, dmauVersion);
         AircraftConfiguration configuration = new AircraftConfiguration(serverConfiguration.getId());
         synchronizationManager.merge(configuration, serverConfiguration, entityMap);
         configurations.add(configuration);
         entityMap.clear();
      }
      return configurations;
   }

   @Override
   public AircraftConfiguration getLatestConfiguration(String aircraftId) throws EntityNotFoundException {
      AircraftConfiguration latestConfiguration = configurationDao.getLatestConfiguration(aircraftId);
      // Initialize lazy collections
      UsageConfiguration usageConfiguration = (UsageConfiguration) latestConfiguration.getConfigurations().get(UsageConfiguration.TYPE);
      usageConfiguration.getExceedanceThresholds().size();
      usageConfiguration.getWorkcardReferences().size();

      if (latestConfiguration.getConfigurations().containsKey(HealthMonitoringConfiguration.TYPE)) {
         HealthMonitoringConfiguration healthConfiguration = (HealthMonitoringConfiguration) latestConfiguration.getConfigurations().get(HealthMonitoringConfiguration.TYPE);
         healthConfiguration.getMechanicalComponentConfigurations().size();
      }
      return latestConfiguration;
   }

   @Override
   public Map<String, Map<String, String>> getConfigurationVersions() throws EntityNotFoundException {
      Map<String, Map<String, String>> aircraftConfigurations = new HashMap<>();
      for (Aircraft aircraft : aircraftDao.findAll()) {
         Map<String, String> configurations = new HashMap<>();
         for (Map.Entry<String, Configuration> entry : getLatestConfiguration(aircraft.getId()).getConfigurations().entrySet()) {
            configurations.put(entry.getKey(), entry.getValue().getVersion() + (entry.getValue().isOriginal() ? "" : "*"));
         }
         if (aircraft.getRtbConfiguration() != null) {
            // Special case for RTB (non historicized)
            configurations.put(RtbConfiguration.TYPE, aircraft.getRtbConfiguration().getVersion() + (aircraft.getRtbConfiguration().isOriginal() ? "" : "*"));
         }
         aircraftConfigurations.put(aircraft.getId(), configurations);
      }
      return aircraftConfigurations;
   }

   @Override
   public void updateAircraftConfiguration(AircraftConfigurationHistoryDto configurationHistoryDto, String applicableFlightId) throws EntityNotFoundException,
         NotificationException, ConcurrentAccessException {
      AircraftConfiguration aircraftConfiguration = configurationDao.findById(configurationHistoryDto.getAircraftConfigurationId());
      String aircraftId = aircraftConfiguration.getAircraft().getId();
      aircraftLockManager.throwExceptionIfBackgroundTask(aircraftId);
      aircraftLockManager.throwExceptionIfAircraftLocked(aircraftId);

      Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      long start;
      long end;
      long duration;
      start = System.currentTimeMillis();
      LOGGER.info("Start updating aircraft configuration (from settings) for the aircraft {}, SN : {}", aircraft.getAircraftType().getName(), aircraft.getAircraftId());
      // Abort if the aircraft is frozen
      if (aircraft.getAircraftState() == AircraftState.FROZEN) {
         throw new ConcurrentAccessException("The aircraft has been modified by an other user.");
      }
      if (aircraft.getAircraftState() == AircraftState.DELETED) {
         throw new ConcurrentAccessException("The aircraft is being deleted.");
      }

      AircraftConfiguration newAircraftConfiguration = aircraftConfigurationManager.cloneAircraftConfiguration(aircraftConfiguration);

      final Date applicableDate;
      if (applicableFlightId != null) {
         final Flight flight = manager.find(Flight.class, applicableFlightId);
         applicableDate = flight.getUsageStartDate();
      } else {
         applicableDate = new Date(0);
      }
      newAircraftConfiguration.setApplicableDate(applicableDate);
      updateConfiguration(newAircraftConfiguration, configurationHistoryDto);
      configurationDao.create(newAircraftConfiguration);
      notificationService.notifyAction(newAircraftConfiguration, Action.CREATION);
      end = System.currentTimeMillis();
      duration = end - start;
      LOGGER.info("End updating aircraft configuration (from settings) for the aircraft {}, SN : {} in {} ms.", aircraft.getAircraftType().getName(), aircraft.getAircraftId(), duration);
   }

   private void updateConfiguration(AircraftConfiguration aircraftConfiguration, AircraftConfigurationHistoryDto configurationHistoryDto) {
      if (configurationHistoryDto.isHealthConfigurationUpdated()) {
         HealthMonitoringConfiguration healthMonitoringConfiguration = (HealthMonitoringConfiguration) aircraftConfiguration.getConfigurations().get(HealthMonitoringConfiguration.TYPE);
         healthDelegate.updateHealthConfiguration(healthMonitoringConfiguration, configurationHistoryDto.getMechanicalComponentConfigurations());

         LOGGER.info("Health configuration have been updated");
      }

      if (configurationHistoryDto.isWorkcardConfigurationUpdated()) {
         usageDelegate.updateUsageConfiguration(aircraftConfiguration, configurationHistoryDto.getWorkcardReferences());

         LOGGER.info("Usage configuration have been updated");
      }
   }

   @Override
   public boolean isFdcrConfigurationAvailable(String aircraftId) throws EntityNotFoundException {
      return getLatestConfiguration(aircraftId).getConfigurations().get(FdcrConfiguration.TYPE) != null;
   }

   @Override
   public AircraftHistory getAircraftHistory(String aircraftId) {
      return aircraftDao.getAircraftHistory(aircraftId);
   }

   @Override
   public boolean isLocked(String aircraftId) {
      return aircraftLockManager.findAircraftLockByAircraftId(aircraftId).isPresent();
   }

}

