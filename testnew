   /**
    * Indicates whether data are valid or not.
    * 
    * @param dataToBeValidated
    *           to be validated
    * @return true if data are valid, false otherwise
    */
   public boolean isValidData(Map<Aircraft, WCMechanicalComponentModel> dataToBeValidated) {

      // for each aircraft
      for (Entry<Aircraft, WCMechanicalComponentModel> entry : dataToBeValidated.entrySet()) {

         // retrieve the whole set of thresholds of the current aircraft
         Multimap<Indicator, WCThresholdModel> wcThresholdMap = getComponentThresholds(entry.getValue());
         for (Indicator indicator : wcThresholdMap.keySet()) {
            WCThresholdModel redModel = null;
            WCThresholdModel amberModel = null;
            for (WCThresholdModel currentModel : wcThresholdMap.get(indicator)) {
               switch (currentModel.getType()) {
                  case FIXED:
                     if (currentModel.getDefaultValue() == null) {
                        // fixed thresholds without value
                        MessageDialog.openError(parent.getShell(),
                              Messages.CORE.getString("healthAlarmPageDataInvalidTitle"),
                              MessageFormat.format(
                                    Messages.CORE.getMnemonicEscapedString("healthAlarmPageDataInvalidMessage"),
                                    entry.getKey().getRegisterNumber(),
                                    currentModel.getHealthMechanicalComponentName() + "/"
                                          + currentModel.getIndicator()
                                          + " (fixed threshold value cannot be undefined)"));
                        return false;
                     }
                     break;

                  case LEARNED:
                     if (currentModel.getMinValue() != null) {
                        final double min;
                        final double max;
                        if (currentModel.getLevel() == ThresholdLevel.HIGH) {
                           min = currentModel.getMinValue();
                           max = currentModel.getMaxValue();
                        } else {
                           min = currentModel.getMaxValue();
                           max = currentModel.getMinValue();
                        }
                        if (min >= max) {
                           MessageDialog.openError(parent.getShell(),
                                 Messages.CORE.getString("healthAlarmPageDataInvalidTitle"),
                                 MessageFormat.format(
                                       Messages.CORE
                                             .getMnemonicEscapedString("healthAlarmPageDataInvalidMessage"),
                                       entry.getKey().getRegisterNumber(),
                                       currentModel.getHealthMechanicalComponentName() + "/"
                                             + currentModel.getIndicator() + " (check min and max values)"));
                           return false;
                        }
                     }
                     break;
                  default:
                     throw new IllegalStateException("Unhandled threshold type : " + currentModel.getType());
               }
               if (currentModel.getSeverity() == Severity.RED) {
                  redModel = currentModel;
               } else {
                  amberModel = currentModel;
               }
            }

            if (redModel != null && amberModel != null) {

               boolean valid = true;
               if (amberModel.getDefaultValue() == null || redModel.getDefaultValue() == null) {
                  continue;
               } else if (amberModel.getLevel() == redModel.getLevel()) {
                  boolean highAmberHigherThanHighRed = amberModel.getLevel() == ThresholdLevel.HIGH
                        && amberModel.getDefaultValue() > redModel.getDefaultValue();
                  // threshold
                  boolean lowAmberSmallerThanLowRed = amberModel.getLevel() == ThresholdLevel.LOW
                        && amberModel.getDefaultValue() < redModel.getDefaultValue();
                  if (highAmberHigherThanHighRed || lowAmberSmallerThanLowRed) {
                     valid = false;
                  }
               } else if (amberModel.getLevel() == ThresholdLevel.HIGH
                     && amberModel.getDefaultValue() < redModel.getDefaultValue()) {
                  // threshold
                  valid = false;
               } else if ((redModel.getLevel() == ThresholdLevel.HIGH)
                     && (redModel.getDefaultValue() < amberModel.getDefaultValue())) {
                  // threshold
                  valid = false;
               }
               if (!valid) {
                  MessageDialog.openError(parent.getShell(),
                        Messages.CORE.getString("healthAlarmPageDataInvalidTitle"),
                        MessageFormat.format(
                              Messages.CORE.getMnemonicEscapedString("healthAlarmPageDataInvalidMessage"),
                              entry.getKey().getRegisterNumber(),
                              amberModel.getHealthMechanicalComponentName() + ">"
                                    + amberModel.getIndicator().getName()));
                  return false;
               }
            }
         }
      }

      List<WCThresholdModel> deviatedModels = new ArrayList<>();
      for (Entry<Aircraft, WCMechanicalComponentModel> entry : dataToBeValidated.entrySet()) {
         for (WCThresholdModel model : getComponentThresholds(entry.getValue()).values()) {
            // BCR-6605 Benoit 30-10: Value is a deviation field, so a Value-only edit must also
            // demand a TE. hasDeviationFieldChanged is the explicit list, it never misses one.
            if (model.isDeviated() || model.isModifiedAgainstBaseline() || hasDeviationFieldChanged(model)) {
               deviatedModels.add(model);
            }
         }
      }
      for (WCThresholdModel model : deviatedModels) {
         if (model.getTeReference() == null || model.getTeReference().trim().isEmpty()) {
            MessageDialog.openError(parent.getShell(),
                  Messages.CORE.getString("healthAlarmPageDataInvalidTitle"), MessageFormat.format(Messages.CORE.getString("deviationErrorTeMandatory"), model.getIndicator().getName()));
            return false;
         }
      }
      for (WCThresholdModel model : deviatedModels) {
         model.setDeviated(true);
      }
      this.data = dataToBeValidated;
      return true;
   }

   /**
    * Retrieve the list of the whole threshold models for a specific component.
    * 
    * @param component
    *           the component from which thresholds models have to be retrieved
    * @return a list of thresholds models
    */
   private Multimap<Indicator, WCThresholdModel> getComponentThresholds(WCMechanicalComponentModel component) {
      Multimap<Indicator, WCThresholdModel> thresholdModels = ArrayListMultimap.create();

      // add the list of thresholds models to the result, if they exist
      for (WCHealthMechanicalComponentModel healthMechanicalComponentModel : component.getHealthComponentModels()) {
         for (WCThresholdModel thresholdModel : healthMechanicalComponentModel.getThresholdModels()) {
            if (thresholdModel.isEnabled()) {
               thresholdModels.put(thresholdModel.getIndicator(), thresholdModel);
            }
         }
      }
      for (WCMechanicalComponentModel mechanicalComponentModel : component.getSubHealthWCModel()) {
         thresholdModels.putAll(getComponentThresholds(mechanicalComponentModel));
      }
      return thresholdModels;
   }

