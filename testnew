   @Override
   public Map<String, Map<IndicatorValue, IAcquisition>> getIndicatorValues(String avionicName, String aircraftId, String indicatorId) {
      Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      Indicator indicator = manager.find(Indicator.class, indicatorId);
      Avionic avionic = Avionic.valueOf(avionicName);
      Map<Date, IAcquisition> dateAcquisitionMap = new HashMap<>();
      // Note : Read indicators for CIGALHE avionic have no accelerometers and no corresponding acquisition
      if (avionic == Avionic.CIGALHE) {
         Set<HealthConfigurationBounds> configurationBoundSet = getConfigurationBounds(aircraftId);
         for (HealthConfigurationBounds configurationBounds : configurationBoundSet) {
            // 1. Find the indicator configuration
            TypedQuery<IndicatorConfiguration> indicatorConfigurationQuery = manager.createNamedQuery("findIndicatorConfigurationByHealthConfigurationAndIndicator", IndicatorConfiguration.class);
            indicatorConfigurationQuery.setParameter("indicatorId", indicatorId);
            indicatorConfigurationQuery.setParameter("configurationId", configurationBounds.getHealthMonitoringConfiguration().getId());
            List<IndicatorConfiguration> indicatorConfigurations = indicatorConfigurationQuery.getResultList();
            if (indicatorConfigurations.isEmpty()) {
               // Indicator was not present => skip the configuration
               continue;
            }
            IndicatorConfiguration indicatorConfiguration = indicatorConfigurations.get(0);
            if (indicatorConfiguration.getAccelerometer() == null) {
               // No accelerometer = read indicator
               // Anyway, no sensor acquisition will match
               continue;
            }

            // 2. Find acquisition matching date bounds + accelerometer
            final TypedQuery<Object[]> sensorAcquisitionQuery;
            if (configurationBounds.getEndDate() == null) {
               sensorAcquisitionQuery = manager.createNamedQuery("findSensorAcquisitionsByAccelerometerIdAfterDate", Object[].class);
               sensorAcquisitionQuery.setParameter("startDate", configurationBounds.getStartDate());
            } else {
               sensorAcquisitionQuery = manager.createNamedQuery("findSensorAcquisitionsByAccelerometerIdBetweenDate", Object[].class);
               sensorAcquisitionQuery.setParameter("startDate", configurationBounds.getStartDate());
               sensorAcquisitionQuery.setParameter("endDate", configurationBounds.getEndDate());
            }
            sensorAcquisitionQuery.setParameter("accelerometerId", indicatorConfiguration.getAccelerometer().getId());
            List<Object[]> sensorAcquisitions = sensorAcquisitionQuery.getResultList();
            for (final Object[] sensorAcquisitionData : sensorAcquisitions) {
               String id = (String) sensorAcquisitionData[0];
               Date startDate = (Date) sensorAcquisitionData[1];
               String componentAcquisitionId = (String) sensorAcquisitionData[2];
               String acquisitionType = (String) sensorAcquisitionData[3];
               double samplingFrequency = (Double) sensorAcquisitionData[4];
               long samplingSize = (Long) sensorAcquisitionData[5];
               String accelerometerName = indicatorConfiguration.getAccelerometer().getName();
               dateAcquisitionMap.put(startDate, new Acquisition(id, acquisitionType, startDate, samplingFrequency, samplingSize, componentAcquisitionId, accelerometerName));
            }
         }
      } else if (avionic == Avionic.MARMS) {
         TypedQuery<Object[]> marmsAcquisitionQuery = manager.createNamedQuery("findMarmsMechanicalComponentAcquisitionByIndicator",
               Object[].class);
         marmsAcquisitionQuery.setParameter("indicator", indicator);
         List<Object[]> marmsAcquisitions = marmsAcquisitionQuery.getResultList();
         for (Object[] marmsAcquisition : marmsAcquisitions) {
            String id = (String) marmsAcquisition[0];
            Date startDate = (Date) marmsAcquisition[1];
            double samplingFrequency = (Double) marmsAcquisition[2];
            long samplingSize = (Long) marmsAcquisition[3];
            dateAcquisitionMap.put(startDate, new Acquisition(id, null, startDate, samplingFrequency, samplingSize, id, null));
         }
      }
      Map<String, Map<IndicatorValue, IAcquisition>> indicatorValuesByFlight = new HashMap<>();
      TypedQuery<Object[]> indicatorValuesQuery = manager.createNamedQuery("findFlightIndicatorValuesByIndicator", Object[].class);
      indicatorValuesQuery.setParameter("indicator", indicator);
      indicatorValuesQuery.setParameter("aircraft", aircraft);
      for (Object[] result : indicatorValuesQuery.getResultList()) {
         FlightIndicatorValue flightIndicatorValue = (FlightIndicatorValue) result[0];
         Flight flight = (Flight) result[1];
         if (!indicatorValuesByFlight.containsKey(flight.getId())) {
            indicatorValuesByFlight.put(flight.getId(), new HashMap<>());
         }
         for (IndicatorValue indicatorValue : flightIndicatorValue.getValues()) {
            indicatorValuesByFlight.get(flight.getId()).put(indicatorValue, dateAcquisitionMap.get(indicatorValue.getStartDate()));
         }
      }
      return indicatorValuesByFlight;
   }

