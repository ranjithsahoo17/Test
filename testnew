
package com.eurocopter.mgs.datamodel.health.monitoring;

import java.io.Serializable;
import java.util.Date;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.FetchType;
import jakarta.persistence.Id;
import jakarta.persistence.JoinColumn;
import jakarta.persistence.ManyToOne;
import jakarta.persistence.NamedQuery;
import jakarta.persistence.Table;
import jakarta.persistence.Temporal;
import jakarta.persistence.TemporalType;

/**
 * The display data of an aircraft.
 */
@Entity
@Table(name = "INDICATOR_DEVIATION")
@NamedQuery(name = "findActiveDeviationsByIndicators", query = "SELECT d FROM IndicatorDeviation d WHERE d.indicatorConfiguration.indicator.id IN :indicatorIds AND d.endDate IS NULL")
@NamedQuery(name = "findDeviationHistoryByIndicators", query = "SELECT d FROM IndicatorDeviation d WHERE d.indicatorConfiguration.indicator.id IN :indicatorIds AND d.endDate IS NOT NULL")
@NamedQuery(name = "findAllDeviationsByAircraft", query = "SELECT d FROM IndicatorDeviation d JOIN d.indicatorConfiguration ic WHERE ic.indicator.id IN (SELECT i.id FROM Aircraft a JOIN a.healthComponents hmc JOIN hmc.indicators i WHERE a.id = :aircraftId)")

public class IndicatorDeviation implements Serializable {

   private static final long serialVersionUID = 1L;

   @Id
   @Column(name = "ID", nullable = false)
   private String id;

   @ManyToOne(fetch = FetchType.LAZY, optional = false)
   @JoinColumn(name = "INDICATOR_CONFIGURATION_ID", nullable = false)
   private IndicatorConfiguration indicatorConfiguration;

   @ManyToOne(fetch = FetchType.LAZY)
   @JoinColumn(name = "FILTERING_LAW_ID")
   private FilteringLaw filteringLaw;

   @Column(name = "TE_REFERENCE", nullable = false)
   private String teReference;

   @Temporal(TemporalType.TIMESTAMP)
   @Column(name = "START_DATE", nullable = false)
   private Date startDate;

   @Temporal(TemporalType.TIMESTAMP)
   @Column(name = "END_DATE")
   private Date endDate;

   @Column(name = "SEVERITY")
   private String severity;

   @Column(name = "THRESHOLD_LEVEL")
   private String thresholdLevel;

   @Column(name = "THRESHOLD_TYPE")
   private String thresholdType;

   @Column(name = "THRESHOLD_VALUE")
   private Double thresholdValue;

   @Column(name = "MIN_VALUE")
   private Double minValue;

   @Column(name = "MAX_VALUE")
   private Double maxValue;

   @Column(name = "LEARNING_TIME")
   private Long learningTime;

   @Column(name = "MINIMUM_DEVIATION")
   private Double minimumDeviation;

   @Column(name = "MEAN_FACTOR")
   private Double meanFactor;

   @Column(name = "DEVIATION_COEFFICIENT")
   private Double deviationCoefficient;
   @Column(name = "NB_SUCCESSIVE_POINTS")
   private Integer nbSuccessivePoints;

   IndicatorDeviation() {
   }

   public IndicatorDeviation(String id) {
      this.id = id;
   }

   public boolean isActive() {
      return endDate == null;
   }

   public String getId() {
      return id;
   }

   public void setId(String id) {
      this.id = id;
   }

   public IndicatorConfiguration getIndicatorConfiguration() {
      return indicatorConfiguration;
   }

   public void setIndicatorConfiguration(IndicatorConfiguration indicatorConfiguration) {
      this.indicatorConfiguration = indicatorConfiguration;
   }

   public FilteringLaw getFilteringLaw() {
      return filteringLaw;
   }

   public void setFilteringLaw(FilteringLaw filteringLaw) {
      this.filteringLaw = filteringLaw;
   }

   public String getTeReference() {
      return teReference;
   }

   public void setTeReference(String teReference) {
      this.teReference = teReference;
   }

   public Date getStartDate() {
      return startDate;
   }

   public void setStartDate(Date startDate) {
      this.startDate = startDate;
   }

   public Date getEndDate() {
      return endDate;
   }

   public void setEndDate(Date endDate) {
      this.endDate = endDate;
   }

   public String getSeverity() {
      return severity;
   }

   public void setSeverity(String severity) {
      this.severity = severity;
   }

   public String getThresholdLevel() {
      return thresholdLevel;
   }

   public void setThresholdLevel(String thresholdLevel) {
      this.thresholdLevel = thresholdLevel;
   }

   public String getThresholdType() {
      return thresholdType;
   }

   public void setThresholdType(String thresholdType) {
      this.thresholdType = thresholdType;
   }

   public Double getThresholdValue() {
      return thresholdValue;
   }

   public void setThresholdValue(Double thresholdValue) {
      this.thresholdValue = thresholdValue;
   }

   public Double getMinValue() {
      return minValue;
   }

   public void setMinValue(Double minValue) {
      this.minValue = minValue;
   }

   public Double getMaxValue() {
      return maxValue;
   }

   public void setMaxValue(Double maxValue) {
      this.maxValue = maxValue;
   }

   public Long getLearningTime() {
      return learningTime;
   }

   public void setLearningTime(Long learningTime) {
      this.learningTime = learningTime;
   }

   public Double getMinimumDeviation() {
      return minimumDeviation;
   }

   public void setMinimumDeviation(Double minimumDeviation) {
      this.minimumDeviation = minimumDeviation;
   }

   public Double getMeanFactor() {
      return meanFactor;
   }

   public void setMeanFactor(Double meanFactor) {
      this.meanFactor = meanFactor;
   }

   public Double getDeviationCoefficient() {
      return deviationCoefficient;
   }

   public void setDeviationCoefficient(Double deviationCoefficient) {
      this.deviationCoefficient = deviationCoefficient;
   }

   public Integer getNbSuccessivePoints() {
      return nbSuccessivePoints;
   }

   public void setNbSuccessivePoints(Integer nbSuccessivePoints) {
      this.nbSuccessivePoints = nbSuccessivePoints;
   }

}
