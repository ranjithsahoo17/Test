import jakarta.persistence.CascadeType;
import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.FetchType;
import jakarta.persistence.Id;
import jakarta.persistence.JoinColumn;
import jakarta.persistence.ManyToOne;
import jakarta.persistence.NamedQuery;
import jakarta.persistence.OneToMany;
import jakarta.persistence.OneToOne;
import jakarta.persistence.OrderBy;
import jakarta.persistence.Table;
import jakarta.persistence.Temporal;
import jakarta.persistence.TemporalType;
import jakarta.persistence.UniqueConstraint;
import jakarta.persistence.Transient;

/**
 * This class represents aircraft entities.
 */
@Entity
@Table(name = "AIRCRAFT", uniqueConstraints = {
      @UniqueConstraint(columnNames = { "AIRCRAFT_TYPE_ID", "AIRCRAFT_SERIAL_NUMBER" }),
      @UniqueConstraint(columnNames = { "AIRCRAFT_TYPE_ID", "AIRCRAFT_ID" }),
      @UniqueConstraint(columnNames = { "REGISTER_NUMBER" }) })
@NamedQuery(name = "findAircrafts", query = "SELECT DISTINCT a FROM Aircraft a WHERE a.aircraftState != 'DELETED'")
@NamedQuery(name = "findAircraftByAircraftId", query = "SELECT a FROM Aircraft a WHERE a.aircraftType.name = :aircraftType AND a.aircraftId = :aircraftId")
@NamedQuery(name = "findAircraftByAircraftIdAndSerialNumber", query = "SELECT a FROM Aircraft a WHERE a.aircraftType.name = :aircraftType " +
      "AND ((:aircraftId IS NULL AND a.aircraftId IS NULL) OR (:aircraftId IS NOT NULL AND a.aircraftId = :aircraftId)) " +
      "AND ((:aircraftSerialNumber IS NULL AND a.aircraftSerialNumber IS NULL) OR (:aircraftSerialNumber IS NOT NULL AND a.aircraftSerialNumber = :aircraftSerialNumber))")
@NamedQuery(name = "findAircraftByAircraftSerialNumber", query = "SELECT a FROM Aircraft a WHERE a.aircraftType.name = :aircraftType AND a.aircraftSerialNumber = :aircraftSerialNumber")
@NamedQuery(name = "findAircraftByRegisterNumber", query = "SELECT a FROM Aircraft a WHERE a.registerNumber = :registerNumber")
@NamedQuery(name = "findAircraftByFileName", query = "SELECT a FROM AircraftConfiguration c JOIN c.aircraft a JOIN c.avionicVersion v WHERE a.aircraftId = :aircraftId AND v.subtype = :subtype AND c.applicableDate < :date ORDER BY c.serialNumber DESC")
@NamedQuery(name = "findAvionicAircraft", query = "SELECT v.subtype, a.aircraftId FROM AircraftConfiguration c JOIN c.aircraft a JOIN c.avionicVersion v")
@NamedQuery(name = "findSubtypeByFlightId", query = "SELECT v.subtype FROM AircraftConfiguration c JOIN c.aircraft a JOIN a.flights f JOIN c.avionicVersion v WHERE f.id = :flightId AND f.configurationSerialNumber = c.serialNumber")
public class Aircraft implements Serializable {

   /** The Constant serialVersionUID. */
   private static final long serialVersionUID = 1L;

   /**
    * Database technical ID.
    */
   @Id
   @Column(name = "ID", nullable = false)
   private String id;

   /**
    * Version for concurrency management
    */
   private int version;

   /**
    * Type of the aircraft. Mandatory / Not updatable.
    */
   @ManyToOne(fetch = FetchType.EAGER, optional = false)
   @JoinColumn(name = "AIRCRAFT_TYPE_ID", nullable = false)
   private AircraftType aircraftType;

   /**
    * aircraft id of the aircraft.
    */
   @Column(name = "AIRCRAFT_ID")
   private String aircraftId;

   /**
    * Data transfer type.
    */
   @Column(name = "DATA_TRANSFER_TYPE")
   private String dataTransferType;

   /**
    * Aircraft serial number.
    */
   @Column(name = "AIRCRAFT_SERIAL_NUMBER")
   private String aircraftSerialNumber;

   /**
    * Register Number of the aircraft. Unique Identifier whatever the aircraft type and whatever the customer owner. Mandatory / Unique.
    */
   @Column(name = "REGISTER_NUMBER", nullable = false)
   private String registerNumber;

   /**
    * Free Textual Description.
    */
   @Column(name = "DESCRIPTION")
   private String description;

   /**
    * The home base name of the A/C. Mandatory.
    */
   @ManyToOne(fetch = FetchType.EAGER, optional = false)
   @JoinColumn(name = "GROUND_STATION_ID", referencedColumnName = "BASE_NAME", updatable = false, nullable = false)
   private GroundStation groundStation;

   /**
    * Engine Type of the aircraft.
    */
   @Column(name = "ENGINE_TYPE")
   private String engineType;

   /**
    * State of the aircraft: Active or Frozen.
    */
   @Column(name = "STATE", nullable = false)
   private String aircraftState;

   /**
    * GO/NOGO Status of the aircraft.
    */
   @Column(name = "STATUS", nullable = false)
   private String aircraftStatus;

   /**
    * Old version of the aircraft (when import / attach). FIXME : To be renamed to 'homeVersion' (the version of the AC in the home base)
    */
   @Column(name = "OLD_VERSION")
   private int oldVersion;

   /**
    * Aircraft display data.
    */
   @Transient
private AircraftDisplayData displayData;

   /**
    * Attachment date.
    */
   @Column(name = "ATTACHMENT_DATE")
   @Temporal(TemporalType.TIMESTAMP)
   private Date attachmentDate;

   /**
    * Set of aircraft accelerometers.
    */
   @OneToMany(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "AIRCRAFT_ID", updatable = false)
   private Set<Accelerometer> accelerometers = new HashSet<>();

   /**
    * Set of mechanical component.
    */
   @Transient
private Set<HealthMechanicalComponent> healthMechanicalComponents = new HashSet<>();

   /**
    * Set of failure characteristics.
    */
   @Transient
private Set<FailureCharacteristics> failureCharacteristics = new HashSet<>();

   /**
    * Set of aircraft FDCR parameters.
    */
   @Transient
private Set<FdcrPartition> fdcrPartitions = new HashSet<>();

   /**
    * Set of flights attached to this aircraft.
    */
   @OneToMany(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "AIRCRAFT_ID", updatable = false)
   private Set<Flight> flights = new HashSet<>();

   /**
    * Set of purged flights attached to this aircraft.
    */
   @Transient
private Set<PurgedFlight> purgedFlights = new HashSet<>();

   /**
    * Set of downloads attached to this aircraft.
    */
   @OneToMany(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "AIRCRAFT_ID", updatable = false)
   private Set<Download> downloads = new HashSet<>();

   @Transient
private RtbConfiguration rtbConfiguration;

   /** The main rotor tuning. */
   @Transient
private MainRotorTuning mainRotorTuning;

   /** The tail rotor tuning. */
   @Transient
private TailRotorTuning tailRotorTuning;

   /**
    * Set of UMS data.
    */
   @Transient
private Set<UmsData> umsData = new HashSet<>();

   /**
    * Set of Flight synthesis usage parameters.
    */
   @Transient
private List<FlightSynthesisUsageParameter> flightSynthesisUsageParameters = new ArrayList<>();

   /**
    * Set of Folder
    */
   @OneToMany(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "AIRCRAFT_ID", updatable = false)
   private Set<Folder> folders = new HashSet<>();

   /**
    * Instantiates a new aircraft.
    */
   Aircraft() {
   }

   /**
    * Instantiates a new aircraft.
    *
    * @param id
