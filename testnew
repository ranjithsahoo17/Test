   private Map<String, Object> buildBasicFlightProperties(Map<String, Object> flightProperties) {
      Map<String, Object> flightBasicProperties = new HashMap<>();
      for (Map.Entry<String, Object> entry : flightProperties.entrySet()) {
         if (!FLIGHT_RELATIONAL_IDS.contains(entry.getKey())) {
            final Object value = formatValue(entry);
            flightBasicProperties.put(entry.getKey(), value);
         }
      }
      return flightBasicProperties;
   }

   private Map<String, Object> buildBasicAircraftProperties(Map<String, Object> aircraftProperties) {
      Map<String, Object> aircraftBasicProperties = new HashMap<>();
      for (Map.Entry<String, Object> entry : aircraftProperties.entrySet()) {
         if (!AIRCRAFT_RELATIONAL_IDS.contains(entry.getKey())) {
            final Object value = formatValue(entry);
            aircraftBasicProperties.put(entry.getKey(), value);
         }
      }
      return aircraftBasicProperties;
   }

   private Object formatValue(Map.Entry<String, Object> entry) {
      final Object value;
      if (entry.getValue() instanceof Number) {
         value = ((Number) entry.getValue()).intValue();
      } else {
         value = entry.getValue();
      }
      return value;
   }

   private void readImportSql(File folder, String filename) {
      List<String> aircraftLines;
      try {
         aircraftLines = IOUtils.readLines(AircraftExportService.class.getResourceAsStream("/sql/" + filename + ".sql"), StandardCharsets.UTF_8);
      } catch (IOException e) {
         throw new RuntimeException(e);
      }

      for (String line : aircraftLines) {
         String formattedLine = line.replace("${aircraft_folder}", folder.getAbsolutePath()).replace("${columns}", findColumns(folder, line));
         Query query = manager.createNativeQuery(formattedLine);
         query.executeUpdate();
      }
   }

   private String findColumns(File folder, String line) {
      Pattern pattern = Pattern.compile("COPY (\\w+) ");
      Matcher matcher = pattern.matcher(line);
      if (matcher.find()) {
         String filename = matcher.group(1) + ".csv";
         File csvFile = new File(folder, filename);
         try {
            return FileUtils.readLines(csvFile, StandardCharsets.UTF_8).get(0).replace(";", ",");
         } catch (IOException e) {
            throw new RuntimeException(e);
         }
      } else {
         throw new IllegalStateException("Invalid line: " + line);
      }
   }

   private CsvParser getCsvParser() {
      CsvParserSettings settings = new CsvParserSettings();
      settings.trimValues(false);
      settings.getFormat().setDelimiter(';');
      settings.setMaxCharsPerColumn(-1);

      return new CsvParser(settings);
   }

   private void updatePendingAndOnErrorLocalDiagnoses(String aircraftId) {
      String localDiagRootDirectory = getLocalDiagRootFolder();
      updatePendingDiagnosesStatus(aircraftId, localDiagRootDirectory);
      updateOnErrorDiagnosesStatusDueToMissingData(aircraftId, localDiagRootDirectory);
   }

   private void updatePendingDiagnosesStatus(String aircraftId, String localDiagRootDirectory) {
      TypedQuery<DiagnosisData> query = manager.createNamedQuery("findPendingDiagnosesByAircraft", DiagnosisData.class);
      query.setParameter("aircraftId", aircraftId);
      for (DiagnosisData diagnosisData : query.getResultList()) {
         String folderName = diagnosisData.getFolderName();
         if (folderName != null && !isLocalDiagDataAvailable(localDiagRootDirectory, folderName)) {
            diagnosisData.setStatus(DiagnosisStatus.ERROR);
            diagnosisData.setErrorCause(DiagnosisErrorCause.MISSING_DATA);
         }
      }
   }

   private void updateOnErrorDiagnosesStatusDueToMissingData(String aircraftId, String localDiagRootDirectory) {
      TypedQuery<DiagnosisData> query = manager.createNamedQuery("findOnErrorDiagnosesDueToMissingDataByAircraft", DiagnosisData.class);
      query.setParameter("aircraftId", aircraftId);
      for (DiagnosisData diagnosisData : query.getResultList()) {
         String folderName = diagnosisData.getFolderName();
         if (folderName != null && isLocalDiagDataAvailable(localDiagRootDirectory, folderName)) {
            diagnosisData.setStatus(DiagnosisStatus.PENDING);
            diagnosisData.setErrorCause(null);
         }
      }
   }

   private String getLocalDiagRootFolder() {
