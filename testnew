   @Override
   public AircraftManagementResult createAircraft(AircraftDto aircraftDto, AircraftConfigurationDto aircraftConfigurationDto, TopicDto topicDto)
         throws AircraftAlreadyExistsException, EntityNotFoundException,
         InvalidArgumentException, NotificationException, AircraftManagementException {
      long start = System.currentTimeMillis();
      LOGGER.info("Start creating aircraft {}, version : {}, SN : {}", aircraftDto.getAircraftType(), aircraftDto.getAvionicVersion(), aircraftDto.getAircraftId());
      DmauVersion dmauVersion = null;
      if (aircraftDto.getDmauVersion() != null) {
         dmauVersion = manager.find(DmauVersion.class, aircraftDto.getDmauVersion());
      }
      AircraftConfigurationBundle configurationBundle = new AircraftConfigurationBundle(aircraftConfigurationDto, dmauVersion);
      AircraftConfigurationBean configurationBean;
      AircraftManagementResult aircraftManagementResult = new AircraftManagementResult();
      configurationBean = configurationBundle.read(aircraftManagementResult);

      try {
         aircraftConfigurationManager.createAircraft(aircraftDto, configurationBean, topicDto);
      } catch (InvalidArgumentException | EntityNotFoundException | NotificationException e) {
         configurationBundle.deleteSourceFolder();
         throw e;
      }

      try {
         File configurationFolder = getAircraftConfigurationFolder(aircraftDto.getAircraftType(), aircraftDto.getAircraftId(), aircraftDto.getAircraftSerialNumber());
         File rootFolder = new File(configurationFolder, "creation");
         if (!rootFolder.exists() && !rootFolder.mkdirs()) {
            throw new DataCollectionException("Unable to create A/C configuration folder: " + rootFolder.getAbsolutePath());
         }
         configurationBundle.moveTo(rootFolder);
      } catch (IOException e) {
         LOGGER.warn("Unable to move A/C configuration file.", e);
      } catch (DataCollectionException e) {
         LOGGER.warn("Unable to collect A/C configuration file.", e);
      }
      long end = System.currentTimeMillis();
      long duration = end - start;
      LOGGER.info("End creating aircraft {}, version : {}, SN : {} in {} ms",
            aircraftDto.getAircraftType(), aircraftDto.getAvionicVersion(), aircraftDto.getAircraftId(), duration);

      return aircraftManagementResult;
   }

   @Override
   public AircraftManagementResult updateAircraft(AircraftDto aircraftDto, AircraftConfigurationDto aircraftConfigurationDto, String applicableFlightId, TopicDto topicDto)
         throws EntityNotFoundException,
         InvalidArgumentException, NotificationException, ConcurrentAccessException, AircraftManagementException {
      long start = System.currentTimeMillis();
      LOGGER.info("Start updating aircraft {}, version : {}, SN : {}", aircraftDto.getAircraftType(), aircraftDto.getAvionicVersion(), aircraftDto.getAircraftId());
      DmauVersion dmauVersion = null;
      if (aircraftDto.getDmauVersion() != null) {
         dmauVersion = manager.find(DmauVersion.class, aircraftDto.getDmauVersion());
      }
      AircraftConfigurationBundle configurationBundle = new AircraftConfigurationBundle(aircraftConfigurationDto, dmauVersion);
      AircraftConfigurationBean configurationBean;
      AircraftManagementResult aircraftManagementResult = new AircraftManagementResult();
      configurationBean = configurationBundle.read(aircraftManagementResult);

      final AircraftIdentificationDetails aircraftIdentificationDetails;
      try {
         aircraftIdentificationDetails = aircraftConfigurationManager.updateAircraft(aircraftDto, configurationBean, applicableFlightId, topicDto);
      } catch (InvalidArgumentException | EntityNotFoundException | ConcurrentAccessException | NotificationException e) {
         configurationBundle.deleteSourceFolder();
         throw e;
      }

      try {
         File oldConfigurationFolder = getAircraftConfigurationFolder(aircraftDto.getAircraftType(), aircraftIdentificationDetails.getPreviousAircraftId(),
               aircraftIdentificationDetails.getPreviousSerialNumber());
         File currentConfigurationFolder = getAircraftConfigurationFolder(aircraftDto.getAircraftType(), aircraftIdentificationDetails.getCurrentAircraftId(),
               aircraftIdentificationDetails.getCurrentSerialNumber());
         if (!oldConfigurationFolder.equals(currentConfigurationFolder)) {
            FileUtils.deleteDirectory(currentConfigurationFolder);
            FileUtils.moveDirectory(oldConfigurationFolder, currentConfigurationFolder);
         }
         SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMdd_hhmm");
         String folderName = "update_" + sdf.format(new Date());
         File rootFolder = new File(currentConfigurationFolder, folderName);
         if (!rootFolder.exists() && !rootFolder.mkdirs()) {
            throw new DataCollectionException("Unable to create A/C configuration folder: " + rootFolder.getAbsolutePath());
         }
         configurationBundle.moveTo(rootFolder);
      } catch (IOException e) {
         LOGGER.warn("Unable to move A/C configuration file.", e);
      } catch (DataCollectionException e) {
         LOGGER.warn("Unable to collect A/C configuration file.", e);
      }
      long end = System.currentTimeMillis();
      long duration = end - start;
      LOGGER.info("End udpating aircraft {}, version : {}, SN : {} in {} ms",
            aircraftDto.getAircraftType(), aircraftDto.getAvionicVersion(), aircraftDto.getAircraftId(), duration);
      return aircraftManagementResult;
   }

