      this.id = id;
   }

   /**
    * Constructor with arguments. Builds a DataCollection.
    *
    */
   public BackgroundOperation(String id, Operation operation) {
      this(id);
      this.operation = operation == null ? null : operation.name();
      Calendar calendar = Calendar.getInstance();
