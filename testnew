   @Override
   public void acknowledgeDeviations(String aircraftId, String loginName, List<String> deviationIds, boolean launchRelearn) throws EntityNotFoundException, ConcurrentAccessException {

      List<IndicatorDeviation> closing = new ArrayList<>();
      for (IndicatorDeviation deviation : healthCommonService.findActiveDeviations(getIndicatorIds(aircraftId))) {
         if (deviationIds.contains(deviation.getId())) {
            closing.add(deviation);
         }
      }
      Date now = new Date();
      for (String id : deviationIds) {
         healthCommonService.acknowledgeDeviation(id, now);
      }

      if (launchRelearn) {
         for (IndicatorDeviation deviation : closing) {
            launchRelearn(aircraftId, loginName, getLearnedThresholdIds(aircraftId, deviation.getIndicatorConfiguration().getIndicator().getId(), deviation.getSeverity(), null),
                  RELEARN_DESCRIPTION_DELETE + deviation.getTeReference());

         }
      }

   }

   private List<String> getLearnedThresholdIds(String aircraftId, String indicatorId, String severity,
         String deviatedType) throws EntityNotFoundException {
      List<String> ids = new ArrayList<>();
      if (deviatedType != null && !ThresholdType.LEARNED.name().equals(deviatedType)) {
         // No return Id;
      }

      for (LearnedThresholdConfiguration threshold : getIndicatorLatestLearnedThresholds(aircraftId, indicatorId)) {
         if (severity != null && !severity.equals(threshold.getThreshold().getSeverity().name())) {
            continue;
         }
         ids.add(threshold.getId());
      }
      return ids;
   }

   private void launchRelearn(String aircraftId, String loginName, List<String> thresholdIds, String description) throws ConcurrentAccessException {
      if (thresholdIds.isEmpty()) {
         return;
      }
      createRelearnThresholdRequests(aircraftId, thresholdIds, 0L, description, loginName);
   }

   private List<IndicatorDeviationDto> toDtos(List<IndicatorDeviation> deviations) {
      List<IndicatorDeviationDto> result = new ArrayList<>();
      for (IndicatorDeviation d : deviations) {
         IndicatorDeviationDto dto = new IndicatorDeviationDto();
         dto.setId(d.getId());
         dto.setIndicatorConfigurationId(d.getIndicatorConfiguration().getId());
         dto.setIndicatorId(d.getIndicatorConfiguration().getIndicator().getId());
         StringBuilder params = new StringBuilder();
         if (d.getFilteringLaw() != null) {
            dto.setFilteringLawId(d.getFilteringLaw().getId());
            dto.setFilteringLawName(d.getFilteringLaw().getName());
         }
         for (ContextualParameter p : d.getFilteringLaw().getContextualParameters()) {
            if (params.length() > 0) {
               params.append("  |  ");
            }
            params.append(p.getName()).append(", min=").append(p.getMinValue()).append(", max=").append(p.getMaxValue());
            if (p.getThresholdOfVariabilityValue() != null) {
               params.append(", S=").append(p.getThresholdOfVariabilityValue());
            }
         }
         dto.setFilteringLawParameters(params.toString());
         dto.setTeReference(d.getTeReference());
         dto.setStartDate(d.getStartDate());
         dto.setEndDate(d.getEndDate());
         dto.setSeverity(d.getSeverity());
         dto.setThresholdLevel(d.getThresholdLevel());
         dto.setThresholdType(d.getThresholdType());
         dto.setThresholdValue(d.getThresholdValue());
         dto.setMinValue(d.getMinValue());
         dto.setMaxValue(d.getMaxValue());
         dto.setLearningTime(d.getLearningTime());
         dto.setMinimumDeviation(d.getMinimumDeviation());
         dto.setMeanFactor(d.getMeanFactor());
         dto.setDeviationCoefficient(d.getDeviationCoefficient());
         dto.setNbSuccessivePoints(d.getNbSuccessivePoints());
         dto.setMaxPointsPerHour(d.getMaxPointsPerHour());
         result.add(dto);
      }
      return result;
   }

