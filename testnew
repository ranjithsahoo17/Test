/**
 * 
 * Aircraft Details Dialog.
 * <P>
 */
public class AircraftDetailsDialog extends Dialog {

   /**
    * If true , The AircraftDetails Dialog has been constructed for the update.
    */
   private static boolean update = false;

   /** The aircraft details composite. */
   private AircraftDetailsComposite aircraftDetailsComposite;

   /** Import Configuration Button */
   private Button importConfigurations;

   /** RTB Parameters */
   private Button rtbParameters;

   /** The aircraft model. */
   private final AircraftDetailsModel aircraftModel;

   private final AtomicReference<String> lastFilePath = new AtomicReference<>();

   /**
    * Instantiates a new aircraft details dialog (for create.
    * 
    * @param parentShell
    *           parent
    */
   public AircraftDetailsDialog(Shell parentShell) {
      super(parentShell);
      aircraftModel = new AircraftDetailsModel();
      setUpdate(false);
   }

   /**
    * Instantiates a new aircraft details dialog (for update).
    * 
    * @param parentShell
    *           Parent
    * @param aircraft
    *           Aircraft
    */
   public AircraftDetailsDialog(Shell parentShell, Aircraft aircraft) {
      super(parentShell);
      setUpdate(true);
      final BundleContext aircraftBundleContext = FrameworkUtil.getBundle(IAircraftBusiness.class).getBundleContext();
      final IAircraftBusiness aircraftBusiness = aircraftBundleContext.getService(aircraftBundleContext.getServiceReference(IAircraftBusiness.class));

      try {
         aircraftModel = new AircraftDetailsModel(aircraft, aircraftBusiness.getAircraftConfiguration(aircraft.getId()));
      } catch (EntityNotFoundException e) {
         // TODO SHT: Exception handling
         throw new IllegalStateException(e);
      }
   }

   @Override
   protected Control createDialogArea(Composite parent) {
      final BundleContext aircraftBundleContext = FrameworkUtil.getBundle(IAircraftBusiness.class).getBundleContext();
      final IAircraftBusiness aircraftBusiness = aircraftBundleContext.getService(aircraftBundleContext.getServiceReference(IAircraftBusiness.class));
      parent.setBackground(Display.getDefault().getSystemColor(SWT.COLOR_WHITE));
      parent.setBackgroundMode(SWT.INHERIT_FORCE);
      parent.setLayout(new GridLayout(1, true));
      aircraftDetailsComposite = new AircraftDetailsComposite(parent, aircraftModel, aircraftBusiness.getAircraftTypes(), update);

      Composite btnComposite = new Composite(parent, SWT.NONE);
      btnComposite.setLayout(new GridLayout(2, true));

      /* Create Import configurations Button */
      importConfigurations = new Button(btnComposite, SWT.NONE);
      importConfigurations.setText(Messages.CORE.getMnemonicEscapedString("AircraftManagement_aircraft_ImportConfigurationButton"));
      importConfigurations.setEnabled(false);
      importConfigurations.addSelectionListener(new ImportConfigurationSelectionAdapter(aircraftDetailsComposite, lastFilePath));

      /* Create RTB Parameters */
      createRTBparameterButton(btnComposite);

      BundleContext bundleContext = FrameworkUtil.getBundle(IUserBusiness.class).getBundleContext();
      IUserBusiness userBusiness = bundleContext.getService(bundleContext.getServiceReference(IUserBusiness.class));
      bundleContext = FrameworkUtil.getBundle(ICoreBusiness.class).getBundleContext();
      ICoreBusiness coreBusiness = bundleContext.getService(bundleContext.getServiceReference(ICoreBusiness.class));
      if (aircraftModel.getAircraftType() != null
            && coreBusiness.getEnabledFeatureNames(aircraftModel.getAvionicVersion().getId()).contains(FeatureName.ROTOR_TRACK_BALANCE)
            && Boolean.parseBoolean(userBusiness.getUserConfigurationProperty(
                  MgsSession.getInstance().getUser().getId(), UserConfigurationKey.RTB_VISIBLE_FEATURES.getKey()))
            && (aircraftModel.getDmauVersion() == null || (aircraftModel.getDmauVersion() != null && aircraftModel.getDmauVersion().hasHealthData()))) {
         rtbParameters.setVisible(true);
         rtbParameters.setEnabled(true);
      } else {
         rtbParameters.setVisible(false);
      }
      return aircraftDetailsComposite;
   }

   @Override
   protected Control createButtonBar(Composite parent) {
      Composite control = (Composite) super.createButtonBar(parent);
      GridLayout layout = (GridLayout) control.getLayout();
      layout.marginWidth = 5;
      return control;
   }

   @Override
   protected void createButtonsForButtonBar(Composite parent) {
      /* Create OK Button * */
      Button okButton = createButton(parent, -1, Messages.CORE.getMnemonicEscapedString("OK"), true);
      okButton.setEnabled(isUpdate());
      okButton.addSelectionListener(new OkCreateUpdateListener(this));
      createButton(parent, IDialogConstants.CANCEL_ID, Messages.CORE.getMnemonicEscapedString("Cancel"), true);
      aircraftDetailsComposite.initModifyListener(aircraftDetailsComposite, okButton);
      aircraftDetailsComposite.updateDataTransferTypeFields(parent);
      aircraftDetailsComposite.setImportConfigurationButton(importConfigurations);
      aircraftDetailsComposite.listenToAircraftAvionicForConfigButton();
   }

   private void createRTBparameterButton(Composite parent) {
      rtbParameters = new Button(parent, SWT.NONE);
      rtbParameters.setText(Messages.CORE.getMnemonicEscapedString("AircraftManagement_aircraft_RTBParametersButton"));
      rtbParameters.setEnabled(true);
      rtbParameters.setVisible(true);
      rtbParameters.addSelectionListener(new RtbParameterSelectionAdapter(isUpdate(), aircraftDetailsComposite));
      aircraftDetailsComposite.setRtbParametersButton(rtbParameters);
   }

   public AircraftDetailsComposite getAircraftDetailsComposite() {
      return aircraftDetailsComposite;
   }

   public static boolean isUpdate() {
      return update;
   }

   public static void setUpdate(boolean updateStatus) {
      update = updateStatus;
   }

   @Override
   protected void configureShell(Shell pShell) {
      String shellTitle = Messages.CORE.getString("aircraftDetailsDialogCreateTitle");
      int shellHeight = 515;
      if (update) {
         shellTitle = Messages.CORE.getString("aircraftDetailsDialogUpdateTitle");
         shellHeight = 545;
      }

      pShell.pack();
      pShell.setSize(GuiUtils.applyDpiRatio(480), GuiUtils.applyDpiRatio(shellHeight));

      super.configureShell(pShell);
      // Move the dialog to the center of the top level shell.
      Rectangle shellBounds = Display.getCurrent().getActiveShell().getBounds();
      Point dialogSize = pShell.getSize();
      pShell.setLocation(shellBounds.x + (shellBounds.width - dialogSize.x) / 2, shellBounds.y
            + (shellBounds.height - dialogSize.y) / 2);
      pShell.setText(shellTitle);
      pShell.setImage(Images.getImage(ImageId.HOME_SETTINGS));
   }
}

