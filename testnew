
package com.eurocopter.mgs.health.presentation.model;

import java.beans.PropertyChangeListener;
import java.beans.PropertyChangeSupport;

/**
 * Threshold learning model.
 */
public class ThresholdLearningModel {

   /**
    * Reason of the threshold learning.
    */
   private String learningReason = "";

   private final PropertyChangeSupport propertyChangeSupport = new PropertyChangeSupport(this);

   private long historyLearningTime;

   /**
    * Default constructor. Builds a ThresholdLearningModel.
    */
   public ThresholdLearningModel() {
      super();
   }

   /**
    * {@inheritDoc}
    *
    * @see com.eurocopter.mgs.health.presentation.model.IThresholdLearningModel#getLearningReason()
    */
   public String getLearningReason() {
      return learningReason;
   }

   /**
    * Sets the learningReason.
    *
    * @param learningReason
    *           the learningReason to set.
    */
   public void setLearningReason(String learningReason) {
      String old = this.learningReason;
      this.learningReason = learningReason;
      propertyChangeSupport.firePropertyChange("learningReason", old, this.learningReason);
   }

   public void setHistoryLearningTime(long historyLearningTime) {
      this.historyLearningTime = historyLearningTime;
   }

   public long getHistoryLearningTime() {
      return historyLearningTime;
   }

   public void addPropertyChangeListener(PropertyChangeListener listener) {
      propertyChangeSupport.addPropertyChangeListener(listener);
   }
}
