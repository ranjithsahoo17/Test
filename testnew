/**
 * This class represents the aircraft workspace.
 */
public class AircraftTreeComposite extends Composite implements MgsEventListener {

   private static final Logger LOGGER = LogManager.getLogger(AircraftTreeComposite.class);

   /** The shared instance. */
   private static AircraftTreeComposite aircraftTreeComposite;

   /** aircraft tree viewer */
   private final AircraftTreeViewer treeViewer;

   /** The Tree View aircrafts nodes providers. */
   private final AircraftTreeNodeProvider aircraftNodesProvider;

   /** The Constant RIGHT_MOUSE_BUTTON. */
   private static final int RIGHT_MOUSE_BUTTON = 3;

   /** The Constant LEFT_MOUSE_BUTTON. */
   private static final int LEFT_MOUSE_BUTTON = 1;

   /** The Constant NODE_ACTION_KEY. */
   private static final int NODE_ACTION_KEY = SWT.CR;

   /** The event manager. */
   private final MgsEventManager eventManager;

   private ITreeViewNodeElement[] lastSelection;

   /**
    * Constructor.
    *
    * @param parent
    *           Parent composite
    * @param style
    *           Widget style
    */
   public AircraftTreeComposite(Composite parent) {
      super(parent, SWT.NONE);
      setLayout(new FillLayout());
      eventManager = MgsEventManager.getInstance();
      eventManager.registerEventListener(this);
      aircraftTreeComposite = this;
      aircraftNodesProvider = new AircraftTreeNodeProvider();
      treeViewer = new AircraftTreeViewer(aircraftNodesProvider.getAircraftTreeNodes(false), this);
      MgsMouseAdapter mouseAdapter = initializeMouseListener();
      treeViewer.getViewer().addSelectionChangedListener(mouseAdapter);
      treeViewer.getViewer().getTree().addKeyListener(mouseAdapter);
      treeViewer.getViewer().getTree().addMouseListener(mouseAdapter);
      treeViewer.getViewer().getTree().addListener(SWT.Expand, event -> {
         if (event.item instanceof TreeItem item) {
            if (item.getData() instanceof AircraftTreeViewNodeElement acNode) {
               treeViewer.getViewer().getTree().select(item);
               manageAircraftNodeSelection(acNode, true, false);
            }
         }
      });
   }

   /**
    * Initialize the mouse listener.
    *
    * @return the mouse listener
    */
   private MgsMouseAdapter initializeMouseListener() {
      return new MgsMouseAdapter();
   }

   /**
    * Get tree view elements.
    *
    * @param treeAircraft
    *           the tree aircraft
    * @return the tree elements
    */
   public List<IFeatureTreeViewNode> getAircraftSubNodes(Aircraft treeAircraft) {
      BundleContext bundleContext = FrameworkUtil.getBundle(ICoreBusiness.class).getBundleContext();
      ICoreBusiness coreBusiness = bundleContext.getService(bundleContext.getServiceReference(ICoreBusiness.class));
      bundleContext = FrameworkUtil.getBundle(IAircraftBusiness.class).getBundleContext();
      IAircraftBusiness aircraftBusiness = bundleContext.getService(bundleContext.getServiceReference(IAircraftBusiness.class));
      final AvionicVersion avionicVersion = aircraftBusiness.getAvionicVersion(MgsSession.getInstance().getAircraft().getId());
      List<FeatureName> enabledFeatureNames = coreBusiness.getEnabledFeatureNames(avionicVersion.getId());

      List<IFeatureTreeViewNode> aircraftSubNodes = new ArrayList<>();

      final IConfigurationElement[] contributions = Platform.getExtensionRegistry().getConfigurationElementsFor(AircraftTreeView.EXTENSION_ID);

      for (IConfigurationElement contribution : contributions) {
         AircraftTreeView nodeProvider;
         try {
            nodeProvider = (AircraftTreeView) contribution.createExecutableExtension(AircraftTreeView.EXTENSION_NODE_ID);
            if (enabledFeatureNames.contains(nodeProvider.getFeatureName())) {
               Optional<IFeatureTreeViewNode> node = nodeProvider.getNode(treeAircraft);
               if (node.isPresent()) {
                  aircraftSubNodes.add(node.get());
               }
            }
         } catch (CoreException e) {
            LOGGER.warn("Cannot instantiate the extension", e);
         }
      }
      // Sort the aircraft sub-nodes (feature nodes only)
      Collections.sort(aircraftSubNodes);
      return aircraftSubNodes;
   }

   /**
    * Inits the aircraft node.
    *
    * @param aircraftTreeViewNode
    *           the aircraft tree view node
    * @return the aircraft tree view node
    */
   private AircraftTreeViewNodeElement initAircraftNode(AircraftTreeViewNodeElement aircraftTreeViewNode) {
      // Reset aircraft node children
      aircraftTreeViewNode.getChildren().clear();

      final BundleContext aircraftBundleContext = FrameworkUtil.getBundle(IAircraftBusiness.class).getBundleContext();
      final IAircraftBusiness aircraftBusiness = aircraftBundleContext.getService(aircraftBundleContext.getServiceReference(IAircraftBusiness.class));
      try {
         Aircraft aircraft = aircraftBusiness.getAircraft(aircraftTreeViewNode.getAircraft().getId());
         List<IFeatureTreeViewNode> nodeElements = getAircraftSubNodes(aircraft);

         // Add Feature nodes
         for (IFeatureTreeViewNode nodeElement : nodeElements) {
            aircraftTreeViewNode.addChild(nodeElement);
         }

         // Find the AircraftTreeViewer listener registered in aircraftTreeViewNode and add it to all the aircraftTreeViewNode sub-nodes
         for (NodeChangeListener listener : aircraftTreeViewNode.getNodeChangeListeners()) {
            if (listener instanceof AircraftTreeViewer) {
               AircraftTreeViewer.registerNodeChangeListeners(nodeElements, listener);
            }
         }

         aircraftTreeViewNode.setInitialized(true);
         aircraftTreeViewNode.setUpdated(false);
      } catch (EntityNotFoundException e) {
         LOGGER.error("", e);
      }

      return aircraftTreeViewNode;
   }

   /**
    * Mouse listener for the tree Handle mouse clicks.
    */
   private static final class ContextualMenuListener implements Listener {

      /** contextual menu */
      private final Menu menu;

      /** Treeview node */
      private final ITreeViewNodeElement node;

      /**
       * Constructor.
       *
       * @param menu
       *           Menu
       * @param node
       *           Node
       */
      private ContextualMenuListener(Menu menu, ITreeViewNodeElement node) {
         this.menu = menu;
         this.node = node;
      }

      /**
       * Handle event.
       *
       * @param event
       *           Event to be handled
       */
      @Override
      public void handleEvent(Event event) {
         List<Action> contextualActions = node.getContextualActions();

         for (final Action contextualAction : contextualActions) {
            MenuItem menuItem;
            menuItem = new MenuItem(menu, SWT.PUSH);
            menuItem.setText(contextualAction.getText());
            menuItem.setEnabled(contextualAction.isEnabled());
            menuItem.addSelectionListener(new SelectionListener() {
               @Override
               public void widgetSelected(SelectionEvent e) {
                  contextualAction.runWithEvent(new MgsInputEvent(node));
               }

               @Override
               public void widgetDefaultSelected(SelectionEvent e) {
                  // Nothing to do.
               }
            });
         }
      }
   }

   /**
    * Mouse listener for the tree Handle mouse clicks.
    */
   class MgsMouseAdapter extends MouseAdapter implements KeyListener, ISelectionChangedListener {

      /**
       * Mouse down.
       *
       * @param e
       *           the e {@inheritDoc}
       * @see org.eclipse.swt.events.MouseAdapter#mouseDown(org.eclipse.swt.events.MouseEvent)
       */
      @Override
      public void mouseDown(MouseEvent e) {
         ITreeViewNodeElement[] nodeElements = getSelectedNodeElements(getTreeFromEvent(e));
         LOGGER.debug("Mouse button pressed : {}", e.button);

         Point point = new Point(e.x, e.y);
         ViewerCell cell = treeViewer.getViewer().getCell(point);
         for (ITreeViewNodeElement treeItem : nodeElements) {
            if (e.button == LEFT_MOUSE_BUTTON && cell != null) {
               handleCheckState(treeItem);
            } else if (e.button == RIGHT_MOUSE_BUTTON) {
               showContextMenu(point, treeItem);
            }
            refreshTree(treeItem);
         }
         if (cell != null) {
            executeSelectedNodes(e, true);
         }
      }

      /**
       * Key pressed.
       *
       * @param e
       *           the e {@inheritDoc}
       * @see org.eclipse.swt.events.KeyListener#keyPressed(org.eclipse.swt.events.KeyEvent)
       */
      @Override
      public void keyPressed(KeyEvent e) {
         LOGGER.debug("keyPressed {}", e);
         if (e.keyCode == NODE_ACTION_KEY || e.keyCode == ' ') {
            ITreeViewNodeElement[] nodeElements;
            nodeElements = getSelectedNodeElements(getTreeFromEvent(e));

            for (ITreeViewNodeElement nodeElement : nodeElements) {
               handleCheckState(nodeElement);
               refreshTree(nodeElement);
            }
         }
      }

      /**
       * Handle the check state of the node.
       *
       * @param nodeElement
       *           the node element
       */
      private void handleCheckState(ITreeViewNodeElement nodeElement) {
         if (nodeElement instanceof ICheckableTreeViewNodeElement checkableTreeNode) {
            checkableTreeNode.setChecked(!checkableTreeNode.isChecked());
         }
      }

      /**
       * Show context menu.
       *
       * @param p
       *           the p
       * @param nodeElement
       *           the node element
       */
      private void showContextMenu(Point p, ITreeViewNodeElement nodeElement) {
         if (!nodeElement.getContextualActions().isEmpty()) {
            Menu menu = new Menu(Display.getCurrent().getActiveShell(), SWT.POP_UP);
            // ADD a contextualMenu (handle right clicks)
            menu.addListener(SWT.Show, new ContextualMenuListener(menu, nodeElement));
            menu.setLocation(toDisplay(p));
            menu.setVisible(true);
         }
      }

      /**
       * Key released.
       *
       * @param e
       *           the e {@inheritDoc}
       * @see org.eclipse.swt.events.KeyListener#keyReleased(org.eclipse.swt.events.KeyEvent)
       */
      @Override
      public void keyReleased(KeyEvent e) {
         // Nothing to do
      }

      @Override
      public void selectionChanged(SelectionChangedEvent e) {
         executeSelectedNodes(e, false);
      }
   }

   /**
    * Gets the tree from event.
    *
    * @param e
    *           the event
    * @return the tree
    */
   private Tree getTreeFromEvent(EventObject e) {
      Tree tree = null;
      if (e.getSource() instanceof TreeViewer treeViewer) {
         tree = treeViewer.getTree();
      } else if (e.getSource() instanceof Tree treeEvent) {
         tree = treeEvent;
      }
      return tree;
   }

   /**
    * Executes selected nodes.
    *
    * @param e
    *           the event
    */
   public void executeSelectedNodes(EventObject e, boolean bypassDuplicateCheck) {
      if (LOGGER.isDebugEnabled() && e != null) {
         LOGGER.debug("Selection Changed event from treeview {}", e);
      }

      final Tree tree;
      if (e != null) {
         tree = getTreeFromEvent(e);
      } else {
         tree = treeViewer.getViewer().getTree();
      }

      ITreeViewNodeElement[] nodeElements = getSelectedNodeElements(tree);
      if (!bypassDuplicateCheck && lastSelection != null && Arrays.equals(lastSelection, nodeElements)) {
         // We shall ignore this execution, because there is a duplicate between a click event and a selection event
         return;
      }
      lastSelection = nodeElements;

      for (ITreeViewNodeElement treeItem : nodeElements) {
         // Check if the node has been programmatically selected (and not by an user click)
         // in that case the event will not be propagated
         if (treeViewer.getSelectionEventPropagationList().contains(treeItem)) {
            treeViewer.getSelectionEventPropagationList().remove(treeItem);
            LOGGER.debug("Programmatical selection found for current node : event will not be propagated");
            return;
         }

         if (treeItem instanceof AircraftTreeViewNodeElement aircraftTreeViewNode) {
            // the selected node is an aircraft, change the current aircraft in session then refresh display
            manageAircraftNodeSelection(aircraftTreeViewNode, false, true);
         } else {
            // the selected node is a sub-node of an aircraft already expanded.
            // get the aircraft root node
            ITreeViewNodeElement nodeElement = treeItem.getRootNodeElement();
            if (nodeElement instanceof AircraftTreeViewNodeElement aircraftTreeViewNode) {

               // Collapse all aircraft node except the selected one
               collapseAllAircraftNodeExcept(aircraftTreeViewNode);

               // the selected node is an aircraft, change the current aircraft in session if need be
               // then notify listeners (aircraft banner...)
               notifyNewAircraftSelection(aircraftTreeViewNode);
            }

            // In all case
            refreshTree(treeItem);
         }

         // For subnodes
         executeNode(treeItem);
      }
   }

   /**
    * Gets the selected node elements.
    *
    * @param tree
    *           the tree
    * @return the selected node elements
    */
   private ITreeViewNodeElement[] getSelectedNodeElements(Tree tree) {
      TreeItem[] selectedTreeitems;
      List<ITreeViewNodeElement> nodeElements = new ArrayList<>();

      if (tree != null) {
         selectedTreeitems = tree.getSelection();
         for (TreeItem treeItem : selectedTreeitems) {
            if (treeItem.getData() instanceof ITreeViewNodeElement treeViewNodeElement) {
               nodeElements.add(treeViewNodeElement);
            }
         }
      }

      return nodeElements.toArray(new ITreeViewNodeElement[0]);
   }

   /**
    * Execute node.
    *
    * @param nodeElement
    *           the node element
    */
   private void executeNode(ITreeViewNodeElement nodeElement) {
      // Execute node linked action (usually left click action)
      if (nodeElement.getAction() != null) {
         nodeElement.getAction().runWithEvent(new MgsInputEvent(nodeElement));
      }
   }

   /**
    * Refresh tree.
    *
    * @param element
    *           the element
    */
   public void refreshTree(ITreeViewNodeElement element) {
      // Refresh the view
      if (element != null) {
         treeViewer.getViewer().refresh(element);
      } else {
         treeViewer.getViewer().refresh();
      }
      // Auto resize columns in the tree
      AircraftTreeViewer.resizeTreeColumns(treeViewer.getViewer().getTree());
   }

   public static AircraftTreeComposite getDefault() {
      return aircraftTreeComposite;
   }

   /**
    * Initialize aircraft.
    *
    * @param aircraftTreeViewNode
    *           the aircraft tree view node
    */
   private void initializeAircraft(AircraftTreeViewNodeElement aircraftTreeViewNode) {
      // The aircraft nodes are lazy loaded
      // Load data the first time the aircraft is clicked or if it has been updated
      if (!aircraftTreeViewNode.isInitialized() || aircraftTreeViewNode.isUpdated()) {
         initAircraftNode(aircraftTreeViewNode);
      }
   }

   /**
    * Load the aircraft sub-nodes if the aircraft has not been initialized or if it has been updated.
    *
    * @param aircraftTreeViewNode
    *           the aircraft node to load
    * @param keepExpandedState
    *           the keep expanded state
    * @param forceMaintenanceReport
    *           to force the Maintenance report display
    */
   private void manageAircraftNodeSelection(AircraftTreeViewNodeElement aircraftTreeViewNode, boolean keepExpandedState, boolean forceMaintenanceReport) {
      Aircraft nodeAircraft = aircraftTreeViewNode.getAircraft();
      Aircraft currentAircraft = MgsSession.getInstance().getAircraft();
      if (currentAircraft == null) {
         return;
      }
      if (!currentAircraft.equals(nodeAircraft)) {
         MgsSession.getInstance().setAircraft(nodeAircraft);
         MgsSession.getInstance().setFlight(null);
      }

      initializeAircraft(aircraftTreeViewNode);

      // Change the current aircraft in the session and notify listeners (aircraft banner...)
      notifyNewAircraftSelection(currentAircraft, nodeAircraft, keepExpandedState, forceMaintenanceReport);

      // Collapse all aircraft node except the selected one
      collapseAllAircraftNodeExcept(aircraftTreeViewNode);

      // Refresh all
      refreshTree(aircraftTreeViewNode);
   }

   /**
    * Selects and expands (if parameter 'expand' = {@code true}) the current aircraft node.
    *
    * @param expand
    *           the expand {@code true} to expand the current aircraft node.
    * @param propagateEvent
    *           To propagate or not the event
    */
   public void selectCurrentAircraftTreeViewNode(boolean expand, boolean propagateEvent) {
      final AircraftTreeViewNodeElement aircraftNode = aircraftNodesProvider.findAircraftNode(MgsSession.getInstance().getAircraft());

      // Update selected node and sub-nodes if needed
      if (!aircraftNode.isInitialized() || aircraftNode.isUpdated()) {
         initAircraftNode(aircraftNode);
      }

      EventType eventType = expand ? EventType.SELECT_EXPAND : EventType.SELECT;
      NodeChangeEvent event = new NodeChangeEvent(eventType, aircraftNode, propagateEvent);
      aircraftNode.notifyListeners(event);
   }

   @Override
   public void onEvent(MgsEvent event) {
      if (!(event instanceof AircraftEvent aircraftEvent)) {
         if (event.getEventType() == MgsEventType.AIRCRAFT_SELECTED_FROM_FLEET_VIEW) {
            // Reinitialize selection (to avoid MRP being hidden after redirection)
            lastSelection = null;
            // Retrieve all aircraft nodes
            treeViewer.setAircraftNodeAsTreeViewerInput(aircraftNodesProvider.getAircraftTreeNodes(true));
            // Select it
            selectAircraftInTreeViewer();
            // Call others view who listen only to AIRCRAFT_SELECTED_FROM_TREE_VIEW
            eventManager.publishEvent(this, new AircraftTreeSelectionEvent());
         }
      } else {
         Aircraft aircraft = aircraftEvent.getAircraft();
         switch (event.getEventType()) {
            case AIRCRAFT_ADDED -> {
               aircraftNodesProvider.addAircraftNode(aircraft);
               treeViewer.setAircraftNodeAsTreeViewerInput(aircraftNodesProvider.getAircraftTreeNodes(false));
               treeViewer.getViewer().refresh();
            }
            case AIRCRAFT_REMOVED -> {
               aircraftNodesProvider.removeAircraftNode(aircraft);
               treeViewer.setAircraftNodeAsTreeViewerInput(aircraftNodesProvider.getAircraftTreeNodes(false));
               treeViewer.getViewer().refresh();
               // Change to fleet view if the removed aircraft is the current selected one
               if (aircraft.equals(MgsSession.getInstance().getAircraft())) {
                  MgsViewManager.MANAGER.showPerspective(PerspectiveConstants.FLEET_PERSPECTIVE_ID);
               }
            }
            case CURRENT_AIRCRAFT_UPDATED -> {
               Aircraft currentAircraft = MgsSession.getInstance().getAircraft();
               if (currentAircraft != null) {
                  AircraftTreeViewNodeElement currentAircraftNode = aircraftNodesProvider.findAircraftNode(currentAircraft);
                  currentAircraftNode.update(currentAircraft);
                  // Update current node and sub-nodes
                  initAircraftNode(currentAircraftNode);
                  NodeChangeEvent nodeEvent = new NodeChangeEvent(EventType.UPDATE, currentAircraftNode);
                  aircraftNodesProvider.updateAircraftNode(nodeEvent, currentAircraftNode);
               }
            }
            case AIRCRAFT_UPDATED -> {
               AircraftTreeViewNodeElement aircraftNode = aircraftNodesProvider.findAircraftNode(aircraft);
               if (aircraftNode != null) {
                  // Aircraft may have been deleted while event is processed
                  aircraftNode.update(aircraft);
                  aircraftNode.setUpdated(true);
                  NodeChangeEvent acNodeEvent = new NodeChangeEvent(EventType.UPDATE, aircraftNode);
                  aircraftNodesProvider.updateAircraftNode(acNodeEvent, aircraftNode);
               }
            }
            default -> {
            }
         }
      }
   }

   /**
    * Select aircraft in {@link AircraftTreeViewer} chosen in the {@link FleetView}.
    */
   private void selectAircraftInTreeViewer() {
      treeViewer.setSelectedAircraft(MgsSession.getInstance().getAircraft());
   }

   /**
    * Collapse all aircraft node except the given selected one.
    *
    * @param aircraftTreeViewNode
    *           the aircraft tree view node
    */
   public void collapseAllAircraftNodeExcept(AircraftTreeViewNodeElement aircraftTreeViewNode) {
      // Collapse all aircraft node except the given node
      for (AircraftTreeViewNodeElement element : aircraftNodesProvider.getAircraftTreeNodes(false)) {
         if (!element.equals(aircraftTreeViewNode)) {
            treeViewer.getViewer().collapseToLevel(element, AbstractTreeViewer.ALL_LEVELS);
         }
      }
   }

   /**
    * Notifies new Aircraft selection.
    *
    * @param currentAircraft
    *           the current A/C
    * @param nodeAircraft
    *           the current node
    * @param keepExpandedState
    *           the keep expanded state
    * @param forceMaintenanceReport
    *           to force the Maintenance report display
    */
   private void notifyNewAircraftSelection(Aircraft currentAircraft, Aircraft nodeAircraft,
         boolean keepExpandedState, boolean forceMaintenanceReport) {
      if (!currentAircraft.equals(nodeAircraft)) {
         eventManager.publishEvent(this, new AircraftTreeSelectionEvent());
         MgsViewManager.MANAGER.switchView(MgsViewId.MAINTENANCE_REPORT.getId(), null, true, null, keepExpandedState);
      } else if (forceMaintenanceReport) {
         // force the MR display
         MgsViewManager.MANAGER.switchView(MgsViewId.MAINTENANCE_REPORT.getId(), null, true, null, true);
      }
   }

   /**
    * Notifies new Aircraft selection.
    *
    * @param aircraftTreeViewNode
    *           the selected aircraft node.
    */
   private void notifyNewAircraftSelection(AircraftTreeViewNodeElement aircraftTreeViewNode) {
      Aircraft nodeAircraft = aircraftTreeViewNode.getAircraft();
      Aircraft currentAircraft = MgsSession.getInstance().getAircraft();
      if (!currentAircraft.equals(nodeAircraft)) {
         MgsSession.getInstance().setAircraft(nodeAircraft);
         MgsSession.getInstance().setFlight(null);
         eventManager.publishEvent(this, new AircraftTreeSelectionEvent());
      }
   }

   /**
    * Return the {@link AircraftTreeViewer} of this {@link AircraftTreeComposite}.
    *
    * @return {@link AircraftTreeViewer}
    */
   public AircraftTreeViewer getAircraftTreeViewer() {
      return treeViewer;
   }

   /**
    * Return the {@link AircraftTreeViewNodeElement} associated with the current A/C.
    *
    * @return {@link AircraftTreeViewNodeElement}
    */
   public AircraftTreeViewNodeElement getCurrentAircraftTreeViewNode() {
      return aircraftNodesProvider.findAircraftNode(MgsSession.getInstance().getAircraft());
   }
}

