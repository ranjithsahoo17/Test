   /**
    * Reads default properties.
    * 
    * @param file
    *           the file
    * @return the properties
    */
   private Properties readDefaultProperties(File file) {
      // Parse XML with DOM
      Document document;
      try {
         DocumentBuilderFactory factoryBuilder = XmlUtils.getSafeBuilderFactory();
         document = factoryBuilder.newDocumentBuilder().parse(file);
      } catch (IOException | SAXException | ParserConfigurationException e) {
         throw new IllegalStateException(MessageFormat.format(CANNOT_READ_THE_DEFAULT_PROPERTIES, e.getMessage()), e);
      }

      Properties properties = new Properties();

      // ----------------------------------------------------------------
      // The map of key to retrieve and convert to properties
      // The boolean value associated mean if the key is required in XML
      // Here are the simple properties (boolean, int and string)
      // ----------------------------------------------------------------
      Map<String, Boolean> simpleValuesList = new HashMap<>();
      simpleValuesList.put(MgsConfigurationKey.PURGE_AUTO.getKey(), true);
      simpleValuesList.put(MgsConfigurationKey.PURGE_MANUAL.getKey(), true);
      simpleValuesList.put(MgsConfigurationKey.FAILURE_CODE_REGROUPING_MODE.getKey(), true);
      simpleValuesList.put(MgsConfigurationKey.DATA_COLLECTION_FOLDER.getKey(), false);
      simpleValuesList.put(MgsConfigurationKey.HFDM_FOLDER.getKey(), false);
      simpleValuesList.put(MgsConfigurationKey.ENGINE_DATA_COLLECTION_FOLDER.getKey(), false);
      simpleValuesList.put(MgsConfigurationKey.ENGINE_DATA_COLLECTION_ACTIVATION.getKey(), true);

      simpleValuesList.put(MgsConfigurationKey.FDCR_PURGE_AUTO.getKey(), true);
      simpleValuesList.put(MgsConfigurationKey.FDCR_PURGE_DATE.getKey(), false);
      simpleValuesList.put(MgsConfigurationKey.FDCR_PURGE_SIZE.getKey(), false);
      simpleValuesList.put(MgsConfigurationKey.FDCR_NB_FLIGHT_HOURS.getKey(), false);
      simpleValuesList.put(MgsConfigurationKey.FDCR_MAX_SELECTED_PARAMETERS.getKey(), true);
      simpleValuesList.put(MgsConfigurationKey.FDCR_HFDM_ENABLED.getKey(), true);

      simpleValuesList.put(MgsConfigurationKey.MGSCONFIGURATION_AUTOMATIC_AUTHENTICATION.getKey(), true);
      simpleValuesList.put(MgsConfigurationKey.MGSCONFIGURATION_CLOSEMONITORING_DEFAULT_DURATION.getKey(), true);
      simpleValuesList.put(MgsConfigurationKey.FLIGHT_REPORT_GENERATION_AUTOMATIC.getKey(), false);
      simpleValuesList.put(MgsConfigurationKey.MAINTENANCE_REPORT_GENERATION_AUTOMATIC.getKey(), false);
      simpleValuesList.put(MgsConfigurationKey.FLIGHT_REPORT_GENERATION_OUTPUT_TYPE.getKey(), true);
      simpleValuesList.put(MgsConfigurationKey.MAINTENANCE_REPORT_GENERATION_OUTPUT_TYPE.getKey(), true);
      simpleValuesList.put(MgsConfigurationKey.CF_AUTOMATIC_DELETION.getKey(), true);
      simpleValuesList.put(MgsConfigurationKey.PCMCIA_AUTOMATIC_DELETION.getKey(), true);
      simpleValuesList.put(MgsConfigurationKey.SD_AUTOMATIC_DELETION.getKey(), true);

      // --------------------------------------
      // For each simple property listed above
      for (Map.Entry<String, Boolean> simpleValue : simpleValuesList.entrySet()) {

         // Retrieve current simple property
         String currentKey = simpleValue.getKey();

         // Retrieve XML tag with this property name (expected : 1)
         NodeList nodeList = document.getElementsByTagName(currentKey);

         // If the tag is found in XML document
         if (nodeList.getLength() > 0) {
            // Get the unique tag/property
            Node uniqueNode = nodeList.item(0);

            // Add property with tag name as key and with its value
            properties.put(currentKey, uniqueNode.getAttributes().getNamedItem("value").getTextContent());
         } else if (simpleValue.getValue()) {
            // Else, if the tag is not found in XML document
            // And it was required
            // Throw an error, missing property is required
            throw new NoSuchElementException("Cannot read the default property '" + currentKey + "'");
         }
      }

      // Return created properties
      return properties;
   }

   /**
    * Reads matrix.
    * 
    * @param file
    *           the file
    * @return the double[][]
    */
   private double[][] readMatrix(File file) {
      try (InputStream is = new FileInputStream(file)) {
         List<String> lines = IOUtils.readLines(is, StandardCharsets.UTF_8);
         int row = Integer.parseInt(lines.get(2));
         int col = Integer.parseInt(lines.get(1));
         double[][] matrix = new double[row][col];
         for (int i = 0; i < row; i++) {
            for (int j = 0; j < col; j++) {
               matrix[i][j] = Double.parseDouble(lines.get(i * col + j + 3));
            }
         }
         return matrix;
      } catch (IOException e) {
         // CANNOT READ FILE --> return null
         LOGGER.error("Problem while reading neural network matrix.", e);
      }
      return null;
   }

   private String[] getNeuralNetworkFiles(String avionicVersion) {
      // Default names
      String mainConfigurationFileName = "no-file";
      String tailConfigurationFileName = "no-file";
      File rootDir = new File(mgsConfigurationFolder, "rotortrackbalance/" + avionicVersion);
      if (rootDir.exists() && rootDir.listFiles() != null) {
         for (File file : rootDir.listFiles()) {
            String name = file.getName();
            if (name.endsWith("-main-rotor.net")) {
               mainConfigurationFileName = "rotortrackbalance/" + avionicVersion + "/" + name;
            } else if (name.endsWith("-tail-rotor.net")) {
               tailConfigurationFileName = "rotortrackbalance/" + avionicVersion + "/" + name;
            }
         }
      }
      return new String[] { mainConfigurationFileName, tailConfigurationFileName };
   }

   /**
    * Unmarshals an XML input stream without namespace information
    * 
    * @param is
    *           the is
    * @param objectClasses
    *           the object classes
    * @return the object
    * @throws JAXBException
    *            the JAXB exception
    * @throws UnsupportedEncodingException
    *            the unsupported encoding exception
    */
   private <T> T unmarshalWithoutNamespace(InputStream is, Class<? extends T> objectClass) throws JAXBException {
      JAXBContext context = JAXBContext.newInstance(objectClass);
      Unmarshaller unmarshaller = context.createUnmarshaller();
      XMLReader reader;
      try {
         SAXParserFactory parserFactory = SAXParserFactory.newInstance();
         SAXParser parser = parserFactory.newSAXParser();
         reader = parser.getXMLReader();
      } catch (SAXException | ParserConfigurationException e) {
         throw new JAXBException(e);
      }
      XMLFilter namespaceFilter = new NamespaceFilter();
      namespaceFilter.setParent(reader);
      SAXSource source = new SAXSource(namespaceFilter, new InputSource(is));
      return objectClass.cast(unmarshaller.unmarshal(source));
   }

   /**
    * Filter to remove all namespace information while unmarshalling XML files
    */
   private static class NamespaceFilter extends XMLFilterImpl {
      public NamespaceFilter() {
         // Nothing to do
      }

      @Override
      public void startElement(String uri, String localName, String qName, Attributes atts) throws SAXException {
         super.startElement("", localName, qName, atts);
      }

      @Override
      public void endElement(String uri, String localName, String qName) throws SAXException {
         super.endElement("", localName, qName);
      }

      @Override
      public void startPrefixMapping(String prefix, String uri) {
         // Stop propagation, nothing to do
      }
   }

   private boolean grantPermissionsToNetworkService(String folderPath) {
      try {
         // check for permissions
         String[] checkCommand = { "icacls", folderPath };
         Process checkProcess = new ProcessBuilder(checkCommand).start();
         BufferedReader reader = new BufferedReader(new InputStreamReader(checkProcess.getInputStream()));
         String line;
         while ((line = reader.readLine()) != null) {
            if (line.toUpperCase().contains("NT AUTHORITY\\NETWORKSERVICE:(OI)(CI)F")) {
               return true;
            }
         }

         // grant permissions
         String[] grantCommand = { "icacls", folderPath, "/grant", "NT AUTHORITY\\NetworkService:(OI)(CI)F" };
         Process grantProcess = new ProcessBuilder(grantCommand).start();
         grantProcess.waitFor();
         if (grantProcess.exitValue() == 0) {
            return true;
         } else {
            LOGGER.warn("Grant process exit value = " + grantProcess.exitValue());
            return false;
         }
      } catch (IOException | InterruptedException e) {
         LOGGER.error("Error when granting permissions.", e);
         return false;
      }
   }

