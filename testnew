   private enum FDCR_TASK {

      RAW_DATA_COLLECTION(1),

      AIRCRAFTS_ANALYSIS(2),

      DATA_COLLECTION(3),

      DELETE_FILES(4);

      private final int id;

      FDCR_TASK(int id) {
         this.id = id;
      }

   }

