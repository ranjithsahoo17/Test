   private Map<String, Set<String>> deleteBeforeImport(File aircraftFolder, UuidMapping mapping, String tableName, String key, Set<String> idsToDelete, String idToReturn, String idToReturn2)
         throws AircraftManagementException {
      File csvFile = new File(aircraftFolder, tableName + ".csv");
      CsvParser parser = getCsvParser();
      List<String[]> allLines = parser.parseAll(csvFile);
      List<String[]> actualLines = new ArrayList<>();
      String[] firstLine = allLines.get(0);
      actualLines.add(firstLine);
      Map<String, Set<String>> returnMap = new HashMap<>();
      returnMap.put(idToReturn, new HashSet<>());
      returnMap.put(idToReturn2, new HashSet<>());
      if (allLines.isEmpty()) {
         return returnMap;
      }
      Map<String, Integer> indexesToReturn = new HashMap<>();
      for (int i = 0; i < firstLine.length; ++i) {
         if (firstLine[i].equals(idToReturn)) {
            indexesToReturn.put(idToReturn, i);
         }
         if (firstLine[i].equals(idToReturn2)) {
            indexesToReturn.put(idToReturn2, i);
         }
      }
      int keyIndex = Arrays.asList(firstLine).indexOf(key);
      for (int i = 1; i < allLines.size(); ++i) {
         String[] line = allLines.get(i);
         String keyValue = line[keyIndex];
         if (idsToDelete.contains(keyValue)) {
            // Store identifiers that have been deleted
            for (Map.Entry<String, Integer> returnFieldEntry : indexesToReturn.entrySet()) {
               returnMap.get(returnFieldEntry.getKey()).add(line[returnFieldEntry.getValue()]);
            }
            // Ignore the line
            continue;
         }
         actualLines.add(line);
      }

      CsvWriterSettings writerSettings = buildWriterSettings();
      CsvWriter writer = new CsvWriter(csvFile, writerSettings);
      writer.writeStringRowsAndClose(actualLines);
      replaceMapping(aircraftFolder, mapping, "aircraft", tableName);
      return returnMap;
   }

