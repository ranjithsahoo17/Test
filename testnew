      for (HealthMechanicalComponentConfiguration mcc : configuration.getMechanicalComponentConfigurations().values()) {
         for (IndicatorConfiguration ic : mcc.getIndicatorConfigurations().values()) {
            ids.add(ic.getIndicator().getId());
         }
      }
      return ids;
   }

   @Override
   public List<FilteringLawDto> getFilteringLaws(String aircraftId) throws EntityNotFoundException {
      List<FilteringLawDto> result = new ArrayList<>();
      for (FilteringLaw law : healthCommonService.findFilteringLaws(aircraftId)) {
         FilteringLawDto dto = new FilteringLawDto();
         dto.setId(law.getId());
         dto.setName(law.getName());
         dto.setOriginal(law.isOriginal());
         dto.setInUse(healthCommonService.isFilteringLawUsedByConfiguration(aircraftId, law.getName()) || healthCommonService.isFilteringLawUsedByDeviation(law.getId()));
         for (ContextualParameter p : law.getContextualParameters()) {
            ContextualParameterDto pDto = new ContextualParameterDto();
            pDto.setId(p.getId());
            pDto.setName(p.getName());
            pDto.setMinValue(p.getMinValue());
            pDto.setMaxValue(p.getMaxValue());
            pDto.setThresholdOfVariabilityValue(p.getThresholdOfVariabilityValue());
            dto.getParameters().add(pDto);
         }
         result.add(dto);
      }
      result.sort((a, b) -> a.getName().compareTo(b.getName()));
      return result;
   }

