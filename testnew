   private ConfigurationValidity checkMgsErrorsDefinition(MgsComputingConfigurationBean mgsComputingConf) {
      for (MgsErrorBean mgsError : mgsComputingConf.getMgsErrors()) {
         if (mgsError.isGenerateAlarm() && mgsError.getSystemStatusErrorCode() == null) {
            return new ConfigurationValidity(false, "MGS Computing file - Undefined system status error code for MGS error code " + mgsError.getCode());
         }
      }
      return new ConfigurationValidity(true);
   }

   /**
    * Check matrix configuration files.
    * 
    * @param avionicVersion
    *           the avionic version
    * @return true, if successful
    */
   private ConfigurationValidity checkMatrixConfigurationFiles(String avionicVersion) {
      String[] configurationFileNames = getNeuralNetworkFiles(avionicVersion);
      File mainConfigurationFile = new File(mgsConfigurationFolder, configurationFileNames[0]);
      File tailConfigurationFile = new File(mgsConfigurationFolder, configurationFileNames[1]);
      ConfigurationValidity configurationValidity = checkMatrixConfigurationFile(mainConfigurationFile);
      if (configurationValidity.isValid()) {
         configurationValidity = checkMatrixConfigurationFile(tailConfigurationFile);
      }
      return configurationValidity;
   }

   /**
    * Check matrix configuration file.
    * 
    * @param matrixConfigurationFile
    *           the matrix configuration file
    * @return true, if successful
    */
   private ConfigurationValidity checkMatrixConfigurationFile(File matrixConfigurationFile) {
      ConfigurationValidity configurationValidity = new ConfigurationValidity(true);
      BufferedReader reader = null;
      try {
         reader = new BufferedReader(new FileReader(matrixConfigurationFile));
         // 1st line is not checked
         reader.readLine();
         // read 2nd line (columns number)
         int columnNumber = Integer.parseInt(reader.readLine());
         // read 3rd line (lines number)
         int lineNumber = Integer.parseInt(reader.readLine());

         // check values
         int valuesNumber = columnNumber * lineNumber;
         Pattern pattern = Pattern.compile("-?0\\.[0-9]{15}");
         for (int i = 0; i < valuesNumber; i++) {
            String value = reader.readLine();
            Matcher matcher = pattern.matcher(value);
            if (!matcher.matches()) {
               configurationValidity = new ConfigurationValidity(false, "Invalid matrix configuration file");
               break;
            }
         }
      } catch (IOException e) {
         LOGGER.warn("Error while validating matrix file.", e);
         configurationValidity = new ConfigurationValidity(false, e.getMessage());
      } finally {
         IOUtils.closeQuietly(reader);
      }

      return configurationValidity;
   }

   /**
    * Validate against XSD.
    * 
    * @param xml
    *           the xml file
    * @param xsd
    *           the xsd file
    * @param configurationFileName
    *           the configuration xml file name
    * @return true, if successful
    */
   private ConfigurationValidity validateAgainstXSD(InputStream xml, InputStream xsd, String configurationFileName) {
      try {
         SchemaFactory schemaFactory = XmlUtils.createFactory();
         Schema schema = schemaFactory.newSchema(new StreamSource(xsd));
         Validator validator = schema.newValidator();
         validator.validate(new StreamSource(xml));
         return new ConfigurationValidity(true);
      } catch (Exception ex) {
         LOGGER.warn("Error while validating xml file.", ex);
         return new ConfigurationValidity(false, "The xml file '" + configurationFileName + "' is not valid : " + ex.getMessage());
      }
   }

