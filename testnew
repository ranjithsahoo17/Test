package com.eurocopter.mgs.datamodel.aircraft;

import java.io.Serializable;
import java.util.ArrayList;
import java.util.Date;
import java.util.HashSet;
import java.util.List;
import java.util.Set;

import com.eurocopter.mgs.datamodel.aircraft.monitoring.AircraftStatus;
import com.eurocopter.mgs.datamodel.core.GroundStation;
import com.eurocopter.mgs.datamodel.fdcr.FdcrPartition;
import com.eurocopter.mgs.datamodel.flight.Download;
import com.eurocopter.mgs.datamodel.flight.Flight;
import com.eurocopter.mgs.datamodel.flight.PurgedFlight;
import com.eurocopter.mgs.datamodel.folder.Folder;
import com.eurocopter.mgs.datamodel.health.common.Accelerometer;
import com.eurocopter.mgs.datamodel.health.monitoring.AircraftDisplayData;
import com.eurocopter.mgs.datamodel.health.monitoring.HealthMechanicalComponent;
import com.eurocopter.mgs.datamodel.rtb.MainRotorTuning;
import com.eurocopter.mgs.datamodel.rtb.RtbConfiguration;
