import com.eurocopter.mgs.xml.aircraftconfiguration.health.common.AccelerometerXMLBean;
import com.eurocopter.mgs.xml.aircraftconfiguration.health.common.FilteringLawXMLBean;
import com.eurocopter.mgs.xml.aircraftconfiguration.health.common.HealthConfigurationXMLBean;
import com.eurocopter.mgs.xml.aircraftconfiguration.health.common.HealthMechanicalComponentXMLBean;
import com.eurocopter.mgs.xml.aircraftconfiguration.health.common.IndicatorXMLBean;
import com.eurocopter.mgs.xml.aircraftconfiguration.health.common.ThresholdXMLBean;
import com.eurocopter.mgs.xml.configuration.unit.Unit;

class HealthIndicatorDelegate {

   private static final HealthThresholdDelegate THRESHOLD_DELEGATE = new HealthThresholdDelegate();

   void validateIndicator(Avionic avionic, IndicatorXMLBean indicatorXMLBean, HealthMechanicalComponentXMLBean mechanicalComponent, HealthConfigurationXMLBean healthConfigurationBean)
         throws DelegateException {
      // Check the number of parameters
      HealthAlgorithm algorithm = indicatorXMLBean.getAlgorithm();
      List<Double> parameters = indicatorXMLBean.getParameters();
      String filteringLawAttribute = indicatorXMLBean.getFilteringLaw();
      final int minParamCount;
      switch (avionic) {
         case CIGALHE -> {
            if (indicatorXMLBean.getAlgorithm() != HealthAlgorithm.Read && indicatorXMLBean.getAlgorithm() != HealthAlgorithm.ACQUISITION_RATE && indicatorXMLBean.getAccelerometer() == null) {
               throw new DelegateException("HealthMonitoring: Missing accelerometer for indicator '" + indicatorXMLBean.getName() + "' in " + mechanicalComponent.getName());
            }
            minParamCount = algorithm.getCigalheMinParameters();
         }
         case MARMS -> minParamCount = algorithm.getMarmsMinParameters();
         default -> throw new IllegalStateException("Unsupported avionic: " + avionic);
      }

      if (parameters.size() < minParamCount) {
         throw new DelegateException("HealthMonitoring: Invalid number of parameters for the indicator '" + indicatorXMLBean.getName()
               + "' of '" + mechanicalComponent.getName()
               + "' mechanical component : algorithm '" + algorithm + "' must have at least "
               + minParamCount + " parameters.");
      }

      // Check the alpha parameter value of the Acquisition rate algorithm
      if (HealthAlgorithm.ACQUISITION_RATE == indicatorXMLBean.getAlgorithm()) {
         Double alpha = parameters.get(0);
         if (alpha < 0 || alpha > 1) {
            throw new DelegateException("HealthMonitoring: Invalid parameter for the indicator '" + indicatorXMLBean.getName()
                  + "' of '" + mechanicalComponent.getName()
                  + "' mechanical component : the parameter value of the algorithm '" + algorithm + "' must be between 0 and 1 included");
         }
      }

      // Check thresholds
      THRESHOLD_DELEGATE.checkThresholdValues(indicatorXMLBean, mechanicalComponent.getFunctionalId());

      // Check the filtering law
      if (filteringLawAttribute != null) {
         Set<FilteringLawXMLBean> filteringLaws = healthConfigurationBean.getFilteringLaws();
         List<String> nameLaws = new ArrayList<>();
         StringBuilder listOfFilteringLawName = new StringBuilder();
         for (FilteringLawXMLBean filteringLaw : filteringLaws) {
            nameLaws.add(filteringLaw.getName());
            if (listOfFilteringLawName.isEmpty()) {
               listOfFilteringLawName = new StringBuilder(filteringLaw.getName());
            } else {
               listOfFilteringLawName.append(" | ").append(filteringLaw.getName());
            }
         }

         if (!nameLaws.contains(filteringLawAttribute)) {
            throw new DelegateException("HealthMonitoring: Invalid name of Law '" + filteringLawAttribute + "' for the indicator '" + indicatorXMLBean.getName()
                  + "' of '" + mechanicalComponent.getName()
                  + "' mechanical component. If you want to use a filtering law on this indicator, the name should be one of the following : "
                  + listOfFilteringLawName + " .");
         }
      }
   }

   void createIndicator(Avionic avionic, HealthMechanicalComponent healthComponent, HealthMechanicalComponentXMLBean mechanicalComponentXMLBean, IndicatorXMLBean indicatorBean,
         Map<String, Map<String, Unit>> unitsByPhysicalQuantity) throws DelegateException {
      // Create indicator
      Indicator indicator = new Indicator(UUID.randomUUID().toString());
      indicator.setFunctionalId(indicatorBean.getFunctionalId());
      indicator.setName(indicatorBean.getName());
      indicator.setActive(true);

      healthComponent.getIndicators().put(indicator.getFunctionalId(), indicator);

      // Create a default display for this indicator
      IndicatorDisplay display = new IndicatorDisplay();
      display.setColor(indicatorBean.getColor());
      display.setStyle(indicatorBean.getStyle() != null ? Style.valueOf(indicatorBean.getStyle().name()) : null);
      display.setTrendColor(indicatorBean.getTrendColor());
      display.setTrendStyle(indicatorBean.getTrendStyle() != null ? Style.valueOf(indicatorBean.getTrendStyle().name()) : null);
      display.setSuccessRateColor(indicatorBean.getSuccessRateColor());
      display.setSuccessRateStyle(indicatorBean.getSuccessRateStyle() != null ? Style.valueOf(indicatorBean.getSuccessRateStyle().name()) : null);
      if (avionic == Avionic.MARMS && indicatorBean.getAlgorithm() == HealthAlgorithm.Read) {
         indicator.setUnitSymbolOverride(StringUtils.trimToEmpty(indicatorBean.getUnit()));
         display.setUnitName("no_unit");
      } else {
         display.setUnitName(getUnitName(indicatorBean, mechanicalComponentXMLBean, unitsByPhysicalQuantity));
      }
      indicator.setDisplay(display);

      // Create thresholds
      for (ThresholdXMLBean thresholdBean : indicatorBean.getThresholds()) {
         THRESHOLD_DELEGATE.createThreshold(indicator, thresholdBean);
      }
   }

   void updateIndicator(Avionic avionic, Indicator indicator, HealthMechanicalComponentXMLBean mechanicalComponentXMLBean, IndicatorXMLBean indicatorBean,
         Map<String, Map<String, Unit>> units)
         throws DelegateException {
      indicator.setName(indicatorBean.getName());
      indicator.setActive(true);

      IndicatorDisplay display = indicator.getDisplay();
      display.setColor(indicatorBean.getColor());
      display.setStyle(indicatorBean.getStyle() != null ? Style.valueOf(indicatorBean.getStyle().name()) : null);
      display.setTrendColor(indicatorBean.getTrendColor());
      display.setTrendStyle(indicatorBean.getTrendStyle() != null ? Style.valueOf(indicatorBean.getTrendStyle().name()) : null);
      display.setSuccessRateColor(indicatorBean.getSuccessRateColor());
      display.setSuccessRateStyle(indicatorBean.getSuccessRateStyle() != null ? Style.valueOf(indicatorBean.getSuccessRateStyle().name()) : null);
      if (avionic == Avionic.MARMS && indicatorBean.getAlgorithm() == HealthAlgorithm.Read) {
         indicator.setUnitSymbolOverride(StringUtils.trimToEmpty(indicatorBean.getUnit()));
         display.setUnitName("no_unit");
      } else {
         display.setUnitName(getUnitName(indicatorBean, mechanicalComponentXMLBean, units));
      }

      // Index thresholds by their functional id
      Map<String, Threshold> thresholds = new HashMap<>();
      for (Threshold threshold : indicator.getThresholds()) {
         thresholds.put(threshold.getFunctionalId(), threshold);
      }

      // Create or update thresholds
      Set<String> activeThresholds = new HashSet<>();
      for (ThresholdXMLBean thresholdXMLBean : indicatorBean.getThresholds()) {
         Threshold threshold = thresholds.get(thresholdXMLBean.getName());
         if (threshold == null) {
            THRESHOLD_DELEGATE.createThreshold(indicator, thresholdXMLBean);
         } else {
            THRESHOLD_DELEGATE.updateThreshold(threshold, thresholdXMLBean);
         }
         activeThresholds.add(thresholdXMLBean.getName());
      }

      // Disable thresholds absent from the new configuration
      for (Threshold threshold : indicator.getThresholds()) {
         threshold.setActive(activeThresholds.contains(threshold.getFunctionalId()));
      }
   }

   void createIndicatorConfiguration(Avionic avionic, HealthMechanicalComponentConfiguration healthComponentConfiguration, IndicatorXMLBean indicatorBean, Map<String, Indicator> indicators,
         Map<String, Accelerometer> accelerometers, HealthConfigurationXMLBean healthConfigurationBean, Map<Threshold, Set<RelearnThresholdRequest>> relearnRequests)
         throws DelegateException {
      Indicator indicator = indicators.get(indicatorBean.getFunctionalId());

      // Create indicator configuration
      IndicatorConfiguration indicatorConfiguration = new IndicatorConfiguration(UUID.randomUUID().toString());
      indicatorConfiguration.setIndicator(indicator);
      if (indicatorBean.getAlgorithm() == HealthAlgorithm.Read && indicatorBean.getReference() == null) {
         throw new DelegateException("The indicator '" + indicatorBean.getFunctionalId() + "' shall have a reference because the algorithm is Read.");
      }
      String pattern = "([HRE]-[0-9]+-[0-9]+-)?[0-9]+-[0-9]+";
      if (indicatorBean.getAlgorithm() == HealthAlgorithm.Read && !indicatorBean.getReference().matches(pattern)) {
         throw new DelegateException("Issue with health configuration concerning reference for indicator "
               + indicatorBean.getFunctionalId() + " (" + indicatorBean.getAlgorithm() + "): Value '" + indicatorBean.getReference() + "' is not valid with respect to pattern '" + pattern + "'.");
      }
      indicatorConfiguration.setReference(indicatorBean.getReference());
      if (indicatorBean.getAlgorithm() == HealthAlgorithm.ACQUISITION_RATE == (indicatorBean.getReferenceIndicator() == null)) {
         throw new DelegateException("The indicator '" + indicatorBean.getFunctionalId() + "' shall have a reference indicator if and only if the algorithm is ACQUISITION_RATE.");
      }
      indicatorConfiguration.setSlidingMedian(indicatorBean.getSlidingMedian());
      indicatorConfiguration.setReferenceIndicator(indicatorBean.getReferenceIndicator());
      indicatorConfiguration.setHealthAlgorithm(indicatorBean.getAlgorithm());
      indicatorConfiguration.setParameters(indicatorBean.getParameters());
      indicatorConfiguration.setFilteringLaw(indicatorBean.getFilteringLaw());
      indicatorConfiguration.setMaxPointsPerHour(indicatorBean.getMaxPointsPerHour());
      if (indicatorBean.getMinSensor() != null && indicatorBean.getMaxSensor() != null && indicatorBean.getMaxSensor() <= indicatorBean.getMinSensor()) {
         throw new DelegateException("The indicator '" + indicatorBean.getFunctionalId() + "' defines invalid 'min' and 'max' attribute.");
      }
      if (indicatorBean.getMinSensor() != null && healthConfigurationBean.getSensorAnomaly() == null) {
         throw new DelegateException("The indicator '" + indicatorBean.getFunctionalId() + "' defines a 'min' attribute but sensor anomaly configuration is missing.");
      }
      indicatorConfiguration.setMinSensor(indicatorBean.getMinSensor());
      if (indicatorBean.getMaxSensor() != null && healthConfigurationBean.getSensorAnomaly() == null) {
         throw new DelegateException("The indicator '" + indicatorBean.getFunctionalId() + "' defines a 'max' attribute but sensor anomaly configuration is missing.");
      }
      indicatorConfiguration.setMaxSensor(indicatorBean.getMaxSensor());
      if (healthConfigurationBean.getSensorAnomaly() != null) {
         indicatorConfiguration.setSensorAnomalyWorkcard(healthConfigurationBean.getSensorAnomaly().getWorkcard());
         indicatorConfiguration.setSensorAnomalySuccessivePoints(healthConfigurationBean.getSensorAnomaly().getNbSuccessivePoints());
      } else {
         indicatorConfiguration.setSensorAnomalyWorkcard(null);
         indicatorConfiguration.setSensorAnomalySuccessivePoints(null);
      }
      if (healthConfigurationBean.getIndicatorInvalidities() != null && indicatorBean.getInvalidityThreshold() != null) {
         if (indicatorBean.getInvalidityThreshold() < 0) {
            throw new DelegateException("The invalidity threshold has to be between 0 and 1 on '" + indicatorBean.getFunctionalId() + "'.");
         }
         indicatorConfiguration.setInvalidityWorkcard(healthConfigurationBean.getIndicatorInvalidities().getWorkcard());
         indicatorConfiguration.setInvalidityThreshold(indicatorBean.getInvalidityThreshold());
      } else if (indicatorBean.getInvalidityThreshold() != null) {
         // Invalidity threshold defined, but no global indicator invalidity configuration: that's an error
         throw new DelegateException("The indicator '" + indicatorBean.getFunctionalId() + "' defines a 'invalidityThreshold' attribute but <indicatorInvalidities /> tag is missing.");
      } else {
         indicatorConfiguration.setInvalidityWorkcard(null);
         indicatorConfiguration.setInvalidityThreshold(null);
      }
      if (indicatorBean.getLsb() != null && (indicatorBean.getAlgorithm() != HealthAlgorithm.Read || avionic != Avionic.MARMS)) {
         throw new DelegateException("The indicator '" + indicatorBean.getFunctionalId() + "' shall not have an attribute LSB");
      } else if (indicatorBean.getLsb() == null && indicatorBean.getAlgorithm() == HealthAlgorithm.Read && avionic == Avionic.MARMS) {
         throw new DelegateException("The indicator '" + indicatorBean.getFunctionalId() + "' must have an attribute LSB");
      }
      indicatorConfiguration.setMultiplier(indicatorBean.getLsb());

      AccelerometerXMLBean accelerometer = indicatorBean.getAccelerometer();
      if (accelerometer != null) {
         indicatorConfiguration.setAccelerometer(accelerometers.get(Accelerometer.normalize(accelerometer.getFunctionalId())));
      }
      healthComponentConfiguration.getIndicatorConfigurations().put(indicator, indicatorConfiguration);

      // Index indicators by their name
      Map<String, Threshold> thresholds = new HashMap<>(indicator.getThresholds().size());
      for (Threshold threshold : indicator.getThresholds()) {
         thresholds.put(threshold.getFunctionalId(), threshold);
      }

      for (ThresholdXMLBean thresholdBean : indicatorBean.getThresholds()) {
         THRESHOLD_DELEGATE.createThresholdConfiguration(indicatorConfiguration, thresholdBean, thresholds, relearnRequests);
      }
   }

   void validateIndicatorUnicity(List<IndicatorXMLBean> indicators, HealthMechanicalComponent hmc) throws DelegateException {
      Set<String> names = new HashSet<>();
      Set<String> functionalIds = new HashSet<>();
      for (IndicatorXMLBean indicator : indicators) {
         if (names.contains(indicator.getName())) {
            throw new DelegateException("Duplicate indicator '" + indicator.getName() + "' in '" + hmc.getName() + "'");
         }
         names.add(indicator.getName());
         if (functionalIds.contains(indicator.getFunctionalId())) {
            throw new DelegateException("Duplicate indicator '" + indicator.getFunctionalId() + "' in '" + hmc.getName() + "'");
         }
         functionalIds.add(indicator.getFunctionalId());
      }
   }

   void validateMinMaxSensor(IndicatorXMLBean indicatorXMLBean, String hmcFuncId) throws DelegateException {
      final Double minSensor = indicatorXMLBean.getMinSensor();
      final Double maxSensor = indicatorXMLBean.getMaxSensor();

      if (minSensor != null && maxSensor != null && minSensor > maxSensor) {
         throw new DelegateException("Issue with health configuration concerning " + hmcFuncId + " > "
               + indicatorXMLBean.getFunctionalId() + " thresholds Sensor values: check minSensor and maxSensor values.");
      }
   }

   private String getUnitName(IndicatorXMLBean indicatorBean, HealthMechanicalComponentXMLBean mechanicalComponentXMLBean, Map<String, Map<String, Unit>> unitsByPhysicalQuantity)
         throws DelegateException {
      if (indicatorBean.getUnit() == null || indicatorBean.getUnit().isEmpty() || unitsByPhysicalQuantity.isEmpty()) {
         return "no_unit";
      } else {
         final String physicalQuantity = mechanicalComponentXMLBean.getPhysicalQuantity();
         final Map<String, Unit> physicalQuantityUnits = unitsByPhysicalQuantity.get(physicalQuantity);
         if (!physicalQuantityUnits.containsKey(indicatorBean.getUnit())) {
            throw new DelegateException("Unit symbol '" + indicatorBean.getUnit() + "' is unknown (on indicator '" + indicatorBean.getName() + "'). Check the physical quantity (" + physicalQuantity
                  + " expected)");
         }
         return physicalQuantityUnits.get(indicatorBean.getUnit()).getName();
      }
   }
}

