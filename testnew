   /**
    * Process sfm.
    *
    * @param aircraftId
    *           the aircraft id
    * @param flightId
    *           the flight id
    * @param aircraftConfiguration
    *           the aircraft configuration
    * @param lastConfiguration
    * @param mntResources
    *           the resources
    * @param dataContext
    *           the data context
    * @param handler
    *           the handler
    */
   private void processSfm(final String aircraftId, final String flightId, final AircraftConfiguration aircraftConfiguration, AircraftConfiguration lastConfiguration,
         final Map<String, Resource> mntResources, final Map<String, Resource> fdcrResources, final DataContext dataContext, final AircraftExceptionHandler handler, boolean lastDownloadedFlight) {
      final Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      final Flight flight = getFlight(aircraft, flightId);
      final DmauVersion dmauVersion = lastConfiguration.getDmauVersion();

      // SFM analysis shall be ignored if flight type is ROTOR RUNNING
      if (flight.getFlightType() != FlightType.ROTOR_RUNNING) {
         LocalDiagnosisConfiguration localDiagnosisConfiguration = (LocalDiagnosisConfiguration) aircraftConfiguration.getConfigurations().get(LocalDiagnosisConfiguration.TYPE);
         if (featureManager.isEnabled(aircraftConfiguration.getAvionicVersion(), FeatureName.LOCAL_DIAGNOSIS) && localDiagnosisConfiguration != null) {
            processLocalDiagnosis(aircraftConfiguration, lastConfiguration, mntResources, fdcrResources, handler, flight, localDiagnosisConfiguration, lastDownloadedFlight);
         }

         DmauFailureConfiguration dmauFailureConfiguration = (DmauFailureConfiguration) aircraftConfiguration.getConfigurations().get(DmauFailureConfiguration.TYPE);
         if (featureManager.isEnabled(aircraftConfiguration.getAvionicVersion(), FeatureName.DMAU_FAILURES) && dmauFailureConfiguration != null) {
            try {
               processDmauFailures(aircraftConfiguration, lastConfiguration, mntResources, flight);
            } catch (MgsComputingException e) {
               // No log here because the only possible path to get here has already a logging statement
               handler.addMgsComputingError(new MgsComputingError(e.getReason(), Avionic.CIGALHE, flight, e.getMessage()));
            }
         }

         FailureContextMonitoringConfiguration failureContextMonitoringConfiguration = (FailureContextMonitoringConfiguration) aircraftConfiguration.getConfigurations()
               .get(FailureContextMonitoringConfiguration.TYPE);
         if (featureManager.isEnabled(aircraftConfiguration.getAvionicVersion(), FeatureName.FAILURE_CONTEXT_MONITORING) && failureContextMonitoringConfiguration != null) {
            try {
               processFailureContextMonitoring(lastConfiguration, mntResources, flight, failureContextMonitoringConfiguration);
            } catch (MgsComputingException e) {
               // No log here because the only possible path to get here has already a logging statement
               handler.addMgsComputingError(new MgsComputingError(e.getReason(), Avionic.CIGALHE, flight, e.getMessage()));
            }
         }

         final boolean active = Boolean.parseBoolean(parameterManager.getConfigurationProperty(MgsConfigurationKey.ENGINE_DATA_COLLECTION_ACTIVATION.getKey()));
         if (featureManager.isEnabled(aircraftConfiguration.getAvionicVersion(), FeatureName.ENGINE_DATA_COLLECTION) && active && dmauVersion != null && dmauVersion.hasEngineData()) {
            try {
               engineDataManager.collectSfm(dataContext, mntResources);
            } catch (final FolderDataCollectionException e) {
               LOGGER.error("Unable to collect SFM data", e);
               handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.SFM_DATA_COLLECTION_ERROR, Avionic.CIGALHE, flight, e.getCause().getMessage()));
            }
         }
      } else {
         LOGGER.warn("Flight type is 'Rotor Running': skip SFM analysis");
      }
   }

   private void processFailureContextMonitoring(AircraftConfiguration lastConfiguration, Map<String, Resource> mntResources, Flight flight,
         FailureContextMonitoringConfiguration failureContextMonitoringConfiguration) throws MgsComputingException {
      long startTime = System.currentTimeMillis();
      IFailureSession failureSession = null;
      boolean fromBadChannel = false;
      String usedChannel = "";

      final CigalheFailureParameters failureParameters = parameterManager.getCigalheFailureParameters();
      final IFailureCigalheDecoder processor = processorFactory.getProcessor(IFailureCigalheDecoder.class);

      Map<String, Map<String, Resource>> resourcesByFolder = folderResourceOrganizer.organize(mntResources);

      // This boolean is used to track the fact that at least one file has been read
      // This is not related to the fact that a file is "valid" or not
      // This boolean will be "true" if the Failure Context Monitoring configuration contains 4 channels
      // but could be "false" if there are less than 4 channels
      boolean fileFound = false;

      // Iterate on channels, folder and files until a valid file has been found
      // Only one file will be used to analyze Failure Context, but we may try to decode several ones
      // until a "valid" one has been found.
      final Iterator<String> channelIterator = failureContextMonitoringConfiguration.getChannelsPriority().iterator();
      while (channelIterator.hasNext() && failureSession == null) {
         final String channel = channelIterator.next();
         final Iterator<Entry<String, Map<String, Resource>>> folderIterator = resourcesByFolder.entrySet().iterator();
         while (folderIterator.hasNext() && failureSession == null) {
            final Entry<String, Map<String, Resource>> folderEntry = folderIterator.next();
            final Map<String, Resource> resourcesInFolder = folderEntry.getValue();
            final Iterator<Entry<String, Resource>> fileIterator = resourcesInFolder.entrySet().iterator();
            while (fileIterator.hasNext() && failureSession == null) {
               final Entry<String, Resource> fileEntry = fileIterator.next();
               final String fileName = fileEntry.getKey();
               if (channelResourceOrganizer.getChannel(fileName).equals(channel)) {
                  fileFound = true;

                  final Resource resource = fileEntry.getValue();
                  final Map<String, Resource> singletonMap = Collections.singletonMap(fileName, resource);

                  try {
                     final CigalheSoftwareVersionBean cigalheSoftwareVersion = parameterManager.getSoftwareVersions(lastConfiguration.getAvionicVersion().getId());
                     CrcBehavior crcBehavior = cigalheSoftwareVersion.getMnt().getCrcBehavior();
                     failureSession = processor.decode(failureParameters.getLookupWindow().getSize(), singletonMap, lastConfiguration.getAvionicVersion().getMntFormat(), crcBehavior);
                     usedChannel = channel;
                  } catch (final DecodingException e) {
                     LOGGER.debug("Exception when decoding MNT file {}", fileName, e);
                  }
               }
            }
         }
         if (failureSession == null) {
            // Will loop at least once on the outer loop:
            // that means file from a "bad" channel will be used
            fromBadChannel = true;
         }
      }

      long endTime = System.currentTimeMillis();
      LOGGER.debug("Failure decoding done in {} ms", (endTime - startTime));

      if (!fileFound) {
         LOGGER.warn("No resources corresponding to the configured channels {} has been found.", failureContextMonitoringConfiguration.getChannelsPriority());
         return;
      }

      if (failureSession == null) {
         // In that case, at least one file has been read (otherwise the condition above would have match)
         // but no session has been stored, that means all files have a decoding error
         LOGGER.error("All MNT file not readable while decoding them for Failure Context Monitoring");
         throw new MgsComputingException(MgsComputingErrorReason.FAILURE_MONITORING_DECODING_ERROR);
      }

      startTime = System.currentTimeMillis();
      IFailureAnalyzer analyzer = analyzerFactory.getAnalyzer(IFailureAnalyzer.class);
      analyzer.analyze(flight, failureSession, (FailureContextMonitoringConfiguration) lastConfiguration.getConfigurations().get(FailureContextMonitoringConfiguration.TYPE), fromBadChannel,
            usedChannel);
      endTime = System.currentTimeMillis();
      LOGGER.debug("Failure analysis done in {} ms", (endTime - startTime));
   }

   private void processDmauFailures(final AircraftConfiguration aircraftConfiguration, final AircraftConfiguration lastConfiguration, final Map<String, Resource> mntResources,
         final Flight flight) throws MgsComputingException {
      long startTime = System.currentTimeMillis();

      Map<String, Map<String, Resource>> resourcesByFolder = folderResourceOrganizer.organize(mntResources);
      if (resourcesByFolder.isEmpty()) {
         // Shall never happen, but anyway, nothing to do
         return;
      }

      final CigalheFailureParameters failureParameters = parameterManager.getCigalheFailureParameters();
      final IFailureCigalheDecoder processor = processorFactory.getProcessor(IFailureCigalheDecoder.class);

      IFailureSession failureSession = null;

      Iterator<Entry<String, Map<String, Resource>>> entryIterator = resourcesByFolder.entrySet().iterator();

      // Keep iterating on folders until a valid one has been found
      // A valid folder means a folder where at least one valid file has been detected
      while (entryIterator.hasNext() && failureSession == null) {
         Entry<String, Map<String, Resource>> folderEntry = entryIterator.next();
         String folderName = folderEntry.getKey();
         Map<String, Resource> resourcesInFolder = folderEntry.getValue();

         try {
            final CigalheSoftwareVersionBean cigalheSoftwareVersion = parameterManager.getSoftwareVersions(lastConfiguration.getAvionicVersion().getId());
            CrcBehavior crcBehavior = cigalheSoftwareVersion.getMnt().getCrcBehavior();
            failureSession = processor.decode(failureParameters.getLookupWindow().getSize(), resourcesInFolder, lastConfiguration.getAvionicVersion().getMntFormat(), crcBehavior);
         } catch (final DecodingException e) {
            LOGGER.debug("Exception when decoding MNT files in folder {}", folderName, e);
         }
      }

      long endTime = System.currentTimeMillis();
      LOGGER.debug("DMAU Failure decoding done in {} ms", (endTime - startTime));

      if (failureSession == null) {
         // At this point, nothing can be done. All folders have been analyzed and nothing can be decoded
         LOGGER.error("All MNT file not readable while decoding them for DMAU failures");
         throw new MgsComputingException(MgsComputingErrorReason.DMAU_FAILURE_DECODING_ERROR);
      }

      startTime = System.currentTimeMillis();

      IDmauFailureAnalyzer analyzer = analyzerFactory.getAnalyzer(IDmauFailureAnalyzer.class);
      analyzer.analyze(flight, failureSession, (DmauFailureConfiguration) aircraftConfiguration.getConfigurations().get(DmauFailureConfiguration.TYPE));

      endTime = System.currentTimeMillis();
      LOGGER.debug("DMAU Failure analysis done in {} ms", (endTime - startTime));
   }

   private void processLocalDiagnosis(final AircraftConfiguration aircraftConfiguration, final AircraftConfiguration lastConfiguration, final Map<String, Resource> mntResources,
         final Map<String, Resource> fdcrResources, final AircraftExceptionHandler handler, final Flight flight, LocalDiagnosisConfiguration localDiagnosisConfiguration,
         boolean lastDownloadedFlight) {
      ISftpService sftpService;
      try {
         sftpService = (ISftpService) new InitialContext().lookup(ISftpService.class.getName() + "#" + ISftpService.class.getName());
      } catch (NamingException e) {
         LOGGER.error("Unable to find FTP service", e);
         handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.LOCAL_DIAG_FTP_SERVICE_UNREACHABLE, Avionic.CIGALHE, flight, e.getMessage()));
         return;
      }

      // For Local Diagnosis, MGS sends all MNT resources
      AvionicVersion avionicVersion = lastConfiguration.getAvionicVersion();
      FdcrDecPreferenceBean fdcrRemovedParametersPreference = parameterManager.getFdcrRemovedParametersPreference(avionicVersion.getId());
      boolean hasFdcrDataToRemove = !fdcrRemovedParametersPreference.getStructures().isEmpty();
      String resourcesFolderName = getResourcesFolderName(aircraftConfiguration, flight);
      try {
         sftpService.store(mntResources, resourcesFolderName, "BIT");
         if (fdcrResources != null && !fdcrResources.isEmpty() && !hasFdcrDataToRemove && localDiagnosisConfiguration.isFdcrDataNeeded()) {
            sftpService.store(fdcrResources, resourcesFolderName, "FDCR");
         }
         InputStream archiveContent = new ByteArrayInputStream(localDiagnosisConfiguration.getRuleConfiguration().getArchiveContent());
         Resource resource = new InputStreamResource(archiveContent);
         sftpService.store(Collections.singletonMap("local-diag.zip", resource), resourcesFolderName);
      } catch (IOException | URISyntaxException e) {
         LOGGER.error("Unable to copy files for Local Diag", e);
         handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.LOCAL_DIAG_FTP_SERVICE_UNREACHABLE, Avionic.CIGALHE, flight, e.getMessage()));
         sftpService.removeQuietly(resourcesFolderName);
         return;
      }

      DiagnosisData diagnosisData = new DiagnosisData(UUID.randomUUID().toString());
      diagnosisData.setFolderName(resourcesFolderName);
      diagnosisData.setStartImmediately(lastDownloadedFlight);
      if (hasFdcrDataToRemove && fdcrResources != null && !fdcrResources.isEmpty() && localDiagnosisConfiguration.isFdcrDataNeeded()) {
         diagnosisData.setStatus(DiagnosisStatus.NOT_YET_STARTED);
      } else if (lastDownloadedFlight) {
         diagnosisData.setStatus(DiagnosisStatus.READY);
      } else {
         diagnosisData.setStatus(DiagnosisStatus.PENDING);
      }
      flight.setDiagnosisData(diagnosisData);
   }

   private String getResourcesFolderName(AircraftConfiguration aircraftConfiguration, Flight flight) {
      final String folderNameSeparator = "_";
      SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMdd_HHmmss");
      sdf.setTimeZone(TimeZone.getTimeZone("GMT"));

      return aircraftConfiguration.getAvionicVersion().getSubtype() + folderNameSeparator +
            aircraftConfiguration.getAircraft().getAircraftId() + folderNameSeparator +
            pad(String.valueOf(flight.getFlightId())) + folderNameSeparator +
            // Even if requirement FDD_DIAG-008 specify that the date must be the date of the flight, an other older requirement from local diag COTS
            // specify that the date must be the date of the folder creation. In order to avoid regression, we decided to keep the folder creation date.
            sdf.format(new Date());
   }

   private String pad(String flightId) {
      return "00000".substring(flightId.length()) + flightId;
   }

   /**
    * Find aircraft.
    *
    * @param aircraftId
    *           the aircraft id
    * @param date
    *           the date
    * @return the aircraft
    * @throws EntityNotFoundException
    *            the entity not found exception
    */
   private Aircraft findAircraft(final AircraftIdentifier aircraftId, final Date date) throws EntityNotFoundException {
      final TypedQuery<Aircraft> aircraft = manager.createNamedQuery("findAircraftByFileName", Aircraft.class);
      aircraft.setParameter("subtype", aircraftId.aircraftSubtype());
      aircraft.setParameter("aircraftId", aircraftId.aircraftId());
      aircraft.setParameter("date", date.getTime() < 0 ? new Date(1L) : date);
      List<Aircraft> result = aircraft.getResultList();
      if (result == null || result.isEmpty()) {
         throw new EntityNotFoundException("Unknown aircraft: subtype=" + aircraftId.aircraftSubtype() + ", aircraftId=" + aircraftId.aircraftId());
      } else {
         return result.get(0);
      }
   }

   private Set<Folder> buildNotificationsDto(Aircraft aircraft, FlightEntry flightEntry, DownloadMode modeDownload) {
      Set<Folder> folders = new HashSet<>();
      for (FeatureId featureId : FeatureId.values()) {
         if (flightEntry.hasResources(featureId)) {
            Map<String, Resource> resourceMap = flightEntry.getResources(featureId);
            Set<String> processedFolderNames = new HashSet<>();
            for (String resourceName : resourceMap.keySet()) {
               String folderName = resourceName.split("/")[0];
               if (!processedFolderNames.contains(folderName)) {
                  processedFolderNames.add(folderName);
                  Folder folder = new Folder(UUID.randomUUID().toString());
                  folder.setName(folderName);
                  folder.setDownloadMode(modeDownload);
                  folder.setAircraftId(aircraft.getId());
                  aircraft.getFolders().add(folder);
                  folders.add(folder);
               }
            }
         }
      }
      return folders;
   }
}


