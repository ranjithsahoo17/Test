import com.eurocopter.mgs.service.task.dto.TaskStatus;
import com.eurocopter.mgs.service.task.dto.TaskType;

class TaskUtils {

   public static TaskModel createTask(BackgroundOperation backgroundOperation, Collection<Aircraft> aircrafts, TaskStatus taskStatus) {
      final TaskType taskType = getTaskType(backgroundOperation.getOperation());
      final TaskModel task = new TaskModel(backgroundOperation.getId());
      task.setDate(backgroundOperation.getCreationDate());
      task.setStatus(taskStatus);
      task.setType(taskType);
      task.setProgress(backgroundOperation.getProgress());
      for (Aircraft aircraft : aircrafts) {
         task.getAircrafts().add(new AircraftTaskModel(aircraft.getAircraftType().getDescription(), aircraft.getAircraftSerialNumberOrId(), aircraft.getRegisterNumber()));
      }
      return task;
   }

   private static TaskType getTaskType(Operation operation) {
      return switch (operation) {
         case ENGINE_DATA_COLLECTION -> TaskType.ENGINE_DATA_COLLECTION;
         case FLIGHT_DATA_COLLECTION -> TaskType.FLIGHT_DATA_COLLECTION;
         case USER_OPERATION_DATA_COLLECTION -> TaskType.USER_OPERATION_DATA_COLLECTION;
         case FDCR_ANALYSIS -> TaskType.FDCR_ANALYSIS;
         case FDCR_PURGE -> TaskType.FDCR_PURGE;
         case FLIGHT_AUTO_PURGE, FLIGHT_MANUAL_PURGE -> TaskType.FLIGHT_PURGE;
         case RAW_DATA_FILTERING -> TaskType.RAW_DATA_FILTERING;
         default -> throw new IllegalStateException("Unsupported operation: " + operation);
      };
   }

   private TaskUtils() {
      // Private Constructor
   }
}

