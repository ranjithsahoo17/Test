   private void refreshFdcrGraphManager() {
      Map<String, FdcrParameterSelectionModel> newFdcrParameterSelectionsModels = new HashMap<>();
      List<FdcrParameterSelectionModel> fdcrParameterSelectionsModelsToAdd = new ArrayList<>();
      // Put the new FDCR parameter selections models for search convenience
      for (FdcrParameterSelectionModel model : fdcrSelectComposite.getFdcrParameterSelectionsModel()) {
         if (model.isSelected()) {
            newFdcrParameterSelectionsModels.put(model.getFunctionalId(), model);
         }
      }
      // Find and remove the FDCR parameter models that are not in the new models list
      for (Entry<String, FdcrParameterSelectionModel> entry : currentFdcrParameterSelectionsModels.entrySet()) {
         if (!newFdcrParameterSelectionsModels.containsKey(entry.getKey())) {
            FdcrParameterSelectionModel fdcrParameterSelectionModel = entry.getValue();
            removeFdcrData(fdcrParameterSelectionModel.getFunctionalId());
         }
      }
      // Find and add the FDCR selection models that are not in the current models list
      for (Entry<String, FdcrParameterSelectionModel> entry : newFdcrParameterSelectionsModels.entrySet()) {
         if (!currentFdcrParameterSelectionsModels.containsKey(entry.getKey())) {
            fdcrParameterSelectionsModelsToAdd.add(entry.getValue());
         }
      }

      fdcrGraphManager.setFdcrParameterSelections(fdcrParameterSelectionsModelsToAdd);

      currentFdcrParameterSelectionsModels = newFdcrParameterSelectionsModels;

      AxisAdapteur<?> domainAxisAdapter = chart.getPlotManager().getPlot().getDomainAxisAdapteur();
      fdcrGraphManager.updateGraph((Double) domainAxisAdapter.getLowerBoundWithoutMargin(), (Double) domainAxisAdapter.getUpperBoundWithoutMargin());
   }

   private void displayFdcrData() {
      if (chart != null && fdcrSelectComposite != null) {
         if (!showFdcrData) {
            return;
         }

         // Take into account 2% margin on each side
         AxisAdapteur<Double> domainAxisAdapteur = chart.getPlotManager().getPlot().getDomainAxisAdapteur();
         double displayedFlightHours = domainAxisAdapteur.getUpperBoundWithoutMargin() - domainAxisAdapteur.getLowerBoundWithoutMargin();
         if (fdcrMaxNbFlightHours > 0 && displayedFlightHours > fdcrMaxNbFlightHours) {
            clearFdcrData();
            showFdcrData = false;
            btnDisplayFdcrData.setSelection(false);
            MessageDialog.openInformation(Display.getDefault().getActiveShell(), Messages.CORE.getString("FdcrDisplay"),
                  Messages.CORE.getString("FdcrMaxFlightHoursError") + " (" + fdcrMaxNbFlightHours + ")");
            return;
         }
         // TODO : delimit the fdcr date time range between the selected indicator start date and the end date.
         updateFdcrDateTimeRange();
         fdcrGraphManager.resetData(MgsSession.getInstance().getFlights());
         refreshFdcrGraphManager();
         Map<String, ChartElementModel<Double>> fdcrChartElements = fdcrGraphManager.getGraphModel().getChartElements();
         for (Entry<String, ChartElementModel<Double>> fdcrChartElement : fdcrChartElements.entrySet()) {
            try {
               chart.addCurve(fdcrChartElement.getValue());
            } catch (ChartException e) {
               LOGGER.warn("", e);
               MessageDialog.openError(Display.getCurrent().getActiveShell(), "Add FDCR curve",
                     "Cannot add fdcr curve : " + e.getMessage());
            }
         }
         registerSamplingDoubleChartElementModelOnDomainAxisChangeEvent(fdcrChartElements.values());
      }
   }

   private void registerSamplingDoubleChartElementModelOnDomainAxisChangeEvent(final Collection<ChartElementModel<Double>> chartElementModels) {
      for (ChartElementModel<?> chartElementModel : chartElementModels) {
         if (chartElementModel instanceof SamplingDoubleChartElementModel) {
            chart.getPlotManager().addDomainAxisChangeListener((SamplingDoubleChartElementModel) chartElementModel);
         }
      }
   }

   private void unregisterSamplingDoubleChartElementModelOnDomainAxisChangeEvent(final Collection<ChartElementModel<Double>> chartElementModels) {
      Collection<ChartElementModel<Double>> chartElementModelCollection = chartElementModels;
      for (ChartElementModel<Double> chartElementModel : chartElementModelCollection) {
         if (chartElementModel instanceof SamplingDoubleChartElementModel) {
            chart.getPlotManager().removeDomainAxisChangeListener((SamplingDoubleChartElementModel) chartElementModel);
            ((SamplingDoubleChartElementModel) chartElementModel).setValueLoader(null);
         }
      }
   }

   private void clearFdcrData() {
      if (chart != null) {
         unregisterSamplingDoubleChartElementModelOnDomainAxisChangeEvent(fdcrGraphManager.getGraphModel().getChartElements().values());
         chart.removeCurves(fdcrGraphManager.getGraphModel().getChartElements().keySet(), false);
         fdcrGraphManager.getGraphModel().removeAllChartElements();
         currentFdcrParameterSelectionsModels.clear();
      }
   }

   private void removeFdcrData(String title) {
      if (chart != null) {
         ChartElementModel<Double> chartElementModelToRemove = fdcrGraphManager.getGraphModel().getChartElement(title);
         unregisterSamplingDoubleChartElementModelOnDomainAxisChangeEvent(Collections.singletonList(chartElementModelToRemove));
         chart.removeCurve(title);
         fdcrGraphManager.getGraphModel().removeChartElement(title);
      }
   }

