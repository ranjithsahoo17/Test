import com.google.common.collect.ArrayListMultimap;
import com.google.common.collect.Multimap;

import jakarta.annotation.Resource;
import jakarta.ejb.EJB;
import jakarta.ejb.Schedule;
import jakarta.ejb.Stateless;
import jakarta.ejb.TransactionManagement;
import jakarta.ejb.TransactionManagementType;
import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;
import jakarta.transaction.UserTransaction;

@Stateless
@TransactionManagement(TransactionManagementType.BEAN)
public class BackgroundOperationTimer {

   private static final Logger LOGGER = LogManager.getLogger(BackgroundOperationTimer.class);

   @PersistenceContext
   private EntityManager manager;

   @Resource
   private UserTransaction transaction;

   @EJB
   private BackgroundOperationDao backgroundOperationDao;

   @EJB
   private GroundStationDao groundStationDao;

   @EJB
   private DataCollectionService dataCollectionService;

   @EJB
   private FdcrDownloadManager fdcrDownloadManager;

   @EJB
   private AircraftDeletionManager aircraftDeletionManager;

   @EJB
   private DataCollectionManager dataCollectionManager;

   @EJB
   private PurgeDataManager purgeDataManager;

   @EJB
   private RawDataFilteringManager rawDataFilteringManager;

   @EJB
   private INotificationService notificationService;

   @EJB
   private BackgroundOperationSingleton currentOperation;

   private TaskModel currentTaskForNotification;

   @Schedule(second = "*/30", minute = "*", hour = "*", persistent = false)
   public void pollBackgroundOperations() {
      if (isGroundStationBusy()) {
         // The ground station is busy: the archive/restore tool must be running
         // We cannot process any background operations, since they may have some interaction
         // with the database itself.
         LOGGER.debug("Unable to process background operations: ground station is busy");
         return;
      }

      List<BackgroundOperation> operations = backgroundOperationDao.findAllBackgroundOperations();
      if (!operations.isEmpty()) {
         LOGGER.info("Polling background operations [{} operations are in queue]", operations.size());
      }
      for (BackgroundOperation operation : operations) {
         final ITaskProgressCallback taskCallback = new TaskCallback();
         LOGGER.info("Processing background operation: {}", operation.getOperation());
         try {
            transaction.begin();
            currentOperation.setOperation(operation);
            currentTaskForNotification = TaskUtils.createTask(operation, backgroundOperationDao.getAircrafts(operation), TaskStatus.RUNNING);
            notifyTask(Action.UPDATE);
            switch (operation.getOperation()) {
               case FLIGHT_DATA_COLLECTION -> dataCollectionManager.performFlightDataCollection(operation.getFolderName(), taskCallback);
               case ENGINE_DATA_COLLECTION -> dataCollectionManager.performEngineDataCollection(operation.getFolderName(), taskCallback);
               case USER_OPERATION_DATA_COLLECTION -> dataCollectionManager.exportCollectedData(dataCollectionService.pollUserOperations(), taskCallback);
               case FDCR_ANALYSIS -> processFdcrAnalysis(operation, taskCallback);
               case AIRCRAFT_DELETION -> aircraftDeletionManager.processDeletion(operation.getAircraftId());
               case FDCR_PURGE, FLIGHT_AUTO_PURGE, FLIGHT_MANUAL_PURGE -> purgeDataManager.handleOperation(operation, taskCallback);
               case RAW_DATA_FILTERING -> processRawDataFiltering(operation, taskCallback);
               default -> throw new IllegalStateException("Unsupported operation: " + operation.getOperation());
            }
            backgroundOperationDao.delete(manager.find(BackgroundOperation.class, operation.getId()));
            transaction.commit();
            LOGGER.info("{}: operation removed from queue", operation.getOperation());
            currentTaskForNotification.setStatus(TaskStatus.DONE);
            notifyTask(Action.DELETION);
         } catch (Exception e) {
            LOGGER.warn("Unable to process background operation, will be retried later", e);
            rollback();
            currentTaskForNotification.setStatus(TaskStatus.PENDING);
            notifyTask(Action.UPDATE);
            // Do not execute next operations
            break;
         } finally {
            currentOperation.setOperation(null);
         }
      }
   }

   private boolean isGroundStationBusy() {
      try {
         return groundStationDao.getRefreshedLocalGroundStation().isBusy();
      } catch (EntityNotFoundException e) {
         LOGGER.warn("Unable to find ground station", e);
         return true;
      }
   }

   private void rollback() {
      try {
         transaction.rollback();
      } catch (Exception e) {
         LOGGER.warn("Unable to rollback transaction", e);
      }
   }

   private void processFdcrAnalysis(BackgroundOperation operation, ITaskProgressCallback mainTaskCallback) {
      long start;
      long end;
      start = System.currentTimeMillis();
      LOGGER.info("Start FDCR analysis ...");
      TopicDto topicDto = new TopicDto(operation.getTopicId());

      Multimap<String, String> downloadByAircrafts = ArrayListMultimap.create();
      for (Map.Entry<String, String> entry : operation.getDownloadIds().entrySet()) {
         downloadByAircrafts.put(entry.getValue(), entry.getKey());
      }

      String downloadFolder = operation.getFolderName();

      try {
         fdcrDownloadManager.analyze(topicDto, downloadFolder, downloadByAircrafts, mainTaskCallback);
         end = System.currentTimeMillis();
         LOGGER.info("End FDCR Analysis in {} ms.", (end - start));
      } catch (Exception e) {
         // The error is not recoverable
         LOGGER.warn("Unable to analyze FDCR data for operation id = {}", operation.getId(), e);
         LOGGER.info("End FDCR Analysis with error");
      }
   }

   private void processRawDataFiltering(BackgroundOperation operation, ITaskProgressCallback mainTaskCallback) {
      rawDataFilteringManager.process(operation.getAircraftId(), operation.getFolderName(), operation.getFilenames(), mainTaskCallback);
   }

   private void notifyTask(Action action) {
      try {
         notificationService.notifyActionImmediately(currentTaskForNotification, action);
      } catch (NotificationException e) {
         LOGGER.info("Unexpected exception while notify task update status action{}", e.getMessage(), e);
      }
   }

   private class TaskCallback extends MainTaskProgressCallback {

      private long timestamp;

      @Override
      protected void progressUpdated() {
         super.progressUpdated();
         double progressRatio = getProgressRatio();
         currentOperation.getOperation().setProgress(progressRatio);
         currentTaskForNotification.setProgress(progressRatio);
         if ((System.currentTimeMillis() - timestamp) > 1000) {
            notifyTask(Action.UPDATE);
            timestamp = System.currentTimeMillis();
         }
      }

   }

}



