   }

   private void mergeAircraftConfigurations(String aircraftId, UuidMapping aircraftMapping, File aircraftFolder) throws AircraftManagementException {
      File csvFile = new File(aircraftFolder, "aircraft_configuration.csv");
      CsvParser parser = getCsvParser();
      List<String[]> allLines = parser.parseAll(csvFile);
      int serialNumberIndex = Arrays.asList(allLines.get(0)).indexOf("serial_number");
      int idIndex = Arrays.asList(allLines.get(0)).indexOf("id");
      Set<String> idsToDelete = new HashSet<>();
      for (int i = 1; i < allLines.size(); ++i) {
         String[] line = allLines.get(i);
         String formattedLine = "SELECT id FROM aircraft_configuration WHERE aircraft_id = ? AND serial_number = ?";
         Query query = manager.createNativeQuery(formattedLine);
         query.setParameter(1, aircraftId);
         query.setParameter(2, Integer.parseInt(line[serialNumberIndex]));
         @SuppressWarnings("unchecked")
         List<Object> resultList = query.getResultList();
         if (resultList.isEmpty()) {
            // The configuration is not present on this MGS base, we will import it
         } else {
            // The configuration is already present, and configuration are immutable => delete it
            idsToDelete.add(line[idIndex]);
         }
      }

      if (!idsToDelete.isEmpty()) {
         deleteBeforeImport(aircraftFolder, aircraftMapping, "aircraft_configuration", "id", idsToDelete);
         Set<String> configurationIds = deleteBeforeImport(aircraftFolder, aircraftMapping, "configuration", "aircraft_configuration_id", idsToDelete, "id");

         deleteUsageConfigurations(aircraftFolder, aircraftMapping, configurationIds);
         deleteHealthConfigurations(aircraftFolder, aircraftMapping, configurationIds);
         deleteFdcrConfigurations(aircraftFolder, aircraftMapping, configurationIds);
         deleteSfmConfigurations(aircraftFolder, aircraftMapping, configurationIds);
         deleteLocalDiagnosisConfigurations(aircraftFolder, aircraftMapping, configurationIds);
         deleteFailureContextMonitoringConfiguration(aircraftFolder, aircraftMapping, configurationIds);
         deleteDmauFailureConfiguration(aircraftFolder, aircraftMapping, configurationIds);
         deleteVpuFailureConfiguration(aircraftFolder, aircraftMapping, configurationIds);
      }
      readImportSql(aircraftFolder, "aircraft-configuration-import");
   }

