   @Override
   public Map<String, HealthMechanicalComponentConfiguration> getMechanicalComponentConfigurationsForAircraft(String aircraftId, String mechanicalComponentId) {
      Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      HealthMechanicalComponent mechanicalComponent = manager.find(HealthMechanicalComponent.class, mechanicalComponentId);

      Map<Integer, HealthMechanicalComponentConfiguration> configurationCache = new HashMap<>();
      for (AircraftConfiguration aircraftConfiguration : configurationDao.findConfigurations(aircraftId)) {
         HealthMonitoringConfiguration healthConfiguration = (HealthMonitoringConfiguration) aircraftConfiguration.getConfigurations().get(HealthMonitoringConfiguration.TYPE);
         if (healthConfiguration != null) {
            int serialNumber = aircraftConfiguration.getSerialNumber();
            configurationCache.put(serialNumber, healthConfiguration.getMechanicalComponentConfigurations().get(mechanicalComponent));
         }
      }

      Map<String, HealthMechanicalComponentConfiguration> configurations = new HashMap<>();
      for (Flight flight : aircraft.getFlights()) {
         if (configurationCache.get(flight.getConfigurationSerialNumber()) != null) {
            configurations.put(flight.getId(), configurationCache.get(flight.getConfigurationSerialNumber()));
         }
      }
      return configurations;
   }

   @Override
   public void createRelearnThresholdRequests(String aircraftId, List<String> learnedThresholdIds, long historyLearningTime,
         String comment, String login) throws ConcurrentAccessException {
      aircraftLockManager.throwExceptionIfAircraftLocked(aircraftId);

      // Check if A/C is frozen
      Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      long start;
      long end;
      start = System.currentTimeMillis();
      LOGGER.info("Start re-learning on aircraft {}, SN : {}", aircraft.getAircraftType().getName(), aircraft.getAircraftId());
      if (aircraft.getAircraftState() == AircraftState.FROZEN || aircraft.getAircraftState() == AircraftState.DELETED) {
         throw new AircraftFrozenException("Cannot set thresholds in relearning on a frozen A/C.");
      }

      Set<String> activeThresholdIds = new HashSet<>();
      try {
         activeThresholdIds = getActiveThresholdIds(aircraftId);
      } catch (EntityNotFoundException e) {
         // NOTHING TO DO: NEXT INSTRUCTION WILL RAISE EXCEPTION
         LOGGER.debug("Unable to find latest health configuration", e);
      }

      if (!activeThresholdIds.containsAll(learnedThresholdIds)) {
         throw new ConcurrentAccessException("Cannot handle relearn request: health configuration has been changed.");
      }

      Date lastFlightDate = healthDao.getLastFlightDate(aircraftId);

      for (String id : learnedThresholdIds) {
         LearnedThresholdConfiguration learnedThreshold = manager.find(LearnedThresholdConfiguration.class, id);

         Map<Indicator, String> indicatorFromThreshold = getIndicatorFromThreshold(aircraft, learnedThreshold.getThreshold());
         Indicator indicator = null;
         List<String> indicatorLocations = new ArrayList<>();
         for (Entry<Indicator, String> entry : indicatorFromThreshold.entrySet()) {
            indicator = entry.getKey();
            indicatorLocations = Arrays.asList(entry.getValue().split(":"));
         }

         if (indicator != null) {
            LOGGER.info("Threshold: {}/{}/{}", Joiner.on('/').join(indicatorLocations), indicator.getName(), learnedThreshold.getThreshold().getSeverity());

            Calendar calendar = Calendar.getInstance(TimeZone.getTimeZone("GMT"));
            healthDao.createRelearnThresholdRequest(aircraft, learnedThreshold, calendar.getTime(), lastFlightDate, historyLearningTime, comment, login, indicator, indicatorLocations);
         }
      }
      end = System.currentTimeMillis();
      LOGGER.info("End re-learning on aircraft {}, SN : {} in {} ms.", aircraft.getAircraftType().getName(), aircraft.getAircraftId(), (end - start));
   }

