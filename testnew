         dto.setInUse(healthCommonService.isFilteringLawUsedByConfiguration(aircraftId, law.getName()) || healthCommonService.isFilteringLawUsedByDeviation(law.getId()));
         for (ContextualParameter p : law.getContextualParameters()) {
            ContextualParameterDto pDto = new ContextualParameterDto();
            pDto.setId(p.getId());
            pDto.setName(p.getName());
            pDto.setMinValue(p.getMinValue());
            pDto.setMaxValue(p.getMaxValue());
            pDto.setThresholdOfVariabilityValue(p.getThresholdOfVariabilityValue());
            dto.getParameters().add(pDto);
         }
         result.add(dto);
      }
      result.sort((a, b) -> a.getName().compareTo(b.getName()));
      return result;
   }

