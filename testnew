   public void saveDeviations() {
      List<IndicatorDeviationDto> newDeviations = new ArrayList<>();
      Aircraft deviationAircraft = null;
      Date now = new Date();
      for (Entry<Aircraft, WCMechanicalComponentModel> entry : data.entrySet()) {
         deviationAircraft = entry.getKey();
         Multimap<Indicator, WCThresholdModel> thresholds = getComponentThresholds(entry.getValue());

         for (WCThresholdModel model : thresholds.values()) {
            LOGGER.info(" Value {} deviated={} deviationId={} icId={} te={}", model.getIndicator().getName(), model.isDeviated(), model.getDeviationId(), model.getIndicatorConfigurationId(),
                  model.getTeReference());
            /*
             * if (!model.isDeviated() || model.getDeviationId() != null) { continue; }
             */

            if (!model.isDeviated() || model.getDeviationId() != null) {
               continue;
            }
            if (!hasDeviationFieldChanged(model)) {
               continue;
            }

            newDeviations.add(toDeviationDto(model, now));
         }
      }
      if (!newDeviations.isEmpty() && deviationAircraft != null) {
         try {
            healthBusiness.createDeviations(deviationAircraft.getId(), MgsSession.getInstance().getUser().getLoginName(), newDeviations);
         } catch (Exception e) {
            LOGGER.error("Could  not   save  deviations", e);
         }
      }

   }

   private boolean hasDeviationFieldChanged(final WCThresholdModel model) {
      final WCThresholdBaseline baseline = model.getBaseline();
      if (baseline == null) {
         return false;
      }
      return !Objects.equals(baseline.getLevel(), model.getLevel())
            || !Objects.equals(baseline.getType(), model.getType())
            || !Objects.equals(baseline.getMinValue(), model.getMinValue())
            || !Objects.equals(baseline.getMaxValue(), model.getMaxValue())
            || !Objects.equals(baseline.getFilteringLawName(), model.getFilteringLawName())
            || !Objects.equals(baseline.getMaxPointsPerHour(), model.getMaxPointsPerHour())
            || (model.getTeReference() != null && !model.getTeReference().trim().isEmpty());
   }

   private IndicatorDeviationDto toDeviationDto(WCThresholdModel model, Date now) {
      IndicatorDeviationDto dto = new IndicatorDeviationDto();
      dto.setIndicatorConfigurationId(model.getIndicatorConfigurationId());
      dto.setStartDate(now);
      dto.setSeverity(model.getSeverity().name());
      dto.setTeReference(model.getTeReference());
      dto.setFilteringLawId(getFilteringLawId(model.getFilteringLawName()));
      WCThresholdBaseline baseline = model.getBaseline();
      if (baseline == null) {
         return dto;
      }
      if (!Objects.equals(baseline.getLevel(), model.getLevel())) {
         dto.setThresholdLevel(model.getLevel().name());
      }
      if (!Objects.equals(baseline.getType(), model.getType())) {
         dto.setThresholdType(model.getType().name());
      }
      if (!Objects.equals(baseline.getDefaultValue(), model.getDefaultValue())) {
         dto.setThresholdValue(model.getDefaultValue());
      }
      if (!Objects.equals(baseline.getMinValue(), model.getMinValue())) {
         dto.setMinValue(model.getMinValue());
      }
      if (!Objects.equals(baseline.getMaxValue(), model.getMaxValue())) {
         dto.setMaxValue(model.getMaxValue());
      }
      /*
       * if (!Objects.equals(baseline.getLearningTime(), model.getLearningTime())) { dto.setLearningTime(model.getLearningTime()); }
       */
      if (!Objects.equals(baseline.getWorkCardReference(), model.getWorkCardReference())) {
         dto.setWorkcard(model.getWorkCardReference());
      }
      if (!Objects.equals(baseline.getMaxPointsPerHour(), model.getMaxPointsPerHour())) {
         dto.setMaxPointsPerHour(model.getMaxPointsPerHour());
      }

      /*
       * if (!Objects.equals(baseline.getMinimumDeviation(), model.getMinimumDeviation())) { dto.setMinimumDeviation(model.getMinimumDeviation()); }
       */
      /*
       * if (!Objects.equals(baseline.getMeanFactor(), model.getMeanFactor())) { dto.setMeanFactor(model.getMeanFactor()); }
       */
      /*
       * if (!Objects.equals(baseline.getDeviationCoefficient(), model.getDeviationCoefficient())) { dto.setDeviationCoefficient(model.getDeviationCoefficient()); }
       */
      /*
       * if (!Objects.equals(baseline.getNbSuccessivePoints(), model.getNbSuccessivePoints())) { dto.setNbSuccessivePoints(model.getNbSuccessivePoints()); }
       */
      return dto;
   }

