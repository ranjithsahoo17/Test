@Remote(IFlightService.class)
@Stateless(mappedName = IFlightService.EJB_NAME)
public class FlightService implements IFlightService {

   /** The Constant LOGGER. */
   private static final Logger LOGGER = LogManager.getLogger(FlightService.class);

   @EJB
   private AircraftDao aircraftDao;

   @PersistenceContext
   private EntityManager manager;

   @EJB
   private AircraftLockManager aircraftLockManager;

   @EJB
   private ConfigurationDao configurationDao;

   @EJB
   private AsyncQueue asyncQueue;

   @Override
   public Flight getFlight(final String flightId) {
      return manager.find(Flight.class, flightId);
   }

   @Override
   public List<Flight> getFlights(final String aircraftId) {
      TypedQuery<Flight> query = manager.createNamedQuery("findFlightsByAircraft", Flight.class);
      query.setParameter("aircraftId", aircraftId);
      List<Flight> flights = query.getResultList();
      return Objects.requireNonNullElse(flights, Collections.emptyList());
   }

   @Override
   public Flight getLastFlight(final String aircraftId) {
      return aircraftDao.getLastFlight(aircraftId).orElse(null);
   }

   @Override
   public List<Download> getDownloads(final String aircraftId) {
      final TypedQuery<Download> query = manager.createNamedQuery("findDownloadsByAircraft", Download.class);
      query.setParameter("aircraftId", aircraftId);
      final List<Download> downloads = query.getResultList();
      if (downloads != null && !downloads.isEmpty()) {
         for (final Download download : downloads) {
            // compute the status of the flights
            computeFlightStatus(download.getFlights());
         }
         return downloads;
      } else {
         return Collections.emptyList();
      }
   }

   @Override
   public List<Download> getDownloads(final String aircraftId, final Date startResult, final Date endResult) {
      final TypedQuery<Download> query = manager.createNamedQuery("findDownloadsByDates", Download.class);
      query.setParameter("aircraftId", aircraftId);
      query.setParameter("start", startResult);
      query.setParameter("end", endResult);
      final List<Download> downloads = query.getResultList();
      if (downloads != null && !downloads.isEmpty()) {
         for (final Download download : downloads) {
            // compute the status of the flights
            computeFlightStatus(download.getFlights());
         }
         return downloads;
      } else {
         return Collections.emptyList();
      }
   }

   @Override
   public Map<String, FlightHourData> getFlightHourData(String aircraftId) {
      Map<String, FlightHourData> flightHourData = new HashMap<>();
      for (Flight flight : getFlights(aircraftId)) {
         flightHourData.put(flight.getId(), flight.getFlightHourData());
      }
      return flightHourData;
   }

   private void computeFlightStatus(final Set<Flight> flights) {
      for (final Flight flight : flights) {
         long ackedAlarmNumber = 0;
         long allAlarmNumber = 0;

         final Map<AlarmStatus, Long> alarmStatusCounts = retrieveAlarmStatus(flight);
         for (final Entry<AlarmStatus, Long> alarmStatusCount : alarmStatusCounts.entrySet()) {
            if (alarmStatusCount.getKey() == AlarmStatus.ACK) {
               ackedAlarmNumber = alarmStatusCount.getValue();
            }
            allAlarmNumber += alarmStatusCount.getValue();
         }

         if (allAlarmNumber == 0) {
            flight.setFlightStatus(FlightStatus.EMPTY);
         } else if (ackedAlarmNumber == 0) {
            flight.setFlightStatus(FlightStatus.RED);
         } else if (allAlarmNumber == ackedAlarmNumber) {
            flight.setFlightStatus(FlightStatus.GREEN);
         } else {
            flight.setFlightStatus(FlightStatus.AMBER);
         }
      }
   }

   private Map<AlarmStatus, Long> retrieveAlarmStatus(final Flight flight) {
      final Map<AlarmStatus, Long> alarmCountPerStatusMap = new EnumMap<>(AlarmStatus.class);
      alarmCountPerStatusMap.put(AlarmStatus.ACK, 0L);
      alarmCountPerStatusMap.put(AlarmStatus.NOTACK, 0L);
      alarmCountPerStatusMap.put(AlarmStatus.CLOSEMONITORED, 0L);

      for (final Alarm alarm : flight.getAlarms()) {
         final AlarmStatus status = alarm.getAlarmStatus();
         alarmCountPerStatusMap.put(status, alarmCountPerStatusMap.get(status) + 1L);
      }

      return alarmCountPerStatusMap;
   }

   @Override
   public AircraftConfiguration getConfiguration(final String flightId) throws EntityNotFoundException {
      return configurationDao.findConfigurationByFlight(flightId);
   }

   @Override
   public void purgeFlights(List<String> aircraftsId, boolean isAuto) throws AircraftConcurrentAccessException, NotificationException {
      long start;
      long end;
      long duration;
      for (final String aircraftId : aircraftsId) {
         Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
         start = System.currentTimeMillis();
         LOGGER.info("Start the purge operation for the aircraft {}, SN : {}", aircraft.getAircraftType().getName(), aircraft.getAircraftId());
         aircraftLockManager.lock(aircraftId, LockCause.AIRCRAFT_PURGE);
         try {
            final PurgeType purgeType = isAuto ? PurgeType.FLIGHT_AUTO : PurgeType.FLIGHT_MANUAL;
            PurgeRequest purgeRequest = new PurgeRequest(purgeType, Collections.singletonList(aircraftId));
            asyncQueue.addTask(purgeRequest);
         } finally {
            aircraftLockManager.unlock(aircraftId);
         }
         end = System.currentTimeMillis();
         duration = end - start;
         LOGGER.info("End the purge operation for the aircraft {}, SN : {} in {} ms.", aircraft.getAircraftType().getName(), aircraft.getAircraftId(), duration);
      }
   }

   @Override
   public Set<Folder> getDownloadedFolders() {
      return new HashSet<>(manager.createNamedQuery("findFolders", Folder.class).getResultList());
   }
}


