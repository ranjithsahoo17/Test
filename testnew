   /**
    * @param originalAircraft
    * @param aircraftProperties
    * @param context
    * @throws AircraftManagementException
    * @throws EntityNotFoundException
    * @throws NotificationException
    * @throws AircraftConcurrentAccessException
    *            if the aircraft lock could not be released
    */
   private ImportAttachResult manageAircraft(Aircraft originalAircraft, GroundStation groundStation, Map<String, Object> aircraftProperties, List<Map<String, Object>> flightsProperties, File folder,
         Context context, ImportAttachOperation operation) throws AircraftManagementException, EntityNotFoundException, NotificationException {

      Map<Object, Object> entityMap = new HashMap<>();

      // --- GENERAL ---
      final String aircraftId = originalAircraft.getId();
      Aircraft aircraftForNotification = new Aircraft(aircraftId);
      aircraftForNotification.setAttachmentDate(originalAircraft.getAttachmentDate());

      LOGGER.info("Import A/C general data.");

      aircraftProperties.put("id", aircraftId);
      aircraftProperties.put("ground_station_id", groundStation.getBaseName());
      aircraftProperties.put("state", AircraftState.ACTIVE.name());
      Map<String, Object> aircraftBasicProperties = buildBasicAircraftProperties(aircraftProperties);

      saveAircraftBasicProperties(originalAircraft, aircraftBasicProperties);
      try {
         manager.flush();
         manager.clear();
      } catch (PersistenceException e) {
         LOGGER.error("Unable to save aircraft data", e.getCause());
         throw new AircraftManagementException("Unable to save aircraft");
      } catch (Exception e) {
         LOGGER.error("Unable to save aircraft data", e);
         throw new AircraftManagementException("Unable to save aircraft");
      }

      originalAircraft = manager.find(Aircraft.class, aircraftId);
      if (operation == ImportAttachOperation.ATTACH_ON_REMOTE_BASE) {
         originalAircraft.setAttachmentDate(Calendar.getInstance(TimeZone.getTimeZone("GMT")).getTime());
      } else if (operation == ImportAttachOperation.ATTACH_ON_HOME_BASE) {
         originalAircraft.setAttachmentDate(null);
      }
      if (operation == ImportAttachOperation.IMPORT) {
         originalAircraft.setVersion(originalAircraft.getVersion());
      }

      progressManager.notifyProgress(context, originalAircraft, Progress.START);

      entityMap.put(originalAircraft.getAircraftType(), originalAircraft.getAircraftType());
      entityMap.put(originalAircraft.getGroundStation(), originalAircraft.getGroundStation());

      readImportSql(folder, "aircraft-full-import");

      for (Map<String, Object> flightProperties : flightsProperties) {
         persistFlight(folder, aircraftId, flightProperties);
      }

      aircraftDao.flush();

      saveAircraftAdvancedProperties(originalAircraft, aircraftProperties);

      aircraftDao.flush();
      aircraftDao.clear();

      LOGGER.info("Finalize and notify A/C import.");

      Aircraft aircraft = aircraftDao.findById(aircraftId);
      // compute the status of the aircraft
      aircraftDao.updateAircraftStatus(aircraft);

      aircraftDao.flush();

      synchronizationManager.merge(aircraftForNotification, aircraft, entityMap);
      // On import/attach, HSA data shall not be sent to the client
      aircraftForNotification.setFlights(new HashSet<>());
      aircraftForNotification.setDownloads(new HashSet<>());
      aircraft.getAccelerometers().size();
      aircraftForNotification.setAccelerometers(aircraft.getAccelerometers());

      ImportAttachResult importAttachResult;
      if (operation == ImportAttachOperation.ATTACH_ON_REMOTE_BASE || operation == ImportAttachOperation.IMPORT) {
         importAttachResult = new ImportAttachResult(aircraftForNotification, Action.CREATION);
      } else {
         importAttachResult = new ImportAttachResult(aircraftForNotification, Action.UPDATE);
      }

      // Notify aircraft configuration creation (without child configurations)
      for (AircraftConfiguration aircraftConfigurationStub : configurationDao.findConfigurations(aircraftId)) {
         AircraftConfiguration aircraftConfiguration = manager.find(AircraftConfiguration.class, aircraftConfigurationStub.getId());
         AircraftConfiguration configuration = new AircraftConfiguration(aircraftConfiguration.getId());
         configuration.setAircraft(new Aircraft(aircraftConfiguration.getAircraft().getId()));
         configuration.setSerialNumber(aircraftConfiguration.getSerialNumber());
         configuration.setApplicableDate(aircraftConfiguration.getApplicableDate());
         configuration.setAvionicVersion(aircraftConfiguration.getAvionicVersion());
         configuration.setDmauVersion(aircraftConfiguration.getDmauVersion());
         // Leave configuration map uninitialized.
         importAttachResult.getAircraftConfigurations().add(aircraftConfiguration);
      }

      // Notify folder creation
      importAttachResult.getFolders().addAll(aircraft.getFolders());

      progressManager.disposeContext();

      return importAttachResult;
   }

   private void persistFlight(File aircraftFolder, final String aircraftId, Map<String, Object> flightProperties)
         throws AircraftManagementException {
      String oldFlightId = flightProperties.get("id").toString();
      Map<String, Object> basicFlightProperties = buildBasicFlightProperties(flightProperties);
      String newFlightId = basicFlightProperties.get("id").toString();
      basicFlightProperties.put("id", newFlightId);
      basicFlightProperties.put(AIRCRAFT_IDENTIFIER_KEY, aircraftId);
      File flightFolder = new File(aircraftFolder, "flight-" + oldFlightId);

      if (flightFolder.exists()) {
         // Flight folder may be missing (re-attach on home base for instance)
         saveFlightBasicProperties(basicFlightProperties);
         removeDuplicateDownloads(newFlightId, flightFolder);
         importFlightData(newFlightId, flightFolder);
         saveFlightAdvancedProperties(newFlightId, flightProperties);
      }
   }

   private void removeDuplicateDownloads(String newFlightId, File flightFolder) {
      File csvFile = new File(flightFolder, "downloads_flights.csv");
      CsvParser parser = getCsvParser();
      List<String[]> allLines = parser.parseAll(csvFile);
      if (allLines.isEmpty()) {
         return;
      }
      List<Integer> columnIndexes = new ArrayList<>();
      fillColumnIndexes(allLines, columnIndexes);
      List<String[]> actualLines = new ArrayList<>();
      actualLines.add(allLines.get(0));
      int downloadIdIndex = Arrays.asList(allLines.get(0)).indexOf("download_id");
      for (int i = 1; i < allLines.size(); ++i) {
         Query checkDownloadFlightExistsQuery = manager.createNativeQuery("SELECT * FROM downloads_flights WHERE download_id = ? AND flight_id = ?");
         checkDownloadFlightExistsQuery.setParameter(1, allLines.get(i)[downloadIdIndex]);
         checkDownloadFlightExistsQuery.setParameter(2, newFlightId);
         boolean downloadFlightNotFound = checkDownloadFlightExistsQuery.getResultList().isEmpty();
         if (downloadFlightNotFound) {
            // Copy only if not exists, in order to avoid duplicated PK
            actualLines.add(allLines.get(i));
         }
      }

      CsvWriterSettings writerSettings = buildWriterSettings();
      CsvWriter writer = new CsvWriter(csvFile, writerSettings);
      writer.writeStringRowsAndClose(actualLines);
   }

