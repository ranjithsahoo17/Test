
package com.eurocopter.mgs.presentation.configuration.store.dialog;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.Map.Entry;

import org.eclipse.jface.window.Window;
import org.osgi.framework.BundleContext;
import org.osgi.framework.FrameworkUtil;

import com.eurocopter.mgs.business.flight.api.IFlightBusiness;
import com.eurocopter.mgs.datamodel.aircraft.Aircraft;
import com.eurocopter.mgs.datamodel.flight.Flight;
import com.eurocopter.mgs.presentation.download.list.FlightComparator;
import com.eurocopter.mgs.service.aircraft.dto.AircraftConfigurationHistoryDto;

public class MgsPreferenceDialogHandler {

   private final Map<AircraftConfigurationHistoryDto, Flight> applicableFlight = new HashMap<>();

   private final Map<AircraftConfigurationHistoryDto, Boolean> okCancels = new HashMap<>();

   public boolean getOkCancel(AircraftConfigurationHistoryDto configurationHistorizationDto) {
      return okCancels.get(configurationHistorizationDto);
   }

   public Flight getApplicableFlight(AircraftConfigurationHistoryDto configurationHistorizationDto) {
      return applicableFlight.get(configurationHistorizationDto);
   }

   public void openDialog(Map<Aircraft, AircraftConfigurationHistoryDto> aircraftConfigurationHistoryMap) {
      boolean okCancel = false;
      MgsPreferenceDialogModel mgsPreferenceDialogModel = new MgsPreferenceDialogModel();
      BundleContext flightBusinessContext = FrameworkUtil.getBundle(IFlightBusiness.class).getBundleContext();
      IFlightBusiness flightBusiness = flightBusinessContext
            .getService(flightBusinessContext.getServiceReference(IFlightBusiness.class));

      for (Entry<Aircraft, AircraftConfigurationHistoryDto> aircraftConfiguration : aircraftConfigurationHistoryMap
            .entrySet()) {
         List<Flight> flights = new ArrayList<>();
         flights.addAll(flightBusiness.getFlights(aircraftConfiguration.getKey().getId(), true));
         flights.sort(new FlightComparator());

         mgsPreferenceDialogModel.setAircraft(aircraftConfiguration.getKey());
         mgsPreferenceDialogModel.setFlights(flights);
         MgsPreferenceDialog mgsPreferenceDialog = new MgsPreferenceDialog(mgsPreferenceDialogModel);
         if (mgsPreferenceDialog.open() == Window.OK) {
            okCancel = true;
            applicableFlight.put(aircraftConfiguration.getValue(),
                  mgsPreferenceDialogModel.getSelectedFlight());
         }
         okCancels.put(aircraftConfiguration.getValue(), okCancel);
      }
   }
}
