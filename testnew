package com.eurocopter.mgs.business.health.impl;

import com.eurocopter.mgs.datamodel.health.monitoring.IndicatorDeviation;
import com.eurocopter.mgs.datamodel.health.monitoring.LearnedThresholdConfiguration;
import com.eurocopter.mgs.datamodel.health.monitoring.ThresholdLevel;

/**
 * BCR-6605 the parameters the learning algorithm needs, resolved from the configuration
 */
public record LearningParameters(long learningTime, double meanFactor, Double deviationCoefficient, Double minimumDeviation, ThresholdLevel thresholdLevel, Double minimumThreshold,
      double maximumThreshold) {
   /** The configured parameters of a learned threshold, with any deviated value taking over. */
   public static LearningParameters of(LearnedThresholdConfiguration configuration, IndicatorDeviation deviation) {
      long learningTime = configuration.getLearningTime();
      double meanFactor = configuration.getMeanFactor();
      Double deviationCoefficient = configuration.getDeviationCoefficient();
      Double minimumDeviation = configuration.getMinimumDeviation();
      ThresholdLevel level = configuration.getThresholdLevel();
      Double min = configuration.getMinimumThreshold();
      double max = configuration.getMaximumThreshold();
      if (deviation != null) {
         if (deviation.getLearningTime() != null) {
            learningTime = deviation.getLearningTime();
         }
         if (deviation.getMeanFactor() != null) {
            meanFactor = deviation.getMeanFactor();
         }
         if (deviation.getDeviationCoefficient() != null) {
            deviationCoefficient = deviation.getDeviationCoefficient();
         }
         if (deviation.getMinimumDeviation() != null) {
            minimumDeviation = deviation.getMinimumDeviation();
         }
         if (deviation.getThresholdLevel() != null) {
            level = ThresholdLevel.valueOf(deviation.getThresholdLevel());
         }
         if (deviation.getMinValue() != null) {
            min = deviation.getMinValue();
         }
         if (deviation.getMaxValue() != null) {
            max = deviation.getMaxValue();
         }
      }
      return new LearningParameters(learningTime, meanFactor, deviationCoefficient, minimumDeviation, level, min, max);
   }

   /**
    * The parameters of a threshold that is learned only because a deviation says so. Everything * comes from the deviation; the fixed configuration has none of these values.
    */
   public static LearningParameters ofDeviationOnly(IndicatorDeviation deviation, ThresholdLevel configuredLevel) {
      return new LearningParameters(deviation.getLearningTime() != null ? deviation.getLearningTime() : 0L, deviation.getMeanFactor() != null ? deviation.getMeanFactor() : 1d,
            deviation.getDeviationCoefficient(), deviation.getMinimumDeviation(), deviation.getThresholdLevel() != null
                  ? ThresholdLevel.valueOf(deviation.getThresholdLevel())
                  : configuredLevel,
            deviation.getMinValue(), deviation.getMaxValue() != null ? deviation.getMaxValue() : Double.MAX_VALUE);
   }
}
