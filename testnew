   public void performApply() {
      healthAlarmsPreferenceStore.innerSave();
      try {
         MgsPreferenceStoreManager.saveAircraftConfigurations();
         /*
          * if (MgsPreferenceStoreManager.wasLastSaveConfirmed()) { healthAlarmsPreferenceStore.saveDeviations(); }
          */
         healthAlarmsPreferenceStore.saveDeviations();
         List<String> deviated = healthAlarmsPreferenceStore.getLastSavedDeviationIndicatorNames();
         if (!deviated.isEmpty()) {
            MessageDialog.openInformation(getShell(),
                  Messages.CORE.getString("deviation.created.title"),
                  Messages.CORE.getString("deviation.created.message") + " " + String.join(", ", deviated));
         }

         MgsPreferenceStoreManager.clearAircraftConfigurations();
         // BCR-6605 refresh the tree and both deviation tabs so the saved rows turn green
         reloadAll();
      } catch (Exception e) {
         LOGGER.error("Error while saving health preferences", e);
      }
   }

   /**
    * Validate data before setting them.
    * 
    * @return true if data are valid, false otherwise
    */
   public boolean isValidData() {
      return healthAlarmsPreferenceStore.isValidData(healthWcModelMap);
   }

   /**
    * Perform Defaults for the preference page.
    */
   public void performDefaults() {
      if (selectedAircraft != null) {
         healthWcModelMap.clear();
         refreshViewer(selectedAircraft, healthAlarmsPreferenceStore.loadHealthModels(selectedAircraft));
      }
   }

   /**
    * Cancel was pressed.
    */
   public void performCancel() {
      // empty the store, otherwise data will be saved because of our handling of needSaving method.
      healthAlarmsPreferenceStore.emptyData();
   }

   /**
    * BCR-6605 reload the tree and both deviation tabs.
    */
   private void reloadAll() {
      if (selectedAircraft == null) {
         return;
      }
      healthWcModelMap.clear();
      refreshViewer(selectedAircraft, healthAlarmsPreferenceStore.loadHealthModels(selectedAircraft));
      deviationListComposite.setAircraft(selectedAircraft);
      deviationHistoryComposite.setAircraft(selectedAircraft);
   }

   public void openFilteringLawDialog() {
      if (selectedAircraft != null) {
         new FilteringLawDialog(healthAlarmsPreferenceStore, selectedAircraft).open();
         reloadAll();
      }
   }

