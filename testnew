   private void mergeAircraftTable(String tableName, Class<?> clazz, UuidMapping mapping, String filename, File folder, String idColumn, String... keyColumns) throws AircraftManagementException {
      Properties tableColumns = new Properties();
      try {
         tableColumns.load(AircraftImportService.class.getResourceAsStream("/sql/aircraft-identifiers.properties"));
      } catch (IOException e) {
         throw new AircraftManagementException("Unable to load aircraft mapping", e);
      }
      Set<String> booleanColumns = getSpecificColumns(tableName, "boolean-columns.properties");
      Set<String> integerColumns = getSpecificColumns(tableName, "integer-columns.properties");
      Set<String> dateColumns = getSpecificColumns(tableName, "date-columns.properties");
      String[] columnNamesArray = tableColumns.getProperty(tableName).split(",");
      Set<String> identifierColumns = new HashSet<>(Arrays.asList(columnNamesArray));

      File csvFile = new File(folder, filename + ".csv");
      CsvParser parser = getCsvParser();
      List<String[]> allLines = parser.parseAll(csvFile);

      List<Integer> columnIndexes = new ArrayList<>();
      fillColumnIndexes(allLines, columnIndexes);

      int idColumnIndex = Arrays.asList(allLines.get(0)).indexOf(idColumn);
      Map<String, Integer> keyColumnIndexes = new LinkedHashMap<>();
      List<String> whereClauses = new ArrayList<>();
      for (String keyColumn : keyColumns) {
         keyColumnIndexes.put(keyColumn, Arrays.asList(allLines.get(0)).indexOf(keyColumn));
         whereClauses.add(tableName + "." + keyColumn + "::character varying = ? ");
      }
      String whereClause = Joiner.on(" AND ").join(whereClauses);

      List<String[]> actualLines = new ArrayList<>();
      actualLines.add(allLines.get(0));
      for (int i = 1; i < allLines.size(); ++i) {
         String formattedLine = "SELECT " + idColumn + " FROM " + tableName + " WHERE " + whereClause;
         Query query = manager.createNativeQuery(formattedLine);
         int j = 1;
         for (Map.Entry<String, Integer> entry : keyColumnIndexes.entrySet()) {
            query.setParameter(j, allLines.get(i)[entry.getValue()]);
            ++j;
         }
         @SuppressWarnings("unchecked")
         List<String> resultList = query.getResultList();
         if (resultList.isEmpty()) {
            // Object does not exist, keep it in CSV file
            actualLines.add(allLines.get(i));
            mapping.put(allLines.get(i)[idColumnIndex], allLines.get(i)[idColumnIndex]);
            continue;
         }
         String currentId = resultList.get(0);
         mapping.put(allLines.get(i)[idColumnIndex], currentId);
         // Do not add the line, it already exists in DB, but need to update fields
         List<String> updateClauses = new ArrayList<>();
         for (String columnName : allLines.get(0)) {
            if (dateColumns.contains(columnName)) {
               updateClauses.add(columnName + " = ?::timestamp without time zone");
            } else {
               updateClauses.add(columnName + " = ?");
            }
         }
         String updateClause = Joiner.on(", ").join(updateClauses);
         String updateQueryStr = "UPDATE " + tableName + " SET " + updateClause + " WHERE " + idColumn + " = ?";
         Query updateQuery = manager.createNativeQuery(updateQueryStr);
         for (int k = 0; k < allLines.get(0).length; ++k) {
            String columnName = allLines.get(0)[k];
            final Object columnValue;
            if (booleanColumns.contains(columnName)) {
               // 't' and 'f' are not accepted by JPQL
               columnValue = toBoolean(allLines.get(i)[k]);
            } else if (integerColumns.contains(columnName)) {
               columnValue = toInteger(allLines.get(i)[k]);
            } else if (identifierColumns.contains(columnName)) {
               if (mapping.contains(allLines.get(i)[k])) {
                  columnValue = mapping.get(allLines.get(i)[k]);
               } else {
                  columnValue = allLines.get(i)[k];
               }
            } else {
               columnValue = allLines.get(i)[k];
            }
            updateQuery.setParameter(k + 1, columnValue);
         }
         updateQuery.setParameter(allLines.get(0).length + 1, currentId);
         updateQuery.executeUpdate();
         manager.getEntityManagerFactory().getCache().evict(clazz, currentId);
         manager.refresh(manager.find(clazz, currentId));
      }
      setRemainingColumnsToNull(actualLines, columnIndexes);

      CsvWriterSettings writerSettings = buildWriterSettings();
      CsvWriter writer = new CsvWriter(csvFile, writerSettings);
      writer.writeStringRowsAndClose(actualLines);
   }

   private Object toInteger(String str) {
      if (str == null) {
         return null;
      }
      return Integer.valueOf(str);
   }

   private Set<String> getSpecificColumns(String tableName, String filename) throws AircraftManagementException {
      Properties booleanColumnsProperties = new Properties();
      try {
         booleanColumnsProperties.load(AircraftImportService.class.getResourceAsStream("/sql/" + filename));
      } catch (IOException e) {
         throw new AircraftManagementException("Unable to load boolean columns", e);
      }
      Set<String> booleanColumns = new HashSet<>();
      if (booleanColumnsProperties.containsKey(tableName)) {
         booleanColumns.addAll(Arrays.asList(booleanColumnsProperties.getProperty(tableName).split(",")));
      }
      return booleanColumns;
   }

   private Object toBoolean(String str) {
      if ("t".equals(str)) {
         return true;
      }
      if ("f".equals(str)) {
         return false;
      }
      return null;
   }

   private void fillColumnIndexes(List<String[]> allLines, List<Integer> columnIndexes) {
      for (int i = 0; i < allLines.get(0).length; ++i) {
         columnIndexes.add(i);
      }
   }

   private void applyColumnMapping(UuidMapping mapping, String[] columnNames, List<String[]> allLines, List<Integer> columnIndexes) {
      for (String columnName : columnNames) {
         int columnIndex = Arrays.asList(allLines.get(0)).indexOf(columnName);
         columnIndexes.remove(Integer.valueOf(columnIndex));
         for (int i = 1; i < allLines.size(); ++i) {
            String value = allLines.get(i)[columnIndex];
            if (value == null || value.isEmpty()) {
               allLines.get(i)[columnIndex] = null;
            } else {
               allLines.get(i)[columnIndex] = mapping.getOrCreate(value);
            }
         }
      }
   }

   private void setRemainingColumnsToNull(List<String[]> allLines, List<Integer> columnIndexes) {
      for (int i = 1; i < allLines.size(); ++i) {
         String[] ithLine = allLines.get(i);
         for (int columnIndex : columnIndexes) {
            if (ithLine != null && ithLine[columnIndex] != null && ithLine[columnIndex].isEmpty()) {
               ithLine[columnIndex] = null;
            }
         }
      }
   }

