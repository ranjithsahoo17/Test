/**
 * Preference store for health alarms.
 */
public class HealthAlarmsPreferenceStore extends MgsPreferenceStore {

   private static final Logger LOGGER = LogManager.getLogger(HealthAlarmsPreferenceStore.class);
   /** data. */
   private Map<Aircraft, WCMechanicalComponentModel> data = new HashMap<>();

   /**
    * List of MCModels
    */
   private WCMechanicalComponentModel rootMechanicalComponents;

   // field, beside lawNameToId
   private final Map<String, String> indicatorDisplayNames = new HashMap<>();

   private final Map<String, String> lawNameToId = new HashMap<>();

   /** Composite parent. */
   private final HealthAlarmsComposite parent;

   private final BundleContext healthBundleContext = FrameworkUtil.getBundle(IHealthCommonBusiness.class)
         .getBundleContext();
   private final IHealthCommonBusiness healthBusiness = healthBundleContext
         .getService(healthBundleContext.getServiceReference(IHealthCommonBusiness.class));

   private final List<String> lastSavedDeviationIndicatorNames = new ArrayList<>();

   private static final Comparator<Severity> SEVERITY_COMPARATOR = (severity1, severity2) -> {
      if (severity1 == severity2) {
         return 0;
      }
      if (severity1 == Severity.RED) {
         return -1;
      }
      return 1;
   };

   /**
    * Constructor with argument. Builds a HealthAlarmsPreferenceStore.
    */
   public HealthAlarmsPreferenceStore(HealthAlarmsComposite parent) {
      this.parent = parent;
   }

   /**
    * Initialize the original mechanical component data.
    * 
    * @param aircraft
    *           the aircraft model
    */
   public void initMechanicalComponentData(Aircraft aircraft) {
      retrieveAircraftMechanicalComponents(aircraft);
   }

   @Override
   public boolean needsSaving() {
      return !data.isEmpty();
   }

   @Override
   public void innerLoad() {
   }

   @Override
   public void innerSave() {

      for (Entry<Aircraft, WCMechanicalComponentModel> modelEntry : data.entrySet()) {
         Aircraft aircraft = modelEntry.getKey();
         HealthMonitoringConfiguration configuration;
         AircraftConfigurationHistoryDto aircraftConfigurationHistoryDto;
         try {
            configuration = getConfiguration(aircraft);
            aircraftConfigurationHistoryDto = MgsPreferenceStoreManager.getAircraftConfigurationDto(aircraft);
         } catch (EntityNotFoundException e) {
            LOGGER.warn("Entity not found exception", e);
            AircraftConcurrentAccessException wrapper = new AircraftConcurrentAccessException(aircraft, true);
            StatusManager.getManager().handle(AircraftExceptionHandler.getStatusForAircraftException(wrapper, "update", Activator.PLUGIN_ID), StatusManager.SHOW);
            continue;
         }
         // Retrieve the root node element
         WCMechanicalComponentModel wcModel = modelEntry.getValue();

         // Create maps to associate JPA entities with WC* instances
         Map<HealthMechanicalComponent, WCHealthMechanicalComponentModel> wcMechanicalComponentModels = new HashMap<>();
         Map<Indicator, Set<WCThresholdModel>> thresholdModels = new HashMap<>();
         getModels(wcModel, wcMechanicalComponentModels, thresholdModels);

         for (Map.Entry<HealthMechanicalComponent, HealthMechanicalComponentConfiguration> mcEntry : configuration.getMechanicalComponentConfigurations().entrySet()) {
            HealthMechanicalComponent mechanicalComponent = mcEntry.getKey();
            MechanicalComponentConfigurationDto mechanicalComponentConfigurationDto = new MechanicalComponentConfigurationDto(mechanicalComponent.getId());
            WCHealthMechanicalComponentModel mechanicalComponentModel = wcMechanicalComponentModels.get(mechanicalComponent);
            mechanicalComponentConfigurationDto.setWorkcardReference(mechanicalComponentModel.getWorkcardReference());
            mechanicalComponentConfigurationDto.setMaxTimeWOAcquisition(mechanicalComponentModel.getMaxtimeWithoutAcquitision());

            for (Map.Entry<Indicator, IndicatorConfiguration> indicatorEntry : mcEntry.getValue().getIndicatorConfigurations().entrySet()) {
               Indicator indicator = indicatorEntry.getKey();
               if (!thresholdModels.containsKey(indicator)) {
                  // This indicator is likely inactive and has no current configuration to copy continue;
               }
               Set<WCThresholdModel> indicatorThresholdModels = thresholdModels.get(indicator);
               IndicatorConfigurationDto indicatorConfigurationDto = new IndicatorConfigurationDto(indicator.getId());
               for (WCThresholdModel wcThresholdModel : indicatorThresholdModels) {
                  if (wcThresholdModel.isEnabled()) {
                     // BCR-6605 deviation fields from the baseline, configuration fields as edited
                     final WCThresholdBaseline baseline = wcThresholdModel.getBaseline() != null
                           ? wcThresholdModel.getBaseline()
                           : new WCThresholdBaseline(wcThresholdModel, wcThresholdModel.getFilteringLawName());
                     final ThresholdConfigurationDto thresholdConfigurationDto;
                     if (baseline.getType() == ThresholdType.FIXED) {
                        thresholdConfigurationDto = new ThresholdConfigurationDto(
                              wcThresholdModel.getSeverity(), baseline.getLevel(), baseline.getType(),
                              wcThresholdModel.getDefaultValue(),
                              wcThresholdModel.getNbSuccessivePoints(),
                              wcThresholdModel.getMinimumEngineOilTemperature());
                     } else {
                        thresholdConfigurationDto = new ThresholdConfigurationDto(
                              wcThresholdModel.getSeverity(), baseline.getLevel(), baseline.getType(),
                              wcThresholdModel.getLearningTime(),
                              baseline.getMinValue(), baseline.getMaxValue(),
                              wcThresholdModel.getDefaultValue(), wcThresholdModel.getMinimumDeviation(),
                              wcThresholdModel.getMeanFactor(), wcThresholdModel.getDeviationCoefficient(),
                              wcThresholdModel.getNbSuccessivePoints(),
                              wcThresholdModel.getMinimumEngineOilTemperature());
                     }
                     thresholdConfigurationDto.setWorkcard(baseline.getWorkCardReference());
                     indicatorConfigurationDto.getThresholdConfigurationDtos().add(thresholdConfigurationDto);
                  }
               }

               mechanicalComponentConfigurationDto.getIndicatorConfigurationDtos().add(indicatorConfigurationDto);
            }
            aircraftConfigurationHistoryDto.getMechanicalComponentConfigurations()
                  .add(mechanicalComponentConfigurationDto);
         }

         aircraftConfigurationHistoryDto.setIndicatorConfigurationUpdated(true);
      }
   }

   private void getModels(WCMechanicalComponentModel wcModel,
         Map<HealthMechanicalComponent, WCHealthMechanicalComponentModel> mechanicalComponents,
         Map<Indicator, Set<WCThresholdModel>> thresholdModels) {
      for (WCMechanicalComponentModel subModel : wcModel.getSubHealthWCModel()) {
         getModels(subModel, mechanicalComponents, thresholdModels);
      }
      for (WCHealthMechanicalComponentModel healthMechanicalComponentModel : wcModel.getHealthComponentModels()) {
         mechanicalComponents.put(healthMechanicalComponentModel.getHealthMechanicalComponent(),
               healthMechanicalComponentModel);
         for (WCThresholdModel wcThresholdModel : healthMechanicalComponentModel.getThresholdModels()) {
            if (!thresholdModels.containsKey(wcThresholdModel.getIndicator())) {
               thresholdModels.put(wcThresholdModel.getIndicator(), new HashSet<>());
            }
            thresholdModels.get(wcThresholdModel.getIndicator()).add(wcThresholdModel);
         }
      }
   }

   private HealthMonitoringConfiguration getConfiguration(Aircraft aircraft) throws EntityNotFoundException {
      try {
         return MgsPreferenceStoreManager.getConfiguration(aircraft, HealthMonitoringConfiguration.TYPE,
               HealthMonitoringConfiguration.class);
      } catch (EntityNotFoundException e) {
         LOGGER.error("Could not load health configuration for aircraft. Register number - Serial number = {}",
               aircraft.getRegisterNumber(), e);
         throw e;
      }
   }

   /**
    * Load data.
    * 
    * @param aircraft
    *           the specified aircraft
    * @return a list of health data
    */
   public WCMechanicalComponentModel loadHealthModels(Aircraft aircraft) {
      emptyData();
      retrieveAircraftMechanicalComponents(aircraft);
      // save it
      data.put(aircraft, rootMechanicalComponents);
      rootMechanicalComponents.setName(Messages.CORE.getString("Label.HealthComponents"));
      WCMechanicalComponentModel all = new WCMechanicalComponentModel();
      all.getSubHealthWCModel().add(rootMechanicalComponents);
      all.setName(Messages.CORE.getString("Label.HealthComponents"));
      return all;
   }

   /**
    * Retrieve the data related to an Aircraft.
    * 
    * @param aircraft
    *           the aircraft
    * @return the list of health data
    */
   public WCMechanicalComponentModel getHealthModels(Aircraft aircraft) {
      final WCMechanicalComponentModel result;
      if (data.containsKey(aircraft)) {
         result = data.get(aircraft);
      } else {
         // load it
         result = loadHealthModels(aircraft);
      }

      if (!Messages.CORE.getString("Label.HealthComponents").equals(result.getName())) {
         WCMechanicalComponentModel all = new WCMechanicalComponentModel();
         all.getSubHealthWCModel().add(result);
         all.setName(Messages.CORE.getString("Label.HealthComponents"));
         return all;
      }
      return result;

   }

   /**
    * Empty the data of the store.
    */
   public void emptyData() {
      data.clear();
   }

   /**
    * Indicates whether data are valid or not.
    * 
    * @param dataToBeValidated
    *           to be validated
    * @return true if data are valid, false otherwise
    */
   public boolean isValidData(Map<Aircraft, WCMechanicalComponentModel> dataToBeValidated) {

      // for each aircraft
      for (Entry<Aircraft, WCMechanicalComponentModel> entry : dataToBeValidated.entrySet()) {

         // retrieve the whole set of thresholds of the current aircraft
         Multimap<Indicator, WCThresholdModel> wcThresholdMap = getComponentThresholds(entry.getValue());
         for (Indicator indicator : wcThresholdMap.keySet()) {
            WCThresholdModel redModel = null;
            WCThresholdModel amberModel = null;
            for (WCThresholdModel currentModel : wcThresholdMap.get(indicator)) {
               switch (currentModel.getType()) {
                  case FIXED:
                     if (currentModel.getDefaultValue() == null) {
                        // fixed thresholds without value
                        MessageDialog.openError(parent.getShell(),
                              Messages.CORE.getString("healthAlarmPageDataInvalidTitle"),
                              MessageFormat.format(
                                    Messages.CORE.getMnemonicEscapedString("healthAlarmPageDataInvalidMessage"),
                                    entry.getKey().getRegisterNumber(),
                                    currentModel.getHealthMechanicalComponentName() + "/"
                                          + currentModel.getIndicator()
                                          + " (fixed threshold value cannot be undefined)"));
                        return false;
                     }
                     break;

                  case LEARNED:
                     if (currentModel.getMinValue() != null) {
                        final double min;
                        final double max;
                        if (currentModel.getLevel() == ThresholdLevel.HIGH) {
                           min = currentModel.getMinValue();
                           max = currentModel.getMaxValue();
                        } else {
                           min = currentModel.getMaxValue();
                           max = currentModel.getMinValue();
                        }
                        if (min >= max) {
                           MessageDialog.openError(parent.getShell(),
                                 Messages.CORE.getString("healthAlarmPageDataInvalidTitle"),
                                 MessageFormat.format(
                                       Messages.CORE
                                             .getMnemonicEscapedString("healthAlarmPageDataInvalidMessage"),
                                       entry.getKey().getRegisterNumber(),
                                       currentModel.getHealthMechanicalComponentName() + "/"
                                             + currentModel.getIndicator() + " (check min and max values)"));
                           return false;
                        }
                     }
                     break;
                  default:
                     throw new IllegalStateException("Unhandled threshold type : " + currentModel.getType());
               }
               if (currentModel.getSeverity() == Severity.RED) {
                  redModel = currentModel;
               } else {
                  amberModel = currentModel;
               }
            }

            if (redModel != null && amberModel != null) {

               boolean valid = true;
               if (amberModel.getDefaultValue() == null || redModel.getDefaultValue() == null) {
                  continue;
               } else if (amberModel.getLevel() == redModel.getLevel()) {
                  boolean highAmberHigherThanHighRed = amberModel.getLevel() == ThresholdLevel.HIGH
                        && amberModel.getDefaultValue() > redModel.getDefaultValue();
                  // threshold
                  boolean lowAmberSmallerThanLowRed = amberModel.getLevel() == ThresholdLevel.LOW
                        && amberModel.getDefaultValue() < redModel.getDefaultValue();
                  if (highAmberHigherThanHighRed || lowAmberSmallerThanLowRed) {
                     valid = false;
                  }
               } else if (amberModel.getLevel() == ThresholdLevel.HIGH
                     && amberModel.getDefaultValue() < redModel.getDefaultValue()) {
                  // threshold
                  valid = false;
               } else if ((redModel.getLevel() == ThresholdLevel.HIGH)
                     && (redModel.getDefaultValue() < amberModel.getDefaultValue())) {
                  // threshold
                  valid = false;
               }
               if (!valid) {
                  MessageDialog.openError(parent.getShell(),
                        Messages.CORE.getString("healthAlarmPageDataInvalidTitle"),
                        MessageFormat.format(
                              Messages.CORE.getMnemonicEscapedString("healthAlarmPageDataInvalidMessage"),
                              entry.getKey().getRegisterNumber(),
                              amberModel.getHealthMechanicalComponentName() + ">"
                                    + amberModel.getIndicator().getName()));
                  return false;
               }
            }
         }
      }

      List<WCThresholdModel> deviatedModels = new ArrayList<>();
      for (Entry<Aircraft, WCMechanicalComponentModel> entry : dataToBeValidated.entrySet()) {
         for (WCThresholdModel model : getComponentThresholds(entry.getValue()).values()) {
            if (model.isDeviated() || model.isModifiedAgainstBaseline()) {
               deviatedModels.add(model);
            }
         }
      }
      for (WCThresholdModel model : deviatedModels) {
         if (model.getTeReference() == null || model.getTeReference().trim().isEmpty()) {
            MessageDialog.openError(parent.getShell(),
                  Messages.CORE.getString("healthAlarmPageDataInvalidTitle"), MessageFormat.format(Messages.CORE.getString("deviationErrorTeMandatory"), model.getIndicator().getName()));
            return false;
         }
      }
      for (WCThresholdModel model : deviatedModels) {
         model.setDeviated(true);
      }
      this.data = dataToBeValidated;
      return true;
   }

   /**
    * Retrieve the list of the whole threshold models for a specific component.
    * 
    * @param component
    *           the component from which thresholds models have to be retrieved
    * @return a list of thresholds models
    */
   private Multimap<Indicator, WCThresholdModel> getComponentThresholds(WCMechanicalComponentModel component) {
      Multimap<Indicator, WCThresholdModel> thresholdModels = ArrayListMultimap.create();

      // add the list of thresholds models to the result, if they exist
      for (WCHealthMechanicalComponentModel healthMechanicalComponentModel : component.getHealthComponentModels()) {
         for (WCThresholdModel thresholdModel : healthMechanicalComponentModel.getThresholdModels()) {
            if (thresholdModel.isEnabled()) {
               thresholdModels.put(thresholdModel.getIndicator(), thresholdModel);
            }
         }
      }
      for (WCMechanicalComponentModel mechanicalComponentModel : component.getSubHealthWCModel()) {
         thresholdModels.putAll(getComponentThresholds(mechanicalComponentModel));
      }
      return thresholdModels;
   }

   /**
    * Retrieves the aircraft monitored mechanical components and indicators with their status from the data base.
    */
   private void retrieveAircraftMechanicalComponents(final Aircraft aircraft) {
      SafeRunnable.run(new SafeRunnable() {
         @Override
         public void run() {
            try {
               rootMechanicalComponents = createAllMechanicalComponents(aircraft).get("");
            } catch (EntityNotFoundException e) {
               LOGGER.error("Cannot find mechanical components for aircaft : {}", aircraft, e);
            }
         }
      });
   }

   /**
    * Build Health node Tree hierarchy
    */
   private Map<String, WCMechanicalComponentModel> createAllMechanicalComponents(final Aircraft aircraft)
         throws EntityNotFoundException {
      Map<String, WCMechanicalComponentModel> createdObjects = new HashMap<>();
      Map<Indicator, IndicatorModel> indicatorModels;
      try {
         indicatorModels = healthBusiness.getIndicatorModels(MgsSession.getInstance().getUser().getId(),
               aircraft.getId());
      } catch (EntityNotFoundException e1) {
         LOGGER.warn("Unable to retrieve indicator models", e1);
         return createdObjects;
      }

      Map<HealthMechanicalComponent, HealthMechanicalComponentConfiguration> hmcConfigurations = healthBusiness.getActiveComponentsAndConfiguration(aircraft.getId());
      Map<String, IndicatorDeviationDto> deviationMap = new HashMap<>();
      try {
         for (IndicatorDeviationDto dto : healthBusiness.findActiveDeviations(aircraft.getId())) {
            deviationMap.put(dto.getIndicatorId() + "|" + dto.getSeverity(), dto);
         }
      } catch (Exception e) {
         LOGGER.warn("Could not load active deviations", e);
      }

      for (Entry<HealthMechanicalComponent, HealthMechanicalComponentConfiguration> entry : hmcConfigurations
            .entrySet()) {
         HealthMechanicalComponent healthMechanicalComponent = entry.getKey();
         int position = healthMechanicalComponent.getPath()
               .lastIndexOf(HealthMechanicalComponent.HMC_PATH_SEPARATOR);
         String parentPath = healthMechanicalComponent.getPath().substring(0, position);
         WCMechanicalComponentModel parentComponent = createdObjects.get(parentPath);
         if (parentComponent == null) {
            parentComponent = createMechanicalComponent(parentPath, createdObjects);
         }
         // List<WCThresholdModel> thresholdModels = getThresholdModels(healthMechanicalComponent, indicatorModels);
         List<WCThresholdModel> thresholdModels = getThresholdModels(healthMechanicalComponent,
               indicatorModels, entry.getValue().getIndicatorConfigurations(), deviationMap);
         WCHealthMechanicalComponentModel wcModel = new WCHealthMechanicalComponentModel(healthMechanicalComponent,
               thresholdModels, entry.getValue().getWorkcard(),
               entry.getValue().getMaximumTimeWithoutAcquistion());
         parentComponent.getHealthComponentModels().add(wcModel);
      }
      return createdObjects;
   }

   private WCMechanicalComponentModel createMechanicalComponent(String path,
         Map<String, WCMechanicalComponentModel> createdObjects) {
      int position = path.lastIndexOf(HealthMechanicalComponent.HMC_PATH_SEPARATOR);
      WCMechanicalComponentModel newMCModel = new WCMechanicalComponentModel();
      newMCModel.setName(path.substring(position + 1));
      createdObjects.put(path, newMCModel);
      if (position >= 0) {
         String parentPath = path.substring(0, position);
         WCMechanicalComponentModel parentComponent = createdObjects.get(parentPath);
         if (parentComponent == null) {
            parentComponent = createMechanicalComponent(parentPath, createdObjects);
         }
         parentComponent.getSubHealthWCModel().add(newMCModel);
      }
      return newMCModel;
   }

   private List<WCThresholdModel> getThresholdModels(HealthMechanicalComponent healthMechanicalComponent,
         Map<Indicator, IndicatorModel> indicatorModels, Map<Indicator, IndicatorConfiguration> indicatorConfigurations,
         Map<String, IndicatorDeviationDto> deviationMap) {
      Severity[] severities = { Severity.RED, Severity.AMBER };
      List<WCThresholdModel> hmcThresholdModels = new ArrayList<>();
      boolean odd = true;

      Set<Indicator> sortedSet = new TreeSet<>((i1, i2) -> i1.getName().compareTo(i2.getName()));
      sortedSet.addAll(healthMechanicalComponent.getIndicators().values());
      for (Indicator indicator : sortedSet) {
         Map<Severity, WCThresholdModel> indicatorThresholdsMap = new TreeMap<>(SEVERITY_COMPARATOR);
         IndicatorModel indicatorModel = indicatorModels.get(indicator);
         String path = healthMechanicalComponent.getPath().replace(String.valueOf(HealthMechanicalComponent.HMC_PATH_SEPARATOR), " - ");
         if (path.startsWith(" - ")) {
            path = path.substring(3);
         }
         indicatorDisplayNames.put(indicator.getId(), path + " - " + indicator.getName());
         for (WCThresholdModel thresholdModel : indicatorModel.getThresholdModels()) {
            thresholdModel.setOdd(odd);
            indicatorThresholdsMap.put(thresholdModel.getSeverity(), thresholdModel);
         }
         for (Severity severity : severities) {
            if (!indicatorThresholdsMap.containsKey(severity)) {
               WCThresholdModel thresholdModel = new WCThresholdModel(indicator,
                     healthMechanicalComponent.getFunctionalId());
               thresholdModel.setSeverity(severity);
               thresholdModel.setOdd(odd);
               indicatorThresholdsMap.put(severity, thresholdModel);
            }
         }
         // stored deviation
         IndicatorConfiguration indicatorConfiguration = indicatorConfigurations.get(indicator);
         String law = indicatorConfiguration != null ? indicatorConfiguration.getFilteringLaw() : null;
         String icId = indicatorConfiguration != null ? indicatorConfiguration.getId() : null;
         Integer points = indicatorConfiguration != null ? indicatorConfiguration.getMaxPointsPerHour() : null;
         for (WCThresholdModel thresholdModel : indicatorThresholdsMap.values()) {
            thresholdModel.setFilteringLawName(law);
            thresholdModel.setIndicatorConfigurationId(icId);
            thresholdModel.setMaxPointsPerHour(points);
            thresholdModel.setBaseline(new WCThresholdBaseline(thresholdModel, law));
            IndicatorDeviationDto deviation = deviationMap.get(indicator.getId() + "|" + thresholdModel.getSeverity().name());
            if (deviation != null) {
               thresholdModel.setDeviated(true);
               thresholdModel.setDeviationId(deviation.getId());
               thresholdModel.setTeReference(deviation.getTeReference());
               thresholdModel.setDeviationStartDate(deviation.getStartDate());
               thresholdModel.setDeviationEndDate(deviation.getEndDate());
               if (deviation.getThresholdLevel() != null) {
                  thresholdModel.setLevel(ThresholdLevel.valueOf(deviation.getThresholdLevel()));
               }
               if (deviation.getThresholdType() != null) {
                  thresholdModel.setType(ThresholdType.valueOf(deviation.getThresholdType()));
               }
               if (deviation.getThresholdValue() != null) {
                  thresholdModel.setDefaultValue(deviation.getThresholdValue());
               }
               if (deviation.getMinValue() != null) {
                  thresholdModel.setMinValue(deviation.getMinValue());
               }
               if (deviation.getMaxValue() != null) {
                  thresholdModel.setMaxValue(deviation.getMaxValue());
               }
               if (deviation.getLearningTime() != null) {
                  thresholdModel.setLearningTime(deviation.getLearningTime());
               }
               if (deviation.getWorkcard() != null) {
                  thresholdModel.setWorkCardReference(deviation.getWorkcard());
               }
               if (deviation.getMinimumDeviation() != null) {
                  thresholdModel.setMinimumDeviation(deviation.getMinimumDeviation());
               }
               if (deviation.getMeanFactor() != null) {
                  thresholdModel.setMeanFactor(deviation.getMeanFactor());
               }
               if (deviation.getDeviationCoefficient() != null) {
                  thresholdModel.setDeviationCoefficient(deviation.getDeviationCoefficient());
               }
               if (deviation.getNbSuccessivePoints() != null) {
                  thresholdModel.setNbSuccessivePoints(deviation.getNbSuccessivePoints());
               }
               if (deviation.getMaxPointsPerHour() != null) {
                  thresholdModel.setMaxPointsPerHour(deviation.getMaxPointsPerHour());
               }
               if (deviation.getFilteringLawName() != null) {
                  thresholdModel.setFilteringLawName(deviation.getFilteringLawName());
                  thresholdModel.setFilteringLawId(deviation.getFilteringLawId());
               }
            }

         }
         hmcThresholdModels.addAll(indicatorThresholdsMap.values());
         odd = !odd;
      }
      return hmcThresholdModels;
   }

