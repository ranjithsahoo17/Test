   /**
    * Check configuration file.
    * 
    * @param configurationFileName
    *           the configuration file name
    * @param xsdFileName
    *           the xsd file name
    */
   private ConfigurationValidity checkXmlConfigurationFile(String configurationFileName, String xsdFileName) {
      File configurationFile = new File(mgsConfigurationFolder, configurationFileName);
      InputStream xmlStream = null;
      ConfigurationValidity result;
      try {
         xmlStream = new FileInputStream(configurationFile);
         InputStream xsdStream = ParameterManager.class.getResourceAsStream(xsdFileName);
         return validateAgainstXSD(xmlStream, xsdStream, configurationFileName);
      } catch (FileNotFoundException e) {
         LOGGER.warn("Configuration file not found.", e);
         result = new ConfigurationValidity(false, e.getMessage());
      } finally {
         IOUtils.closeQuietly(xmlStream);
      }
      return result;
   }

   /**
    * Check rtb configuration.
    * 
    * @param avionicVersion
    *           the avionic version
    * @return true, if successful
    */
   public ConfigurationValidity checkRtbConfiguration(AvionicVersion avionicVersion) {
      // check rotor-rtb.xml
      String configurationFileName = "rotortrackbalance/" + avionicVersion.getId() + "/rotor-rtb.xml";
      String xsdFileName = "/xsd/aircraftConfiguration/rtb.xsd";
      ConfigurationValidity configurationValidity = checkXmlConfigurationFile(configurationFileName, xsdFileName);

      if (configurationValidity.isValid()) {
         configurationFileName = "rotortrackbalance/" + avionicVersion.getId() + "/learning_acquisition/learning_tuning.xml";
         File configurationFile = new File(mgsConfigurationFolder, configurationFileName);
         if (configurationFile.exists()) {
            // check learning_tuning.xml
            xsdFileName = "/xsd/rotortrackbalance/learning_tuning.xsd";
            configurationValidity = checkXmlConfigurationFile(configurationFileName, xsdFileName);
         } else {
            // check neural-network-{acType}-main-rotor.net and neural-network-{acType}-tail-rotor.net
            configurationValidity = checkMatrixConfigurationFiles(avionicVersion.getId());
         }
      }

      return configurationValidity;
   }

