package com.eurocopter.mgs.delegate.health;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.UUID;

import org.apache.commons.lang.StringUtils;

import com.eurocopter.mgs.datamodel.aircraft.Avionic;
import com.eurocopter.mgs.datamodel.health.common.Accelerometer;
import com.eurocopter.mgs.datamodel.health.common.HealthAlgorithm;
import com.eurocopter.mgs.datamodel.health.common.Style;
import com.eurocopter.mgs.datamodel.health.monitoring.HealthMechanicalComponent;
import com.eurocopter.mgs.datamodel.health.monitoring.HealthMechanicalComponentConfiguration;
import com.eurocopter.mgs.datamodel.health.monitoring.Indicator;
import com.eurocopter.mgs.datamodel.health.monitoring.IndicatorConfiguration;
import com.eurocopter.mgs.datamodel.health.monitoring.IndicatorDisplay;
import com.eurocopter.mgs.datamodel.health.monitoring.RelearnThresholdRequest;
import com.eurocopter.mgs.datamodel.health.monitoring.Threshold;
