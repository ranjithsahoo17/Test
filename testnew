   @Override
   public Map<HealthMechanicalComponent, HealthMechanicalComponentConfiguration> getLatestHealthConfiguration() {
      return latestComponentConfiguration;
   }

   @Override
   public Map<Indicator, Map<Flight, HealthAlarm>> getExistingHealthAlarms() {
      TypedQuery<Object[]> query = manager.createNamedQuery("findNotAckHealthAlarmsAndFlightByAircraft", Object[].class);
      query.setParameter("aircraftId", aircraft.getId());
      Map<Indicator, Map<Flight, HealthAlarm>> alarms = new HashMap<>();
      for (Object[] row : query.getResultList()) {
         HealthAlarm alarm = (HealthAlarm) row[0];
         Flight flight = (Flight) row[1];
         Indicator indicator = alarm.getIndicator();
         alarms.computeIfAbsent(indicator, k -> new HashMap<>()).put(flight, alarm);
      }
      return alarms;
   }

   @Override
   public Map<Indicator, Map<Flight, SensorAnomaly>> getExistingSensorAnomaly() {
      TypedQuery<Object[]> query = manager.createNamedQuery("findNotAckSensorAnomalyAndFlightByAircraft", Object[].class);
      query.setParameter("aircraftId", aircraft.getId());
      Map<Indicator, Map<Flight, SensorAnomaly>> sensorAnomalies = new HashMap<>();
      for (Object[] row : query.getResultList()) {
         SensorAnomaly sensorAnomaly = (SensorAnomaly) row[0];
         Flight flight = (Flight) row[1];
         Indicator indicator = sensorAnomaly.getIndicator();
         sensorAnomalies.computeIfAbsent(indicator, k -> new HashMap<>()).put(flight, sensorAnomaly);
      }
      return sensorAnomalies;
   }

   /**
    * Gets all indicator values for given flight and indicator
    *
    * @param flight
    * @return indicator values
    */
   @Override
   public Set<IndicatorValueHolder> getIndicatorValues(final Flight flight) {
      TypedQuery<Object[]> query = manager.createQuery(
            "SELECT fiv.indicator, iv.startDate, iv.cumulatedFlightTime, iv.value FROM Flight f JOIN f.flightIndicatorValues fiv JOIN fiv.values iv WHERE f.id = :flightId", Object[].class);
      query.setParameter("flightId", flight.getId());
      return toHolders(query);
   }

   /**
    * Gets all indicator values for given flight and indicator
    *
    * @param flight
    * @param indicator
    * @return indicator values
    */
   @Override
   public Set<IndicatorValueHolder> getIndicatorValues(final Flight flight, final Indicator indicator) {
      TypedQuery<Object[]> query = manager.createQuery(
            "SELECT fiv.indicator, iv.startDate, iv.cumulatedFlightTime, iv.value FROM Flight f JOIN f.flightIndicatorValues fiv JOIN fiv.values iv WHERE fiv.indicator.id = :indicatorId AND f.id = :flightId",
            Object[].class);
      query.setParameter("flightId", flight.getId());
      query.setParameter("indicatorId", indicator.getId());
      return toHolders(query);
   }

   @Override
   public Set<Flight> getFlightsWithValues(Indicator indicator) {
      TypedQuery<Flight> query = manager.createQuery("SELECT f FROM Flight f JOIN f.flightIndicatorValues fiv WHERE fiv.indicator.id = :indicatorId", Flight.class);
      query.setParameter("indicatorId", indicator.getId());
      return new HashSet<>(query.getResultList());
   }

   @Override
   public boolean isIndicatorActive(String indicatorId, String flightId) {
      TypedQuery<AircraftConfiguration> query = manager.createQuery(
            "SELECT c FROM AircraftConfiguration c JOIN c.aircraft a JOIN a.flights f WHERE f.id = :flightId AND f.configurationSerialNumber = c.serialNumber", AircraftConfiguration.class);
      query.setParameter("flightId", flightId);
      List<AircraftConfiguration> aircraftConfigurations = query.getResultList();
      if (aircraftConfigurations.isEmpty()) {
         return false;
      }
      AircraftConfiguration aircraftConfiguration = aircraftConfigurations.iterator().next();
      HealthMonitoringConfiguration healthMonitoringConfiguration = (HealthMonitoringConfiguration) aircraftConfiguration.getConfigurations().get(HealthMonitoringConfiguration.TYPE);
      if (healthMonitoringConfiguration == null) {
         return false;
      }
      TypedQuery<IndicatorConfiguration> indicatorConfigurationQuery = manager.createNamedQuery("findIndicatorConfigurationByHealthConfigurationAndIndicator", IndicatorConfiguration.class);
      indicatorConfigurationQuery.setParameter("configurationId", healthMonitoringConfiguration.getId());
      indicatorConfigurationQuery.setParameter("indicatorId", indicatorId);
      return !indicatorConfigurationQuery.getResultList().isEmpty();
   }

   @Override
   public AircraftHistory getAircraftHistory() {
      TypedQuery<Object[]> query = manager.createNamedQuery("sumPurgedFlightsForAircraft", Object[].class);
      query.setParameter("aircraftId", aircraft.getId());
      List<Object[]> results = query.getResultList();
      if (results.isEmpty()) {
         return new AircraftHistory();
      }
      Object[] row = results.get(0);
      return new AircraftHistory((Long) row[0], (Long) row[1], (Long) row[2], (Long) row[3]);
   }

   @Override
   public List<IndicatorRawValue> getLastIndicatorRawValuesBeforeFlight(Aircraft aircraft, Flight flight, Indicator indicator, int count) {
      TypedQuery<IndicatorRawValue> indicatorRawValueQuery = manager
            .createNamedQuery("findIndicatorRawValuesBeforeFlight", IndicatorRawValue.class);
      indicatorRawValueQuery.setParameter("aircraft", aircraft);
      indicatorRawValueQuery.setParameter("indicator", indicator);
      indicatorRawValueQuery.setParameter("date", flight.getDate());
      indicatorRawValueQuery.setMaxResults(count);
      return indicatorRawValueQuery.getResultList();
   }

   @Override
   public Set<String> getFlightIdsWithRawValuesAfterFlight(Aircraft aircraft, Flight flight, Indicator indicator, int count) {
      TypedQuery<Object[]> indicatorRawValueQuery = manager
            .createNamedQuery("findFlightsAfterFlightWithIndicatorRawValues", Object[].class);
      indicatorRawValueQuery.setParameter("aircraft", aircraft);
      indicatorRawValueQuery.setParameter("indicator", indicator);
      indicatorRawValueQuery.setParameter("date", flight.getDate());
      indicatorRawValueQuery.setMaxResults(count);
      Set<String> flightIds = new HashSet<>();
      for (Object[] row : indicatorRawValueQuery.getResultList()) {
         String flightId = (String) row[0];
         flightIds.add(flightId);
      }
      return flightIds;
   }

   private Set<IndicatorValueHolder> toHolders(TypedQuery<Object[]> query) {
      Set<IndicatorValueHolder> holders = new HashSet<>();
      for (Object[] row : query.getResultList()) {
         holders.add(new IndicatorValueHolderImpl((Indicator) row[0], (Date) row[1], (Long) row[2], (Double) row[3]));
      }
      return holders;
   }

   public record IndicatorValueHolderImpl(Indicator indicator, Date date, Long cumulatedFlightTime, double value) implements IndicatorValueHolder {

      @Override
      public Indicator getIndicator() {
         return indicator;
      }

      @Override
      public Date getDate() {
         return date;
      }

      @Override
      public Long getCumulatedFlightTime() {
         return cumulatedFlightTime;
      }

      @Override
      public double getValue() {
         return value;
      }
   }

   @Override
   public Map<String, IndicatorDeviation> getDeviations() {
      List<String> indicatorIds = new ArrayList<>();
      for (HealthMechanicalComponent hmc : aircraft.getHealthComponents()) {
         for (Indicator indicator : hmc.getIndicators().values()) {
            indicatorIds.add(indicator.getId());
         }
      }
      Map<String, IndicatorDeviation> deviations = new HashMap<>();
      if (indicatorIds.isEmpty()) {
         return deviations;
      }

      TypedQuery<IndicatorDeviation> query = manager.createNamedQuery("findAllDeviationsByIndicators", IndicatorDeviation.class);
      query.setParameter("indicatorIds", indicatorIds);

      for (IndicatorDeviation deviation : query.getResultList()) {
         String key = deviation.getIndicatorConfiguration().getIndicator().getId()
               + "|" + deviation.getSeverity();
         // Keep the most recently created one when an indicator has been deviated more than once
         IndicatorDeviation existing = deviations.get(key);
         if (existing == null || deviation.getStartDate().after(existing.getStartDate())) {
            deviations.put(key, deviation);
         }
      }
      return deviations;
   }

}


