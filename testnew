package com.eurocopter.mgs.download.analysis.health.algo;

import java.util.ArrayList;
import java.util.List;

import com.eurocopter.mgs.download.analysis.health.impl.HealthIndicatorValueAdapter;

public final class FilteringAlgorithm {

   /**
    * Default constructor. Builds a FilteringAlgorithm.
    */
   private FilteringAlgorithm() {
      // Nothing to do
   }

   public static List<HealthIndicatorValueAdapter> filterHealthIndicatorValues(List<HealthIndicatorValueAdapter> values, int maxPointsPerHour) {
      final List<HealthIndicatorValueAdapter> res = new ArrayList<>();

      if (values.size() <= maxPointsPerHour) {
         return values;
      }

      if (maxPointsPerHour == 1) {
         res.add(values.get(values.size() - 1));
         return res;
      }

      res.add(values.get(0));
      for (int i = 2; i <= maxPointsPerHour; i++) {
         final int minIndex = maxPointsPerHour + (i * (i - 1)) / 2;
         final int maxIndex = maxPointsPerHour + (i * (i + 1)) / 2 - 1;
         res.add(values.get(getIndex(i, minIndex, maxIndex, values.size(), i == maxPointsPerHour) - 1));
      }
      return res;
   }

   private static int getIndex(int i, int min, int max, int valueCount, boolean lastIndex) {
      if (valueCount < min) {
         return i;
      }
      if (lastIndex) {
         return valueCount;
      }
      return Math.min(max, valueCount);
   }

}


