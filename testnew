   private void processAircraftMerge(File aircraftFolder, Context context, Map<String, Object> aircraftProperties, List<Map<String, Object>> flightsProperties, Aircraft newAircraft)
         throws AircraftManagementException, EntityNotFoundException, NotificationException {
      long start;
      long end;
      long duration;
      start = System.currentTimeMillis();
      LOGGER.info("Start merge A/C.");

      Map<Object, Object> entityMap = new HashMap<>();

      // --- GENERAL ---
      final String aircraftId = newAircraft.getId();
      Aircraft aircraftForNotification = new Aircraft(aircraftId);
      aircraftForNotification.setAttachmentDate(newAircraft.getAttachmentDate());

      LOGGER.info("Import A/C general data.");

      UuidMapping aircraftMapping = new UuidMapping();
      aircraftMapping.put(aircraftProperties.get("id").toString(), aircraftId);

      aircraftProperties.put("id", aircraftId);

      newAircraft = manager.find(Aircraft.class, aircraftId);
      newAircraft.setAttachmentDate(null);

      // 1. Merge health monitoring data
      mergeAircraftTable("accelerometer", Accelerometer.class, aircraftMapping, aircraftFolder, "id", AIRCRAFT_IDENTIFIER_KEY, "functional_id");
      mergeAircraftTable("health_mechanical_component", HealthMechanicalComponent.class, aircraftMapping, aircraftFolder, "id", AIRCRAFT_IDENTIFIER_KEY, "functional_id");
      mergeAircraftTable("indicator", Indicator.class, aircraftMapping, aircraftFolder, "id", "health_mechanical_component_id", "functional_id");
      mergeAircraftTable("threshold", Threshold.class, aircraftMapping, aircraftFolder, "id", "indicator_id", "functional_id");

      // 2. Merge FDCR monitoring data
      mergeAircraftTable("fdcr_partition", FdcrPartition.class, aircraftMapping, aircraftFolder, "id", AIRCRAFT_IDENTIFIER_KEY, "name");
      mergeAircraftTable("fdcr_parameter", FdcrParameter.class, aircraftMapping, aircraftFolder, "id", "partition_id", "functional_id");
      mergeAircraftTable("fdcr_parameter", FdcrParameter.class, aircraftMapping, "fdcr_parameter2", aircraftFolder, "id", "parameter_id", "functional_id");
      deleteAircraftData(aircraftId, "aircraft-fdcr-monitoring-delete");
      replaceMapping(aircraftFolder, aircraftMapping, "aircraft", "fdcr_partition_indexes");
      replaceMapping(aircraftFolder, aircraftMapping, "aircraft", "fdcr_parameter_preference");
      replaceMapping(aircraftFolder, aircraftMapping, "aircraft", "fdcr_indicator_preference");
      replaceMapping(aircraftFolder, aircraftMapping, "aircraft", "fdcr_usage_preference");
      replaceMapping(aircraftFolder, aircraftMapping, "aircraft", "fdcr_parameter_preference", "fdcr_parameter_preference2");
      replaceMapping(aircraftFolder, aircraftMapping, "aircraft", "fdcr_indicator_preference", "fdcr_indicator_preference2");
      replaceMapping(aircraftFolder, aircraftMapping, "aircraft", "fdcr_usage_preference", "fdcr_usage_preference2");

      // 3. Merge failure characteristics data
      mergeAircraftTable("failure_characteristics", FailureCharacteristics.class, aircraftMapping, aircraftFolder, "id", AIRCRAFT_IDENTIFIER_KEY, "functional_id");

      // 4. Delete + Recreate aircraft settings
      deleteAircraftTable("flight_synthesis_usage_parameter", AIRCRAFT_IDENTIFIER_KEY, aircraftId);
      replaceMapping(aircraftFolder, aircraftMapping, "aircraft", "flight_synthesis_usage_parameter");
      deleteAircraftTable("ums_data", AIRCRAFT_IDENTIFIER_KEY, aircraftId);
      replaceMapping(aircraftFolder, aircraftMapping, "aircraft", "ums_data");

      // 5. Delete health images
      deleteAircraftData(aircraftId, "aircraft-display-data-delete");

      // 6. Delete RTB configuration
      deleteAircraftData(aircraftId, "aircraft-rtb-configuration-delete");
      for (String tableName : Arrays.asList("rotor_characteristics", "rotor_accelerometers", "rotor_flight_configurations", "rotor_harmonics", "rotor_max_tuning_values", "rotor_min_tuning_values",
            "rotor_tuning_points", "rotor_tuning_units", "rtbconfiguration", "rotor_tuning", "tuning_value", "rotor_tuning_accelerometer_weights", "rotor_tuning_flight_configuration_weights",
            "rotor_tuning_harmonic_weights", "rotor_tuning_selected_acquisitions")) {
         replaceMapping(aircraftFolder, aircraftMapping, "aircraft", tableName);
      }

      manager.flush();
      manager.clear();

      // 7. Merge downloads
      mergeAircraftTable("download", Download.class, aircraftMapping, aircraftFolder, "download_id", AIRCRAFT_IDENTIFIER_KEY, "date");

      // 8. Merge folders
      mergeAircraftTable("folder", Folder.class, aircraftMapping, aircraftFolder, "id", AIRCRAFT_IDENTIFIER_KEY, "name");

      manager.flush();
      manager.clear();

      // 9. Import all new data
      readImportSql(aircraftFolder, "aircraft-data-import");

      // 10. Link ac_display_data line with aircraft
      String displayDataId = findLastLine(aircraftFolder, "ac_display_data", "id");
      if (displayDataId != null) {
         Query query = manager.createNativeQuery("UPDATE aircraft SET displaydata_id = ? WHERE id = ?");
         query.setParameter(1, displayDataId);
         query.setParameter(2, aircraftId);
         query.executeUpdate();

         AircraftDisplayData add = manager.find(AircraftDisplayData.class, displayDataId);
         Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
         aircraft.setDisplayData(add);
      }

      for (String tuningColumnName : Arrays.asList("mainrotortuning_id", "tailrotortuning_id")) {
         Object value = aircraftProperties.get(tuningColumnName);
         if (value != null) {
            String oldId = value.toString();
            String newId = aircraftMapping.getOrCreate(oldId);
            Query query = manager.createNativeQuery("UPDATE aircraft SET " + tuningColumnName + " = ? WHERE id = ?");
            query.setParameter(1, newId);
            query.setParameter(2, aircraftId);
            query.executeUpdate();

            Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
            if (tuningColumnName.contains("mainrotortuning_id")) {
               aircraft.setMainRotorTuning(manager.find(MainRotorTuning.class, newId));
            } else if (tuningColumnName.contains("tailrotortuning_id")) {
               aircraft.setTailRotorTuning(manager.find(TailRotorTuning.class, newId));
            } else {
               throw new IllegalStateException();
            }
         }
      }

      Object rtbConfigurationValue = aircraftProperties.get("rtb_configuration_id");
      if (rtbConfigurationValue != null) {
         String oldId = rtbConfigurationValue.toString();
         String newId = aircraftMapping.getOrCreate(oldId);
         Query query = manager.createNativeQuery("UPDATE aircraft SET rtb_configuration_id = ? WHERE id = ?");
         query.setParameter(1, newId);
         query.setParameter(2, aircraftId);
         query.executeUpdate();

         Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
         aircraft.setRtbConfiguration(manager.find(RtbConfiguration.class, newId));
      }

      manager.flush();
      manager.clear();

      // 11. Merge aircraft configurations
      mergeAircraftConfigurations(aircraftId, aircraftMapping, aircraftFolder);

      manager.flush();
      manager.clear();

      // 12. Merge flights
      for (Map<String, Object> flightProperties : flightsProperties) {
         // Iteration on all flights present on the remote base

         // A folder has been created only if the flight is "exported" (= if it has been modified)
         String packageFlightTechnicalId = flightProperties.get("id").toString();
         int flightId = ((Number) flightProperties.get("flight_id")).intValue();
         boolean flightDetached = new File(aircraftFolder, "flight-" + packageFlightTechnicalId).exists();
         if (!flightDetached) {
            // No reason to delete it, just skip it
            continue;
         }
         String date = flightProperties.get("usage_start_date").toString();
         Query findFlightQuery = manager
               .createNativeQuery(
                     "SELECT id, usage_flight_data_id FROM flight WHERE flight_id = ? AND usage_start_date - ?::timestamp without time zone BETWEEN '-1 day'::interval AND '1 day'::interval AND aircraft_id = ?");
         findFlightQuery.setParameter(1, flightId);
         findFlightQuery.setParameter(2, date);
         findFlightQuery.setParameter(3, aircraftId);
         @SuppressWarnings("unchecked")
         List<Object[]> findFlightResult = findFlightQuery.getResultList();
         if (!findFlightResult.isEmpty()) {
            // Flight exists, delete it before importing it
            Object[] row = findFlightResult.get(0);
            String flightTechnicalId = row[0].toString();
            String usageFlightDataId = row[1] == null ? null : row[1].toString();
            deleteFlight(flightTechnicalId, usageFlightDataId);
         }
         persistFlight(aircraftFolder, aircraftId, flightProperties);
      }

      manager.flush();
      manager.clear();

      progressManager.notifyProgress(context, newAircraft, Progress.START);

      entityMap.put(newAircraft.getAircraftType(), newAircraft.getAircraftType());
      entityMap.put(newAircraft.getGroundStation(), newAircraft.getGroundStation());

      manager.flush();
      manager.clear();

      LOGGER.info("Finalize and notify A/C import.");

      Aircraft aircraft = aircraftDao.findById(aircraftId);
      aircraft.setAircraftState(AircraftState.ACTIVE);
      // compute the status of the aircraft
      aircraftDao.updateAircraftStatus(aircraft);

      manager.flush();

      synchronizationManager.merge(aircraftForNotification, aircraft, entityMap);
      // On import/attach, HSA data shall not be sent to the client
      aircraftForNotification.setFlights(new HashSet<>());
      aircraftForNotification.setDownloads(new HashSet<>());
      aircraft.getAccelerometers().size();
      aircraftForNotification.setAccelerometers(aircraft.getAccelerometers());

      ImportAttachResult importAttachResult = new ImportAttachResult(aircraftForNotification, Action.UPDATE);

      // Notify aircraft configuration creation (without child configurations)
      for (AircraftConfiguration aircraftConfigurationStub : configurationDao.findConfigurations(aircraftId)) {
         AircraftConfiguration aircraftConfiguration = manager.find(AircraftConfiguration.class, aircraftConfigurationStub.getId());
         AircraftConfiguration configuration = new AircraftConfiguration(aircraftConfiguration.getId());
         configuration.setAircraft(new Aircraft(aircraftConfiguration.getAircraft().getId()));
         configuration.setSerialNumber(aircraftConfiguration.getSerialNumber());
         configuration.setApplicableDate(aircraftConfiguration.getApplicableDate());
         configuration.setAvionicVersion(aircraftConfiguration.getAvionicVersion());
         configuration.setDmauVersion(aircraftConfiguration.getDmauVersion());
         // Leave configuration map uninitialized.
         importAttachResult.getAircraftConfigurations().add(aircraftConfiguration);
      }

      // Notify folder creation
      importAttachResult.getFolders().addAll(aircraft.getFolders());

      progressManager.disposeContext();

      end = System.currentTimeMillis();
      duration = end - start;
      LOGGER.info("End merge A/C in {} ms.", duration);
      notificationService.notifyAction(importAttachResult.getAircraftForNotification(), importAttachResult.getAction());
      notifyEntityCreation(importAttachResult);
   }

   private String findLastLine(File aircraftFolder, String tableName, String idColumn) {
      File csvFile = new File(aircraftFolder, tableName + ".csv");
      CsvParser parser = getCsvParser();
      List<String[]> allLines = parser.parseAll(csvFile);
      String[] firstLine = allLines.get(0);
      int searchedColumn = Arrays.asList(firstLine).indexOf(idColumn);
      for (int i = 1; i < allLines.size(); ++i) {
         String[] line = allLines.get(i);
         if (line[searchedColumn] != null) {
            return line[searchedColumn];
         }
      }
      return null;
   }

