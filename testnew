import com.eurocopter.mgs.service.aircraft.ejb.AircraftLockManager;
import com.eurocopter.mgs.service.aircraft.exception.AircraftFrozenException;
import com.eurocopter.mgs.service.datacollection.ejb.BasicAlarmDescriptionFormatter;
import com.eurocopter.mgs.service.datacollection.ejb.DataCollectionService;
import com.eurocopter.mgs.service.exception.ConcurrentAccessException;
import com.eurocopter.mgs.service.exception.NotificationException;
import com.eurocopter.mgs.service.notification.api.INotificationService;
import com.eurocopter.mgs.service.notification.dto.ActionNotificationDto.Action;
import com.eurocopter.mgs.service.utils.DateTimeFormatterUtils;

import jakarta.ejb.EJB;
import jakarta.ejb.Local;
import jakarta.ejb.Stateless;
import jakarta.persistence.EntityManager;
import jakarta.persistence.PersistenceContext;

@Local
@Stateless
public class AcknowledgementManager {

   private static final Logger LOGGER = LogManager.getLogger(AcknowledgementManager.class);

   private static final String ALARM_DESCRIPTION_KEY = "Alarm: {}, {}, {}";

   @EJB
   private AircraftDao aircraftDao;

   @EJB
   private INotificationService notificationService;

   @EJB
   private DataCollectionService dataCollectionService;

   @EJB
   private AircraftLockManager aircraftLockManager;

   @PersistenceContext
   private EntityManager manager;

   public void acknowledgeAlarms(String aircraftId, Map<String, AlarmStatus> alarmIds, Date date, String description, String changedComponentName, boolean createMarker, String login)
         throws ConcurrentAccessException {
      aircraftLockManager.throwExceptionIfAircraftLocked(aircraftId);
      List<Alarm> alarms = manager.createNamedQuery("findAlarmsByIds", Alarm.class)
            .setParameter("alarmIds", alarmIds.keySet())
            .getResultList();
      if (alarms != null) {
         for (Alarm alarm : alarms) {
            if (alarm.getAlarmStatus() != alarmIds.get(alarm.getId())) {
               throw new ConcurrentAccessException("Alarm has been updated");
            }
         }
         acknowledgeAlarms(aircraftId, alarms, date, description, changedComponentName, createMarker, login);
      }
   }

   public void closeMonitorAlarms(String aircraftId, List<? extends Alarm> alarms, Date date, String description, long duration, String login) throws ConcurrentAccessException {
      List<Flight> flights = manager.createNamedQuery("findFlightsByAircraft", Flight.class).setParameter("aircraftId", aircraftId).getResultList();
      if (flights != null && alarms != null && !alarms.isEmpty()) {
         Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
         if (aircraft.getAircraftState() == AircraftState.FROZEN || aircraft.getAircraftState() == AircraftState.DELETED) {
            throw new AircraftFrozenException("Alarm acknowledgment attempt on a frozen aircraft");
         }
         aircraftLockManager.throwExceptionIfAircraftLocked(aircraftId);

         BasicAlarmDescriptionFormatter formatter = new BasicAlarmDescriptionFormatter();
         final AircraftHistory aircraftHistory = aircraftDao.getAircraftHistory(aircraftId);

         Duration maintenanceFlightHoursAtBeginning = computeTotalNumberMaintenanceFlightHours(aircraftHistory, flights);
         Duration icaoFlightHoursAtBeginning = computeTotalNumberIcaoFlightHours(aircraftHistory, flights);
         LOGGER.info("Start close monitor alarms ");
         for (Alarm alarm : alarms) {
            if (alarm.getAlarmStatus() == AlarmStatus.ACK || alarm.getAlarmStatus() == AlarmStatus.CLOSEMONITORED) {
               throw new ConcurrentAccessException("Alarm already acknowlegded or closemonitored.");
            }

            if (alarm.isCloseMonitoringApplicable()) {
               String descriptionForLog = formatter.getDescription(alarm);
               LOGGER.info(ALARM_DESCRIPTION_KEY, alarm.getSeverity(), descriptionForLog, DateTimeFormatterUtils.format(alarm.getDate()));
               alarm.setAlarmStatus(AlarmStatus.CLOSEMONITORED);

               CloseMonitoredAcknowledgement newAck4alarm = new CloseMonitoredAcknowledgement(UUID.randomUUID().toString());
               newAck4alarm.setDate(date);
               newAck4alarm.setDescription(description);
               newAck4alarm.setCloseMonitoringDuration(duration);
               newAck4alarm.setRemainingDuration(duration);
               if (alarm instanceof HealthAlarm && ((HealthAlarm) alarm).getHealthMechanicalComponent().isGroundAcquisition()) {
                  newAck4alarm.setFlightHoursAtBeginning(icaoFlightHoursAtBeginning.getMillis());
               } else {
                  newAck4alarm.setFlightHoursAtBeginning(maintenanceFlightHoursAtBeginning.getMillis());
               }
               alarm.setAcknowledgement(newAck4alarm);
            }
         }
         updateAircraftStatusAndNotify(aircraft);
         dataCollectionService.collectAlarmAcknowledgment(alarms, Type.CLOSED_MONITORING.value(), description, null, duration, login, aircraft.getRegisterNumber());
         LOGGER.info("End close monitor alarms ");
      } else {
         throw new ConcurrentAccessException("Alarm already acknowlegded or closemonitored.");
      }
   }

   private void acknowledgeAlarms(String aircraftId, List<Alarm> alarms, Date date, String description, String changedComponentName, boolean createMarker, String login)
         throws ConcurrentAccessException {
      if (alarms != null && !alarms.isEmpty()) {
         Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
         if (aircraft.getAircraftState() == AircraftState.FROZEN) {
            throw new AircraftFrozenException("Alarm acknowledgment attempt on a frozen aircraft");
         }
         if (aircraft.getAircraftState() == AircraftState.DELETED) {
            throw new AircraftFrozenException("Alarm acknowledgment attempt on a deleted aircraft");
         }

         BasicAlarmDescriptionFormatter formatter = new BasicAlarmDescriptionFormatter();
         LOGGER.info("Start acknowledge alarms ");
         for (Alarm alarm : alarms) {
            if (alarm.getAlarmStatus() == AlarmStatus.ACK) {
               throw new ConcurrentAccessException("Alarm already acknowledged");
            }

            String descriptionForLog = formatter.getDescription(alarm);
            LOGGER.info(ALARM_DESCRIPTION_KEY, alarm.getSeverity(), descriptionForLog, DateTimeFormatterUtils.format(alarm.getDate()));

            alarm.setAlarmStatus(AlarmStatus.ACK);
            alarm.setCreateMarker(createMarker);

            Acknowledgement currentAck = alarm.getAcknowledgement();
            if (currentAck != null) {
               currentAck.setDate(date);
               currentAck.setDescription(description);
            } else {
               Acknowledgement newAck4alarm = new Acknowledgement(UUID.randomUUID().toString());
               newAck4alarm.setDate(date);
               newAck4alarm.setDescription(description);
               alarm.setAcknowledgement(newAck4alarm);
            }
         }

         List<Alarm> alarmsList = new ArrayList<>(alarms);

         updateAircraftStatusAndNotify(aircraft);
         dataCollectionService.collectAlarmAcknowledgment(alarmsList, Type.ACKNOWLEDGEMENT.value(), description, changedComponentName, 0, login, aircraft.getRegisterNumber());
         LOGGER.info("End acknowledge alarms ");
      }
   }

   public void updateAircraftStatusAndNotify(Aircraft aircraft) {
      aircraftDao.updateAircraftStatus(aircraft);

      manager.flush();
      manager.clear();

      Aircraft aircraftForNotification = manager.find(Aircraft.class, aircraft.getId());
      try {
         notificationService.notifyAction(AircraftCloner.clone(aircraftForNotification), Action.UPDATE);
      } catch (NotificationException e) {
         LOGGER.info("Unexpected exception while notify aircraft update status action{}", e.getMessage(), e);
      }
   }

   public void keepCloseMonitoringStatus(Set<String> kept) {
      LOGGER.info("According to user choice, start setting alarm to close monitoring state");
      BasicAlarmDescriptionFormatter formatter = new BasicAlarmDescriptionFormatter();
      for (String alarmId : kept) {
         HealthAlarm alarm = manager.find(HealthAlarm.class, alarmId);
         alarm.setCloseMonitoringStatus(null);

         String descriptionForLog = formatter.getDescription(alarm);
         LOGGER.info(ALARM_DESCRIPTION_KEY, alarm.getSeverity(), descriptionForLog, DateTimeFormatterUtils.format(alarm.getDate()));
      }
      LOGGER.info("End setting alarm to close monitoring state");
   }

   public void cancelCloseMonitoringStatus(Set<String> withdrawn) {
      for (String alarmId : withdrawn) {
         HealthAlarm alarm = manager.find(HealthAlarm.class, alarmId);
         alarm.setCloseMonitoringStatus(null);
         alarm.setAcknowledgement(null);
         alarm.setAlarmStatus(AlarmStatus.NOTACK);
      }
   }

   private Duration computeTotalNumberMaintenanceFlightHours(AircraftHistory aircraftHistory, List<Flight> flights) {
      long totalDuration = 0;
      for (Flight flight : flights) {
         totalDuration += flight.getMaintenanceFlightTime();
      }
      return new Duration(totalDuration + aircraftHistory.getMaintenanceFlightTime());
   }

   private Duration computeTotalNumberIcaoFlightHours(AircraftHistory aircraftHistory, List<Flight> flights) {
      long totalDuration = 0;
      for (Flight flight : flights) {
         totalDuration += flight.getFlightDuration();
      }
      return new Duration(totalDuration + aircraftHistory.getIcaoFlightTime());
   }
}


