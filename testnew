   private void importFlightData(String flightId, File flightFolder) {
      List<String> flightLines;
      try {
         flightLines = IOUtils.readLines(AircraftExportService.class.getResourceAsStream("/sql/flight-import.sql"), StandardCharsets.UTF_8);
      } catch (IOException e) {
         throw new RuntimeException(e);
      }

      importBinaryData(flightFolder, "signal", "signals.bin", flightId);
      importBinaryData(flightFolder, "fdcr_dataset", "fdcr.bin", flightId);

      for (String line : flightLines) {
         String formattedLine = line.replace("${flight_folder}", flightFolder.getAbsolutePath()).replace("${columns}", findColumns(flightFolder, line));
         Query query = manager.createNativeQuery(formattedLine);
         query.executeUpdate();
      }
   }

   private void importBinaryData(File flightFolder, String tableName, String inputFileName, String flightId) {
      final String partitionName = tableName + "_" + flightId.replace('-', '_');
      manager.createNativeQuery("CREATE TABLE IF NOT EXISTS " + partitionName + " PARTITION OF " + tableName + " FOR VALUES IN ('" + flightId + "')").executeUpdate();

      manager.flush();
      manager.clear();

      FileInputStream fis = null;
      try {
         fis = new FileInputStream(new File(flightFolder, inputFileName));
         final CopyManager copyManager = PgConnectionUtils.getCopyAPI(manager);
         copyManager.copyIn("COPY " + tableName + " FROM STDIN WITH BINARY", fis);
      } catch (IOException | SQLException e) {
         throw new RuntimeException(e);
      } finally {
         IOUtils.closeQuietly(fis);
      }
   }

   private void replaceIds(UuidMapping mapping, File flightFolder, String tableName, String[] columnNames) {
      File csvFile = new File(flightFolder, tableName + ".csv");
      CsvParser parser = getCsvParser();
      List<String[]> allLines = parser.parseAll(csvFile);
      List<Integer> columnIndexes = new ArrayList<>();
      fillColumnIndexes(allLines, columnIndexes);
      applyColumnMapping(mapping, columnNames, allLines, columnIndexes);
      setRemainingColumnsToNull(allLines, columnIndexes);

      CsvWriterSettings writerSettings = buildWriterSettings();
      CsvWriter writer = new CsvWriter(csvFile, writerSettings);
      writer.writeStringRowsAndClose(allLines);
   }

   private CsvWriterSettings buildWriterSettings() {
      CsvWriterSettings writerSettings = new CsvWriterSettings();
      writerSettings.getFormat().setDelimiter(';');
      writerSettings.setQuotationTriggers('\r', '\n');
      writerSettings.setMaxCharsPerColumn(-1);
      writerSettings.trimValues(false);
      writerSettings.setNormalizeLineEndingsWithinQuotes(false);
      return writerSettings;

   }

