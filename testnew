/**
 * Learning threshold composite.
 */
public class ThresholdLearningComposite extends Composite implements PropertyChangeListener {

   /** Reason of the threshold learning. */
   private StyledText learningReason;

   /** Threshold learning dialog OK button. */
   private Button thresholdLearningDialogOKButton;

   /** Empty description validator. */
   private ValidateFieldSize reasonValidator;

   /** Threshold learning model. */
   private final ThresholdLearningModel model;

   private LearningPastHoursSelectionComposite pastHoursSelectionComposite;

   /**
    * Create the composite.
    *
    * @param parent
    *           the parent composite
    * @param style
    *           the composite style
    * @param model
    *           the threshold learning model
    */
   public ThresholdLearningComposite(Composite parent, ThresholdLearningModel model, long defaultHistoryDuration) {
      super(parent, SWT.NONE);
      this.model = model;
      model.addPropertyChangeListener(this);
      createContent(defaultHistoryDuration);
      initializeDataBindings();
      GridLayout layout = new GridLayout(3, false);
      layout.marginWidth = 10;
      setLayout(layout);
   }

   /**
    * Sets the thresholdLearningDialogOKButton.
    *
    * @param dialogOKButton
    *           the thresholdLearningDialogOKButton to set
    */
   public void setLearningThresholdDialogOKButton(Button dialogOKButton) {
      this.thresholdLearningDialogOKButton = dialogOKButton;
      // initialize the button activation state
      manageThresholdLearningDialogOKButton();
   }

   @Override
   public void propertyChange(PropertyChangeEvent arg0) {
      manageThresholdLearningDialogOKButton();
   }

   /**
    * Create the composite content.
    *
    * @param defaultHistoryDuration
    */
   private void createContent(long defaultHistoryDuration) {

      // title
      this.getShell().setText(Messages.CORE.getMnemonicEscapedString("ThresholdLearningComposite_0"));

      // learning reason
      Group reasonSection = new Group(this, ExpandableComposite.TITLE_BAR);
      reasonSection.setLayout(new GridLayout());
      GridData gdreasonSection = new GridData(SWT.FILL, SWT.FILL, false, false, 3, 1);
      gdreasonSection.heightHint = 113;
      gdreasonSection.widthHint = 494;
      reasonSection.setLayoutData(gdreasonSection);
      reasonSection.setText(Messages.CORE.getMnemonicEscapedString("Description"));

      learningReason = new StyledText(reasonSection, SWT.V_SCROLL | SWT.MULTI | SWT.WRAP);
      GridData reasonTextData = new GridData(SWT.FILL, SWT.FILL, true, true);
      learningReason.setLayoutData(reasonTextData);

      pastHoursSelectionComposite = new LearningPastHoursSelectionComposite(this, defaultHistoryDuration);
      pastHoursSelectionComposite.setLayoutData(gdreasonSection);
   }

   /**
    * Initialize data binding.
    *
    * @return data binding context
    */
   private DataBindingContext initializeDataBindings() {
      DataBindingContext bindingContext = new DataBindingContext();

      ControlDecoration descriptionTextDecoration = HealthMonitoringUtil.createDecorator(learningReason, StringUtils.EMPTY);
      UpdateValueStrategy<String, String> updateDescription = new UpdateValueStrategy<>();
      reasonValidator = new ValidateFieldSize(descriptionTextDecoration);
      descriptionTextDecoration.setDescriptionText(reasonValidator.getMessage());
      updateDescription.setAfterConvertValidator(reasonValidator);

      IObservableValue<String> reasonTextObserveSelectionObserveWidget = WidgetProperties.text(SWT.FocusOut, SWT.Modify).observe(learningReason);
      IObservableValue<String> acknowledgmentReasonObserveValue = PojoProperties.value("learningReason", String.class).observe(model);
      bindingContext.bindValue(reasonTextObserveSelectionObserveWidget, acknowledgmentReasonObserveValue, updateDescription, null);

      bindingContext.bindValue(BeanProperties.value("selectedTime").observe(pastHoursSelectionComposite), PojoProperties.value("historyLearningTime").observe(model));

      reasonValidator.addValidatorListener(source -> manageThresholdLearningDialogOKButton());

      return bindingContext;
   }

   /**
    * Manage threshold learning dialog OK button.
    */
   private void manageThresholdLearningDialogOKButton() {
      if (thresholdLearningDialogOKButton != null) {
         thresholdLearningDialogOKButton.setEnabled(reasonValidator.getStatus().isOK());
      }
   }
}





