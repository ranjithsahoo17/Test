import jakarta.ejb.TransactionManagement;
import jakarta.ejb.TransactionManagementType;
import jakarta.jms.Connection;
import jakarta.jms.ConnectionFactory;
import jakarta.jms.JMSException;
import jakarta.jms.Message;
import jakarta.jms.MessageConsumer;
import jakarta.jms.ObjectMessage;
import jakarta.jms.Queue;
import jakarta.jms.Session;
import jakarta.transaction.UserTransaction;

@Stateless
@TransactionManagement(TransactionManagementType.BEAN)
public class AsyncTaskListener {

   private static final Logger LOGGER = LogManager.getLogger(AsyncTaskListener.class);

   @Resource
   private UserTransaction transaction;

   @EJB
   private PurgeDataManager purgeDataManager;

   @EJB
   private AircraftDeletionManager aircraftDeletionManager;

   @EJB
   private AsyncQueue asyncQueue;

   @EJB
   private FdcrDownloadManager fdcrDownloadManager;

   @EJB
   private BackgroundOperationService backgroundOperationService;

   /**
    * Connection factory.
    */
   @Resource(mappedName = "jms/MgsConnectionFactory")
   private ConnectionFactory connectionFactory;

   /**
    * Notification Topic.
    */
   @Resource(mappedName = "jms/MgsAsyncTaskQueue")
   private Queue queue;

   @Schedule(second = "*/15", minute = "*", hour = "*", persistent = false)
   public void poll() throws Exception {
      try (Connection connection = connectionFactory.createConnection();
            Session session = connection.createSession(false, Session.CLIENT_ACKNOWLEDGE);
            MessageConsumer consumer = session.createConsumer(queue);) {
         connection.start();
         Message message = consumer.receive(1500L);
         while (message != null) {
            if (message instanceof ObjectMessage) {
               try {
                  transaction.begin();
                  processMessage((ObjectMessage) message);
                  transaction.commit();
               } catch (Exception e) {
                  transaction.rollback();
                  throw e;
               }
            }
            message = consumer.receive(1500L);
         }
      } catch (JMSException e) {
         LOGGER.warn("Unable to handle JMS message", e);
      }
   }

   private void processMessage(final ObjectMessage message) throws JMSException {
      // It is used to move messages from JMS queue into the "background" table
      // That prevents message queue to be stuck on a message
      final Serializable messageContent = message.getObject();
      if (messageContent instanceof PurgeRequest purgeRequest) {
         for (String aircraftId : purgeRequest.getAircraftIds()) {
            final Operation operation;
            PurgeType purgeType = purgeRequest.getPurgeType();
            if (purgeType == PurgeType.FDCR) {
               operation = BackgroundOperation.Operation.FDCR_PURGE;
            } else if (purgeType == PurgeType.FLIGHT_AUTO) {
               operation = BackgroundOperation.Operation.FLIGHT_AUTO_PURGE;
            } else if (purgeType == PurgeType.FLIGHT_MANUAL) {
               operation = BackgroundOperation.Operation.FLIGHT_MANUAL_PURGE;
            } else {
               throw new IllegalStateException(purgeType.name());
            }
            BackgroundOperation backgroundOperation = new BackgroundOperation(UUID.randomUUID().toString(), operation);
            backgroundOperation.setAircraftId(aircraftId);
            for (String downloadId : purgeRequest.getDownloadPerAircraft().get(aircraftId)) {
               backgroundOperation.getDownloadIds().put(downloadId, aircraftId);
            }
            backgroundOperationService.create(backgroundOperation);
         }
         message.acknowledge();
      } else if (messageContent instanceof final DataCollectionRequest dataCollectionRequest) {
         final BackgroundOperation dataCollectionOperation;
         switch (dataCollectionRequest.getType()) {
            case ENGINE_DATA_COLLECTION -> dataCollectionOperation = new BackgroundOperation(UUID.randomUUID().toString(), Operation.ENGINE_DATA_COLLECTION, dataCollectionRequest.getFolderName());
            case FLIGHT_DATA_COLLECTION -> dataCollectionOperation = new BackgroundOperation(UUID.randomUUID().toString(), Operation.FLIGHT_DATA_COLLECTION, dataCollectionRequest.getFolderName());
            case USER_OPERATION_DATA_COLLECTION -> dataCollectionOperation = new BackgroundOperation(UUID.randomUUID().toString(), Operation.USER_OPERATION_DATA_COLLECTION);
            default -> {
               LOGGER.warn("Unknown data collection request: {}", dataCollectionRequest.getType());
               dataCollectionOperation = null;
            }
         }
         if (dataCollectionOperation != null) {
            for (Map.Entry<String, String> downloadAircraftEntry : dataCollectionRequest.getDownloadPerAircraft().entries()) {
               dataCollectionOperation.getDownloadIds().put(downloadAircraftEntry.getValue(), downloadAircraftEntry.getKey());
            }
            backgroundOperationService.create(dataCollectionOperation);
         }
         message.acknowledge();
      } else if (messageContent instanceof final FdcrAnalysisRequest fdcrAnalysisRequest) {
         BackgroundOperation operation = new BackgroundOperation(UUID.randomUUID().toString(), Operation.FDCR_ANALYSIS, fdcrAnalysisRequest.getFolderName());
         operation.setTopicId(fdcrAnalysisRequest.getTopicDto().getOperationId());
         for (Entry<String, String> entry : fdcrAnalysisRequest.getDownloadPerAircraft().entries()) {
            operation.getDownloadIds().put(entry.getValue(), entry.getKey());
         }
         backgroundOperationService.create(operation);
         message.acknowledge();
      } else if (messageContent instanceof final RawDataFilteringRequest rawDataFilteringRequest) {
         BackgroundOperation operation = new BackgroundOperation(UUID.randomUUID().toString(), Operation.RAW_DATA_FILTERING, rawDataFilteringRequest.getFolderName());
         operation.setAircraftId(rawDataFilteringRequest.getAircraftId());
         operation.getFilenames().addAll(rawDataFilteringRequest.getFilenames());
         backgroundOperationService.create(operation);
         message.acknowledge();
      }
   }
}


