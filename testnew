   public void importAircraft(File aircraftFolder, TopicDto topicDto)
         throws AircraftManagementException, EntityNotFoundException, NotificationException, AircraftConcurrentAccessException {
      long start;
      long end;
      long duration;
      start = System.currentTimeMillis();

      Context context = progressManager.initContext(topicDto);
      LOGGER.info("Start import aircraft from the folder {}", aircraftFolder.getName());
      Map<String, Object> aircraftProperties = JsonUtils.readMap(new File(aircraftFolder, "aircraft.json"));
      Map<String, Object> groundStationProperties = JsonUtils.readMap(new File(aircraftFolder, "ground_station.json"));
      List<Map<String, Object>> flightsProperties = JsonUtils.readMapList(new File(aircraftFolder, "flight.json"));

      throwExceptionIfGroundStationVersionDifferent(groundStationProperties);

      // Check if aircraft exists
      String aircraftTypeName = aircraftProperties.get("aircraft_type_id").toString();
      String aircraftFunctionalId = aircraftProperties.get(AIRCRAFT_IDENTIFIER_KEY) != null ? aircraftProperties.get(AIRCRAFT_IDENTIFIER_KEY).toString() : null;
      String aircraftSerialNumber = aircraftProperties.get("aircraft_serial_number") != null ? aircraftProperties.get("aircraft_serial_number").toString() : null;
      Optional<Aircraft> optionalAircraft = getOptionalAircraft(aircraftTypeName, aircraftFunctionalId, aircraftSerialNumber);
      LOGGER.info("Importing aircraft (type: {}, ID: {}, SN: {} )", aircraftTypeName, aircraftFunctionalId, aircraftSerialNumber);

      Aircraft newAircraft = new Aircraft(aircraftProperties.get("id").toString());
      GroundStation groundStation = groundStationDao.getLocalGroundStation();
      if (optionalAircraft.isPresent()) {
         Aircraft aircraft = optionalAircraft.get();
         String aircraftTechnicalId = aircraft.getId();
         aircraftLockManager.throwExceptionIfBackgroundTask(aircraftTechnicalId);
         aircraftLockManager.lock(aircraftTechnicalId, LockCause.IMPORTATTACH);
         try {
            processAircraftReplacement(aircraftFolder, context, aircraftProperties, flightsProperties, newAircraft, aircraft, groundStation, ImportAttachOperation.IMPORT);
         } catch (Exception e) {
            LOGGER.error(e.getMessage(), e);
            aircraftLockManager.unlock(aircraftTechnicalId);
         }
      } else {
         processAircraftCreation(aircraftFolder, context, aircraftProperties, flightsProperties, newAircraft, groundStation, ImportAttachOperation.IMPORT);
      }
      updatePendingAndOnErrorLocalDiagnoses(newAircraft.getId());
      end = System.currentTimeMillis();
      duration = end - start;
      LOGGER.info("End import aircraft from the folder {} in {} ms.", aircraftFolder.getName(), duration);
   }

   /**
    * @param topicDto
    * @throws AircraftManagementException
    * @throws EntityNotFoundException
    * @throws NotificationException
    * @throws AircraftConcurrentAccessException
    * @throws AircraftAlreadyExistsException
    *            if the aircraft lock could not be released
    */
   public void attachAircraft(File aircraftFolder, TopicDto topicDto, boolean override)
         throws AircraftManagementException, EntityNotFoundException, NotificationException, AircraftAlreadyExistsException {
      Context context = progressManager.initContext(topicDto);

      Map<String, Object> aircraftProperties = JsonUtils.readMap(new File(aircraftFolder, "aircraft.json"));
      Map<String, Object> groundStationProperties = JsonUtils.readMap(new File(aircraftFolder, "ground_station.json"));
      List<Map<String, Object>> flightsProperties = JsonUtils.readMapList(new File(aircraftFolder, "flight.json"));

      throwExceptionIfGroundStationVersionDifferent(groundStationProperties);
      throwExceptionIfReattachOnThirdBase(groundStationProperties);

      // Check if aircraft exists
      String aircraftTypeName = aircraftProperties.get("aircraft_type_id").toString();
      String aircraftFunctionalId = aircraftProperties.get(AIRCRAFT_IDENTIFIER_KEY) != null ? aircraftProperties.get(AIRCRAFT_IDENTIFIER_KEY).toString() : null;
      String aircraftSerialNumber = aircraftProperties.get("aircraft_serial_number") != null ? aircraftProperties.get("aircraft_serial_number").toString() : null;
      Optional<Aircraft> optionalAircraft = getOptionalAircraft(aircraftTypeName, aircraftFunctionalId, aircraftSerialNumber);
      GroundStation localGroundStation = groundStationDao.getLocalGroundStation();
      boolean sameStation = localGroundStation.getBaseName().equals(groundStationProperties.get("base_name").toString());

      LOGGER.info("Attaching aircraft (type: {}, ID: {}, SN: {})", aircraftTypeName, aircraftFunctionalId, aircraftSerialNumber);

      if (optionalAircraft.isEmpty()) {
         // Aircraft doesn't exist => attachment on remote base
         // It looks like an import, but with specific ground station and attachment date set
         GroundStation groundStation = getOrCreateGroundStation(groundStationProperties);
         Aircraft aircraft = new Aircraft(aircraftProperties.get("id").toString());
         if (sameStation) {
            processAircraftCreation(aircraftFolder, context, aircraftProperties, flightsProperties, aircraft, groundStation, ImportAttachOperation.ATTACH_ON_HOME_BASE);
         } else {
            processAircraftCreation(aircraftFolder, context, aircraftProperties, flightsProperties, aircraft, groundStation, ImportAttachOperation.ATTACH_ON_REMOTE_BASE);
         }
         updatePendingAndOnErrorLocalDiagnoses(aircraft.getId());
         return;
      }

      // Existing aircraft
      Aircraft newAircraft = new Aircraft(aircraftProperties.get("id").toString());
      Aircraft existingAircraft = optionalAircraft.get();

      // If attachment date is null, the aircraft has never been re-attached to a remote base
      // = Detach the Reattach on the same station
      boolean fromRemoteBase = aircraftProperties.get("attachment_date") != null;

      if (sameStation && fromRemoteBase) {
         throwExceptionIfDataAreOlderThanCurrentStation(existingAircraft, aircraftProperties, false);
         processAircraftMerge(aircraftFolder, context, aircraftProperties, flightsProperties, existingAircraft);
         updatePendingAndOnErrorLocalDiagnoses(existingAircraft.getId());
      } else if (sameStation) {
         // Nothing to do
         existingAircraft.setAircraftState(AircraftState.ACTIVE);
         notificationService.notifyAction(AircraftCloner.clone(existingAircraft), Action.UPDATE);
      } else {
         // On remote base
         if (!override) {
            throwExceptionIfDataAreOlderThanCurrentStation(existingAircraft, aircraftProperties, true);
         }
         GroundStation groundStation = getOrCreateGroundStation(groundStationProperties);
         processAircraftReplacement(aircraftFolder, context, aircraftProperties, flightsProperties, newAircraft, existingAircraft, groundStation, ImportAttachOperation.ATTACH_ON_REMOTE_BASE);
         updatePendingAndOnErrorLocalDiagnoses(newAircraft.getId());
      }
   }

   private Optional<Aircraft> getOptionalAircraft(String aircraftTypeName, String aircraftFunctionalId, String aircraftSerialNumber) throws AircraftManagementException {
      Optional<Aircraft> optionalAircraftByAircraftIdAndSerialNumber = aircraftDao.findByAircraftIdAndSerialNumber(aircraftTypeName, aircraftFunctionalId, aircraftSerialNumber);
      if (optionalAircraftByAircraftIdAndSerialNumber.isPresent()) {
         return optionalAircraftByAircraftIdAndSerialNumber;
      }

      Optional<Aircraft> optionalAircraftBySerialNumber = aircraftDao.findByAircraftSerialNumber(aircraftTypeName, aircraftSerialNumber);
      Optional<Aircraft> optionalAircraftByAircraftId = aircraftDao.findByAircraftId(aircraftTypeName, aircraftFunctionalId);
      if (optionalAircraftBySerialNumber.isPresent() && optionalAircraftByAircraftId.isPresent()) {
         Aircraft aircraftBySerialNumber = optionalAircraftBySerialNumber.get();
         Aircraft aircraftByAircraftId = optionalAircraftByAircraftId.get();
         if (!aircraftBySerialNumber.getId().equals(aircraftByAircraftId.getId())) {
            // import not possible
            throw new AircraftManagementException("There are two aircrafts in the station matching an aircraft to be imported (A/C type: " + aircraftTypeName + ", ID: "
                  + aircraftByAircraftId.getAircraftId() + ", SN: " + aircraftBySerialNumber.getAircraftSerialNumber() + ")");
         }
      } else if (optionalAircraftBySerialNumber.isPresent()) {
         return optionalAircraftBySerialNumber;
      } else {
         return optionalAircraftByAircraftId;
      }

      return Optional.empty();
   }

   private void throwExceptionIfDataAreOlderThanCurrentStation(Aircraft existingAircraft, Map<String, Object> aircraftProperties, boolean askUserConfirmation)
         throws AircraftAlreadyExistsException, AircraftManagementException {
      int packageOldness = ((Number) aircraftProperties.get("version")).intValue();
      int aircraftOldness = existingAircraft.getVersion();
      if (packageOldness < aircraftOldness) {
         // Data are older => error
         String message = "Data to re-attach are older than those in the current station.";
         if (askUserConfirmation) {
            throw new AircraftAlreadyExistsException(message);
         }
         throw new AircraftManagementException(message);
      }
   }

   private void throwExceptionIfGroundStationVersionDifferent(Map<String, Object> groundStationProperties) throws EntityNotFoundException, AircraftManagementException {
      GroundStation localGroundStation = groundStationDao.getLocalGroundStation();
      String localVersion = localGroundStation.getVersionDb();
      String packageVersion = groundStationProperties.get("version").toString();
      if (!localVersion.equals(packageVersion)) {
         throw new AircraftManagementException("Local station (V" + localVersion + ") is not compatible with imported package (V" + packageVersion + ").");
      }
   }

   private void throwExceptionIfReattachOnThirdBase(Map<String, Object> groundStationProperties) throws EntityNotFoundException, AircraftManagementException {
      GroundStation localGroundStation = groundStationDao.getLocalGroundStation();
      if (!(Boolean) groundStationProperties.get("local") && !localGroundStation.getBaseName().equals(groundStationProperties.get("base_name").toString())) {
         throw new AircraftManagementException("It is not possible to attach data to a remote station which are not re-attached to its home station before.");
      }
   }

