import jakarta.persistence.TemporalType;
import jakarta.persistence.Transient;
import jakarta.persistence.UniqueConstraint;

/**
 * This class represents a flight.
 */
@Entity
@Table(name = "FLIGHT", uniqueConstraints = { @UniqueConstraint(columnNames = {
      "FLIGHT_DATE", "FLIGHT_ID", "AIRCRAFT_ID", "LOCAL" }) })
@NamedQuery(name = "findFlightsByAircraft", query = "SELECT f FROM Aircraft a JOIN a.flights f WHERE a.id = :aircraftId AND f.hasUsageData = TRUE")
@NamedQuery(name = "findAllFlightsByAircraft", query = "SELECT f FROM Aircraft a JOIN a.flights f WHERE a.id = :aircraftId")
@NamedQuery(name = "findFlightByFlightIdAndDate", query = "SELECT f FROM Aircraft a JOIN a.flights f WHERE a.id = :aircraftId AND f.flightId = :flightId AND f.date BETWEEN :date1 AND :date2")
@NamedQuery(name = "findFlightByFlightId", query = "SELECT f FROM Flight f WHERE f.id = :id")
@NamedQuery(name = "findFlightsByAircraftOlderThanDate", query = "SELECT f FROM Aircraft a JOIN a.flights f WHERE a.id = :aircraftId and f.usageStartDate < :date ")
@NamedQuery(name = "findFlightsOlderThanDate", query = "SELECT f FROM Flight f WHERE f.usageStartDate < :date ")
@NamedQuery(name = "findFlightsByAircraftOrderByDate", query = "SELECT f FROM Aircraft a JOIN a.flights f WHERE a.id = :aircraftId order by f.usageStartDate ASC")
@NamedQuery(name = "findFlightsOrderByDate", query = "SELECT f FROM Flight f order by f.usageStartDate ASC")
@NamedQuery(name = "findFlightsOrderByDateDesc", query = "SELECT f FROM Aircraft a JOIN a.flights f WHERE a.id = :aircraftId AND f.hasUsageData = TRUE ORDER BY f.usageStartDate DESC")
@NamedQuery(name = "findFlightBySensorAcquisition", query = "SELECT f FROM Aircraft a JOIN a.flights f JOIN f.sensorAcquisitions sa WHERE sa.id = :sensorAcquisitionId")
public class Flight implements Serializable {

   /**
    * Serial Id.
    */
   private static final long serialVersionUID = 1L;

   /**
    * Database Id.
    */
   @Id
   @Column(name = "ID", nullable = false)
   private String id;

   /**
    * Flight Id.
    */
   @Column(name = "FLIGHT_ID", nullable = false)
   private int flightId;

   /**
    * Start date for the flight.
    */
   @Column(name = "FLIGHT_DATE", nullable = false)
   @Temporal(TemporalType.TIMESTAMP)
   private Date date;

   /**
    * Whether the flight is local or remote.
    */
   @Column(name = "LOCAL")
   private boolean local;

   /**
    * Start date defined in usage data.
    */
   @Column(name = "USAGE_START_DATE")
   @Temporal(TemporalType.TIMESTAMP)
   private Date usageStartDate;

   /**
    * End date defined in usage data.
    */
   @Column(name = "USAGE_END_DATE")
   @Temporal(TemporalType.TIMESTAMP)
   private Date usageEndDate;

   /**
    * Jet lag for the flight
    */
   @Column(name = "JET_LAG")
   private Long jetLag;

   /**
    * Start date defined in health data.
    */
   @Column(name = "HEALTH_START_DATE")
   @Temporal(TemporalType.TIMESTAMP)
   private Date healthStartDate;

   /**
    * End date for the flight.
    */
   @Column(name = "HEALTH_END_DATE")
   @Temporal(TemporalType.TIMESTAMP)
   private Date healthEndDate;

   /**
    * Flight type.
    */
   private String flightType;

   /**
    * Flight duration.
    */
   @Column(name = "MAINTENANCE_FLIGHT_TIME")
   private long maintenanceFlightTime;

   /**
    * Maintenance start date which is the minimum between the usage start date and the first failure of the flight
    */
   @Column(name = "MAINTENANCE_START_DATE")
   @Temporal(TemporalType.TIMESTAMP)
   private Date maintenanceStartDate;

   /**
    * Maintenance end date which is the maximum between the usage end date and the last failure of the flight
    */
   @Column(name = "MAINTENANCE_END_DATE")
   @Temporal(TemporalType.TIMESTAMP)
   private Date maintenanceEndDate;

   /**
    * Number of landings (defined in USAGE data - Has to be mocked up with the only Health data feature).
    */
   @Column(name = "LANDINGS")
   private int landings;

   /**
    * Flight status.
    */
   @Transient
   private String flightStatus;

   /**
    * Configuration serial number to associate a flight with the applicable configuration that has been used to analyze all data.
    */
   @Column(name = "CONFIGURATION_SERIAL_NUMBER")
   private int configurationSerialNumber;

   /** The last download date. */
   @Column(name = "LAST_DOWNLOAD_DATE")
   @Temporal(TemporalType.TIMESTAMP)
   private Date lastDownloadDate;

   /**
    * The property unloaded is false only for SNDE flights
    */
   @Column(name = "UNLOADED")
   private boolean unloaded;

   @Column(name = "HAS_USAGE_DATA")
   private boolean hasUsageData = true;

   @Column(name = "HAS_FDCR_DATA")
   private boolean hasFdcrData;

   /** The sensor acquisitions. */
   @ServerOnly
   @OneToMany(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "FLIGHT_ID", updatable = false)
   private Set<SensorAcquisition> sensorAcquisitions = new HashSet<>();

   /** The M'ARMS acquisitions. */
   @ServerOnly
   @OneToMany(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "FLIGHT_ID", updatable = false)
   private Set<MarmsMechanicalComponentAcquisition> mechanicalComponentAcquisitions = new HashSet<>();

   /** The engine vibration acquisitions. */
   @ServerOnly
   @OneToMany(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "FLIGHT_ID", updatable = false)
   private Set<EngineAcquisition> engineAcquisition = new HashSet<>();

   /** The contextual acquisitions. */
   @OneToMany(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "FLIGHT_ID", updatable = false)
   private Set<ContextualAcquisition> contextualAcquisitions = new HashSet<>();

   /** The main rotor acquisition. */
   @ServerOnly
   @OneToOne(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "MAIN_ROTOR_ACQUISITION_ID")
   private RotorAcquisition mainRotorAcquisition;

   /** The tail rotor acquisition. */
   @ServerOnly
   @OneToOne(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "TAIL_ROTOR_ACQUISITION_ID")
   private RotorAcquisition tailRotorAcquisition;

   /** The flight hour data. */
   @ServerOnly
   @OneToOne(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "FLIGHT_HOUR_DATA_ID")
   private FlightHourData flightHourData;

   /** The usage flight data. */
   @ServerOnly
   @OneToOne(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "USAGE_FLIGHT_DATA_ID")
   private UsageFlightData usageFlightData;

   /** The alarms. */
   @ServerOnly
   @OneToMany(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "FLIGHT_ID", updatable = false)
   private Set<Alarm> alarms = new HashSet<>();

   /** The failure groups. */
   @ServerOnly
   @OneToMany(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "FLIGHT_ID", updatable = false)
   private Set<FailureGroup> failureGroups = new HashSet<>();

   /** The flight indicator values. */
   @ServerOnly
   @OneToMany(cascade = CascadeType.ALL, fetch = FetchType.LAZY, orphanRemoval = true)
   @JoinColumn(name = "FLIGHT_ID", updatable = false)
   private Set<FlightIndicatorValue> flightIndicatorValues = new HashSet<>();

