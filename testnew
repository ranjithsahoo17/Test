   public void exportAircraft(String aircraftId, String registerNumber, File destination) throws EntityNotFoundException, AircraftManagementException,
         NotificationException, AircraftConcurrentAccessException, AircraftExportDetachException {
      String zipName = "MGS_Export_" + removeInvalidCharacters(registerNumber) + "_" + dateFormat.format(Calendar.getInstance(TimeZone.getTimeZone("GMT")).getTime()) + ".zip";
      try {
         TopicDto topicDto = notificationManager.createTopicDto();
         String sftpServerDirectory = buildSftpUrl("/" + SFTP_EXPORT_DIR_NAME + "/" + zipName);
         File exportDirectory = new File(sftpServerManager.getHomeDirectory() + "/" + SFTP_EXPORT_DIR_NAME);
         if (!exportDirectory.exists()) {
            exportDirectory.mkdirs();
         }
         File exportedFile = new File(sftpServerManager.getHomeDirectory() + new URI(sftpServerDirectory).getPath());
         aircraftManagementService.exportAircraft(aircraftId, new AircraftManagementDto(sftpServerDirectory), topicDto);
         LOGGER.info("Transferring export file to client");
         FileUtils.copyFileToDirectory(exportedFile, destination);
      } catch (IOException | URISyntaxException e) {
         handleExportDetachException(aircraftId, destination, zipName, e);
      } finally {
         File toBeDeleted = new File(sftpServerManager.getHomeDirectory(), SFTP_EXPORT_DIR_NAME + "/" + zipName);
         FileUtils.deleteQuietly(toBeDeleted);
      }
   }

   @Override
   public void unfreezeAircraft(String aircraftId) throws EntityNotFoundException, NotificationException, AircraftConcurrentAccessException {
      aircraftManagementService.unfreezeAircraft(aircraftId);
   }

   @Override
   public void deleteAircraft(String aircraftId) throws EntityNotFoundException, NotificationException, AircraftConcurrentAccessException {
      TopicDto topicDto = notificationManager.createTopicDto();
      aircraftManagementService.deleteAircraft(aircraftId, topicDto);
   }

   public void setSftpServerManager(SftpServerManager sftpServerManager) {
      this.sftpServerManager = sftpServerManager;
   }

   @Override
   public void attachAircraft(File file, boolean override) throws AircraftAlreadyExistsException, EntityNotFoundException, AircraftManagementException,
         NotificationException {
      try {
         String sourcePath = getImportSourcePath(file);
         TopicDto topicDto = notificationManager.createTopicDto();
         aircraftManagementService.attachAircraft(new AircraftManagementDto(sourcePath), topicDto, override);
      } catch (MalformedURLException | URISyntaxException e) {
         throw new AircraftManagementException("Error while copying file to sftp server", e);
      } finally {
         File toBeDeleted = new File(sftpServerManager.getHomeDirectory(), SFTP_IMPORT_DIR_NAME + "/" + file.getName());
         FileUtils.deleteQuietly(toBeDeleted);
      }
   }

   @Override
   public void detachAircraft(String aircraftId, String registerNumber, File destination, Date detachDate) throws EntityNotFoundException,
         AircraftManagementException,
         NotificationException, AircraftConcurrentAccessException, AircraftExportDetachException {
      String zipName = "MGS_Detachment_" + removeInvalidCharacters(registerNumber) + "_" + dateFormat.format(Calendar.getInstance(TimeZone.getTimeZone("GMT")).getTime()) + ".zip";
      try {
         TopicDto topicDto = notificationManager.createTopicDto();
         // URL ftpServerDirectory = new URI(sftpServerManager.getSftpServerAddress() + "/" + SFTP_EXPORT_DIR_NAME + "/" + zipName).toURL();
         String ftpServerDirectory = buildSftpUrl("/" + SFTP_EXPORT_DIR_NAME + "/" + zipName);

         File detachDirectory = new File(sftpServerManager.getHomeDirectory() + "/" + SFTP_EXPORT_DIR_NAME);
         if (!detachDirectory.exists()) {
            detachDirectory.mkdirs();
         }
         File detachedFile = new File(sftpServerManager.getHomeDirectory() + new URI(ftpServerDirectory).getPath());
         aircraftManagementService
               .detachAircraft(aircraftId, detachDate, new AircraftManagementDto(ftpServerDirectory), topicDto);
         FileUtils.copyFileToDirectory(detachedFile, destination);
      } catch (IOException | URISyntaxException e) {
         handleExportDetachException(aircraftId, destination, zipName, e);
      } finally {
         File toBeDeleted = new File(sftpServerManager.getHomeDirectory(), SFTP_EXPORT_DIR_NAME + "/" + zipName);
         FileUtils.deleteQuietly(toBeDeleted);
      }
   }

   private void handleExportDetachException(String aircraftId, File destination, String zipName, Exception e)
         throws EntityNotFoundException, NotificationException, AircraftConcurrentAccessException, AircraftExportDetachException {
      aircraftManagementService.unfreezeAircraft(aircraftId);
      File fileToDelete = new File(destination.getAbsolutePath() + "/" + zipName);
      if (fileToDelete.exists()) {
         FileUtils.deleteQuietly(fileToDelete);
      }
      throw new AircraftExportDetachException(e.getMessage(), e);
   }

   private String getImportSourcePath(File file) throws AircraftManagementException, MalformedURLException, URISyntaxException {
      File destinationDirectory = new File(sftpServerManager.getHomeDirectory(), SFTP_IMPORT_DIR_NAME);
      if (!destinationDirectory.exists()) {
         destinationDirectory.mkdirs();
      }
      try {
         FileUtils.copyFileToDirectory(file, destinationDirectory);
      } catch (IOException e) {
         throw new AircraftManagementException("Error while copying file to sftp server", e);
      }
      // return new URI(sftpServerManager.getSftpServerAddress() + "/" + SFTP_IMPORT_DIR_NAME + "/" + file.getName()).toURL();
      return buildSftpUrl("/" + SFTP_IMPORT_DIR_NAME + "/" + file.getName());
   }

   /**
    * Creates a configuration DTO from an XML file set.
    * 
    * @param configurationDto
    *           the configuration dto
    * @param rtbTuningsDto
    *           the rtb tunings dto
    *
    * @return the aircraft configuration dto
    * @throws JAXBException
    *            the JAXB exception
    * @throws IOException
    *            Signals that an I/O exception has occurred.
    * @throws URISyntaxException
    */
   private AircraftConfigurationDto createAircraftConfigurationDto(ConfigurationDto configurationDto, RtbTuningsDto rtbTuningsDto) throws IOException, URISyntaxException {

      AircraftConfigurationDto acConfigurationDto = new AircraftConfigurationDto();
      acConfigurationDto.setRtbTunings(rtbTuningsDto);

      tempFolder = SFTP_CONFIGURATION_DIR_NAME + "/" + dateFormat.format(Calendar.getInstance(
            TimeZone.getTimeZone("GMT")).getTime()) + "/";
      File configurationDirectory = new File(sftpServerManager.getHomeDirectory(), tempFolder);
      if (!configurationDirectory.exists() && !configurationDirectory.mkdirs()) {
         throw new IOException("Unable to create directory: " + configurationDirectory.getAbsolutePath());
      }
      String basePath = "/" + tempFolder;

      if (configurationDto.getHealthConfigurationFile() != null) {
         FileUtils.copyFile(configurationDto.getHealthConfigurationFile(), new File(configurationDirectory, "health.zip"));
         acConfigurationDto.setHealthConfiguration(buildSftpUrl(basePath + "health.zip"));
      }
      if (configurationDto.getUsageConfigurationFile() != null) {
         FileUtils.copyFile(configurationDto.getUsageConfigurationFile(), new File(configurationDirectory, "usage.xml"));
         acConfigurationDto.setUsageConfiguration(buildSftpUrl(basePath + "usage.xml"));
      }

      if (configurationDto.getSfmConfigurationFile() != null) {
         FileUtils.copyFile(configurationDto.getSfmConfigurationFile(), new File(configurationDirectory, "sfm.xml"));
         acConfigurationDto.setSfmConfiguration(buildSftpUrl(basePath + "sfm.xml"));
      }
      if (configurationDto.getLocalDiagnosisConfigurationFile() != null) {
         FileUtils.copyFile(configurationDto.getLocalDiagnosisConfigurationFile(), new File(configurationDirectory, "local-diag.zip"));
         acConfigurationDto.setLocalDiagnosisConfiguration(buildSftpUrl(basePath + "local-diag.zip"));
      }
      if (configurationDto.getFdcrConfigurationFile() != null) {
         FileUtils.copyFile(configurationDto.getFdcrConfigurationFile(), new File(configurationDirectory, "fdcr.zip"));
         acConfigurationDto.setFdcrConfiguration(buildSftpUrl(basePath + "fdcr.zip"));
      }
      if (configurationDto.getRtbParameterFile() != null) {
         FileUtils.copyFile(configurationDto.getRtbParameterFile(), new File(configurationDirectory, "rtb.zip"));
         acConfigurationDto.setRtbConfiguration(buildSftpUrl(basePath + "rtb.zip"));
      }
      if (configurationDto.getFailureContextMonitoringConfigurationFile() != null) {
         FileUtils.copyFile(configurationDto.getFailureContextMonitoringConfigurationFile(), new File(configurationDirectory, "failure-ctxt-monitoring.zip"));
         acConfigurationDto.setFailureContextMonitoringConfiguration(buildSftpUrl(basePath + "failure-ctxt-monitoring.zip"));
      }

      if (configurationDto.getDmauFailuresConfigurationFile() != null) {
         FileUtils.copyFile(configurationDto.getDmauFailuresConfigurationFile(), new File(configurationDirectory, "dmau-failures.xml"));
         acConfigurationDto.setDmauFailuresConfiguration(buildSftpUrl(basePath + "dmau-failures.xml"));
      }
      if (configurationDto.getMarmsSystemStatusConfigurationFile() != null) {
         FileUtils.copyFile(configurationDto.getMarmsSystemStatusConfigurationFile(), new File(configurationDirectory, "marms-system-status.xml"));
         acConfigurationDto.setMarmsSystemStatusConfiguration(buildSftpUrl(basePath + "marms-system-status.xml"));
      }
      if (configurationDto.getRawDataFilteringConfigurationFile() != null) {
         FileUtils.copyFile(configurationDto.getRawDataFilteringConfigurationFile(), new File(configurationDirectory, "raw-data-filtering.xml"));
         acConfigurationDto.setRawDataFilteringConfiguration(buildSftpUrl(basePath + "raw-data-filtering.xml"));
      }
      return acConfigurationDto;
   }

   private void deleteTempFolder() {
      // delete quietly temp folder
      FileUtils.deleteQuietly(new File(sftpServerManager.getHomeDirectory() + "/" + tempFolder));
   }

   private String buildSftpUrl(String absolutePath) throws URISyntaxException, MalformedURLException {
      return new URI("sftp", sftpServerManager.getUsername() + ":" + sftpServerManager.getPassword(), sftpServerManager.getHost(), sftpServerManager.getPort(), absolutePath, null, null).toString();
   }

   private String removeInvalidCharacters(String str) {
      // Replace the invalid characters for Windows files name.
      return str.replaceAll("[^a-zA-Z0-9._]", "-");
   }
