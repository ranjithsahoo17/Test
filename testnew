   /**
    * Bug fix : this method retrieves the sub curves (thresholds) of previously removed models.
    * The previously removed sub curves are saved in the backupUpSubCurves map.
    * 
    * @param newModels new models to be added to the graph
    * 
    */
   private void restoreSubCurves(List<ChartElementModel<Double>> newModels) {	   
	   List<ChartElementModel<Double>> subCurves = new ArrayList<>();
	   if (newModels != null && !newModels.isEmpty()) {
         for (ChartElementModel<Double> model : newModels) {
            if (!model.isFlagIsSubCurve()) {
               Set<ChartElementModel<Double>> listSubCurves = backupUpSubCurves.get(model.getYTitle());
               if (listSubCurves != null && !listSubCurves.isEmpty()) {
                  for (ChartElementModel<Double> subCurve : listSubCurves) {
                	  if (!newModels.contains(subCurve)) { 
                		  subCurves.add(subCurve);
                	  }
                  }
               }
            }
         }
      }
      newModels.addAll(subCurves);
   }

   /**
    * Retrieve models to be added.
    * 
    * @param newModels
    *           models to be added
    * @return the list of models to be added
    */
   private List<ChartElementModel<Double>> retrieveModelToAdd(
         List<ChartElementModel<Double>> newModels) {
      List<ChartElementModel<Double>> added = new ArrayList<>();
      // to added
      for (ChartElementModel<Double> indicator : newModels) {
         ChartElementModel<Double> tmp = getChartElement(indicator.getYTitle(), indicators);
         if (tmp == null) {
            if (indicator.getColor() == null) {
               if (!indicator.isFlagIsSubCurve()) {
                  indicator.setColor(colorGenerator.getNextColor());
               } else {
                  // Need to retrieve color from parent
                  Color parentColor = retrieveColorFromParent(indicator.getMainTitle(), newModels);
                  if (parentColor == null) {
                     throw new IllegalStateException("No parent color found");
                  }
                  indicator.setColor(parentColor);
               }
            }
            added.add(indicator);
            if (indicator.isFlagIsSubCurve()) {
               // backup sub curve
               Set<ChartElementModel<Double>> listSubCurves = backupUpSubCurves.get(indicator.getMainTitle());
               if (listSubCurves == null) {
                  listSubCurves = new HashSet<>();
               }
               listSubCurves.add(indicator);
               backupUpSubCurves.put(indicator.getMainTitle(), listSubCurves);
            }
         } else {
            indicator.setColor(tmp.getColor());
         }
      }
      return added;
   }

   /**
    * Retrieve models to be removed.
    * 
    * @param newModels
    *           models to be added
    * @return the list of models to be removed
    */
   private List<ChartElementModel<Double>> retrieveModelToRemove(List<ChartElementModel<Double>> newModels) {
      List<ChartElementModel<Double>> removed = new ArrayList<>();
      // to be removed
      if (indicators != null) {
         for (ChartElementModel<Double> indicator : indicators) {
            ChartElementModel<Double> tmp = getChartElement(indicator.getYTitle(), newModels);
            if (tmp == null) {
               removed.add(indicator);
               if (!indicator.isFlagIsSubCurve()) {
                  // Mark the color user by indicator as available
                  colorGenerator.addColor(indicator.getColor());
               } else {
                  // remove sub curves from backup
                  backupUpSubCurves.remove(indicator.getYTitle());
               }
            } else {
               // Mark the color user by indicator as used
               if (!indicator.isFlagIsSubCurve()) {
                  colorGenerator.removeColor(indicator.getColor());
               }
            }
         }
      }
      return removed;
   }

   /**
    * Search for ChartElementModel contained in the list with the name.
    * 
    * @param name
    *           the name searched
    * @param list
    *           the list of ChartElementModel
    * @return ChartElementModel is found, null other whise
    */
   private static ChartElementModel<Double> getChartElement(String name, List<ChartElementModel<Double>> list) {
      ChartElementModel<Double> result = null;
      if (list != null && name != null) {
         for (ChartElementModel<Double> chartElementModel : list) {
            if (name.equals(chartElementModel.getYTitle())) {
               result = chartElementModel;
               break;
            }
         }
      }
      return result;
   }

   /**
    * Retrieve color form the indicator of the list who has the name.
    * 
    * @param pTitle
    *           to search
    * @param chartElementModels
    *           to search inside
    * @return the color found or null
    */
   private Color retrieveColorFromParent(String pTitle, List<ChartElementModel<Double>> chartElementModels) {
      for (ChartElementModel<Double> chartElementModel : chartElementModels) {
         if (!chartElementModel.isFlagIsSubCurve() && chartElementModel.getYTitle().equals(pTitle)) {
            return chartElementModel.getColor();
         }
      }
      return null;
   }

   /**
    * * Create the chart with data <strong>To be called in AWT thread !</strong>.
    * 
    * @param flightModels
    * 
    * @param model
    *           model
    * @throws ChartException
    *            the chart exception
    */
   private void createChart(List<FlightModel> flightModels, ChartElementModel<Double> model) {
      MainChartConfig<Double> config = chartFactory.getMainChartConfigDouble(ChartType.XYCHART, true);
      // Create flightBackGround
      Map<FlightModel, Duration> fhAtBeginningOfFlight = new HashMap<>();
      Map<FlightModel, Duration> fhAtEndingOfFlight = new HashMap<>();
      for (FlightModel healthFlightModel : flightModels) {
         fhAtBeginningOfFlight.put(healthFlightModel, healthFlightModel.getBeginningOfFlightForDisplay(chartParameter.isGroundAcquisitionMode()));
         fhAtEndingOfFlight.put(healthFlightModel, healthFlightModel.getEndOfFlightForDisplay(chartParameter.isGroundAcquisitionMode()));
      }
      config.setFlightBackGroundDataModelList(chartFactory.createFlightBackGroundFlightHours(flightModels, fhAtBeginningOfFlight, fhAtEndingOfFlight));

      config.setVerticalCursorFlightHours(true);

      chart = chartFactory.getMainChart(model, config);

      indicatorTrendMarkerHandler = new IndicatorTrendMarkerHandler(view.getNodeModel(), chart, chartParameter, flightModels);
      chart.getMainChartPanel().setRightClickMouseListener(indicatorTrendMarkerHandler);
      toolTipListener = new ToolTipListener(config);
      toolTipListener.setSelectedContextualData(selectedContextualData);
      chart.addChartTooltipListener(toolTipListener);
      chartElementRemovedListener = new ChartElementRemovedListener<>() {
         @Override
         public void chartRemoved(ChartElementModel<Double> chartElementRemoved) {
            if (showFdcrData && chartElementRemoved.getyTitleUninternationalized() != null) {
               fdcrSelectComposite.removeSelectedFdcrParameter(chartElementRemoved.getyTitleUninternationalized());
            }
            indicators.remove(chartElementRemoved);
            removeSelectionIfNecessary(chartElementRemoved);
            uncheckIndicator(chartElementRemoved);
         }

         @Override
         public void chartRemovedAll() {
            if (indicators != null && !indicators.isEmpty()) {
               for (ChartElementModel<Double> chartElementModel : indicators) {
                  uncheckIndicator(chartElementModel);
               }
               indicators.clear();
            }
            view.unselectSample();
         }
      };
      chart.addChartElementRemoveListener(chartElementRemovedListener);

      chartElementAddedListener = chartElementAdded -> {
         if (chart.getNumberMasterCurveDisplay() > 1) {
            getDisplay().asyncExec(() -> {
               if (!isDisposed()) {
                  btnShowLocationBar.setSelection(true);
                  // Configure chart axis
                  if (chart != null) {
                     chart.setYAxisVisible(btnShowYAxis.getSelection());
                     chart.setLocationBarsVisible(btnShowLocationBar.getSelection());
                  }
               }
            });
         }
      };
      chart.addChartElementAddedListener(chartElementAddedListener);

      chartElementSelectedListener = (pointSelected, chartElementSelected) -> {
         Object data = chartElementSelected.getData();
         if (data instanceof IndicatorChartModelData indicatorChartModelData) {
            indicatorChartModelData.setColor(chartElementSelected
                  .getColor());
            view.selectSample(indicatorChartModelData, pointSelected.x);
         } else {
            view.unselectSample();
         }
      };
      chart.addChartElementSelectedListener(chartElementSelectedListener);

      // add an event listener to manage the selection of the learned threshold curves
      curveClickListener = new ChartPlotClickedOnCurveListener<>() {
         @Override
         public void clickedOnCurve(final ChartElementModel<Double> chartElement, final String s,
               final String s1) {
            final BundleContext healthBundleContext = FrameworkUtil.getBundle(IHealthCommonBusiness.class).getBundleContext();
            final IHealthCommonBusiness healthBusiness = healthBundleContext.getService(healthBundleContext.getServiceReference(IHealthCommonBusiness.class));
            final Display defaultDisplay = Display.getDefault();
            if (chartElement.getData() == null) {
               return;
            }
            Runnable threadLearning = new Runnable() {
               @Override
               public void run() {
                  LOGGER.debug("Starting threshold learning."); //$NON-NLS-1$
                  try {
                     // create the threshold learning dialog window
                     ThresholdLearningData thresholdLearningData = (ThresholdLearningData) chartElement.getData();
                     final ThresholdLearningDialog dialog = new ThresholdLearningDialog(thresholdLearningData.getLearningTime());
                     if (dialog.open() == Window.OK) {
                        synchronized (this) {
                           // get the learned threshold
                           List<String> learnedThresholdIds = new ArrayList<>(thresholdLearningData.getThresholdIds());
                           // create the threshold learning requests
                           String learningReason = dialog.getModel().getLearningReason();
                           long historyLearningTime = dialog.getModel().getHistoryLearningTime();
                           final User currentUser = MgsSession.getInstance().getUser();
                           final Aircraft aircraft = MgsSession.getInstance().getAircraft();
                           healthBusiness.createRelearnThresholdRequests(aircraft.getId(), learnedThresholdIds, historyLearningTime, learningReason, currentUser.getLoginName());
                        }
                        MgsEventManager.getInstance().publishEvent(null, new LearningThresholdUpdated());
                     }
                  } catch (AircraftConcurrentAccessException e) {
                     StatusManager.getManager().handle(AircraftExceptionHandler.getStatusForAircraftException(e, "relearn", Activator.PLUGIN_ID), StatusManager.BLOCK);
                  } catch (AircraftFrozenException e) {
                     StatusManager.getManager().handle(new GenericStatus(IStatus.ERROR, Activator.PLUGIN_ID, Messages.CORE.getString("relearn.aborted.aircraftFrozen"), e), StatusManager.BLOCK); //$NON-NLS-1$
                  } catch (ServiceException e) {
                     StatusManager.getManager().handle(new GenericStatus(IStatus.ERROR, Activator.PLUGIN_ID, Messages.CORE.getString("relearn.aborted"), e), StatusManager.BLOCK); //$NON-NLS-1$
                  }
                  LOGGER.debug("Ending threshold learning."); //$NON-NLS-1$
               }
            };
            defaultDisplay.asyncExec(threadLearning);
         }
      };
      chart.addChartPlotClickedOnCurveListener(curveClickListener);

      // add an event listener to select in the flight list the displayed fight in the chart background
      flightBackgroundChangeListener = flightId -> {
         final BundleContext flightBundleContext = FrameworkUtil.getBundle(IFlightBusiness.class).getBundleContext();
         final IFlightBusiness flightBusiness = flightBundleContext.getService(flightBundleContext.getServiceReference(IFlightBusiness.class));
         final Flight flight = flightBusiness.getFlight(flightId, MgsSession.getInstance().isConnected());

         Runnable backgroundChangeThread = () -> {
            // initialize the event to send
            MgsSession.getInstance().setFlight(flight);
            // publish to event to select the flight in the flight list
            MgsEventManager.getInstance().publishEvent(null, new FlightSelectionEvent(
                  flight));
         };
         Display.getDefault().asyncExec(backgroundChangeThread);
      };
      chart.addFlightBackgroundChangeListener(flightBackgroundChangeListener);
      chart.getPlotManager().addDomainAxisChangeListener(domainAxisChangeListener);

      chartFrame.add(chart.getMainPanel());
      chartFrame.validate();
   }

   /**
    * Update the trend display.
    * 
    * <br />
    * <strong>To be called in AWT thread !</strong>
    * 
    * @param flightModels
    * 
    * @param added
    *           the list of indicators to be added to the display.
    * @param removed
    *           the list of indicators to be removed from the display.
    * @throws ChartException
    *            the chart exception
    */
   private void updateChart(List<FlightModel> flightModels, final List<ChartElementModel<Double>> added, final List<ChartElementModel<Double>> removed) {
      for (ChartElementModel<Double> model : added) {
         try {
            if (chart == null) {
               // first time
               createChart(flightModels, model);
            } else {
               if (!model.isFlagIsSubCurve()) {
                  chart.addCurve(model);
               } else {
                  chart.addSubCurve(model.getMainTitle(), model);
               }
            }
         } catch (ChartException e) {
            LOGGER.warn(e.getMessage(), e);
            throw new UnhandledException(e);
         }
      }

      refreshMarkers();

      //
      for (ChartElementModel<Double> model : removed) {
         removeSelectionIfNecessary(model);
         chart.removeCurve(model.getYTitle());
      }
   }

   /**
    * Show the indicator success rate.
    * 
    * @param show
    *           <code>true</code> to show it, <code>false</code> to hide it.
    */
   private void showSuccessRate(final boolean show) {
      if (chart != null) {
         try {
            SwingUtilities.invokeAndWait(() -> {
               try {
                  if (successRateModel != null) {
                     if (show) {
                        chart.addCurve(successRateModel);
                     } else {
                        chart.removeCurve(successRateModel.getYTitle());
                     }
                  }
               } catch (ChartException e) {
                  LOGGER.error(e.getMessage(), e);
                  throw new UnhandledException(e);
               }
            });
         } catch (InterruptedException e) {
            LOGGER.error(e.getMessage(), e);
