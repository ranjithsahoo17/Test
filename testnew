import org.apache.logging.log4j.Logger;
import org.eclipse.persistence.exceptions.DatabaseException;

import com.eurocopter.mgs.datamodel.aircraft.Aircraft;
import com.eurocopter.mgs.datamodel.aircraft.configuration.AircraftHistory;
import com.eurocopter.mgs.datamodel.aircraft.monitoring.AircraftStatus;
import com.eurocopter.mgs.datamodel.alarm.Alarm;
import com.eurocopter.mgs.datamodel.flight.Flight;
import com.eurocopter.mgs.service.aircraft.exception.AircraftAlreadyExistsException;
import com.eurocopter.mgs.service.exception.EntityNotFoundException;

import jakarta.ejb.Local;
import jakarta.ejb.Stateless;
import jakarta.persistence.EntityManager;
import jakarta.persistence.NoResultException;
import jakarta.persistence.PersistenceContext;
import jakarta.persistence.PersistenceException;
import jakarta.persistence.TypedQuery;

/**
 * This class represents the aircraft dao. This dao contains methods to retrieve aircrafts data from the database.
 */
@Local
@Stateless
public class AircraftDao {

   /** Class logger. */
   private static final Logger LOGGER = LogManager.getLogger(AircraftDao.class);

   @PersistenceContext
   private EntityManager manager;

   public void create(Aircraft entity) throws AircraftAlreadyExistsException {
      try {
         manager.persist(entity);
         manager.flush();
      } catch (PersistenceException e) {
         if (e.getCause() instanceof DatabaseException) {
            LOGGER.error("Could not create aircraft", e);
            throw new AircraftAlreadyExistsException("Aircraft already exists: " + entity);
         }
      }
   }

   public Aircraft findById(String id) throws EntityNotFoundException {
      Aircraft aircraft = manager.find(Aircraft.class, id);
      if (aircraft != null) {
         return aircraft;
      } else {
         throw new EntityNotFoundException("Aircraft not found: id=" + id);
      }
   }

   public Optional<Aircraft> findByAircraftId(String aircraftType, String aircraftId) {
      TypedQuery<Aircraft> query = manager.createNamedQuery("findAircraftByAircraftId", Aircraft.class);
      query.setParameter("aircraftType", aircraftType);
      query.setParameter("aircraftId", aircraftId);
      try {
         return Optional.of(query.getSingleResult());
      } catch (NoResultException e) {
         LOGGER.debug("No result", e);
         return Optional.empty();
      }
   }

   public Optional<Aircraft> findByAircraftIdAndSerialNumber(String aircraftType, String aircraftId, String aircraftSerialNumber) {
      TypedQuery<Aircraft> query = manager.createNamedQuery("findAircraftByAircraftIdAndSerialNumber", Aircraft.class);
      query.setParameter("aircraftType", aircraftType);
      query.setParameter("aircraftId", aircraftId);
      query.setParameter("aircraftSerialNumber", aircraftSerialNumber);
      try {
         return Optional.of(query.getSingleResult());
      } catch (NoResultException e) {
         LOGGER.debug("No result", e);
         return Optional.empty();
      }
   }

   public Optional<Aircraft> findByAircraftSerialNumber(String aircraftType, String aircraftSerialNumber) {
      TypedQuery<Aircraft> query = manager.createNamedQuery("findAircraftByAircraftSerialNumber", Aircraft.class);
      query.setParameter("aircraftType", aircraftType);
      query.setParameter("aircraftSerialNumber", aircraftSerialNumber);
      try {
         return Optional.of(query.getSingleResult());
      } catch (NoResultException e) {
         LOGGER.debug("No result", e);
         return Optional.empty();
      }
   }

   public List<Aircraft> findAll() {
      TypedQuery<Aircraft> query = manager.createNamedQuery("findAircrafts", Aircraft.class);
      List<Aircraft> aircrafts = query.getResultList();
      if (aircrafts != null) {
         for (Aircraft aircraft : aircrafts) {
            aircraft.getAccelerometers().size(); // Initialize accelerometer collection
            aircraft.getFolders().size(); // Initialize folder collection
         }
         return aircrafts;
      } else {
         return Collections.emptyList();
      }
   }

   public void updateAircraftStatus(String aircraftId) {
      updateAircraftStatus(manager.find(Aircraft.class, aircraftId));
   }

   public void updateAircraftStatus(Aircraft aircraft) {
      List<Alarm> alarms = new ArrayList<>();
      for (Flight flight : aircraft.getFlights()) {
         alarms.addAll(flight.getAlarms());
      }

      AircraftStatus status = AircraftStatus.getLowestStatus();
      for (Alarm alarm : alarms) {
         status = AircraftStatus.getHighestStatus(status, alarm.getAlarmFullState());
         if (status == AircraftStatus.getHighestStatus()) {
            break;
         }
      }

      aircraft.setAircraftStatus(status);
   }

   public Optional<Flight> getLastFlight(final String aircraftId) {
      TypedQuery<Flight> queryLastFlight = manager.createNamedQuery("findFlightsOrderByDateDesc", Flight.class);
      queryLastFlight.setParameter("aircraftId", aircraftId);
      queryLastFlight.setMaxResults(1);
      List<Flight> flights = queryLastFlight.getResultList();
      if (flights.isEmpty()) {
         return Optional.empty();
      }
      return Optional.of(flights.get(0));
   }

   public Optional<Flight> getPrevisousFlight(final String aircraftId, final Flight flight) {
      TypedQuery<Flight> querySecondLastFlight = manager.createNamedQuery("findFlightsByAircraftOlderThanDate", Flight.class);
      querySecondLastFlight.setParameter("aircraftId", aircraftId);
      querySecondLastFlight.setParameter("date", flight.getUsageStartDate());
      querySecondLastFlight.setMaxResults(1);
      List<Flight> flights = querySecondLastFlight.getResultList();
      if (flights.isEmpty()) {
         return Optional.empty();
      }
      return Optional.of(flights.get(0));
   }

   public void flush() {
      manager.flush();
   }

   public void clear() {
      manager.clear();
   }

   public AircraftHistory getAircraftHistory(String aircraftId) {
      TypedQuery<Object[]> query = manager.createNamedQuery("sumPurgedFlightsForAircraft", Object[].class);
      query.setParameter("aircraftId", aircraftId);
      List<Object[]> results = query.getResultList();
      if (results.isEmpty()) {
         return new AircraftHistory();
      }
      Object[] row = results.get(0);
      return new AircraftHistory((Long) row[0], (Long) row[1], (Long) row[2], (Long) row[3]);
   }
}


