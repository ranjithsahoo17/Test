package com.eurocopter.mgs.datamodel.health.monitoring;

import java.io.Serializable;
import java.util.Date;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.NamedQuery;
import jakarta.persistence.Table;
import jakarta.persistence.Temporal;
import jakarta.persistence.TemporalType;

/**
 * Entity that represents a request to re-learn a threshold.
 */
@Entity
@Table(name = "RELEARN_THRESHOLD_REQUEST")
@NamedQuery(name = "findRelearnRequestsByThreshold", query = "SELECT rr FROM LearnedThresholdConfiguration ltc JOIN ltc.relearnRequests rr WHERE ltc.threshold.id = :thresholdId")
public class RelearnThresholdRequest implements Serializable {

   private static final long serialVersionUID = 1L;

   /**
    * Database ID
    */
   @Id
   @Column(name = "ID", nullable = false)
   private String id;

   /**
    * Textual description of the reason of the re-learn
    */
   @Column(name = "DESCRIPTION")
   private String description;

   /**
    * Effective date/time of the launch of the re-learn process
    */
   @Temporal(TemporalType.TIMESTAMP)
   private Date startDate;

   /**
    * Applicable date/time of the learned value. Flight download date shall be used for the comparison
    */
   @Temporal(TemporalType.TIMESTAMP)
   private Date endDate;

   @Temporal(TemporalType.TIMESTAMP)
   @Column(name = "APPLICABLE_FLIGHT_DATE")
   private Date applicableFlightDate;

   @Temporal(TemporalType.TIMESTAMP)
   @Column(name = "START_FLIGHT_DATE")
   private Date startFlightDate;

   /**
    * Is handled
    */
   @Column(name = "HANDLED", nullable = false)
   private boolean handled;

   @Column(name = "HISTORY_LEARNING_TIME", nullable = false)
   private long historyLearningTime;

   /**
    * Value computed after learning
    */
   @Column(name = "learnedValue")
   private Double learnedValue;

   @Column(name = "CREATE_MARKER")
   private boolean createMarker;

   RelearnThresholdRequest() {
   }

   public RelearnThresholdRequest(String id) {
      this.id = id;
      createMarker = true;
   }

   public String getId() {
      return id;
   }

   public String getDescription() {
      return description;
   }

   public void setDescription(String description) {
      this.description = description;
   }

   public Date getStartDate() {
      return startDate;
   }

   public void setStartDate(Date effectiveDate) {
      startDate = effectiveDate;
   }

   public Date getEndDate() {
      return endDate;
   }

   public void setEndDate(Date endDate) {
      this.endDate = endDate;
   }

   public boolean isHandled() {
      return handled;
   }

   public void setHandled(boolean handled) {
      this.handled = handled;
   }

   public void setHistoryLearningTime(long historyLearningTime) {
      this.historyLearningTime = historyLearningTime;
   }

   public long getHistoryLearningTime() {
      return historyLearningTime;
   }

   public void setLearnedValue(Double learnedValue) {
      this.learnedValue = learnedValue;
   }

   public Double getLearnedValue() {
      return learnedValue;
   }

   public boolean isCreateMarker() {
      return createMarker;
   }

   public void setCreateMarker(boolean createMarker) {
      this.createMarker = createMarker;
   }

   public Date getApplicableFlightDate() {
      return applicableFlightDate;
   }

   public void setApplicableFlightDate(Date applicableFlightDate) {
      this.applicableFlightDate = applicableFlightDate;
   }

   public Date getStartFlightDate() {
      return startFlightDate;
   }

   public void setStartFlightDate(Date startFlightDate) {
      this.startFlightDate = startFlightDate;
   }

   @Override
   public int hashCode() {
      final int prime = 31;
      int result = 1;
      result = prime * result + ((id == null) ? 0 : id.hashCode());
      return result;
   }

   @Override
   public boolean equals(Object obj) {
      if (this == obj) {
         return true;
      }
      if (obj == null) {
         return false;
      }
      if (getClass() != obj.getClass()) {
         return false;
      }
      RelearnThresholdRequest other = (RelearnThresholdRequest) obj;
      if (id == null) {
         return other.id == null;
      } else
         return id.equals(other.id);
   }

   @Override
   public String toString() {
      return "RelearnThresholdRequest [id=" + id + ", description=" + description + ", effectiveDate=" + startDate + ", handled=" + handled + "]";
   }
}



