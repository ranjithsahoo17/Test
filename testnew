package com.eurocopter.mgs.presentation.utils;

import java.util.ArrayList;
import java.util.List;

import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;
import org.osgi.framework.BundleContext;
import org.osgi.framework.FrameworkUtil;

import com.eurocopter.mgs.business.health.api.IHealthCommonBusiness;
import com.eurocopter.mgs.presentation.common.MgsSession;
import com.eurocopter.mgs.service.health.common.dto.IndicatorDeviationDto;

/**
 * BCR-6605 helpers for the configuration update warnings.
 */
public final class DeviationWarningUtils {
   private static final Logger LOGGER = LogManager.getLogger(DeviationWarningUtils.class);

   private DeviationWarningUtils() {
   }

   private static IHealthCommonBusiness business() {
      BundleContext context = FrameworkUtil.getBundle(IHealthCommonBusiness.class).getBundleContext();
      return context.getService(context.getServiceReference(IHealthCommonBusiness.class));
   }

   /** True when the aircraft has at least one deviation that has not been closed. */
   public static boolean hasActiveDeviations(String aircraftId) {
      try {
         return !business().findActiveDeviations(aircraftId).isEmpty();
      } catch (Exception e) {
         LOGGER.warn("Could not check active deviations", e);
         return false;
      }
   }

   /** Closes every active deviation of the aircraft, after a new configuration is applied. */
   public static void acknowledgeAll(String aircraftId) {
      try {
         List<String> ids = new ArrayList<>();
         for (IndicatorDeviationDto dto : business().findActiveDeviations(aircraftId)) {
            ids.add(dto.getId());
         }
         if (!ids.isEmpty()) {
            // business().acknowledgeDeviations(ids);
            business().acknowledgeDeviations(aircraftId, MgsSession.getInstance().getUser().getLoginName(), ids, false);
         }
      } catch (Exception e) {
         LOGGER.error("Could not acknowledge deviations after configuration update", e);
      }
   }

   /** True when any of these learned thresholds has an active deviation. */
   public static boolean hasActiveDeviationOnThresholds(String aircraftId, List<String> thresholdIds) {
      try {
         return business().hasActiveDeviationOnThresholds(aircraftId, thresholdIds);
      } catch (Exception e) {
         LOGGER.warn("Could not check deviations for thresholds", e);
         return false;
      }
   }

}

