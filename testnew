   /**
    * Set the appropriate avionic version according to the selected aircraft type.
    */
   private void listenToAircraftTypeForAvionic(final ComboViewer avionicVersionComboViewer) {
      final BundleContext aircraftBundleContext = FrameworkUtil.getBundle(IAircraftBusiness.class).getBundleContext();
      final IAircraftBusiness aircraftBusiness = aircraftBundleContext.getService(aircraftBundleContext.getServiceReference(IAircraftBusiness.class));
      if (aircraftModel.getAircraftType() != null) {
         List<AvionicVersion> avionicVersionList = aircraftBusiness.getAvionicVersions(aircraftModel.getAircraftType().getName());
         avionicVersionList.sort((o1, o2) -> {
            int c = o1.getPosition() - o2.getPosition();
            if (c != 0) {
               return c;
            }
            return o1.getName().compareTo(o2.getName());
         });
         avionicVersionComboViewer.setInput(avionicVersionList);
      }
      aircraftModel.addPropertyChangeListener(AIRCRAFT_TYPE, evt -> {
         List<AvionicVersion> avionicVersionList = aircraftBusiness.getAvionicVersions(aircraftModel.getAircraftType().getName());
         avionicVersionList.sort((Comparator<AvionicVersion>) (o1, o2) -> {
            int c = o1.getPosition() - o2.getPosition();
            if (c != 0) {
               return c;
            }
            return o1.getName().compareTo(o2.getName());
         });
         avionicVersionComboViewer.setInput(avionicVersionList);
         if (avionicVersionList.size() == 1) {
            avionicVersionComboViewer.setSelection(new StructuredSelection(avionicVersionList.iterator().next()));
         } else {
            avionicVersionComboViewer.setSelection(StructuredSelection.EMPTY);
            detailsModifyListener.validateInputs();
         }
         manageConfigurationButton(aircraftModel.getAvionicVersion() != null);
      });
   }

   /**
    * Manage configuration Button.
    * 
    * @param state
    *           The state ( true or false )
    */
   private void manageConfigurationButton(boolean state) {
      BundleContext bundleContext = FrameworkUtil.getBundle(ICoreBusiness.class).getBundleContext();
      ICoreBusiness coreBusiness = bundleContext.getService(bundleContext.getServiceReference(ICoreBusiness.class));
      Avionic avionic = aircraftModel.getAircraftType().getAvionic();

      if (aircraftModel.getAvionicVersion() == null) {
         importConfigurationButton.setEnabled(false);
         rtbParametersButton.setEnabled(false);
         rtbParametersButton.setVisible(false);
         return;
      }

      List<FeatureName> enabledFeatureNames = coreBusiness.getEnabledFeatureNames(aircraftModel.getAvionicVersion().getId());
      boolean rtbFeaturePresent = isRtbFeaturePresent(enabledFeatureNames);
      boolean healthFeaturePresent = isHealthFeaturePresent(enabledFeatureNames);

      boolean dmauVersionRequired = avionic == Avionic.CIGALHE && healthFeaturePresent;

      if (importConfigurationButton != null) {
         boolean importConfigurationButtonEnabled = state && (!dmauVersionRequired || aircraftModel.getDmauVersion() != null);
         importConfigurationButton.setEnabled(importConfigurationButtonEnabled);
      }
      if (rtbParametersButton != null) {
         // #698 Verify if the aircraft type contains RTB feature
         boolean rtbParametersButtonEnabled = state
               && (!dmauVersionRequired || (aircraftModel.getDmauVersion() != null && aircraftModel.getDmauVersion().hasHealthData()))
               && rtbFeaturePresent;
         rtbParametersButton.setEnabled(rtbParametersButtonEnabled);
         rtbParametersButton.setVisible(rtbParametersButtonEnabled);
      }
   }

   /**
    * Update data transfer type related fields.
    * 
    * @param parent
    */
   public void updateDataTransferTypeFields(Composite parent) {
      if (update) {
         final Combo dmauVersionCombo = dmauVersionComboViewer.getCombo();
         detailsModifyListener.setDmauCheckEnabled(dmauVersionCombo.isEnabled());

         DataTransferType dataTransferType = aircraftModel.getDataTransferType();
         boolean isDataTransferTypeEnabled = aircraftModel.getAircraftType().getName().equals("EC225");
         if (isDataTransferTypeEnabled) {
            if (dataTransferType != null) {
               dataTransferTypeComboViewer.setSelection(new StructuredSelection(dataTransferType));

               // if wACS then display aircraft serial number
               boolean isAircraftSerialNumberEnabled = aircraftModel.getDataTransferType().equals(DataTransferType.WACS);
               ((GridData) aircraftSerialNumberLabel.getLayoutData()).exclude = !isAircraftSerialNumberEnabled;
               ((GridData) aircraftSerialNumberText.getLayoutData()).exclude = !isAircraftSerialNumberEnabled;
               aircraftSerialNumberLabel.setVisible(isAircraftSerialNumberEnabled);
               aircraftSerialNumberText.setVisible(isAircraftSerialNumberEnabled);

               String aircraftSerialNumber = aircraftModel.getAircraftSerialNumber();
               if (aircraftSerialNumber != null) {
                  aircraftSerialNumberText.setText(aircraftSerialNumber);
                  aircraftSerialNumberDecorator.hide();
               } else {
                  aircraftSerialNumberText.setText("");
                  if (aircraftModel.getAircraftId() != null) {
                     aircraftSerialNumberDecorator.hide();
                  } else {
                     aircraftSerialNumberDecorator.show();
                  }
               }
            } else {
               // set DTU as default
               dataTransferTypeComboViewer.setSelection(new StructuredSelection(DataTransferType.DTU));
            }
            dataTransferTypeDecorator.hide();
         }

         ((GridData) dataTransferTypeLabel.getLayoutData()).exclude = !isDataTransferTypeEnabled;
         ((GridData) dataTransferTypeComboViewer.getControl().getLayoutData()).exclude = !isDataTransferTypeEnabled;
         final Combo dataTransferTypeCombo = dataTransferTypeComboViewer.getCombo();
         ((GridData) dataTransferTypeCombo.getLayoutData()).exclude = !isDataTransferTypeEnabled;
         dataTransferTypeLabel.setVisible(isDataTransferTypeEnabled);
         dataTransferTypeCombo.setVisible(isDataTransferTypeEnabled);

         parent.layout();
         parent.getParent().layout();

         detailsModifyListener.validateInputs();
      }
   }

   private boolean isHealthFeaturePresent(List<FeatureName> enabledFeatureNames) {
      boolean rtbFeaturePresent = isRtbFeaturePresent(enabledFeatureNames);
      boolean healthMonitoringFeaturePresent = enabledFeatureNames.contains(FeatureName.HEALTH_MONITORING);
      boolean healthSignalFeaturePresent = enabledFeatureNames.contains(FeatureName.HEALTH_SIGNAL_ANALYSIS);
      return rtbFeaturePresent || healthMonitoringFeaturePresent || healthSignalFeaturePresent;
   }

   private boolean isRtbFeaturePresent(List<FeatureName> enabledFeatureNames) {
      return enabledFeatureNames.contains(FeatureName.ROTOR_TRACK_BALANCE);
   }

   private boolean isHealthEnabled(List<FeatureName> enabledFeature) {
      return enabledFeature.contains(FeatureName.HEALTH_SIGNAL_ANALYSIS) || enabledFeature.contains(FeatureName.HEALTH_MONITORING);
   }

   private boolean isDmauVersionDisabledFromAvionicVersion(List<FeatureName> enabledFeature) {
      return aircraftModel.getAircraftType().getAvionic() == Avionic.MARMS || !enabledFeature.contains(FeatureName.HEALTH_SIGNAL_ANALYSIS)
            && !enabledFeature.contains(FeatureName.HEALTH_MONITORING)
            && !enabledFeature.contains(FeatureName.ROTOR_TRACK_BALANCE);
   }

   private boolean isDmauVersionSelectableFromAircraftType(List<FeatureName> enabledFeature) {
      return aircraftModel.getAircraftType().getAvionic() == Avionic.CIGALHE
            && (enabledFeature.isEmpty() || enabledFeature.contains(FeatureName.HEALTH_SIGNAL_ANALYSIS)
                  || enabledFeature.contains(FeatureName.HEALTH_MONITORING) || enabledFeature.contains(FeatureName.ROTOR_TRACK_BALANCE));
   }

   private ControlDecoration createDecorator(Control text) {
      ControlDecoration controlDecoration = new ControlDecoration(text, SWT.LEFT | SWT.TOP);
      FieldDecoration fieldDecoration = FieldDecorationRegistry.getDefault().getFieldDecoration(FieldDecorationRegistry.DEC_ERROR);
      controlDecoration.setImage(fieldDecoration.getImage());
      return controlDecoration;
   }

   public void setRotorTunings(MainRotorTuning mainRotorTuning, TailRotorTuning tailRotorTuning) {
      this.mainRotorTuning = mainRotorTuning;
      this.tailRotorTuning = tailRotorTuning;
   }

   private GridData createGridData(int horizontalAlignment, int verticalAlignment, boolean grabHorizontalSpace, boolean grabVerticalSpace, boolean exclude) {
      GridData data = new GridData(horizontalAlignment, verticalAlignment, grabHorizontalSpace, grabVerticalSpace);
      data.exclude = exclude;
      return data;
   }
}


