/**
 * Indicator chart models creation Job.
 */
public class CreateIndicatorChartModelsJob extends Job {

   private static final Logger LOGGER = LogManager.getLogger(CreateIndicatorChartModelsJob.class);

   private final IHealthCommonBusiness healthBusiness;

   /** the collection of selected indicators. */
   private final Collection<IndicatorHmcModel> indicators;

   /** the list of indicator chart models, indexed by indicator. */
   private final Map<Indicator, List<ChartElementModel<Double>>> chartElementModels = new HashMap<>();

   /** the list of indicator success rate chart model, indexed by indicator. */
   private final Map<Indicator, ChartElementModel<Double>> successRateModels = new HashMap<>();

   private List<FlightModel> flightModels;

   /** The chart parameters. */
   private ChartParameter chartParameter;

   private final ChartFactory chartFactory;

   private Map<Indicator, IndicatorDisplay> indicatorDisplayMap = new HashMap<>();

   private boolean groundAcquisitionMode = false;

   private final Map<Indicator, Map<Flight, Map<Severity, ThresholdValue>>> thresholdDataByFlightAndIndicator = new HashMap<>();

   private static final Comparator<ThresholdValue> THRESHOLD_VALUES_COMPARATOR = (o1, o2) -> o1.getBeginningDuration().compareTo(o2.getBeginningDuration());

   /**
    * Builds a CreateIndicatorChartModelsJob.
    * 
    * @param indicators
    *           the collection of selected indicators.
    * @param view
    *           fthe view
    */
   public CreateIndicatorChartModelsJob(Collection<IndicatorHmcModel> indicators, HealthIndicatorChartView view) {
      super("Indicator chart models creation");
      this.indicators = indicators;
      final BundleContext userBundleContext = FrameworkUtil.getBundle(IUserBusiness.class).getBundleContext();
      final IUserBusiness userBusiness = userBundleContext.getService(userBundleContext.getServiceReference(IUserBusiness.class));
      Properties properties = userBusiness.getUserConfigurationProperties(MgsSession.getInstance().getUser().getId());
      chartFactory = new ChartFactory(properties);
      Aircraft aircraft = MgsSession.getInstance().getAircraft();
      if (aircraft != null) {
         try {
            indicatorDisplayMap = userBusiness.getIndicatorDisplays(
                  MgsSession.getInstance().getUser().getId(),
                  aircraft.getId());
         } catch (EntityNotFoundException e) {
            LOGGER.error("Cannot find indicator display.", e);
         }
      }
      if (view.getIndicatorTrendComposite() != null) {
         chartParameter = view.getIndicatorTrendComposite().getChartParameter();
      }

      final BundleContext healthBundleContext = FrameworkUtil.getBundle(IHealthCommonBusiness.class).getBundleContext();
      healthBusiness = healthBundleContext.getService(healthBundleContext.getServiceReference(IHealthCommonBusiness.class));
   }

   @Override
   protected IStatus run(IProgressMonitor pMonitor) {
      SubMonitor localMonitor = SubMonitor.convert(pMonitor,
            "Creating indicator chart model for indicators", indicators.size());
      localMonitor.beginTask("Creating indicator chart model for indicators", indicators.size());

      for (IndicatorHmcModel indicatorModel : indicators) {
         if (!groundAcquisitionMode && indicatorModel.getParentComponent().isGroundAcquisition()) {
            groundAcquisitionMode = true;
            chartParameter.setGroundAcquisitionMode(true);
         }
      }

      if (indicators.isEmpty()) {
         localMonitor.done();
         return Status.OK_STATUS;
      }

      this.flightModels = HealthMonitoringUtil.getFlightsDisplayed(groundAcquisitionMode);
      if (flightModels != null && !flightModels.isEmpty()) {
         flightModels.sort((f1, f2) -> {
            if (f1.getFlight().getHealthStartDate() == null || f2.getFlight().getHealthStartDate() == null) {
               return f1.getFlight().getUsageStartDate().compareTo(f2.getFlight().getUsageStartDate());
            } else {
               return f1.getFlight().getHealthStartDate().compareTo(f2.getFlight().getHealthStartDate());
            }
         });

         for (IndicatorHmcModel indicatorModel : indicators) {
            List<Double> xIndicator = new ArrayList<>();
            List<Double> yIndicator = new ArrayList<>();
            List<Double> ySuccessRate = new ArrayList<>();
            MultiMap xyThresholds = new MultiValueMap();
            MultiMap thresholdMarkers = new MultiValueMap();
            IndicatorChartModelData indicatorChartModelData = new IndicatorChartModelData(indicatorModel);

            Set<ThresholdConfiguration> displayedThresholdConfigurations = new HashSet<>();

            // READ THE DATA FROM THE SERVER
            readFlightData(flightModels, indicatorChartModelData, indicatorModel, xIndicator, yIndicator, ySuccessRate);

            readFlightThresholdData(flightModels, indicatorModel, xyThresholds, thresholdMarkers, displayedThresholdConfigurations);

            List<ChartMarker<Double>> markers = readFlightMarkers(flightModels, indicatorModel);

            if (yIndicator.isEmpty()) {
               // No indicator value to display
               localMonitor.worked(1);
               continue;
            }

            double[] bounds = null;
            if (chartParameter != null) {
               bounds = chartParameter.computeBounds(groundAcquisitionMode);
            }

            if (bounds == null || bounds.length == 0) {
               // No flight to display
               localMonitor.worked(1);
               continue;
            }

            final double startXInit = bounds[0];
            final double endXInit = bounds[1];

            List<ChartElementModel<Double>> models = new ArrayList<>();
            chartElementModels.put(indicatorModel.getIndicator(), models);
            // indicator curve
            ChartElementModel<Double> indicatorChartModel = createIndicatorChartModel(indicatorModel, xIndicator, yIndicator, indicatorChartModelData, startXInit, endXInit, markers);
            models.add(indicatorChartModel);
            // trend
            ChartElementModel<Double> trendCurveModel = createTrendCurveModel(indicatorModel, xIndicator, yIndicator, startXInit, endXInit);
            if (null != trendCurveModel) {
               models.add(trendCurveModel);
            }
            // thresholds
            // learned thresholds from latest configuration
            List<LearnedThresholdConfiguration> latestLearnedThresholds;
            Aircraft aircraft = MgsSession.getInstance().getAircraft();
            if (aircraft == null) {
               latestLearnedThresholds = Collections.emptyList();
            } else {
               try {
                  latestLearnedThresholds = healthBusiness.getIndicatorLatestLearnedThresholds(aircraft.getId(), indicatorModel.getIndicator().getId());
               } catch (EntityNotFoundException e) {
                  LOGGER.warn("Entity not found", e);
                  latestLearnedThresholds = Collections.emptyList();
               }
            }
            for (ThresholdConfiguration thresholdConf : displayedThresholdConfigurations) {
               Threshold threshold = thresholdConf.getThreshold();
               ChartElementModel<Double> chartElementModel = createThresholdChartModel(indicatorModel, threshold, xyThresholds, thresholdMarkers, startXInit, endXInit, indicatorChartModel);
               if (null != chartElementModel) {
                  initializePopupMenu(latestLearnedThresholds, chartElementModel);
                  models.add(chartElementModel);
               }
            }
            // success rate
            if (!ySuccessRate.isEmpty()) {
               ChartElementModel<Double> chartElementModel = createSuccessRateChartModel(
                     indicatorModel.getIndicator(), indicatorDisplayMap, xIndicator, ySuccessRate, startXInit, endXInit);
               successRateModels.put(indicatorModel.getIndicator(), chartElementModel);
            }
            localMonitor.worked(1);
         }
      }
      localMonitor.done();
      return Status.OK_STATUS;
   }

   private void initializePopupMenu(List<LearnedThresholdConfiguration> latestLearnedThresholds, ChartElementModel<Double> chartElementModel) {
      // Search if a learned configuration exists in the last health configuration for the given threshold
      final Set<String> learnedThresholds = new HashSet<>();
      long learningTime = 0;
      for (LearnedThresholdConfiguration conf : latestLearnedThresholds) {
         learnedThresholds.add(conf.getId());
         learningTime = conf.getLearningTime();
      }

      final Aircraft aircraft = MgsSession.getInstance().getAircraft();
      final boolean aircraftActive = aircraft != null && aircraft.getAircraftState() != AircraftState.FROZEN;
      final boolean canLaunchRelearning = MgsSession.getInstance().getUser().getProfile().canRunThresholdRelearning();
      if (!learnedThresholds.isEmpty() && aircraftActive && canLaunchRelearning) {
         chartElementModel.setData(new ThresholdLearningData(learnedThresholds, learningTime));
         // create the contextual menu to launch a threshold learning
         Map<String, String> popUpMenuItems = new HashMap<>();
         popUpMenuItems.put("1", Messages.CORE.getString("ClickLearnThresholdAction"));
         chartElementModel.setPopUpMenuItems(popUpMenuItems);
      }
   }

   /**
    * Create the success rate chart model.
    * 
    * @param indicator
    *           the indicator.
    * @param xIndicator
    *           the indicator x values.
    * @param ySuccessRate
    *           the the success rate y values.
    * @param startX
    *           the starting x coordinate.
    * @param endX
    *           the ending x coordinate.
    * @param indicatorDisplayMap
    * 
    * @return the success rate chart model.
    */
   private ChartElementModel<Double> createSuccessRateChartModel(
         Indicator indicator, Map<Indicator, IndicatorDisplay> indicatorDisplayMap,
         List<Double> xIndicator, List<Double> ySuccessRate, double startX, double endX) {

      ChartElementModel<Double> chartElementModel = chartFactory.getChartElementModel();
      chartElementModel.setXTitle(Messages.CORE.getString("Flight_hours"));
      String name = Messages.CORE.getString("CreateIndicatorChartModelsJob_4");
      chartElementModel.setMainTitle(name);
      chartElementModel.setYTitle(name);

      double end = Math.max(xIndicator.size(), ySuccessRate.size());
      for (int i = 0; i < end; i++) {
         chartElementModel.addPoint(xIndicator.get(i), ySuccessRate.get(i));
      }

      chartElementModel.setStartX(startX);
      chartElementModel.setEndX(endX);

      IndicatorDisplay indicatorDisplay = indicatorDisplayMap.get(indicator);
      if (indicatorDisplay == null) {
         indicatorDisplay = indicator.getDisplay();
      }
      Color color = ColorUtils.fromString(indicatorDisplay.getSuccessRateColor());
      chartElementModel.setColor(color);
      chartElementModel.setStyle(1.5f, indicatorDisplay.getSuccessRateStyle().name());

      chartElementModel.setyUnit(Messages.CORE.getString("CreateIndicatorChartModelsJob_successRateUnit"));
      chartElementModel.setDisplayToolTip(true);
      return chartElementModel;
   }

   /**
    * Create the threshold chart model.
    * 
    * @param indicator
    *           the indicator.
    * @param thresholdConf
    *           the threshold.
    * @param thresholdConfMap
    * @param xyThresholds
    *           the xy threshold values.
    * @param thresholdMarkers
    *           the threshold markers.
    * @param startX
    *           the starting x coordinate.
    * @param endX
    *           the ending x coordinate.
    * @param latestLearnedThreshold
    * @param indicatorChartModel
    * 
    * @return the threshold chart model.
    */
   private ChartElementModel<Double> createThresholdChartModel(final IndicatorHmcModel indicatorModel,
         Threshold threshold, MultiMap xyThresholds, MultiMap thresholdMarkers, double startX, double endX, ChartElementModel<Double> indicatorChartModel) {

      ChartElementModel<Double> chartElementModel = null;
      Collection<SingletonMap> values = (Collection<SingletonMap>) xyThresholds.get(threshold);
      if (values != null) {

         chartElementModel = chartFactory.getChartElementModel();
         chartElementModel.setLeftClickListener(new HealthIndicatorLeftClickListener(indicatorModel, thresholdDataByFlightAndIndicator));
         chartElementModel.setXTitle(Messages.CORE.getString("Flight_hours"));
         Indicator indicator = indicatorModel.getIndicator();
         String name = indicator.getName();
         chartElementModel.setMainTitle(name);
         chartElementModel.setYTitle(threshold.getId());

         switch (threshold.getSeverity()) {
            case AMBER -> {
               RGB amber = MgsColor.getColorAmber();
               chartElementModel.setColor(new Color(amber.red, amber.green, amber.blue));
            }
            case RED -> {
               RGB red = MgsColor.getColorRed();
               chartElementModel.setColor(new Color(red.red, red.green, red.blue));
            }
            default -> {
            }
            // nothing
         }

         for (SingletonMap xy : values) {
            chartElementModel.addPoint((Double) xy.getKey(), (Double) xy.getValue());
         }

         chartElementModel.setStartX(startX);
         chartElementModel.setEndX(endX);

         // Retrieve Unit symbol
         chartElementModel.setyUnit(getUnitLabel(indicator));

         chartElementModel.setStyle(1.5f, chartParameter.getThresholdCurveStyle());

         if (thresholdMarkers.containsKey(threshold)) {
            List<ChartMarker<Double>> chartMarkerList = new ArrayList<>((Collection<ChartMarker<Double>>) thresholdMarkers.get(threshold));
            chartElementModel.setChartMarkerList(chartMarkerList);
         }
         chartElementModel.setFlagIsSubCurve(true);
      } else {
         // PR8299 : Add relearn request markers to indicator charts when threshold value is undefined
         if (thresholdMarkers.containsKey(threshold)) {
            List<ChartMarker<Double>> chartMarkerList = new ArrayList<>(
                  (Collection<ChartMarker<Double>>) thresholdMarkers.get(threshold));
            indicatorChartModel.getChartMarkerList().addAll(chartMarkerList);
         }
      }

      return chartElementModel;
   }

   /**
    * Create the indicator trend chart model.
    * 
    * @param indicator
    *           the indicator.
    * @param xIndicator
    *           the indicator x values.
    * @param yIndicator
    *           the indicator y values.
    * @param startX
    *           the starting x coordinate.
    * @param endX
    *           the ending x coordinate.
    * 
    * @return the indicator trend chart model.
    */
   private ChartElementModel<Double> createTrendCurveModel(IndicatorHmcModel indicatorModel,
         List<Double> xIndicator, List<Double> yIndicator, double startX, double endX) {

      ChartElementModel<Double> chartElementModel = null;

      List<Double> xTrend = new ArrayList<>();
      List<Double> yTrend = new ArrayList<>();

      double[] xArray = ArrayUtils.toPrimitive(xIndicator.toArray(new Double[0]));
      double[] yArray = ArrayUtils.toPrimitive(yIndicator.toArray(new Double[0]));
      // sort x and y arrays wrt x ascending order
      sort(xArray, yArray);

      int numberOfValue = chartParameter.getIndicatorTrendAverageNumberOfValueBefore() + 1
            + chartParameter.getIndicatorTrendAverageNumberOfValueAfter();
      // do not convert trend values into another unit, it is a average compute of already converted indicator values
      for (int i = chartParameter.getIndicatorTrendAverageNumberOfValueBefore(); i < yArray.length - chartParameter.getIndicatorTrendAverageNumberOfValueAfter(); i++) {
         double mean = StatUtils.sum(yArray, i - chartParameter.getIndicatorTrendAverageNumberOfValueBefore(), numberOfValue) / numberOfValue;
         xTrend.add(xArray[i]);
         yTrend.add(mean);
      }
      if (!xTrend.isEmpty()) {
         chartElementModel = chartFactory.getChartElementModel();
         Indicator indicator = indicatorModel.getIndicator();
         String name = indicator.getName();
         chartElementModel.setMainTitle(name);
         chartElementModel.setXTitle(Messages.CORE.getString("Flight_hours"));
         chartElementModel.setYTitle(name + Messages.CORE.getString("CreateIndicatorChartModelsJob_9"));
         chartElementModel.setStartX(startX);
         chartElementModel.setEndX(endX);

         double end = Math.max(xTrend.size(), yTrend.size());
         for (int i = 0; i < end; i++) {
            chartElementModel.addPoint(xTrend.get(i), yTrend.get(i));
         }

         IndicatorDisplay indicatorDisplay = indicatorDisplayMap.get(indicator);
         if (indicatorDisplay == null) {
            indicatorDisplay = indicator.getDisplay();
         }

         String colorRgb = indicatorDisplay.getTrendColor();

         if (colorRgb != null) {
            chartElementModel.setColor(ColorUtils.fromString(colorRgb));
         }

         chartElementModel.setStyle(0.5f, indicatorDisplay.getTrendStyle().name());

         // Retrieve Unit symbol
         chartElementModel.setyUnit(getUnitLabel(indicator));
         chartElementModel.setFlagIsSubCurve(true);
      }
      return chartElementModel;
   }

   // sort x and y arrays wrt x ascending order
   private void sort(double[] xArray, double[] yArray) {
      for (int i = xArray.length; i > 0; i--) {
         for (int j = 0; j < i - 1; j++) {
            if (xArray[j] > xArray[j + 1]) {
               double tmp = xArray[j];
               xArray[j] = xArray[j + 1];
               xArray[j + 1] = tmp;
               tmp = yArray[j];
               yArray[j] = yArray[j + 1];
               yArray[j + 1] = tmp;
            }
         }
      }
   }

   /**
    * Create the indicator chart model.
    * 
    * @param indicator
    *           the indicator.
    * @param indicatorDisplayMap
    * @param xIndicator
    *           the indicator x values.
    * @param yIndicator
    *           the indicator y values.
    * @param indicatorChartModelData
    *           the indicator chart model data.
    * @param startXInit
    *           the starting x coordinate at first display.
    * @param endXInit
    *           the ending x coordinate at first display.
    * @param markers
    *           the list of chart markers.
    * @return the indicator chart model.
    */
   private ChartElementModel<Double> createIndicatorChartModel(IndicatorHmcModel indicatorModel, List<Double> xIndicator, List<Double> yIndicator,
         IndicatorChartModelData indicatorChartModelData, double startXInit, double endXInit, List<ChartMarker<Double>> markers) {
      ChartElementModel<Double> chartElementModel = chartFactory.getChartElementModel();
      chartElementModel.setDisplayedSelectedPoint(true);
      chartElementModel.setXTitle(Messages.CORE.getString("Flight_hours"));
      chartElementModel.setStaticText("");
      Indicator indicator = indicatorModel.getIndicator();
      String name = indicator.getName();
      chartElementModel.setYTitle(name);

      // Compute nb point (max of X and Y points)
      double end = Math.max(xIndicator.size(), yIndicator.size());
      for (int i = 0; i < end; i++) {
         // Add current point
         chartElementModel.addPoint(xIndicator.get(i), yIndicator.get(i));
      }

      // Set values min/max of the chart's data
      chartElementModel.setStartX(startXInit);
      chartElementModel.setEndX(endXInit);

      IndicatorDisplay indicatorDisplay = indicatorDisplayMap.get(indicator);
      if (indicatorDisplay == null) {
         indicatorDisplay = indicator.getDisplay();
      }

      // Set indicator color
      String colorUser = indicatorDisplay.getColor();
      if (colorUser != null) {
         chartElementModel.setColor(ColorUtils.fromString(colorUser));
      }

      // set indicator style
      chartElementModel.setStyle(2f, indicatorDisplay.getStyle().name());

      // Retrieve Unit symbol
      chartElementModel.setyUnit(getUnitLabel(indicator));

      chartElementModel.setChartMarkerList(markers);
      chartElementModel.setDisplayToolTip(true);
      chartElementModel.setData(indicatorChartModelData);
      return chartElementModel;
   }

   /**
    * Read the flights data from the server.
    * 
    * @param flightModels
    * @param indicatorChartModelData
    * @param indicatorModel
    * @param xIndicator
    * @param yIndicator
    * @param ySuccessRate
    */

   // READ THE DATA FROM THE SERVER
   private void readFlightData(List<FlightModel> flightModels, IndicatorChartModelData indicatorChartModelData,
         IndicatorHmcModel indicatorModel, List<Double> xIndicator, List<Double> yIndicator, List<Double> ySuccessRate) {
      // END THE DATA FROM THE SERVER

      final BundleContext unitBundleContext = FrameworkUtil.getBundle(IUnitBusiness.class).getBundleContext();
      final IUnitBusiness unitBusiness = unitBundleContext.getService(unitBundleContext.getServiceReference(IUnitBusiness.class));

      Indicator indicator = indicatorModel.getIndicator();

      String defaultIndicatorUnit = indicator.getDisplay().getUnitName();
      // Recover the default unit
      IndicatorDisplay userIndicatorDisplay = indicatorDisplayMap.get(indicator);

      /**
       * Initialize the indicator values and the success rates.
       */
      Aircraft aircraft = MgsSession.getInstance().getAircraft();
      if (aircraft == null) {
         return;
      }
      Avionic avionic = aircraft.getAircraftType().getAvionic();
      Map<String, Map<IndicatorValue, IAcquisition>> indicatorValuesFlightMap = healthBusiness.getIndicatorValues(avionic.name(), aircraft.getId(), indicator.getId());
      for (FlightModel flightModel : flightModels) {
         Flight flight = flightModel.getFlight();
         if (indicatorValuesFlightMap.containsKey(flight.getId())) {
            Map<IndicatorValue, IAcquisition> indicatorValuesMap = indicatorValuesFlightMap.get(flight.getId());
            for (Entry<IndicatorValue, IAcquisition> entry : indicatorValuesMap.entrySet()) {
               IndicatorValue indicatorValue = entry.getKey();
               final Duration duration;
               if (groundAcquisitionMode || indicatorValue.getCumulatedFlightTime() == null) {
                  // Use the absolute date on X-axis
                  long flightHours = flightModel.computeRelativeDateForDisplay(indicatorValue.getStartDate(), groundAcquisitionMode, true);
                  duration = new Duration(flightHours);
               } else {
                  // Use the cumulated flight time (= relative)
                  duration = new Duration(flightModel.clampFlightRelativeDateForDisplay(indicatorValue.getCumulatedFlightTime()));
               }
               double x = convertToCoordinate(duration);
               xIndicator.add(x);

               final double convertedY;
               if (indicator.getUnitSymbolOverride() == null && userIndicatorDisplay != null) {
                  convertedY = unitBusiness.convert(indicatorValue.getValue(), defaultIndicatorUnit, userIndicatorDisplay.getUnitName());
               } else {
                  convertedY = indicatorValue.getValue();
               }
               yIndicator.add(convertedY);

               if (indicatorValue.getSuccessRateValue() != null) {
                  ySuccessRate.add(indicatorValue.getSuccessRateValue() * 100.0);// to convert into percentage
               }
               indicatorChartModelData.addData(x, flight, indicatorValue, entry.getValue());
            }
         }
      }
   }

   private void readFlightThresholdData(List<FlightModel> flightModels, IndicatorHmcModel indicatorModel, MultiMap xyThresholds,
         MultiMap thresholdMarkers, Set<ThresholdConfiguration> displayedThresholdConfigurations) {

      Indicator indicator = indicatorModel.getIndicator();

      thresholdDataByFlightAndIndicator.put(indicator, new HashMap<>());

      /**
       * Initialize the threshold relearn request markers.
       */
      Map<Duration, Threshold> thresholdMarkerDurations = new HashMap<>();

      Set<Threshold> allThresholds = new HashSet<>();
      Map<String, HealthMechanicalComponentConfiguration> healthMechanicalComponentConfigurations;

      Aircraft aircraft = MgsSession.getInstance().getAircraft();
      if (aircraft == null) {
         healthMechanicalComponentConfigurations = Collections.emptyMap();
      } else {
         try {
            healthMechanicalComponentConfigurations = healthBusiness
                  .getMechanicalComponentConfigurationsForAircraft(aircraft.getId(), indicatorModel.getParentComponent().getId());
         } catch (EntityNotFoundException e1) {
            LOGGER.error("Unable to get configurations.", e1);
            healthMechanicalComponentConfigurations = Collections.emptyMap();
         }
      }

      FlightModel firstFlightDisplayed = null;
      FlightModel lastFlightDisplayed = null;
      List<FlightModel> flightsDisplayed = new ArrayList<>();
      if (groundAcquisitionMode) {
         firstFlightDisplayed = flightModels.get(0);
         lastFlightDisplayed = flightModels.get(flightModels.size() - 1);
         flightsDisplayed.addAll(flightModels);
      } else {
         for (FlightModel flightModel : flightModels) {
            if (firstFlightDisplayed == null && flightModel.getDisplayStartDate(groundAcquisitionMode) != null) {
               firstFlightDisplayed = flightModel;
            }
            if (flightModel.getDisplayEndDate(groundAcquisitionMode) != null) {
               lastFlightDisplayed = flightModel;
            }
            if (flightModel.getDisplayStartDate(groundAcquisitionMode) != null && flightModel.getDisplayEndDate(groundAcquisitionMode) != null) {
               flightsDisplayed.add(flightModel);
            }
         }
      }

      Map<Threshold, Map<Flight, ThresholdConfiguration>> allThresholdConfigurations = new HashMap<>();
      if (firstFlightDisplayed != null) {
         // AT LEAST ONE FLIGHT IS DISPLAYED
         for (FlightModel flightModel : flightsDisplayed) {
            Set<Threshold> flightThresholds = new HashSet<>();
            Map<String, Set<RelearnThresholdRequest>> relearnRequestMap = new HashMap<>();
            HealthMechanicalComponentConfiguration healthMechanicalComponentConfiguration = healthMechanicalComponentConfigurations.get(flightModel.getFlight().getId());
            if (healthMechanicalComponentConfiguration != null) {
               IndicatorConfiguration indicatorConfiguration = healthMechanicalComponentConfiguration.getIndicatorConfigurations().get(indicator);
               if (indicatorConfiguration != null) {
                  for (ThresholdConfiguration thresholdConfiguration : indicatorConfiguration.getThresholdConfigurations()) {
                     flightThresholds.add(thresholdConfiguration.getThreshold());
                  }
                  // Store threshold configurations used
                  displayedThresholdConfigurations.addAll(indicatorConfiguration.getThresholdConfigurations());
                  for (ThresholdConfiguration thrConf : indicatorConfiguration.getThresholdConfigurations()) {
                     Threshold threshold = thrConf.getThreshold();
                     allThresholds.add(threshold);
                     if (!allThresholdConfigurations.containsKey(threshold)) {
                        allThresholdConfigurations.put(threshold, new HashMap<>());
                     }
                     if (!relearnRequestMap.containsKey(threshold.getId())) {
                        relearnRequestMap.put(threshold.getId(), new TreeSet<>(Collections.reverseOrder(new RelearnThresholdRequestComparator())));
                     }
                     allThresholdConfigurations.get(threshold).put(flightModel.getFlight(), thrConf);
                     if (thrConf instanceof LearnedThresholdConfiguration) {
                        relearnRequestMap.get(threshold.getId()).addAll(((LearnedThresholdConfiguration) thrConf).getRelearnRequests());
                     }
                  }
               }
            }

            // Do not display marker multiple times
            for (Threshold flightThreshold : flightThresholds) {
               for (RelearnThresholdRequest request : relearnRequestMap.get(flightThreshold.getId())) {
                  Date effectiveDateTime = request.getStartFlightDate();
                  Duration duration = null;
                  if (effectiveDateTime.after(lastFlightDisplayed.getDisplayEndDate(groundAcquisitionMode)) || effectiveDateTime.equals(lastFlightDisplayed.getDisplayEndDate(groundAcquisitionMode))) {
                     // the date time is after the last flight
                     duration = lastFlightDisplayed.getEndOfFlightForDisplay(groundAcquisitionMode);
                  } else if (effectiveDateTime.before(firstFlightDisplayed.getDisplayStartDate(groundAcquisitionMode))
                        || effectiveDateTime.equals(firstFlightDisplayed.getDisplayStartDate(groundAcquisitionMode))) {
                     // the date time is before the first flight
                     duration = firstFlightDisplayed.getBeginningOfFlightForDisplay(groundAcquisitionMode);
                  } else {
                     for (FlightModel otherFlightModel : flightModels) {
                        if (effectiveDateTime.before(otherFlightModel.getDisplayEndDate(groundAcquisitionMode))) {
                           duration = otherFlightModel.getBeginningOfFlightForDisplay(groundAcquisitionMode);
                           break;
                        }
                     }
                  }
                  if (duration != null) {
                     Threshold thresholdToMark;
                     thresholdToMark = thresholdMarkerDurations.getOrDefault(duration, flightThreshold);
                     if (request.isCreateMarker()) {
                        // initialization of the marker
                        double x = convertToCoordinate(duration);
                        ChartMarker<Double> marker = new ChartMarker<>();
                        marker.setxCoordinateValue(x);
                        marker.setMarkerText(ConvertUtils.formatDateTime(effectiveDateTime) + " " + request.getDescription());
                        if (!thresholdMarkers.containsValue(marker)) {
                           thresholdMarkers.put(thresholdToMark, marker);
                        }
                        thresholdMarkerDurations.put(duration, flightThreshold);
                     }
                  }
               }
            }
         }
      }

      /**
       * Initialize the threshold values.
       */
      for (Threshold threshold : allThresholds) {
         // get the threshold values
         final Map<Flight, ThresholdConfiguration> flightThresholdConfigurations;
         flightThresholdConfigurations = allThresholdConfigurations.getOrDefault(threshold, Collections.emptyMap());

         // This collection contains all existing threshold configurations (not only the displayed ones)
         // This is used to get additional markers, corresponding to configurations not displayed (because there is no applicable flight)
         Set<ThresholdConfiguration> thresholdConfigurations = new HashSet<>(healthBusiness.getThresholdConfigurations(threshold.getId()));
         thresholdConfigurations.removeAll(displayedThresholdConfigurations);
         for (ThresholdConfiguration thresholdConfiguration : thresholdConfigurations) {
            if (!(thresholdConfiguration instanceof LearnedThresholdConfiguration learnedThresholdConfiguration)) {
               continue;
            }
            for (RelearnThresholdRequest request : learnedThresholdConfiguration.getRelearnRequests()) {
               if (!request.isCreateMarker()) {
                  continue;
               }
               Date effectiveDateTime = request.getStartFlightDate();
               Duration duration = null;
               if (effectiveDateTime.after(lastFlightDisplayed.getDisplayEndDate(groundAcquisitionMode))) {
                  duration = lastFlightDisplayed.getEndOfFlightForDisplay(groundAcquisitionMode);
               } else if (effectiveDateTime.before(firstFlightDisplayed.getDisplayStartDate(groundAcquisitionMode))) {
                  // Learning to old to be displayed
                  duration = null;
               } else {
                  for (FlightModel flightModel : flightModels) {
                     if (effectiveDateTime.before(flightModel.getDisplayEndDate(groundAcquisitionMode))) {
                        duration = flightModel.getBeginningOfFlightForDisplay(groundAcquisitionMode);
                        break;
                     }
                  }
               }
               if (duration == null) {
                  continue;
               }
               double x = convertToCoordinate(duration);
               ChartMarker<Double> marker = new ChartMarker<>();
               marker.setxCoordinateValue(x);
               marker.setMarkerText(ConvertUtils.formatDateTime(effectiveDateTime) + " " + request.getDescription());
               if (!thresholdMarkers.containsValue(marker)) {
                  thresholdMarkers.put(threshold, marker);
               }
               thresholdMarkerDurations.put(duration, threshold);
            }
         }

         final List<ThresholdValue> values = retrieveThresholdValues(flightThresholdConfigurations, flightModels, indicator);

         // We need a non-null value to display the curve
         // otherwise JFreeChart complains
         boolean nonNullValueFound = false;
         if (!values.isEmpty()) {
            for (ThresholdValue thresholdValue : values) {
               double startX = convertToCoordinate(thresholdValue.getBeginningDuration());
               double endX = convertToCoordinate(thresholdValue.getEndDuration());
               if (thresholdValue.isDefined()) {
                  // add the threshold points
                  addValueToMultiMap(xyThresholds, threshold, new SingletonMap(startX, thresholdValue.getValue()));
                  addValueToMultiMap(xyThresholds, threshold, new SingletonMap(endX, thresholdValue.getValue()));
                  nonNullValueFound = true;
               } else {
                  // No value for that period of time
                  addValueToMultiMap(xyThresholds, threshold, new SingletonMap(startX, null));
                  addValueToMultiMap(xyThresholds, threshold, new SingletonMap(endX, null));
               }
            }
         }
         if (!nonNullValueFound) {
            // Remove all null values that have been put inside the map
            xyThresholds.remove(threshold);
         }
      }
   }

   private void addValueToMultiMap(MultiMap xyThresholds, Threshold thresholdKey, SingletonMap singletonMapValue) {
      xyThresholds.put(thresholdKey, singletonMapValue);
   }

   private List<ChartMarker<Double>> readFlightMarkers(List<FlightModel> flightModels, IndicatorHmcModel indicatorModel) {
      List<ChartMarker<Double>> markers = new ArrayList<>();
      final Indicator indicator = indicatorModel.getIndicator();

      Map<Flight, FlightModel> flightModelMap = new HashMap<>();
      for (FlightModel flightModel : flightModels) {
         flightModelMap.put(flightModel.getFlight(), flightModel);
      }
      markers.addAll(getMarkersForAlarms(healthBusiness.getHealthAlarmsByIndicator(indicator.getId(), true), flightModelMap, groundAcquisitionMode));

      Map<? extends Alarm, Flight> greyAlarms = healthBusiness.getAcknowledgedGreyHealthAlarmsAndVpuAnomaliesByHmc(indicatorModel.getParentComponent().getId());
      markers.addAll(getMarkersForAlarms(greyAlarms, flightModelMap, groundAcquisitionMode));
      return markers;
   }

   private List<ThresholdValue> retrieveThresholdValues(Map<Flight, ThresholdConfiguration> thresholdConfigurations, List<FlightModel> flightModels, Indicator indicator) {
      List<ThresholdValue> values = new ArrayList<>();
      Map<Flight, Map<Severity, ThresholdValue>> thresholdDataByFlight = thresholdDataByFlightAndIndicator.get(indicator);

      for (FlightModel flightModel : flightModels) {
         final Flight flight = flightModel.getFlight();
         ThresholdConfiguration thresholdConfiguration = thresholdConfigurations.get(flight);

         if (!thresholdDataByFlight.containsKey(flight)) {
            thresholdDataByFlight.put(flight, new HashMap<>());
         }

         final Duration beginningOfFlight = flightModel.getBeginningOfFlightForDisplay(groundAcquisitionMode);
         final Duration endOfFlight = flightModel.getEndOfFlightForDisplay(groundAcquisitionMode);
         String unitLabel = getUnitLabel(indicator);
         if (thresholdConfiguration instanceof FixedThresholdConfiguration) {
            // Fixed threshold => constant value between beginning and end of configuration
            final Double fixedValue = ((FixedThresholdConfiguration) thresholdConfiguration).getValue();
            double convertedValue = convertThresholdValue(indicator, fixedValue);
            final ThresholdValue thresholdValue = new ThresholdValue(beginningOfFlight, endOfFlight, convertedValue, unitLabel);
            thresholdDataByFlight.get(flight).put(thresholdConfiguration.getThreshold().getSeverity(), thresholdValue);
            values.add(thresholdValue);
         } else if (thresholdConfiguration instanceof LearnedThresholdConfiguration learnedThresholdConfiguration) {

            RelearnThresholdRequest request = getApplicableRelearnRequest(flight, learnedThresholdConfiguration);
            if (request != null) {
               // Request has ended before the flight download
               double value = request.getLearnedValue();
               double convertedValue = convertThresholdValue(indicator, value);
               final ThresholdValue thresholdValue = new ThresholdValue(beginningOfFlight, endOfFlight, convertedValue,
                     learnedThresholdConfiguration.getMinimumThreshold(),
                     learnedThresholdConfiguration.getMaximumThreshold(), unitLabel);
               thresholdDataByFlight.get(flight).put(thresholdConfiguration.getThreshold().getSeverity(), thresholdValue);
               values.add(thresholdValue);
            } else {
               // No started request before the flight
               // Check threshold default value
               if (learnedThresholdConfiguration.getValue() != null) {
                  // Take the default value
                  double value = learnedThresholdConfiguration.getValue();
                  double convertedValue = convertThresholdValue(indicator, value);
                  final ThresholdValue thresholdValue = new ThresholdValue(beginningOfFlight, endOfFlight, convertedValue,
                        learnedThresholdConfiguration.getMinimumThreshold(),
                        learnedThresholdConfiguration.getMaximumThreshold(), unitLabel);
                  thresholdDataByFlight.get(flight).put(thresholdConfiguration.getThreshold().getSeverity(), thresholdValue);
                  values.add(thresholdValue);
               } else {
                  // No default value => do not show the threshold at all
                  final ThresholdValue thresholdValue = new ThresholdValue(beginningOfFlight, endOfFlight,
                        learnedThresholdConfiguration.getMinimumThreshold(),
                        learnedThresholdConfiguration.getMaximumThreshold(), unitLabel);
                  thresholdDataByFlight.get(flight).put(thresholdConfiguration.getThreshold().getSeverity(), thresholdValue);
                  values.add(thresholdValue);
               }
            }
         }
      }

      values.sort(THRESHOLD_VALUES_COMPARATOR);
      return values;
   }

   private RelearnThresholdRequest getApplicableRelearnRequest(final Flight currentFlight, final ThresholdConfiguration thresholdConfiguration) {
      SortedSet<RelearnThresholdRequest> sortedRequests = new TreeSet<>(Collections.reverseOrder(new RelearnThresholdRequestComparator()));
      sortedRequests.addAll(((LearnedThresholdConfiguration) thresholdConfiguration).getRelearnRequests());

      for (RelearnThresholdRequest request : sortedRequests) {
         boolean flightDownloadedAfterRequest = request.getStartDate().before(currentFlight.getLastDownloadDate());
         boolean requestLaunchedBeforeFlight = request.getStartFlightDate().before(currentFlight.getUsageStartDate());
         if (flightDownloadedAfterRequest && requestLaunchedBeforeFlight) {
            // That's an appropriate request, but we have to check if the request is completed
            // If so, the applicable flight date must be before the current flight
            boolean requestCompleted = request.isHandled() && request.getLearnedValue() != null;
            if (requestCompleted && currentFlight.getUsageStartDate().after(request.getApplicableFlightDate())) {
               return request;
            } else {
               break;
            }
         }
         // Otherwise, explore other relearn requests
      }
      return null;
   }

   /**
    * Builds the list of markers for given alarms and flights.
    * 
    * @param alarms
    *           the list of alarms
    * @param flights
    *           the list of flights
    * @return the list of corresponding markers
    */
   private Collection<ChartMarker<Double>> getMarkersForAlarms(final Map<? extends Alarm, Flight> alarms, final Map<Flight, FlightModel> flightModelMap, final boolean groundAcquisitionMode) {
      List<ChartMarker<Double>> markers = new ArrayList<>();
      for (Map.Entry<? extends Alarm, Flight> alarmEntry : alarms.entrySet()) {
         Alarm healthAlarm = alarmEntry.getKey();
         Flight flight = alarmEntry.getValue();
         if (healthAlarm.isCreateMarker()) {
            FlightModel flightModel = flightModelMap.get(flight);
            // Not unloaded flights are not displayed (they have no health data)
            if (flightModel != null && flightModel.getFlight().isUnloaded()) {
               // Only display markers if flight is displayed
               Duration flightBeginning = flightModel.getBeginningOfFlightForDisplay(groundAcquisitionMode);
               Duration flightEnd = flightModel.getEndOfFlightForDisplay(groundAcquisitionMode);
               if (flightBeginning == null || flightEnd == null || flightBeginning.equals(flightEnd)) {
                  continue;
               }
               final long hours;
               if (healthAlarm.getCumulatedFlightTime() != null && !groundAcquisitionMode) {
                  hours = flightModel.clampFlightRelativeDateForDisplay(healthAlarm.getCumulatedFlightTime());
               } else {
                  Date alarmDate = healthAlarm.getDate();
                  hours = flightModel.computeRelativeDateForDisplay(alarmDate, groundAcquisitionMode, true);
               }
               ChartMarker<Double> marker = new ChartMarker<>();
               // 'hours' can be (slightly) negative when we display a grey alarm marker before the first flight
               double x = Math.max(0, hours / 3600000d);
               marker.setMarkerText(healthAlarm.getAcknowledgement().getDescription());
               marker.setxCoordinateValue(x);
               markers.add(marker);
            }
         }
      }
      return markers;
   }

   /**
    * Convert to coordinate.
    * 
    * @param duration
    *           the duration
    * @return the coordinate
    */
   private double convertToCoordinate(Duration duration) {
      return duration.getMillis() / 3600000d;
   }

