package com.eurocopter.mgs.presentation.aircraft.tree;

import java.util.ArrayList;
import java.util.List;

import org.apache.logging.log4j.LogManager;
import org.apache.logging.log4j.Logger;
import org.eclipse.swt.widgets.Display;
import org.eclipse.ui.PlatformUI;
import org.osgi.framework.BundleContext;
import org.osgi.framework.FrameworkUtil;

import com.eurocopter.mgs.business.aircraft.api.IAircraftBusiness;
import com.eurocopter.mgs.datamodel.aircraft.Aircraft;
import com.eurocopter.mgs.presentation.aircraft.main.tree.AircraftTreeViewNodeElement;
import com.eurocopter.mgs.presentation.core.extension.NodeChangeEvent;

/**
 * The Class AircraftTreeNodeProvider.
 */
public class AircraftTreeNodeProvider {

   private static final Logger LOGGER = LogManager.getLogger(AircraftTreeNodeProvider.class);

   /** aircraftTreeViewNodes. */
   private List<AircraftTreeViewNodeElement> aircraftTreeViewNodes = null;

   /**
    * Gets the aircraft tree nodes.
    * 
    * @param refreshData
    *           if true, request new aircraft list from server
    * @return the aircraft tree nodes
    */
   public List<AircraftTreeViewNodeElement> getAircraftTreeNodes(boolean refreshData) {
      if (aircraftTreeViewNodes == null || refreshData) {
         aircraftTreeViewNodes = new ArrayList<>();
         LOGGER.debug("Initialize aircrafts for the MGS tree extension");
         final BundleContext aircraftBundleContext = FrameworkUtil.getBundle(IAircraftBusiness.class).getBundleContext();
         final IAircraftBusiness aircraftBusiness = aircraftBundleContext.getService(aircraftBundleContext.getServiceReference(IAircraftBusiness.class));

         List<Aircraft> aircrafts = aircraftBusiness.getAircrafts();
         if (LOGGER.isDebugEnabled()) {
            LOGGER.debug("Aircrafts retrieved from business : {}", aircrafts);
         }

         for (Aircraft aircraft : aircrafts) {
            AircraftTreeViewNodeElement aircraftTreeViewNode = new AircraftTreeViewNodeElement(aircraft);
            aircraftTreeViewNodes.add(aircraftTreeViewNode);
         }

         aircraftTreeViewNodes.sort((o1, o2) -> o1.getAircraft().getRegisterNumber().compareTo(o2.getAircraft().getRegisterNumber()));
      }
      return aircraftTreeViewNodes;
   }

   /**
    * Change Image of the node.
    * 
    * @param nodeEvent
    *           Node Change Event
    * @param node
    *           the node.
    */
   public void updateAircraftNode(final NodeChangeEvent nodeEvent, final AircraftTreeViewNodeElement node) {
      Display display = PlatformUI.getWorkbench().getDisplay();
      if (display != null) {
         display.asyncExec(() -> node.notifyListeners(nodeEvent));
      }
   }

   /**
    * Gets the aircraft node.
    * 
    * @param aircraftId
    *           the aircraft identifier.
    * @return the aircraft node.
    */
   public AircraftTreeViewNodeElement findAircraftNode(Aircraft aircraft) {
      if (aircraftTreeViewNodes == null) {
         throw new IllegalStateException("The Tree View is not yet initialized.");
      }

      AircraftTreeViewNodeElement aircraftNode = null;
      for (AircraftTreeViewNodeElement aircraftTreeViewNode : aircraftTreeViewNodes) {
         Aircraft nodeAircraft = aircraftTreeViewNode.getAircraft();
         if (aircraft.equals(nodeAircraft)) {
            aircraftNode = aircraftTreeViewNode;
            break;
         }
      }
      return aircraftNode;
   }

   /**
    * Adds the given aircraft to the tree view.
    * 
    * @param aircraft
    *           the aircraft to be added.
    */
   public void addAircraftNode(Aircraft aircraft) {
      AircraftTreeViewNodeElement aircraftTreeViewNode = new AircraftTreeViewNodeElement(aircraft);
      aircraftTreeViewNodes.add(aircraftTreeViewNode);
   }

   /**
    * Removes the given aircraft from the tree view.
    * 
    * @param aircraft
    *           the aircraft to be removed.
    */
   public void removeAircraftNode(Aircraft aircraft) {
      aircraftTreeViewNodes.remove(findAircraftNode(aircraft));
   }
}


