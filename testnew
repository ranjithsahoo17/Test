/**
 * The Class AircraftBanner.
 */
public final class AircraftBannerComposite extends Composite implements MgsEventListener {

   private static final Logger LOGGER = LogManager.getLogger(AircraftBannerComposite.class);

   /** The instance. */
   private static AircraftBannerComposite instance;

   /** Container */
   private Composite container;

   /** Composite for toolbar */
   private Composite toolbarComposite;

   /** Toolbar Manager 1*. */
   private ToolBarManager toolBarManager1 = null;

   /** Toolbar Manager 2*. */
   private ToolBarManager toolBarManager2 = null;

   /** Flight list and flight synthesis component. */
   private FlightListComponent flightListComponent;

   private AircraftComponent aircraftComponent;

   /**
    * Instantiates a new aircraft banner.
    * 
    * @param parent
    *           the parent
    */
   private AircraftBannerComposite(Composite parent) {
      super(parent, SWT.NONE);
      initialize();
      updateButtonState(MgsSession.getInstance().isConnected());
      container.pack();
      this.layout(true);
      this.pack();
   }

   /**
    * Initialize.
    */
   private void initialize() {
      setLayout(GuiTools.initGridLayout(2));

      setLayoutData(new GridData(SWT.FILL, SWT.FILL, true, true));
      createButtonComposite();
      updateAircraftBanner(false);

      MgsEventManager.getInstance().registerEventListener(this);
   }

   /**
    * This method initializes buttonComposite.
    * 
    */
   private void createButtonComposite() {
      /** Composite container **/
      container = new Composite(this, SWT.NONE);
      GridLayout gridLayout = GuiTools.initGridLayout(5);
      gridLayout.makeColumnsEqualWidth = false;
      container.setLayout(gridLayout);
      container.setLayoutData(new GridData(SWT.FILL, SWT.FILL, true, true));
      /** Aircraft Identification **/
      createAircraftIdentification();
      /** Flight list */
      createFlightList();
      /** Flight synthesis */
      createFlightSynthesis();
      /** Layout container */
      container.layout(true);
      /** Create Actions **/
      createActions();
      /** Initialize actions */
      initializeActions();
   }

   /**
    * Create Aircraft Identification.
    */
   private void createAircraftIdentification() {
      Composite aircraftComponentContainer = new Composite(container, SWT.NONE);
      GridData gridData = new GridData(SWT.FILL, SWT.FILL, false, true);
      gridData.widthHint = GuiConstants.getStyles().getAircraftListItemWidth();
      aircraftComponentContainer.setLayoutData(gridData);
      GridLayout gridLayout = new GridLayout(1, true);
      gridLayout.marginHeight = 0;
      gridLayout.marginWidth = 0;
      aircraftComponentContainer.setLayout(gridLayout);
      aircraftComponent = new AircraftComponent(aircraftComponentContainer, null, null);
      aircraftComponent.setLayoutData(new GridData(SWT.FILL, SWT.FILL, true, true));
   }

   private void createFlightList() {
      flightListComponent = new FlightListComponent(container);
      GridData flightListComponentGd = new GridData(SWT.FILL, SWT.FILL, false, false);
      flightListComponentGd.heightHint = GuiUtils.applyDpiRatio(125);
      flightListComponent.setLayoutData(flightListComponentGd);
      flightListComponent.setVisible(true);
   }

   /**
    * Initialize flight synthesis.
    */
   private void createFlightSynthesis() {
      Composite flightSynthesisComposite = new Composite(container, SWT.NONE);
      GridData compGd = new GridData(SWT.FILL, SWT.FILL, true, false);
      compGd.heightHint = GuiUtils.applyDpiRatio(125);
      flightSynthesisComposite.setLayoutData(compGd);
      flightSynthesisComposite.setLayout(GuiTools.initGridLayout(1));

      FlightSynthesisCompositeProvider flightSynthesisCompositeProvider = new FlightSynthesisCompositeProvider();
      Composite injectedComposite = flightSynthesisCompositeProvider.createFlightSynthesisComposite(flightSynthesisComposite);
      injectedComposite.setLayoutData(new GridData(SWT.FILL, SWT.FILL, true, true));
   }

   /**
    * Creates the actions.
    */
   private void createActions() {
      toolbarComposite = new Composite(this, SWT.RIGHT | SWT.INHERIT_FORCE);
      toolbarComposite.setLayout(new GridLayout(2, false));

      GridData data = new GridData(SWT.FILL, SWT.FILL, false, true);
      data.verticalAlignment = SWT.CENTER;
      toolbarComposite.setLayoutData(data);
   }

   /**
    * Initialize actions.
    */
   private void initializeActions() {
      if (toolBarManager1 == null) {
         toolBarManager1 = new ToolBarManager(SWT.FLAT | SWT.VERTICAL);
         /** Toolbar 1 */
         ToolBar toolbar1 = toolBarManager1.createControl(toolbarComposite);

         GridData data = new GridData(SWT.RIGHT, SWT.BOTTOM, false, false);
         toolbar1.setLayoutData(data);
         toolbar1.setFont(CoreResourcesUtils.getFont(CoreResourcesUtils.TOOLBAR_ACTION_FONT));
         container.addDisposeListener(e -> {
            toolBarManager1.dispose();
            toolBarManager1 = null;
         });
      }

      if (toolBarManager2 == null) {
         toolBarManager2 = new ToolBarManager(SWT.FLAT | SWT.VERTICAL);
         /** Toolbar 2 */
         ToolBar toolbar2 = toolBarManager2.createControl(toolbarComposite);

         GridData data = new GridData(SWT.RIGHT, SWT.BOTTOM, false, false);
         toolbar2.setLayoutData(data);
         toolbar2.setFont(CoreResourcesUtils.getFont(CoreResourcesUtils.TOOLBAR_ACTION_FONT));
         container.addDisposeListener(e -> {
            toolBarManager2.dispose();
            toolBarManager2 = null;
         });
      }

      String extensionPointId = "com.eurocopter.mgs.core.presentation.bannerAction";
      String extensionPointAction = "action";

      final IConfigurationElement[] contributions = Platform.getExtensionRegistry().getConfigurationElementsFor(extensionPointId);
      for (int i = 0; i < contributions.length / 2; i++) {
         Action action = castContributionIntoAction(contributions[i], extensionPointAction);
         if (action != null) {
            ActionContributionItem item = new ActionContributionItem(action);
            item.setMode(ActionContributionItem.MODE_FORCE_TEXT);
            final boolean visible;
            if (action instanceof BannerAction bannerAction) {
               visible = bannerAction.isEnabled();
            } else {
               visible = true;
            }
            item.setVisible(visible);
            toolBarManager1.add(item);
         }
      }
      for (int i = contributions.length / 2; i < contributions.length; i++) {
         Action action = castContributionIntoAction(contributions[i], extensionPointAction);
         if (action != null) {
            ActionContributionItem item = new ActionContributionItem(action);
            item.setMode(ActionContributionItem.MODE_FORCE_TEXT);
            final boolean visible;
            if (action instanceof BannerAction bannerAction) {
               visible = bannerAction.isEnabled();
            } else {
               visible = true;
            }
            item.setVisible(visible);
            toolBarManager2.add(item);
         }
      }
      toolBarManager1.update(true);
      toolBarManager2.update(true);
   }

   /**
    * Cast contribution into Action.
    * 
    * @param contribution
    *           Contribution
    * @param extensionPointAction
    *           Extension point name
    * @return Action
    */
   private Action castContributionIntoAction(IConfigurationElement contribution,
         String extensionPointAction) {
      try {
         return (Action) contribution.createExecutableExtension(extensionPointAction);
      } catch (CoreException e) {
         LOGGER.error("error casting contribution into action {}", contribution, e);
      }
      return null;
   }

   /**
    * Gets the single instance of AircraftBanner.
    * 
    * @param parent
    *           the parent
    * @return single instance of AircraftBanner
    */
   public static AircraftBannerComposite getInstance(Composite parent) {
      if (instance == null) {
         instance = new AircraftBannerComposite(parent);
      }
      return instance;
   }

   /**
    * On event.
    * 
    * @param event
    *           the event {@inheritDoc}
    * @see com.eurocopter.mgs.presentation.event.MgsEventListener#onEvent(com.eurocopter.mgs.presentation.event.MgsEvent)
    */
   @Override
   public void onEvent(MgsEvent event) {
      switch (event.getEventType()) {
         case AIRCRAFT_SELECTED_FROM_TREE_VIEW -> updateAircraftBanner(false);
         case CURRENT_AIRCRAFT_UPDATED, CURRENT_AIRCRAFT_FLIGHT_DELETED -> updateAircraftBanner(true);
         case CONNECTION_EVENT -> {
            ConnectionEvent connectionEvent = (ConnectionEvent) event;
            updateButtonState(connectionEvent.isConnected());
         }
         default -> {
         }
      }
   }

   private void updateButtonState(boolean connected) {
      toolbarComposite.setVisible(connected);
   }

   /**
    * Update aircraft Banner.
    */
   private void updateAircraftBanner(boolean keepSelection) {
      Aircraft currentAircraft = MgsSession.getInstance().getAircraft();
      if (currentAircraft != null) {
         aircraftComponent.refresh(currentAircraft);
      }
      flightListComponent.refresh(keepSelection);
   }
}


