   public List<Deviation> findActive(String aircraftId) {
      return manager.createQuery(
            "SELECT d FROM Deviation d "
                  + "JOIN d.indicatorConfiguration ic "
                  + "JOIN HealthMonitoringConfiguration hmc "
                  + "JOIN hmc.mechanicalComponentConfigurations mcc "
                  + "JOIN mcc.indicatorConfigurations ic2 "
                  + "WHERE ic2 = ic AND hmc.aircraft.id = :aircraftId "
                  + "AND d.endDate IS NULL", Deviation.class)
            .setParameter("aircraftId", aircraftId)
            .getResultList();
   }
