/**
 * The Class CigalheDownloadManager.
 */
@Local
@Stateless
public class CigalheDownloadManager extends DownloadManager {

   /** The Constant LOGGER. */
   private static final Logger LOGGER = LogManager.getLogger(CigalheDownloadManager.class);

   /** The parameter manager. */
   @EJB
   private ParameterManager parameterManager;

   /** The progress manager. */
   @EJB
   private ProgressManager progressManager;

   /** The engine data manager. */
   @EJB
   private EngineDataCollectionManager engineDataManager;

   /** The feature manager. */
   @EJB
   private FeatureManager featureManager;

   /** The aircraft lock manager. */
   @EJB
   private AircraftLockManager aircraftLockManager;

   /** The processor factory. */
   private final ProcessorFactory processorFactory = new ProcessorFactory();

   /** The analyzer factory. */
   private final AnalyzerFactory analyzerFactory = new AnalyzerFactory();

   private final RtbDelegate rtbDelegate = new RtbDelegate();

   private final ChannelResourceOrganizer channelResourceOrganizer = new ChannelResourceOrganizer();
   private final FolderResourceOrganizer folderResourceOrganizer = new FolderResourceOrganizer();

   /**
    * Download in connected mode. (Handling disconnected download is done by the business manager matching this manager).
    *
    * @param bundle
    *           the bundle
    * @param context
    *           the context
    * @param downloadDate
    *           the download date
    * @param exceptionHandler
    *           the exception handler
    * @return the multimap
    * @throws NotificationException
    *            the notification exception
    */
   public Multimap<String, String> download(CigalheDownloadBundle bundle, Context context, Date downloadDate, ExceptionHandler exceptionHandler, DownloadMode modeDownload)
         throws NotificationException {
      Aircraft lastAircraft = null;
      // Map from downloadId value to aircraftId
      Multimap<String, String> aircraftDownloads = ArrayListMultimap.create();

      // Map from aircraft technical id to flight entries
      Multimap<String, FlightEntry> aircraftFlights = ArrayListMultimap.create();
      for (AircraftIdentifier aircraftId : bundle.getAircraftIds()) {
         for (FlightEntry flightEntry : bundle.getFlights(aircraftId)) {
            Aircraft aircraft;
            try {
               aircraft = findAircraft(aircraftId, flightEntry.getFilenameDate());
            } catch (final EntityNotFoundException e) {
               LOGGER.debug("Aircraft not found", e);
               exceptionHandler.addAircraftError(new AircraftError(null, AircraftErrorType.AIRCRAFT_NOT_MANAGED, aircraftId.aircraftSubtype(), aircraftId.aircraftId()));
               // If the A/C is not managed, go straight to the next aircraft
               continue;
            }
            if (aircraft.getAircraftState() == AircraftState.DELETED) {
               exceptionHandler.addAircraftError(new AircraftError(null, AircraftErrorType.AIRCRAFT_NOT_MANAGED, aircraftId.aircraftSubtype(), aircraftId.aircraftId()));
               // if the A/C is deleted, consider it is not managed
               continue;
            }
            if (flightEntry.hasResources(FeatureId.USAGE)) {
               // Ignore flights that do not contain USAGE data
               aircraftFlights.put(aircraft.getId(), flightEntry);
            }
         }
      }

      // Loop over all flight entries
      for (Entry<String, Collection<FlightEntry>> entry : aircraftFlights.asMap().entrySet()) {
         String aircraftId = entry.getKey();

         Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
         if (aircraft == null) {
            // Must never happen! We found the aircraft some lines ago.
            throw new IllegalStateException("Cannot find aircraft with id " + aircraftId);
         }

         if (aircraft.getAircraftState() == AircraftState.FROZEN) {
            exceptionHandler.addAircraftError(new AircraftError(aircraft, AircraftErrorType.AIRCRAFT_FROZEN, aircraft.getRegisterNumber()));
            // If the A/C is frozen, go straight to the next aircraft
            continue;
         }

         // Lock the A/C while the download unfolds
         try {
            aircraftLockManager.lock(aircraftId, LockCause.DOWNLOAD);
         } catch (final AircraftConcurrentAccessException e) {
            LOGGER.debug("Aircraft locked", e);
            String lockCause = e.getAircraftLock() != null && e.getAircraftLock().getLockCause() != null ? e.getAircraftLock().getLockCause().name() : LockCause.NONE.name();
            exceptionHandler.addAircraftError(new AircraftError(aircraft, AircraftErrorType.AIRCRAFT_LOCKED, lockCause));
            // If the A/C is locked, go straight to the next aircraft
            continue;
         }

         List<Folder> folders = new ArrayList<>();

         // "try-finally" block to unlock the A/C for sure once the download has ended
         try {
            final Download download = new Download(UUID.randomUUID().toString());
            download.setDownloadDate(downloadDate);
            // Save the download operation in database
            aircraft.getDownloads().add(download);

            final String downloadId = download.getId();

            manager.flush();
            manager.clear();

            LOGGER.info("Download flights for A/C: {}", aircraft.getRegisterNumber());
            AircraftExceptionHandler handler = exceptionHandler.getExceptionHandler(aircraft);

            long startTime = System.currentTimeMillis();

            // Loop over all aircraft flights
            final Iterator<FlightEntry> flightEntryIterator = entry.getValue().iterator();
            while (flightEntryIterator.hasNext()) {
               final FlightEntry flightEntry = flightEntryIterator.next();
               flightEntry.setLastDownloadedFlight(!flightEntryIterator.hasNext());
               LOGGER.info("Start processing Flight {}...", flightEntry.getFlightId());
               long startProcessingFlight = System.currentTimeMillis();
               processFlight(aircraftId, downloadId, flightEntry, context, folders, handler, modeDownload);
               long endProcessingFlight = System.currentTimeMillis();
               LOGGER.info("End processing Flight {} in {} ms", flightEntry.getFlightId(), (endProcessingFlight - startProcessingFlight));
            }

            List<MgsComputingError> mgsComputingErrors = handler.buildComputingError();
            if (!mgsComputingErrors.isEmpty()) {
               processMgsComputingErrors(aircraftId, downloadId, mgsComputingErrors, handler);
            }

            long endTime = System.currentTimeMillis();

            if (handler.buildComputingError().isEmpty() && handler.buildResult().isEmpty()) {
               LOGGER.info("Download flights completed without error in {} ms", (endTime - startTime));
            } else {
               LOGGER.info("Download flights completed with error in {} ms", (endTime - startTime));
               LOGGER.info("MGS computing error(s) {}", handler.buildComputingError());
               LOGGER.info("MGS download error(s) {}", handler.buildResult());
            }

            // Update aircraft status according to raised alarms
            aircraftDao.updateAircraftStatus(aircraftId);

            manager.flush();
            manager.clear();

            notifyAircraftUpdated(aircraftId);
            notificationService.notifyFolderActions(folders, Action.CREATION);

            aircraftDownloads.put(aircraftId, downloadId);
            lastAircraft = aircraft;
         } finally {
            // Unlock the A/C after the download has ended
            aircraftLockManager.unlock(aircraftId);
         }
      }

      progressManager.notifyProgress(context, new DownloadProgressDto(lastAircraft, null), Progress.END);

      return aircraftDownloads;
   }

   /**
    * Process flight.
    *
    * @param aircraftId
    *           the aircraft id
    * @param downloadId
    *           the download id
    * @param flightEntry
    *           the flight entry
    * @param context
    *           the context
    * @param folders
    * @param handler
    *           the handler
    * @throws NotificationException
    *            the notification exception
    */
   private void processFlight(final String aircraftId, final String downloadId, final FlightEntry flightEntry, final Context context,
         List<Folder> folders, final AircraftExceptionHandler handler, DownloadMode modeDownload) throws NotificationException {
      Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      Download download = getDownload(aircraft, downloadId);

      final AircraftConfiguration lastConfiguration;
      final Optional<AircraftConfiguration> optionalLastAircraftConfiguration = configurationDao.findLatestConfiguration(aircraft.getId());
      if (optionalLastAircraftConfiguration.isPresent()) {
         lastConfiguration = optionalLastAircraftConfiguration.get();
      } else {
         handler.addDownloadError(new DownloadError(AnalysisStep.INIT, Avionic.CIGALHE,
               createFlightForDownloadError(flightEntry.getFlightId(), flightEntry.getFilenameDate()),
               "Aircraft Configuration not found for aircraft id: " + aircraft.getId()));
         // There is nothing else that can be done, we have to stop flight analysis at this point
         return;
      }

      final SpareConfiguration spareConfiguration;
      try {
         spareConfiguration = parameterManager.getSpareConfiguration(lastConfiguration.getAvionicVersion().getUsageFormat().getId());
      } catch (Exception e) {
         LOGGER.error("Invalid spare configuration", e);
         handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.USAGE_PROCESSING_ERROR,
               Avionic.CIGALHE, getOrCreateFlightForComputingError(aircraft.getId(), flightEntry.getFlightId(), flightEntry.getFilenameDate(), download.getId()),
               "Invalid Spare configuration", true));
         // There is nothing else that can be done, we have to stop flight analysis at this point
         return;
      }

      IUsageSession usageData;
      try {
         final CigalheSoftwareVersionBean cigalheSoftwareVersion = parameterManager.getSoftwareVersions(lastConfiguration.getAvionicVersion().getId());
         final IUsageCigalheDecoder processor = processorFactory.getProcessor(lastConfiguration.getAvionicVersion(), IUsageCigalheDecoder.class);
         usageData = processor.decode(flightEntry.getResources(FeatureId.USAGE), spareConfiguration, cigalheSoftwareVersion.getUsage().isCheckCopiedCrc());
      } catch (final DecodingException e) {
         LOGGER.error("Could not decode Usage data", e);
         handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.USAGE_DECODING_ERROR,
               Avionic.CIGALHE, getOrCreateFlightForComputingError(aircraft.getId(), flightEntry.getFlightId(), flightEntry.getFilenameDate(), download.getId()),
               e.getCause() != null ? e.getCause().getMessage() : e.getMessage(), true));
         return;
      } catch (Exception e) {
         LOGGER.error("Error while decoding Usage data", e);
         handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.USAGE_DECODING_ERROR,
               Avionic.CIGALHE, getOrCreateFlightForComputingError(aircraft.getId(), flightEntry.getFlightId(), flightEntry.getFilenameDate(), download.getId()),
               e.getCause() != null ? e.getCause().getMessage() : e.getMessage(), true));
         return;
      }

      int flightId = usageData.getFlightId();
      if (flightId != flightEntry.getFlightId()) {
         // At this point we know the exact flight id (read in the usage file) which may be different from the one read in the filename.
         // This log allow to keep the trace of the processing flight
         LOGGER.info("The flight id read in the usage flight file (= {}) is different from the one read in the filename (= {}).", flightId, flightEntry.getFlightId());
      }
      Date date = usageData.getStartDate();

      // Retrieve the applicable aircraft configuration
      final AircraftConfiguration applicableConfiguration;
      Optional<AircraftConfiguration> optionalAircraftConfiguration = configurationDao.findConfiguration(aircraft.getId(), date);
      if (optionalAircraftConfiguration.isPresent()) {
         applicableConfiguration = optionalAircraftConfiguration.get();

         AvionicVersion latestAvionicVersion = lastConfiguration.getAvionicVersion();
         if (!latestAvionicVersion.equals(applicableConfiguration.getAvionicVersion())) {
            String errorMessage = "Applicable configuration does not match the current one (applicable = "
                  + applicableConfiguration.getAvionicVersion().getId() + ", current = " + latestAvionicVersion.getId() + ")";
            LOGGER.error("Error while downloading flight {}: {}", flightEntry.getFlightId(), errorMessage);
            handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.INVALID_APPLICABLE_CONFIGURATION,
                  Avionic.CIGALHE, getOrCreateFlightForComputingError(aircraft.getId(), flightEntry.getFlightId(), flightEntry.getFilenameDate(), download.getId()),
                  errorMessage, true));
            // There is nothing else that can be done, we have to stop flight analysis at this point
            return;
         }
      } else {
         DateFormat dateTimeFormat = DateFormat.getDateTimeInstance(DateFormat.SHORT, DateFormat.DEFAULT);
         dateTimeFormat.setTimeZone(TimeZone.getTimeZone("GMT"));
         String errorMessage = "Flight date may be invalid (" + dateTimeFormat.format(date) + ")";
         LOGGER.error("Error while downloading flight {}: {}", flightEntry.getFlightId(), errorMessage);
         handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.INVALID_FLIGHT_DATE,
               Avionic.CIGALHE, getOrCreateFlightForComputingError(aircraft.getId(), flightEntry.getFlightId(), flightEntry.getFilenameDate(), download.getId()),
               errorMessage, true));
         // There is nothing else that can be done, we have to stop flight analysis at this point
         return;
      }

      Flight flight = new Flight(UUID.randomUUID().toString());
      flight.setFlightId(flightId);
      flight.setDate(date);
      flight.setConfigurationSerialNumber(applicableConfiguration.getSerialNumber());

      String signalPartitionTableName = "signal_" + flight.getId().replace('-', '_');
      manager.createNativeQuery("CREATE TABLE IF NOT EXISTS " + signalPartitionTableName + " PARTITION OF signal FOR VALUES IN ('" + flight.getId() + "')").executeUpdate();

      String fdcrDatasetPartitionTableName = "fdcr_dataset_" + flight.getId().replace('-', '_');
      manager.createNativeQuery("CREATE TABLE IF NOT EXISTS " + fdcrDatasetPartitionTableName + " PARTITION OF fdcr_dataset FOR VALUES IN ('" + flight.getId() + "')").executeUpdate();

      final String flightTechnicalId = flight.getId();

      try {
         manager.flush();
      } catch (Exception e) {
         LOGGER.debug("Unable to flush entity manager", e);
         handler.addDownloadError(new DownloadError(AnalysisStep.INIT, Avionic.CIGALHE, flight, "An error occurred during database transaction."));
         return;
      }

      final boolean active = Boolean.parseBoolean(parameterManager.getConfigurationProperty(MgsConfigurationKey.ENGINE_DATA_COLLECTION_ACTIVATION.getKey()));
      final DmauVersion dmauVersion = lastConfiguration.getDmauVersion();
      DataContext dataContext = null;
      if (featureManager.isEnabled(applicableConfiguration.getAvionicVersion(), FeatureName.ENGINE_DATA_COLLECTION) && active && dmauVersion != null && dmauVersion.hasEngineData()) {
         dataContext = engineDataManager.initDataContext(aircraft, flight.getFlightId(), flight.getDate(), download.getDownloadDate());
      }

      // Save latest close monitored alarms for health analysis of an already existing flight before the alarms are deleted in usage processing
      final Map<Indicator, HealthAlarm> latestCloseMonitoredAlarms = findLatestCloseMonitoredAlarms(aircraft);

      progressManager.notifyProgress(context, new DownloadProgressDto(aircraft, flight), Progress.USAGE);
      boolean usageAnalysisFailed = false;

      final Flight existingFlight = findFlight(aircraft, flight.getFlightId(), date);
      if (existingFlight != null) {
         flight.setFlightType(existingFlight.getFlightType());
      }

      // At this point, flight has usage data, already checked before
      long startTime = System.currentTimeMillis();
      try {
         processUsage(aircraft.getId(), usageData, flight, applicableConfiguration, lastConfiguration, spareConfiguration, flightEntry.getResources(FeatureId.USAGE), dataContext, handler);
         manager.flush();
      } catch (final Exception e) {
         LOGGER.error("Exception when processing usage", e);
         MgsComputingErrorReason reason = MgsComputingErrorReason.USAGE_PROCESSING_ERROR;
         if (e instanceof MgsComputingException mgsComputingException) {
            // More accurate reason
            reason = mgsComputingException.getReason();
         }
         handler.addMgsComputingError(new MgsComputingError(reason, Avionic.CIGALHE,
               getOrCreateFlightForComputingError(aircraftId, flightId, flight.getDate(), downloadId),
               e.getCause() != null ? e.getCause().getMessage() : e.getMessage(), true));
         usageAnalysisFailed = true;
      } finally {
         long endTime = System.currentTimeMillis();
         LOGGER.debug("Usage processing done in {} ms", (endTime - startTime));
      }

      if (usageAnalysisFailed) {
         // When usage analysis fails, abort the whole flight analysis
         LOGGER.error("Error during usage processing: abort flight download");
         aircraft = manager.find(Aircraft.class, aircraftId);
         download = getDownload(aircraft, downloadId);
         if (download != null) {
            download.getFlights().remove(flight);
         }
         manager.flush();
         return;
      }

      if (existingFlight != null) {
         try {
            processExistingFlightDeletion(existingFlight);
         } catch (MgsComputingException e) {
            LOGGER.error("Error during deletion of previous flight", e);
            handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.FLIGHT_DELETION_ERROR,
                  Avionic.CIGALHE, getOrCreateFlightForComputingError(aircraft.getId(), flightEntry.getFlightId(), flightEntry.getFilenameDate(), download.getId()),
                  e.getCause() != null ? e.getCause().getMessage() : e.getMessage()));
            return;
         }
      }

      deleteExistingPurgedFlightIfAny(aircraft, flight);

      download.getFlights().add(flight);
      aircraft.getFlights().add(flight);

      // Usage analysis succeeded so downloaded flight is OK --> update last download date
      flight.setLastDownloadDate(download.getDownloadDate());
      manager.flush();
      manager.clear();

      progressManager.notifyProgress(context, new DownloadProgressDto(aircraft, flight), Progress.HEALTH);

      if (featureManager.isHealthEnabled(applicableConfiguration.getAvionicVersion()) && lastConfiguration.getDmauVersion().hasHealthData()) {
         boolean healthAnalysisFailed = false;

         if (flightEntry.hasResources(FeatureId.HEALTH)) {
            startTime = System.currentTimeMillis();
            try {
               processHealth(aircraftId, flightTechnicalId, applicableConfiguration, lastConfiguration, flightEntry.getResources(FeatureId.HEALTH), dataContext, handler, latestCloseMonitoredAlarms);
               manager.flush();
            } catch (final Exception e) {
               LOGGER.error("Exception when processing health", e);
               MgsComputingErrorReason reason = MgsComputingErrorReason.HEALTH_PROCESSING_ERROR;
               if (e instanceof MgsComputingException mgsComputingException) {
                  // More accurate reason
                  reason = mgsComputingException.getReason();
               }
               handler.addMgsComputingError(new MgsComputingError(reason, Avionic.CIGALHE, flight, e.getCause() != null ? e.getCause().getMessage() : e.getMessage()));
               healthAnalysisFailed = true;
            } finally {
               long endTime = System.currentTimeMillis();
               LOGGER.debug("Health processing done in {} ms", (endTime - startTime));
               manager.clear();
            }
         } else {
            healthAnalysisFailed = true;
            String message = "No expected HMS Data available (A/C=" + aircraftId + ", flight=" + flightId + ")";
            LOGGER.error(message);
            handler.addMgsComputingError(
                  new MgsComputingError(MgsComputingErrorReason.NO_EXPECTED_HMS_DATA_AVAILABLE, Avionic.CIGALHE, flight, message));
         }

         if (healthAnalysisFailed) {
            LOGGER.info("Process 'grey alarms'");

            startTime = System.currentTimeMillis();
            try {
               processGreyAlarms(aircraftId, flightTechnicalId, applicableConfiguration, handler);
               manager.flush();
            } catch (final RuntimeException e) {
               LOGGER.debug("Unable to flush entity manager", e);
               handler.addDownloadError(new DownloadError(AnalysisStep.HEALTH, Avionic.CIGALHE, flight, "An error occurred during database transaction."));
            } finally {
               long endTime = System.currentTimeMillis();
               LOGGER.debug("Health 'grey alarms' processing done in {} ms", (endTime - startTime));
               manager.clear();
            }
         }
      }
      aircraft = manager.find(Aircraft.class, aircraftId);
      flight = manager.find(Flight.class, flightTechnicalId);

      progressManager.notifyProgress(context, new DownloadProgressDto(aircraft, flight), Progress.RTB);

      progressManager.notifyProgress(context, new DownloadProgressDto(aircraft, flight), Progress.SFM);
      if (flightEntry.hasResources(FeatureId.SFM)) {
         startTime = System.currentTimeMillis();
         try {
            processSfm(aircraftId, flightTechnicalId, applicableConfiguration, lastConfiguration, flightEntry.getResources(FeatureId.SFM), flightEntry.getResources(FeatureId.FDCR), dataContext,
                  handler, flightEntry.isLastDownloadedFlight());
            manager.flush();
         } catch (final Exception e) {
            LOGGER.error("Exception when processing SFM", e);
            handler.addMgsComputingError(
                  new MgsComputingError(MgsComputingErrorReason.SFM_PROCESSING_ERROR, Avionic.CIGALHE, flight, e.getCause() != null ? e.getCause().getMessage() : e.getMessage()));
         } finally {
            long endTime = System.currentTimeMillis();
            LOGGER.info("SFM processing done in {} ms", (endTime - startTime));
            manager.clear();
         }
      }

      progressManager.notifyProgress(context, new DownloadProgressDto(aircraft, flight), Progress.FDCR);

      aircraft = manager.find(Aircraft.class, aircraftId);
      aircraft.getFolders().size();
      folders.addAll(buildNotificationsDto(aircraft, flightEntry, modeDownload));
      manager.persist(aircraft);
      manager.flush();
      manager.clear();
   }

   /**
    * Validate UfmInternalVersion and HlxVersion of flight file against software_version.xml configuration file of the aircraft. Return Error #100 (MgsComputingException) in case of invalid software
    * version and abort download.
    * 
    * @param softwareVersionsXmlConfigurationFile
    * @param umfInternalVersion
    * @param helionixVersion
    * @throws MgsComputingException
    */
   private void validateSoftwareVersions(Set<String> softwareVersionsXmlConfigurationFile, String umfInternalVersion, String helionixVersion) throws MgsComputingException {

      if (softwareVersionsXmlConfigurationFile != null && !softwareVersionsXmlConfigurationFile.isEmpty()) {

         // Check if software_versions.xml contains HlxVersions or UfmInternalVersion, based on field length
         boolean swVersionsContainsHlxVersions = softwareVersionsXmlConfigurationFile.stream().allMatch(s -> s.length() >= 15);

         // Check HlxVersions if present in flight file AND detected in the configuration file
         if (!isNullOrEmpty(helionixVersion) && swVersionsContainsHlxVersions && !softwareVersionsXmlConfigurationFile.contains(helionixVersion)) {
            LOGGER.error("Incompatible usage software version (HelionixVersion) : {}", helionixVersion);
            throw new MgsComputingException(MgsComputingErrorReason.USAGE_SW_VERSION_ERROR);

            // Otherwise check UmfInternalVersion
         } else if (!isNullOrEmpty(umfInternalVersion) && !swVersionsContainsHlxVersions && !softwareVersionsXmlConfigurationFile.contains(umfInternalVersion)) {
            LOGGER.error("Incompatible usage software version (UmfInternalVersion)  : {}", umfInternalVersion);
            throw new MgsComputingException(MgsComputingErrorReason.USAGE_SW_VERSION_ERROR);
         }
      }
   }

   private boolean isNullOrEmpty(String value) {
      return value == null || value.trim().isEmpty();
   }

   /**
    * Process usage.
    *
    * @param aircraftId
    *           the aircraft id
    * @param usageData
    * @param aircraftConfiguration
    *           the aircraft configuration
    * @param lastConfiguration
    * @param spareConfiguration
    * @param resources
    *           the resources
    * @param dataContext
    *           the data context
    * @param handler
    *           the handler
    */
   private void processUsage(final String aircraftId, IUsageSession usageData, final Flight flight, final AircraftConfiguration aircraftConfiguration, final AircraftConfiguration lastConfiguration,
         SpareConfiguration spareConfiguration, final Map<String, Resource> resources, final DataContext dataContext, final AircraftExceptionHandler handler) throws MgsComputingException {
      final Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      final DmauVersion dmauVersion = lastConfiguration.getDmauVersion();

      CigalheSoftwareVersionBean cigalheSoftwareVersion = parameterManager.getSoftwareVersions(lastConfiguration.getAvionicVersion().getId());

      // Check software version
      Set<String> usageSwVersionsXML = cigalheSoftwareVersion.getUsage().getUsageSwVersions();
      validateSoftwareVersions(usageSwVersionsXML, usageData.getSoftwareVersion(), usageData.getHlxVersion());

      // Check aircraft type
      final String aircraftType = cigalheSoftwareVersion.getAircraftSubtype();
      if (aircraftType != null && !aircraftType.isEmpty() && !usageData.getAircraftType().isEmpty() && !aircraftType.equals(usageData.getAircraftType())) {
         LOGGER.error("Incompatible usage aircraft type: {}", aircraftType);
         throw new MgsComputingException(MgsComputingErrorReason.USAGE_AIRCRAFT_TYPE_ERROR);
      }

      // Check rotor state (i.e. flight type)
      if (!usageData.isEndOfFlight() && flight.getFlightType() == FlightType.END_OF_FLIGHT) {
         // We cannot override a "END_OF_FLIGHT" flight with a "ROTOR_RUNNING" one
         LOGGER.error("Cannot replace a flight recorded at END_OF_FLIGHT with a ROTOR_RUNNING one");
         throw new MgsComputingException(MgsComputingErrorReason.ROTOR_RUNNING_VS_END_OF_FLIGHT);
      }

      flight.setFlightId(usageData.getFlightId());

      List<String> deactivatedAlarms = new ArrayList<>();
      try {
         deactivatedAlarms = parameterManager.getDeactivatedAlarms(lastConfiguration.getAvionicVersion().getUsageFormat().getId());
      } catch (final Exception e) {
         LOGGER.error("Error while fetching the deactivated alarms.", e);
      }

      try {
         final IUsageAnalyzer usageCigalheAnalyzer = analyzerFactory.getAnalyzer(IUsageAnalyzer.class);
         usageCigalheAnalyzer.analyze(aircraft, flight, aircraftConfiguration, usageData, spareConfiguration, deactivatedAlarms);
      } catch (final AnalysisException e) {
         LOGGER.error("Could not analyze Usage data", e);
         throw new MgsComputingException(MgsComputingErrorReason.USAGE_PROCESSING_ERROR, e);
      }

      final IUsageAsciiAnalyzer asciiAnalyzer = analyzerFactory.getAnalyzer(IUsageAsciiAnalyzer.class);
      asciiAnalyzer.analyze(flight, usageData);

      final boolean active = Boolean.parseBoolean(parameterManager.getConfigurationProperty(MgsConfigurationKey.ENGINE_DATA_COLLECTION_ACTIVATION.getKey()));
      if (featureManager.isEnabled(aircraftConfiguration.getAvionicVersion(), FeatureName.ENGINE_DATA_COLLECTION) && active && dmauVersion != null && dmauVersion.hasEngineData()) {
         try {
            engineDataManager.collectUsage(aircraft.getEngineType(), dataContext, aircraftConfiguration.getAvionicVersion(), resources);
         } catch (final FolderDataCollectionException e) {
            LOGGER.error("Could not collect Usage Engine data", e);
            handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.USAGE_ENGINE_DATA_COLLECTION_ERROR, Avionic.CIGALHE, flight, e.getCause().getMessage()));
         }
      }
   }

   /**
    * Process health.
    *
    * @param aircraftId
    *           the aircraft id
    * @param flightId
    *           the flight id
    * @param aircraftConfiguration
    *           the aircraft configuration
    * @param lastConfiguration
    * @param resources
    *           the resources
    * @param dataContext
    *           the data context
    * @param handler
    *           the handler
    * @param latestCloseMonitoredAlarms
    * @throws EntityNotFoundException
    *            the entity not found exception
    * @throws SignalPersistenceException
    *            the signal persistence exception
    * @throws IOException
    */
   private void processHealth(final String aircraftId, final String flightId, final AircraftConfiguration aircraftConfiguration, final AircraftConfiguration lastConfiguration,
         final Map<String, Resource> resources, final DataContext dataContext, final AircraftExceptionHandler handler, final Map<Indicator, HealthAlarm> latestCloseMonitoredAlarms)
         throws MgsComputingException, SignalPersistenceException {
      final Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      final Flight flight = getFlight(aircraft, flightId);
      final AvionicVersion avionicVersion = aircraftConfiguration.getAvionicVersion();
      final AvionicVersion lastAvionicVersion = lastConfiguration.getAvionicVersion();
      final DmauVersion dmauVersion = lastConfiguration.getDmauVersion();
      IHealthSessionDescriptor sessionDescriptor;

      final HealthErrorHandler healthErrorHandler = new HealthErrorHandler();

      IHealthSession healthData;
      long startTime = System.currentTimeMillis();

      final IHealthCigalheDecoder processor = processorFactory.getProcessor(dmauVersion, IHealthCigalheDecoder.class);
      AircraftIdentifier id = new AircraftIdentifier(lastAvionicVersion.getSubtype(), aircraft.getAircraftId());
      healthData = processor.decode(id, resources, parameterManager.getHealthAvionicVersionParameters(lastAvionicVersion.getId()), healthErrorHandler);

      sessionDescriptor = processor.decodeSessionDescriptor(id, resources, healthData, flight);
      healthData.setAircraftType(sessionDescriptor.getAircraftType());
      healthData.setFlightStartDateTime(sessionDescriptor.getFlightStartDateTime());
      healthData.setOtStartDateTime(sessionDescriptor.getOtStartDateTime());
      healthData.setSoftwareVersion(sessionDescriptor.getSoftwareVersion());
      healthData.getTakeoffDateTimes().addAll(sessionDescriptor.getTakeoffDateTimes());
      healthData.getLandingDateTimes().addAll(sessionDescriptor.getLandingDateTimes());
      long endTime = System.currentTimeMillis();
      LOGGER.debug("Health decoding done in {} ms", (endTime - startTime));

      if (featureManager.isEnabled(avionicVersion, FeatureName.HEALTH_MONITORING)
            || featureManager.isEnabled(avionicVersion, FeatureName.HEALTH_SIGNAL_ANALYSIS)) {
         // Check aircraft id
         if (!sessionDescriptor.getAircraftId().isEmpty() && !sessionDescriptor.getAircraftId().equals(aircraft.getAircraftId())) {
            LOGGER.error("Invalid aircraft id (actual={}, expected={})", sessionDescriptor.getAircraftId(), aircraft.getAircraftId());
            throw new MgsComputingException(MgsComputingErrorReason.HEALTH_AIRCRAFT_ID_ERROR);
         }

         // Check software version
         if (sessionDescriptor.isSoftwareVersionRead() && !lastAvionicVersion.getHealthVersions().isEmpty() && !lastAvionicVersion.getHealthVersions().contains(healthData.getSoftwareVersion())) {
            LOGGER.error("Incompatible health software version: {}", healthData.getSoftwareVersion());
            throw new MgsComputingException(MgsComputingErrorReason.HEALTH_SW_VERSION_ERROR);
         }

         // Check aircraft type
         if (!lastAvionicVersion.getSubtype().isEmpty() && !lastAvionicVersion.getSubtype().equals(healthData.getAircraftType())) {
            LOGGER.error("Incompatible health aircraft type: {}", healthData.getAircraftType());
            throw new MgsComputingException(MgsComputingErrorReason.HEALTH_AIRCRAFT_TYPE_ERROR);
         }

         startTime = System.currentTimeMillis();
         final IHealthSignalAnalyzer healthSignalAnalyzer = analyzerFactory.getAnalyzer(IHealthSignalAnalyzer.class);
         healthSignalAnalyzer.analyze(aircraft, flight, healthData);
         endTime = System.currentTimeMillis();
         LOGGER.debug("Health signal analysis done in {} ms", (endTime - startTime));
      }

      if (featureManager.isEnabled(avionicVersion, FeatureName.HEALTH_MONITORING)) {
         startTime = System.currentTimeMillis();
         final Map<HealthMechanicalComponent, HealthMechanicalComponentConfiguration> latestIndicatorConfig = configurationDao.getLatestHealthMechanicalComponentConfigurations(aircraftId);
         if (!latestIndicatorConfig.isEmpty()) {
            final HealthSubsequentFlightHandler healthSubsequentFlightHandler = new HealthSubsequentFlightHandler();
            try {
               final IHealthMonitoringAnalyzer healthMonitoringAnalyzer = analyzerFactory.getAnalyzer(IHealthMonitoringAnalyzer.class);
               final HealthMonitoringParameters healthMonitoringParameters = parameterManager.getHealthMonitoringParameters();
               HealthHistoryProvider healthHistoryProvider = new HealthHistoryProvider(manager, aircraft, latestCloseMonitoredAlarms, latestIndicatorConfig);
               healthMonitoringAnalyzer.analyze(aircraft, flight, aircraftConfiguration, healthData, healthHistoryProvider,
                     healthMonitoringParameters, healthErrorHandler, healthSubsequentFlightHandler);

               for (String subsequentFlightId : healthSubsequentFlightHandler.getFlightIds()) {
                  processSlidingMedianOnSubsequentFlight(healthMonitoringAnalyzer, aircraft, subsequentFlightId, aircraftConfiguration, healthHistoryProvider, healthMonitoringParameters,
                        healthErrorHandler);
               }
            } catch (final AnalysisException e) {
               LOGGER.error("Exception when analyzing health monitoring", e);
               throw new MgsComputingException(MgsComputingErrorReason.HEALTH_MONITORING_ANALYSIS_ERROR, e);
            }
         }
         endTime = System.currentTimeMillis();
         LOGGER.debug("Health monitoring analysis done in {} ms", (endTime - startTime));
      }

      for (Entry<String, String> invalidAcquisitionEntry : healthErrorHandler.getInvalidAcquisitions().entrySet()) {
         String message = String.format("Invalid acquisition [%s]: %s", invalidAcquisitionEntry.getKey(), invalidAcquisitionEntry.getValue());
         LOGGER.error(message);
         handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.INVALID_HEALTH_ACQUISITION, Avionic.CIGALHE, flight, message));
      }

      if (featureManager.isEnabled(avionicVersion, FeatureName.ROTOR_TRACK_BALANCE)) {
         startTime = System.currentTimeMillis();

         final Set<IRtbAcquisition> rtbData = healthData.getRtbAcquisitions().keySet();
         RtbConfiguration rtbConfiguration = lastAvionicVersion.getRtbConfiguration();
         if (rtbConfiguration == null || rtbConfiguration.getMainRotorCharacteristics() == null || rtbConfiguration.getTailRotorCharacteristics() == null) {
            try {
               final AvionicVersion aVersion = manager.find(AvionicVersion.class, avionicVersion.getId());
               rtbConfiguration = rtbDelegate.loadDefaultRotorCharacteristics(aVersion,
                     parameterManager.getRtbParametersByAvionicVersion(avionicVersion.getId()),
                     parameterManager.getRtbNeuralNetworksByAvionicVersion(avionicVersion.getId()));
               rtbConfiguration.setOriginal(true);
            } catch (Exception e) {
               LOGGER.error("RTB Configuration error:{}", e.getMessage(), e);
               throw new MgsComputingException(MgsComputingErrorReason.RTB_CONFIGURATION_ERROR, e);
            }
         }
         final IRtbAnalyzer rtbAnalyzer = analyzerFactory.getAnalyzer(IRtbAnalyzer.class);
         rtbAnalyzer.analyze(aircraft, flight, rtbData, rtbConfiguration);
         endTime = System.currentTimeMillis();
         LOGGER.debug("RTB analysis done in {} ms", (endTime - startTime));
      }

      final boolean active = Boolean.parseBoolean(parameterManager.getConfigurationProperty(MgsConfigurationKey.ENGINE_DATA_COLLECTION_ACTIVATION.getKey()));
      if (healthErrorHandler.getInvalidAcquisitions().isEmpty() && featureManager.isEnabled(avionicVersion, FeatureName.ENGINE_DATA_COLLECTION) && active && dmauVersion.hasEngineData()) {
         startTime = System.currentTimeMillis();
         try {
            engineDataManager.collectHealth(dataContext, resources);
         } catch (final FolderDataCollectionException e) {
            LOGGER.error("Unable to collect health", e);
            handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.HEALTH_DATA_COLLECTION_ERROR, Avionic.CIGALHE, flight, e.getCause().getMessage()));
         }
         endTime = System.currentTimeMillis();
         LOGGER.debug("Health engine data collection done in {} ms", (endTime - startTime));
      }
   }

