   /**
    * Disable / Enable Import Configuration button according to the aircraft Type.
    */
   public void listenToAircraftAvionicForConfigButton() {
      aircraftModel.addPropertyChangeListener(AVIONIC_VERSION,
            evt -> {
               // If The user change the aircraft type
               aircraftConfigurationDto = null;
               detailsModifyListener.validateInputs();
               manageConfigurationButton(aircraftModel.getAvionicVersion() != null);
            });
      aircraftModel.addPropertyChangeListener(DMAU_VERSION,
            evt -> {
               final DmauVersion selectedDmauVersion = (DmauVersion) evt.getNewValue();
               if (selectedDmauVersion != null && !selectedDmauVersion.hasHealthData()) {
                  if (aircraftConfigurationDto != null) {
                     aircraftConfigurationDto.setHealthConfigurationFile(null);
                     aircraftConfigurationDto.setRtbParameterFile(null);
                     aircraftConfigurationDto.setDmauFailuresConfigurationFile(null);
                  }
                  rtbParametersButton.setEnabled(false);
                  rtbParametersButton.setVisible(false);
               } else {
                  rtbParametersButton.setEnabled(true);
                  rtbParametersButton.setVisible(true);
               }
            });
   }

   /**
    * Init the modify Listener.
    * 
    * @param aircraftDetailsComposite
    *           The aricraft details composite
    * @param okButton
    *           The ok button
    */
   public void initModifyListener(AircraftDetailsComposite aircraftDetailsComposite, Button okButton) {
      detailsModifyListener = new DetailsModifyListener(aircraftDetailsComposite, okButton, update, aircraftModel.getAvionicVersion(), aircraftModel.getDmauVersion());
      aircraftModel.addPropertyChangeListener(detailsModifyListener);
      detailsModifyListener.validateInputs();
   }

   /**
    * Activate or not additional buttons.
    */
   private void checkAdditionalButtons() {
      if (aircraftModel.getAircraftType() != null) {
         importConfigurationButton.setEnabled(true);
         if (rtbParametersButton != null) {
            rtbParametersButton.setEnabled(true);
         }
      } else {
         importConfigurationButton.setEnabled(false);
         if (rtbParametersButton != null) {
            rtbParametersButton.setEnabled(false);
         }
      }
   }

   /**
    * Initialize Details Field.
    * 
    * @param parent
    *           The parent
    */
   private void initDetailsField(Composite parent, List<AircraftType> aircaftTypes) {

      createAircraftTypeComboViewer(parent, aircaftTypes);
      createAvionicVersionComboViewer(parent);
      createDmauVersionComboViewer(parent);
      createDataTransferTypeComboViewer(parent);
      createAircraftSerialNumberText(parent);
      createAircraftIdText(parent);
      createRegisterTextField(parent);

      if (update) {
         Label detachLabel = new Label(parent, SWT.NONE);
         detachLabel.setText(Messages.CORE.getString("AircraftDetailsComposite_ApplicableFlight"));

         final BundleContext flightBundleContext = FrameworkUtil.getBundle(IFlightBusiness.class).getBundleContext();
         final IFlightBusiness flightBusiness = flightBundleContext.getService(flightBundleContext.getServiceReference(IFlightBusiness.class));

         flightComboViewer = new ComboViewer(parent, SWT.READ_ONLY);
         flightComboViewer.setContentProvider(ArrayContentProvider.getInstance());
         flightComboViewer.setLabelProvider(new LabelProvider() {
            @Override
            public String getText(Object element) {
               if (element == null) {
                  return "";
               }
               Flight flight = (Flight) element;
               Avionic avionic = aircraftModel.getAircraftType().getAvionic();
               String flightId = MessageFormat.format(
                     Messages.CORE.getString("flightListTableColumnFlightIDContent"), FlightUtils.formatFlightId(avionic, flight.getFlightId()));
               Date usageStartDate = JetLagUtils.applyJetLagIfApplicable(flight.getUsageStartDate(), flight.getJetLag());
               String flightDate = ConvertUtils.formatDateTime(usageStartDate);
               return flightId + " - " + flightDate;
            }
         });
         List<Flight> flights = flightBusiness.getFlights(aircraftModel.getAircraft().getId(), true);
         flights.sort(new FlightComparator());
         flightComboViewer.setInput(flights);
         flightComboViewer.insert(null, 0);

         Combo applicableFlightCombo = flightComboViewer.getCombo();
         applicableFlightCombo.setText("");
         applicableFlightCombo.setLayoutData(new GridData(SWT.FILL, SWT.FILL, true, false, 1, 1));
         applicableFlightCombo.setBounds(0, 0, 61, 21);

         IObservableValue<Flight> target = ViewerProperties.singleSelection(Flight.class).observe(flightComboViewer);
         IObservableValue<Flight> model = BeanProperties.value("applicableFlight", Flight.class).observe(aircraftModel);
         localbindingContext.bindValue(target, model);

         if (!flights.isEmpty()) {
            flightComboViewer.setSelection(new StructuredSelection(flights.iterator().next()));
         }
      }
      createDescriptionPart();
   }

