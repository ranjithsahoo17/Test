public abstract class DownloadManager {

   /** The Constant LOGGER. */
   private static final Logger LOGGER = LogManager.getLogger(DownloadManager.class);

   /** Flight date tolerance when retrieving flight using business flight ID. */
   private static final long DATE_TOLERANCE = 24L * 60L * 60L * 1000L;

   @PersistenceContext
   protected EntityManager manager;

   @EJB
   protected MgsComputingUtils mgsComputingUtils;

   @EJB
   protected AircraftDao aircraftDao;

   @EJB
   protected ConfigurationDao configurationDao;

   @EJB
   protected INotificationService notificationService;

   // TODO use a named query instead
   protected Flight findFlight(final Aircraft aircraft, final int flightId, final Date date) {
      final MultiValuedMap<Integer, Flight> flights = new HashSetValuedHashMap<>();
      for (final Flight flight : aircraft.getFlights()) {
         flights.put(flight.getFlightId(), flight);
      }
      if (flights.containsKey(flightId)) {
         final Collection<Flight> potentialFlights = flights.get(flightId);
         for (final Flight potentialFlight : potentialFlights) {
            if (Math.abs(potentialFlight.getDate().getTime() - date.getTime()) < DATE_TOLERANCE) {
               return potentialFlight;
            }
         }
      }
      return null;
   }

   protected void processMgsComputingErrors(String aircraftId, String downloadId, List<MgsComputingError> mgsComputingErrors, AircraftExceptionHandler handler) {
      final Download downloadToUpdate = manager.find(Download.class, downloadId);
      if (downloadToUpdate != null) {
         // In some cases (transaction rollback), the download may not have been persisted
         String avionicVersionId = null;
         final Optional<AircraftConfiguration> optionalLastAircraftConfiguration = configurationDao.findLatestConfiguration(aircraftId);
         if (optionalLastAircraftConfiguration.isPresent()) {
            avionicVersionId = optionalLastAircraftConfiguration.get().getAvionicVersion().getId();
         }

         for (final MgsComputingError error : mgsComputingErrors) {
            Flight flight = manager.find(Flight.class, error.getFlightTechnicalId());
            if (flight != null && flight.hasUsageData() && error.hasUsageError()) {
               if (avionicVersionId != null) {
                  String errorMessage = mgsComputingUtils.getErrorMessageForPopUp(error.getReason().getErrorCode(), avionicVersionId);
                  error.setErrorMessage(errorMessage);
               }
               // A pop up must be displayed to the end user
               DownloadError downloadError = createDownloadError(AnalysisStep.USAGE, error);
               downloadError.setErrorCode(error.getReason().getErrorCode());
               handler.addDownloadError(downloadError);
               continue;
            }
            if (flight != null && avionicVersionId != null) {
               mgsComputingUtils.createAlarmIfNotAlreadyExists(error.getReason().getErrorCode(), flight, avionicVersionId);
            } else {
               // A pop up is displayed to the end user
               handler.addDownloadError(createDownloadError(AnalysisStep.INIT, error));
            }
         }
      }
   }

   protected Flight createFlightForDownloadError(int flightId, Date date) {
      Flight flight = new Flight(UUID.randomUUID().toString());
      flight.setFlightId(flightId);
      flight.setUsageStartDate(date);
      return flight;
   }

   protected Flight getOrCreateFlightForComputingError(String aircraftId, int flightId, Date flightDate, String downloadId) {
      final Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      Flight flight = findFlight(aircraft, flightId, flightDate);
      if (flight != null && !flight.hasUsageData()) {
         // Previous downloaded flight had Usage error
         try {
            processExistingFlightDeletion(flight);
            flight = null;
         } catch (MgsComputingException e) {
            return flight;
         }

      }
      if (flight == null) {
         Download download = getDownload(aircraft, downloadId);
         flight = new Flight(UUID.randomUUID().toString());
         flight.setFlightId(flightId);
         flight.setDate(flightDate);
         flight.setUsageStartDate(flightDate);
         flight.setHasUsageData(false);
         flight.setFlightType(FlightType.ROTOR_RUNNING);
         flight.setLastDownloadDate(download.getDownloadDate());
         aircraft.getFlights().add(flight);
         download.getFlights().add(flight);
      }
      return flight;
   }

   protected void processExistingFlightDeletion(Flight existingFlight) throws MgsComputingException {
      try {
         FlightDeletionManager flightDeletionManager = new FlightDeletionManager(manager);
         // Usage flight data can be null. This type of flight is used for MGS computing error.
         // In order to use the same process of 'normal' flight deletion (same SQL queries), usageFlightDataId is replaced by the flight ID
         String usageFlightDataId = existingFlight.hasUsageData() ? existingFlight.getUsageFlightData().getId() : existingFlight.getId();
         flightDeletionManager.processFlightDeletion(existingFlight.getId(), usageFlightDataId);
      } catch (Exception e) {
         LOGGER.error("Error while deleting previous flight", e);
         throw new MgsComputingException(MgsComputingErrorReason.FLIGHT_DELETION_ERROR);
      }
      manager.flush();
   }

   protected Map<Indicator, HealthAlarm> findLatestCloseMonitoredAlarms(Aircraft aircraft) {
      TypedQuery<HealthAlarm> query = manager.createNamedQuery("findCloseMonitoredHealthAlarmsByAircraft", HealthAlarm.class);
      query.setParameter("aircraftId", aircraft.getId());
      Map<Indicator, HealthAlarm> alarms = new HashMap<>();
      for (HealthAlarm healthAlarm : query.getResultList()) {
         alarms.put(healthAlarm.getIndicator(), healthAlarm);
      }
      return alarms;
   }

   protected void notifyAircraftUpdated(final String aircraftId) throws NotificationException {
      final Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      aircraft.getAccelerometers().size();
      manager.clear();
      notificationService.notifyAction(AircraftCloner.clone(aircraft), Action.UPDATE);
   }

   protected Download getDownload(final Aircraft aircraft, final String downloadId) {
      for (final Download d : aircraft.getDownloads()) {
         if (d.getId().equals(downloadId)) {
            return d;
         }
      }
      return null;
   }

   protected Flight getFlight(final Aircraft aircraft, final String flightId) {
      Flight flight = null;
      for (final Flight f : aircraft.getFlights()) {
         if (f.getId().equals(flightId)) {
            flight = f;
            break;
         }
      }
      return flight;
   }

   protected void deleteExistingPurgedFlightIfAny(Aircraft aircraft, Flight flight) {
      Query query = manager.createNamedQuery("deletePurgedFlight");
      query.setParameter("flightId", flight.getFlightId());
      query.setParameter("flightDateBefore", new Date(flight.getDate().getTime() - DATE_TOLERANCE));
      query.setParameter("flightDateAfter", new Date(flight.getDate().getTime() + DATE_TOLERANCE));
      query.setParameter("aircraftId", aircraft.getId());
      query.executeUpdate();
   }

   private DownloadError createDownloadError(AnalysisStep step, MgsComputingError computingError) {
      return new DownloadError(step, computingError.getAvionic(), computingError.getFlightId(), computingError.getFlightDate(), computingError.getErrorMessage());
   }

}


