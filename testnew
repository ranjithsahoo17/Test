import jakarta.transaction.UserTransaction;

@Singleton
@TransactionManagement(TransactionManagementType.BEAN)
public class AircraftDeletionManager {

   private static final Logger LOGGER = LogManager.getLogger(AircraftDeletionManager.class);

   @PersistenceContext
   private EntityManager manager;

   @Resource
   private UserTransaction transaction;

   @EJB
   private ConfigurationDao configurationDao;

   @EJB
   private AircraftDao aircraftDao;

   @EJB
   private ParameterManager parameterManager;

   @EJB
   private AircraftLockManager aircraftLockManager;

   @EJB
   private PurgeDataManager purgeDataManager;

   @Lock(LockType.WRITE)
   public void processDeletion(String aircraftId) {
      long start;
      long end;
      start = System.currentTimeMillis();
      LOGGER.info("Start Aircraft deletion operation ...");
      Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      if (aircraft == null) {
         // Aircraft already deleted => nothing to do
         return;
      }

      LOGGER.debug("Starting A/C deletion [id = {}]", aircraftId);

      LOGGER.debug("Remove flights [aircraft id = {}]", aircraftId);
      purgeDataManager.purgeAllFlights(aircraftId);

      LOGGER.debug("Remove aircraft configurations [aircraft id = {}]", aircraftId);
      processConfigurationDeletion(aircraftId);

      LOGGER.debug("Deleting indicator preferences [aircraft id = {}]", aircraftId);
      deleteIndicatorPreferences(aircraftId);

      LOGGER.debug("Removing aircraft [aircraft id = {}]", aircraftId);
      removeAircraft(aircraftId);

      LOGGER.debug("Cleaning folder [aircraft id = {}]", aircraftId);
      cleanFolder(aircraft);

      LOGGER.debug("A/C deletion completed [id = {}]", aircraftId);
      end = System.currentTimeMillis();
      LOGGER.info("End Aircraft deletion operation in {} ms.", (end - start));
   }

   public void processConfigurationDeletion(String aircraftTechnicalId) {
      try {
         transaction.begin();
         List<String> aircraftConfigurationLines;
         try {
            aircraftConfigurationLines = IOUtils.readLines(AircraftDeletionManager.class.getResourceAsStream("/sql/aircraft-configuration-delete.sql"), StandardCharsets.UTF_8);
         } catch (IOException e) {
            throw new RuntimeException(e);
         }
         for (String line : aircraftConfigurationLines) {
            if (line.isEmpty() || line.startsWith("--")) {
               continue;
            }
            String formattedLine = line
                  .replace("${aircraft_id}", "'" + aircraftTechnicalId + "'");
            Query query = manager.createNativeQuery(formattedLine);
            query.executeUpdate();
         }
         transaction.commit();
      } catch (Exception e) {
         rollbackAndThrow(e);
      }
   }

   private void removeAircraft(String aircraftId) {
      try {
         transaction.begin();
         Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
         manager.remove(aircraft);
         transaction.commit();
      } catch (Exception e) {
         rollbackAndThrow(e);
      }
   }

   private void rollbackAndThrow(Exception e) {
      try {
         transaction.rollback();
      } catch (Exception e2) {
         // Better throw the original exception
         LOGGER.warn("Unable to rollback transaction", e2);
      }
      throw new UnmanagedTransactionException(e);
   }

   private void cleanFolder(Aircraft aircraft) {
      try {
         File configurationFolder = getAircraftConfigurationFolder(aircraft.getAircraftType().getName(), aircraft.getAircraftId(), aircraft.getAircraftSerialNumber());
         FileUtils.deleteDirectory(configurationFolder);
      } catch (Exception e) {
         LOGGER.warn("Unable to delete A/C configuration file.", e);
      }
   }

   private void deleteIndicatorPreferences(String aircraftId) {
      try {
         transaction.begin();
         Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
         Set<Indicator> indicators = new HashSet<>();
         for (HealthMechanicalComponent hmc : aircraft.getHealthComponents()) {
            indicators.addAll(hmc.getIndicators().values());
         }
         for (User user : manager.createNamedQuery("findAllUsers", User.class).getResultList()) {
            for (Indicator indicator : indicators) {
               user.getIndicators().remove(indicator.getId());
            }
         }
         transaction.commit();
      } catch (Exception e) {
         rollbackAndThrow(e);
      }
   }

   private File getAircraftConfigurationFolder(String aircraftType, String aircraftId, String aircraftSerialNumber) throws DataCollectionException {
      final String aircraftConfigurationFolderPath = parameterManager.getConfigurationProperty(MgsConfigurationKey.CUSTOMIZED_AIRCRAFT_DEFINITION_FILES.getKey());
      final AircraftConfigurationFolderUtils acfu = new AircraftConfigurationFolderUtils();
      final String folderName = acfu.getAircraftConfigurationFolderName(aircraftType, aircraftId, aircraftSerialNumber);
      final File aircraftFolder = new File(aircraftConfigurationFolderPath, folderName);
      if (!aircraftFolder.exists() && !aircraftFolder.mkdirs()) {
         throw new DataCollectionException("Aircraft configuration folder does not exist: " + aircraftFolder.getAbsolutePath());
      }
      return aircraftFolder;
   }
}

