   /**
    * Creates the entity map.
    *
    * @return the map
    * @throws EntityNotFoundException
    *            the entity not found exception
    */
   private Map<Object, Object> createEntityMap() {
      // Retrieve existing objects to populate associations when merging aircrafts
      Map<Object, Object> entityMap = new HashMap<>();

      List<GroundStation> groundStations = persistenceManager.getEntityManager().createNamedQuery("findAllGroundStations", GroundStation.class).getResultList();
      for (GroundStation groundStation : groundStations) {
         entityMap.put(groundStation, groundStation);
      }

      List<AircraftType> aircraftTypes = persistenceManager.getEntityManager().createNamedQuery("findAllAircraftTypes", AircraftType.class).getResultList();
      for (AircraftType aircraftType : aircraftTypes) {
         entityMap.put(aircraftType, aircraftType);
      }

      List<AvionicVersion> avionicVersions = persistenceManager.getEntityManager().createNamedQuery("findAllAvionicVersions", AvionicVersion.class).getResultList();
      for (AvionicVersion avionicVersion : avionicVersions) {
         entityMap.put(avionicVersion, avionicVersion);
      }

      List<DmauVersion> dmauVersions = persistenceManager.getEntityManager().createNamedQuery("findAllDmauVersions", DmauVersion.class).getResultList();
      for (DmauVersion dmauVersion : dmauVersions) {
         entityMap.put(dmauVersion, dmauVersion);
      }

      List<UsageFormat> usageFormats = persistenceManager.getEntityManager().createNamedQuery("findAllUsageFormats", UsageFormat.class).getResultList();
      for (UsageFormat usageFormat : usageFormats) {
         entityMap.put(usageFormat, usageFormat);
      }

      return entityMap;
   }

   private void mergeAircraftTypes(Map<Object, Object> entityMap) {
      Set<AircraftType> serverAircraftTypes = aircraftService.getAircraftTypes();
      Map<String, AircraftType> localAircraftTypes = new HashMap<>();
      for (AircraftType aircraftType : getAircraftTypes()) {
         localAircraftTypes.put(aircraftType.getName(), aircraftType);
      }

      for (AircraftType serverAircraftType : serverAircraftTypes) {
         if (localAircraftTypes.containsKey(serverAircraftType.getName())) {
            // Merge avionic versions
            AircraftType localAircraftType = localAircraftTypes.get(serverAircraftType.getName());

            for (AvionicVersion localAvionicVersion : new HashSet<>(localAircraftType.getAvionicVersions().values())) {
               if (!serverAircraftType.getAvionicVersions().containsKey(localAvionicVersion.getName())) {
                  // deleted avionic version
                  localAircraftType.getAvionicVersions().remove(localAvionicVersion.getName());
                  persistenceManager.getEntityManager().remove(localAvionicVersion);
               }
            }

            for (Map.Entry<String, AvionicVersion> avionicVersionEntry : localAircraftType.getAvionicVersions().entrySet()) {
               String key = avionicVersionEntry.getKey();
               AvionicVersion localAvionicVersion = avionicVersionEntry.getValue();
               AvionicVersion serverAvionicVersion = serverAircraftType.getAvionicVersions().get(key);
               synchronizationManager.merge(localAvionicVersion, serverAvionicVersion, entityMap);
            }

            for (AvionicVersion serverAvionicVersion : new HashSet<>(serverAircraftType.getAvionicVersions().values())) {
               if (!localAircraftType.getAvionicVersions().containsKey(serverAvionicVersion.getName())) {
                  // Created avionic version
                  AvionicVersion localAvionicVersion = new AvionicVersion(serverAvionicVersion.getName());
                  synchronizationManager.merge(localAvionicVersion, serverAvionicVersion, entityMap);
                  localAircraftType.getAvionicVersions().put(localAvionicVersion.getName(), localAvionicVersion);
                  entityMap.put(localAvionicVersion, localAvionicVersion);
                  persistenceManager.getEntityManager().persist(localAvionicVersion);
               }
            }
         } else {
            AircraftType localAircraftType = new AircraftType(serverAircraftType.getName());
            synchronizationManager.merge(localAircraftType, serverAircraftType, entityMap);
            entityMap.put(localAircraftType, localAircraftType);

            persistenceManager.getEntityManager().persist(localAircraftType);
         }
      }
      persistenceManager.getEntityManager().flush();
   }

   private void mergeDmauVersions(Map<Object, Object> entityMap) {

      Map<String, DmauVersion> localVersions = new HashMap<>();
      Map<String, DmauVersion> serverVersions = new HashMap<>();

      for (DmauVersion serverVersion : aircraftService.getDmauVersions()) {
         serverVersions.put(serverVersion.getId(), serverVersion);
      }

      for (DmauVersion localVersion : getDmauVersions()) {
         if (!serverVersions.containsKey(localVersion.getId())) {
            persistenceManager.getEntityManager().remove(localVersion);
         } else {
            localVersions.put(localVersion.getId(), localVersion);
         }
      }

      for (DmauVersion serverVersion : serverVersions.values()) {
         if (!localVersions.containsKey(serverVersion.getId())) {
            DmauVersion newVersion = new DmauVersion(serverVersion.getId(), serverVersion.getName(), serverVersion.hasEngineData(), serverVersion.hasHealthData());
            newVersion.setError(serverVersion.getError());
            entityMap.put(newVersion, newVersion);
            persistenceManager.getEntityManager().persist(newVersion);
         } else {
            DmauVersion localVersion = localVersions.get(serverVersion.getId());
            if (localVersion.getName().equals(serverVersion.getName())) {
               localVersion.setName(serverVersion.getName());
               localVersion.setError(serverVersion.getError());
               localVersion.setEngineData(serverVersion.hasEngineData());
               localVersion.setHealthData(serverVersion.hasHealthData());
            }
         }

      }
      persistenceManager.getEntityManager().flush();
   }

   private void mergeUsageFormats(Map<Object, Object> entityMap) {

      Map<String, UsageFormat> localFormats = new HashMap<>();

      for (UsageFormat localFormat : getUsageFormats()) {
         localFormats.put(localFormat.getId(), localFormat);
      }

      for (UsageFormat serverFormat : aircraftService.getUsageFormats()) {
         if (!localFormats.containsKey(serverFormat.getId())) {
            UsageFormat newFormat = new UsageFormat(serverFormat.getId());
            newFormat.setEngineCount(serverFormat.getEngineCount());
            entityMap.put(newFormat, newFormat);
            persistenceManager.getEntityManager().persist(newFormat);
         }
      }
      persistenceManager.getEntityManager().flush();
   }

   /**
    * Retrieves aircrafts from the server and add them to the local database.
    *
    * @param entityMap
    *           previously created root entities (ground station, A/C types...)
    */
   private List<ActionNotificationDto> mergeAircrafts(Map<Object, Object> entityMap) {
      List<ActionNotificationDto> actionNotifications = new ArrayList<>();
      EntityManager em = persistenceManager.getEntityManager();
      
      Set<Aircraft> aircrafts = aircraftService.getAircrafts();
      Map<String, Aircraft> localAircrafts = new HashMap<>();
      for (Aircraft aircraft : getAircrafts()) {
         localAircrafts.put(aircraft.getId(), aircraft);
      }

      for (Aircraft localAircraft : localAircrafts.values()) {
         if (!aircrafts.contains(localAircraft)) {
            onAircraftDeletion(localAircraft);
            actionNotifications.add(new ActionNotificationDto(localAircraft, Action.DELETION));
         }
      }

      int i=1;
      int size = aircrafts.size();
      for (Aircraft serverAircraft : aircrafts) {
    	 LOGGER.info("Merging aircrafts : " + i + "/" + size + "...");
    	 
         if (localAircrafts.containsKey(serverAircraft.getId())) {
            Aircraft localAircraft = localAircrafts.get(serverAircraft.getId());
            if (localAircraft.getVersion() != serverAircraft.getVersion()) {
               synchronizationManager.merge(localAircraft, serverAircraft, entityMap);
               entityMap.put(localAircraft, localAircraft);
               em.flush();

               mergeAircraftConfigurations(serverAircraft, entityMap);

               actionNotifications.add(new ActionNotificationDto(localAircraft, Action.UPDATE));
            }
         } else {
        	onAircraftCreation(serverAircraft);
            Aircraft localAircraft = em.find(Aircraft.class, serverAircraft.getId());
            entityMap.put(localAircraft, localAircraft);
            em.flush();

            mergeAircraftConfigurations(serverAircraft, entityMap);

            actionNotifications.add(new ActionNotificationDto(localAircraft, Action.CREATION));
         }
         i++;
      }

      return actionNotifications;
   }

   private void mergeAircraftConfigurations(Aircraft serverAircraft, Map<Object, Object> entityMap) {
      Set<AircraftConfiguration> serverAircraftConfigurations = aircraftService.getAircraftConfigurations(serverAircraft.getId());

      TypedQuery<AircraftConfiguration> aircraftConfigurationQuery = persistenceManager.getEntityManager().createNamedQuery("findAircraftConfigurations", AircraftConfiguration.class);
      aircraftConfigurationQuery.setParameter("aircraftId", serverAircraft.getId());
      Set<AircraftConfiguration> localAircraftConfigurations = new HashSet<>(aircraftConfigurationQuery.getResultList());

      // When using "restore" feature, we can have deleted A/C configurations
      for (AircraftConfiguration localAircraftConfiguration : localAircraftConfigurations) {
         if (!serverAircraftConfigurations.contains(localAircraftConfiguration)) {
            persistenceManager.getEntityManager().remove(localAircraftConfiguration);
            persistenceManager.getEntityManager().flush();
         }
      }

      for (AircraftConfiguration serverAircraftConfiguration : serverAircraftConfigurations) {
         if (!localAircraftConfigurations.contains(serverAircraftConfiguration)) {
            AircraftConfiguration localConfiguration = new AircraftConfiguration(serverAircraftConfiguration.getId());
            synchronizationManager.merge(localConfiguration, serverAircraftConfiguration, entityMap);
            persistenceManager.getEntityManager().persist(localConfiguration);
            persistenceManager.getEntityManager().flush();
         }
      }
   }
}


