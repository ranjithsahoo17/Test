   /**
    * Return the unit label to display.
    * 
    * @param unitName
    *           unit name
    * @return unit label
    */
   private String getUnitLabel(Indicator indicator) {
      IndicatorDisplay display = indicatorDisplayMap.get(indicator);
      final BundleContext unitBundleContext = FrameworkUtil.getBundle(IUnitBusiness.class).getBundleContext();
      final IUnitBusiness unitBusiness = unitBundleContext.getService(unitBundleContext.getServiceReference(IUnitBusiness.class));

      final String unitSymbol;
      if (indicator.getUnitSymbolOverride() != null) {
         unitSymbol = indicator.getUnitSymbolOverride();
      } else {
         final String unitName;
         if (display != null) {
            unitName = display.getUnitName();
         } else {
            unitName = indicator.getDisplay().getUnitName();
         }
         unitSymbol = unitBusiness.getUnitSymbol(unitName);
      }
      return unitSymbol;
   }

   private double convertThresholdValue(Indicator indicator, double value) {
      final BundleContext unitBundleContext = FrameworkUtil.getBundle(IUnitBusiness.class).getBundleContext();
      final IUnitBusiness unitBusiness = unitBundleContext.getService(unitBundleContext.getServiceReference(IUnitBusiness.class));

      IndicatorDisplay userIndicatorDisplay = indicatorDisplayMap.get(indicator);
      String defaultIndicatorUnit = indicator.getDisplay().getUnitName();
      final double convertedValue;
      if (indicator.getUnitSymbolOverride() != null || userIndicatorDisplay == null) {
         convertedValue = value;
      } else {
         convertedValue = unitBusiness.convert(value, defaultIndicatorUnit, userIndicatorDisplay.getUnitName());
      }

      return convertedValue;
   }

