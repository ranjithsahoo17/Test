   public File getTempDataCollectionFolder() {
      // Check temp data collection folder disk
      String tempDataCollectionPath = getConfigurationProperty(MgsConfigurationKey.TEMP_DATA_COLLECTION_FOLDER.getKey());
      File tempDataCollectionFolder = new File(tempDataCollectionPath);
      if (tempDataCollectionFolder.exists() || tempDataCollectionFolder.mkdirs()) {
         return tempDataCollectionFolder;
      }
      // Check if the disk still exists
      String hardDriveLetter = tempDataCollectionFolder.getAbsolutePath().substring(0, 3);
      File hardDrive = new File(hardDriveLetter);
      if (!hardDrive.exists()) {
         // Download will not be possible, since the hard drive does not exist
         // Just fallback to the hard drive where MGS is installed
         char targetHardDrive = System.getProperty("catalina.base").charAt(0);
         String targetPath = targetHardDrive + tempDataCollectionFolder.getAbsolutePath().substring(1);
         MgsConfigurationProperty property = manager.find(MgsConfigurationProperty.class, MgsConfigurationKey.TEMP_DATA_COLLECTION_FOLDER.getKey());
         property.setValue(targetPath);
         manager.merge(property);

         LOGGER.warn("Temp data collection folder changed to: {}", targetPath);
         File targetFile = new File(targetPath);
         if (!targetFile.exists() && !targetFile.mkdirs()) {
            LOGGER.warn("Cannot access temp data collection folder: {}", targetPath);
         }
         return targetFile;
      }
      return tempDataCollectionFolder;
   }

