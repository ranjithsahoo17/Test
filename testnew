   private ComboViewer createAvionicVersionComboViewer(final Composite parent) {
      final Label detailLabel = new Label(parent, SWT.NONE);
      detailLabel.setText(Messages.CORE.getString("Avionic_Version"));
      final ComboViewer avionicVersionComboViewer = new ComboViewer(parent);
      avionicVersionComboViewer.setContentProvider(ArrayContentProvider.getInstance());
      avionicVersionComboViewer.setLabelProvider(new LabelProvider() {
         @Override
         public String getText(Object element) {
            if (element instanceof AvionicVersion) {
               return ((AvionicVersion) element).getName();
            }
            return super.getText(element);
         }
      });
      avionicVersionComboViewer.addSelectionChangedListener(e -> {
         AvionicVersion selectedVersion = (AvionicVersion) ((IStructuredSelection) e.getSelection()).getFirstElement();
         if (selectedVersion != null && !selectedVersion.equals(aircraftModel.getAvionicVersion())) {
            if (aircraftModel.canUpdateAircraft()) {
               aircraftModel.setAvionicVersion(selectedVersion);
            } else {
               avionicVersionComboViewer.setSelection(new StructuredSelection(aircraftModel.getAvionicVersion()));
               MessageBox mb = new MessageBox(AircraftDetailsComposite.this.getShell(), SWT.ERROR | SWT.OK);
               mb.setText(Messages.CORE.getString("Error"));
               mb.setMessage(Messages.CORE.getString("AircraftDetailsComposite_CannotChangeVersion_error"));
               mb.open();
            }
         }
      });
      Combo avionicVersionCombo = avionicVersionComboViewer.getCombo();
      avionicVersionCombo.setLayoutData(new GridData(SWT.FILL, SWT.FILL, true, false, 1, 1));
      avionicVersionCombo.setBounds(0, 0, 61, 21);
      // BINDING
      if (avionicVersionCombo.isEnabled()) {
         avionicVersionDecorator = createDecorator(avionicVersionCombo);
      }
      IObservableValue<AvionicVersion> decriptionObserveWidget = ViewerProperties.singleSelection(AvionicVersion.class).observe(avionicVersionComboViewer);
      IObservableValue<AvionicVersion> decriptionObserveValue = BeanProperties.value(AVIONIC_VERSION, AvionicVersion.class).observe(aircraftModel);
      localbindingContext.bindValue(decriptionObserveWidget, decriptionObserveValue);

      listenToAircraftTypeForAvionic(avionicVersionComboViewer);
      if (update) {
         avionicVersionComboViewer.setSelection(new StructuredSelection(aircraftModel.getAvionicVersion()));
         avionicVersionDecorator.hide();
      }
      return avionicVersionComboViewer;
   }

   private ComboViewer createDmauVersionComboViewer(final Composite parent) {
      final Label detailLabel = new Label(parent, SWT.NONE);
      detailLabel.setText(Messages.CORE.getString("DMAU_Version"));
      dmauVersionComboViewer = new ComboViewer(parent);
      dmauVersionComboViewer.setContentProvider(ArrayContentProvider.getInstance());
      dmauVersionComboViewer.setLabelProvider(new LabelProvider() {
         @Override
         public String getText(Object element) {
            if (element instanceof DmauVersion) {
               return ((DmauVersion) element).getName();
            }
            return super.getText(element);
         }
      });
      dmauVersionComboViewer.addSelectionChangedListener(e -> {
         DmauVersion selectedVersion = (DmauVersion) ((IStructuredSelection) e.getSelection()).getFirstElement();
         if (selectedVersion != null && !selectedVersion.equals(aircraftModel.getDmauVersion())) {
            if (aircraftModel.canUpdateAircraft()) {
               aircraftModel.setDmauVersion(selectedVersion);
            } else {
               dmauVersionComboViewer.setSelection(new StructuredSelection(aircraftModel.getDmauVersion()));
               MessageBox mb = new MessageBox(AircraftDetailsComposite.this.getShell(), SWT.ERROR | SWT.OK);
               mb.setText(Messages.CORE.getString("Error"));
               mb.setMessage(Messages.CORE.getString("AircraftDetailsComposite_CannotChangeDmauVersion_error"));
               mb.open();
            }
         }
      });
      final BundleContext aircraftBundleContext = FrameworkUtil.getBundle(IAircraftBusiness.class).getBundleContext();
      final IAircraftBusiness aircraftBusiness = aircraftBundleContext.getService(aircraftBundleContext.getServiceReference(IAircraftBusiness.class));
      List<DmauVersion> dmauVersions = aircraftBusiness.getDmauVersions();
      dmauVersionComboViewer.setInput(dmauVersions);

      final Combo dmauVersionCombo = dmauVersionComboViewer.getCombo();
      dmauVersionCombo.setLayoutData(new GridData(SWT.FILL, SWT.FILL, true, false, 1, 1));
      dmauVersionCombo.setBounds(0, 0, 61, 21);
      // BINDING
      if (dmauVersionCombo.isEnabled()) {
         dmauVersionDecorator = createDecorator(dmauVersionCombo);
      }
      IObservableValue<DmauVersion> decriptionObserveWidget = ViewerProperties.singleSelection(DmauVersion.class).observe(dmauVersionComboViewer);
      IObservableValue<DmauVersion> decriptionObserveValue = BeanProperties.value(DMAU_VERSION, DmauVersion.class).observe(aircraftModel);
      localbindingContext.bindValue(decriptionObserveWidget, decriptionObserveValue);

      final BundleContext coreBundleContext = FrameworkUtil.getBundle(ICoreBusiness.class).getBundleContext();
      final ICoreBusiness coreBusiness = coreBundleContext.getService(coreBundleContext.getServiceReference(ICoreBusiness.class));

      aircraftModel.addPropertyChangeListener(AIRCRAFT_TYPE, evt -> {
         dmauVersionComboViewer.setSelection(StructuredSelection.EMPTY);
         List<FeatureName> enabledFeature = new ArrayList<>();
         if (aircraftModel.getAvionicVersion() != null) {
            enabledFeature = coreBusiness.getEnabledFeatureNames(aircraftModel.getAvionicVersion().getId());
         }
         if (isDmauVersionSelectableFromAircraftType(enabledFeature)) {
            detailsModifyListener.setDmauCheckEnabled(true);
            dmauVersionCombo.setEnabled(true);
            dmauVersionDecorator.show();
         } else {
            detailsModifyListener.setDmauCheckEnabled(false);
            dmauVersionCombo.setEnabled(false);
            dmauVersionDecorator.hide();
         }
         detailsModifyListener.validateInputs();
         manageConfigurationButton(aircraftModel.getAvionicVersion() != null);
      });

      aircraftModel.addPropertyChangeListener(AVIONIC_VERSION, evt -> {
         aircraftConfigurationDto = null;
         dmauVersionComboViewer.setSelection(StructuredSelection.EMPTY);
         List<FeatureName> enabledFeature = coreBusiness.getEnabledFeatureNames(aircraftModel.getAvionicVersion().getId());
         if (isDmauVersionDisabledFromAvionicVersion(enabledFeature)) {
            detailsModifyListener.setDmauCheckEnabled(false);
            dmauVersionCombo.setEnabled(false);
            dmauVersionDecorator.hide();
         } else {
            detailsModifyListener.setDmauCheckEnabled(true);
            dmauVersionCombo.setEnabled(true);
            dmauVersionDecorator.show();
         }
         boolean isHealthEnabled = isHealthEnabled(enabledFeature);
         detailsModifyListener.setHealthEnabled(isHealthEnabled);
         detailsModifyListener.validateInputs();
         manageConfigurationButton(aircraftModel.getAvionicVersion() != null);
      });

      aircraftModel.addPropertyChangeListener(DMAU_VERSION, evt -> manageConfigurationButton(aircraftModel.getDmauVersion() != null));

      if (update) {
         List<FeatureName> enabledFeature = new ArrayList<>();
         if (aircraftModel.getAvionicVersion() != null) {
            enabledFeature = coreBusiness.getEnabledFeatureNames(aircraftModel.getAvionicVersion().getId());
         }
         if (isDmauVersionSelectableFromAircraftType(enabledFeature)) {
            if (aircraftModel.getDmauVersion() != null) {
               dmauVersionComboViewer.setSelection(new StructuredSelection(aircraftModel.getDmauVersion()));
            } else {
               dmauVersionComboViewer.setSelection(StructuredSelection.EMPTY);
            }
         } else {
            dmauVersionCombo.setEnabled(false);
         }
         dmauVersionDecorator.hide();
      }
      return dmauVersionComboViewer;
   }

   private ComboViewer createDataTransferTypeComboViewer(final Composite parent) {
      dataTransferTypeLabel = new Label(parent, SWT.NONE);
      dataTransferTypeLabel.setText(Messages.CORE.getString("DTU_Wacs_Version"));
      dataTransferTypeLabel.setLayoutData(createGridData(SWT.BEGINNING, SWT.CENTER, false, false, true));

      dataTransferTypeComboViewer = new ComboViewer(parent);
      dataTransferTypeComboViewer.setContentProvider(ArrayContentProvider.getInstance());
      dataTransferTypeComboViewer.setLabelProvider(new LabelProvider() {
         @Override
         public String getText(Object element) {
            if (element instanceof DataTransferType) {
               return ((DataTransferType) element).label;
            }
            return super.getText(element);
         }
      });
      dataTransferTypeComboViewer.setInput(DataTransferType.values());
      dataTransferTypeComboViewer.getControl().setLayoutData(createGridData(SWT.FILL, SWT.FILL, true, true, true));
      final Combo dataTransferTypeCombo = dataTransferTypeComboViewer.getCombo();
      dataTransferTypeCombo.setLayoutData(createGridData(SWT.FILL, SWT.FILL, true, true, true));

      dataTransferTypeDecorator = createDecorator(dataTransferTypeCombo);
      (dataTransferTypeDecorator.getControl()).setVisible(false);

      IObservableValue<DataTransferType> targetObservableValue = ViewerProperties.singleSelection(DataTransferType.class).observe(dataTransferTypeComboViewer);
      IObservableValue<DataTransferType> modelObservableValue = BeanProperties.value(DATA_TRANSFER_TYPE, DataTransferType.class).observe(aircraftModel);
      localbindingContext.bindValue(targetObservableValue, modelObservableValue);

      aircraftModel.addPropertyChangeListener(AIRCRAFT_TYPE, evt -> {
         dataTransferTypeComboViewer.setSelection(StructuredSelection.EMPTY);

         boolean isDataTransferTypeEnabled = aircraftModel.getAircraftType().getName().equals("EC225");
