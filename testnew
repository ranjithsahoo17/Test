/**
 * Manager for Preference Store Objects .
 */
public final class MgsPreferenceStoreManager {

   private static final Logger LOGGER = LogManager.getLogger(MgsPreferenceStoreManager.class);

   // The EPC UMS data and flight synthesis preferences is saved by the method saveAircraftConfigurations() to avoid to display multiple time the error message in case a download is processing
   public static final Multimap<Aircraft, String> SELECTED_FLIGHT_SYNTHESIS_DATA = ArrayListMultimap.create();
   public static final Multimap<Aircraft, UmsData> EPC_UMS_DATA = ArrayListMultimap.create();

   private static final Map<Aircraft, AircraftConfiguration> AIRCRAFT_CONFIGURATIONS = new HashMap<>();

   private static final Map<Aircraft, AircraftConfigurationHistoryDto> AIRCRAFT_CONFIGURATION_HISTORIES = new HashMap<>();

   private static final Set<Aircraft> DIRTY_AIRCRAFTS = new HashSet<>();
   private static final Set<Aircraft> FLIGHT_SYNTHESIS_DIRTY_AIRCRAFTS = new HashSet<>();

   private static boolean lastSaveConfirmed = false;

   /** BCR-6605 true when the applicable-flight popup was actually shown for the last save. */
   private static boolean lastSavePrompted = false;

   private static final MgsPreferenceStore MGS_CONFIGURATION_PREFERENCE_STORE = MgsConfigurationPreferenceStore.getInstance();
   private static final MgsPreferenceStore USER_PREFERENCE_STORE = UserConfigurationPreferenceStore.getInstance();

   /**
    *
    * Default constructor. Builds a MGSPreferenceStoreManager.
    */
   private MgsPreferenceStoreManager() {
   }

   /**
    * Getting the MGS PreferenceStore object.
    *
    * @return instance of MGSConfigurationpreferenceStore
    */
   public static synchronized MgsPreferenceStore getMgsConfigurationPreferenceStore() {
      return MGS_CONFIGURATION_PREFERENCE_STORE;
   }

   /**
    * Getting the user configuration preference store.
    *
    * @return instance of UserConfigurationPreferenceStore
    */
   public static synchronized MgsPreferenceStore getUserPreferenceStore() {
      return USER_PREFERENCE_STORE;
   }

   public static synchronized void saveAircraftConfigurations() {
      lastSaveConfirmed = false;
      lastSavePrompted = false;
      try {
         // Save first the preferences that are not historicized: avoid to show the "Applicable flight" popup in case of concurrent access error
         saveFlightSynthesisConfigurations();
         saveUmsDataConfigurations();

         IAircraftBusiness aircraftBusiness = getAircraftBusiness();
         Map<Aircraft, AircraftConfigurationHistoryDto> dirtyAircraftsConfigurations = new HashMap<>();
         for (Map.Entry<Aircraft, AircraftConfigurationHistoryDto> entry : AIRCRAFT_CONFIGURATION_HISTORIES.entrySet()) {
            Aircraft aircraft = entry.getKey();
            if (DIRTY_AIRCRAFTS.contains(aircraft)) {
               dirtyAircraftsConfigurations.put(aircraft, AIRCRAFT_CONFIGURATION_HISTORIES.get(aircraft));
            }
         }
         // BCR-6605 remember that the user was asked, so the caller can tell "nothing to confirm"
         // apart from "asked and cancelled"
         lastSavePrompted = !dirtyAircraftsConfigurations.isEmpty();
         if (!dirtyAircraftsConfigurations.isEmpty()) {
            MgsPreferenceDialogHandler mgsPreferenceDialogHandler = new MgsPreferenceDialogHandler();
            mgsPreferenceDialogHandler.openDialog(dirtyAircraftsConfigurations);
            for (Map.Entry<Aircraft, AircraftConfigurationHistoryDto> entry : dirtyAircraftsConfigurations.entrySet()) {
               AircraftConfigurationHistoryDto configurationHistorizationDto = entry.getValue();
               if (mgsPreferenceDialogHandler.getOkCancel(configurationHistorizationDto)) {
                  lastSaveConfirmed = true;
                  Flight applicableFlight = mgsPreferenceDialogHandler.getApplicableFlight(configurationHistorizationDto);
                  final String applicableFlightId;
                  if (applicableFlight != null) {
                     applicableFlightId = applicableFlight.getId();
                  } else {
                     applicableFlightId = null;
                  }
                  aircraftBusiness.updateAircraftConfiguration(configurationHistorizationDto, null, applicableFlightId);
               }
            }
         }
      } catch (AircraftConcurrentAccessException e) {
         StatusManager.getManager().handle(AircraftExceptionHandler.getStatusForAircraftException(e, "update", Activator.PLUGIN_ID), StatusManager.SHOW); //$NON-NLS-1$
      } catch (ConcurrentAccessException e) {
         LOGGER.warn("Concurrent access exception", e);
         StatusManager.getManager().handle(new GenericStatus(IStatus.ERROR, Activator.PLUGIN_ID, Messages.CORE.getString("update.aborted.concurrentUpdate")), StatusManager.BLOCK); //$NON-NLS-1$
      } catch (EntityNotFoundException e) {
         LOGGER.warn("Entity not found exception", e);
         StatusManager.getManager().handle(
               new GenericStatus(IStatus.ERROR, Activator.PLUGIN_ID, Messages.CORE.getString("updateConf.aborted.missingElement"), e), //$NON-NLS-1$
               StatusManager.SHOW);
      } catch (ServiceException e) {
         LOGGER.warn("Service exception", e);
         StatusManager.getManager().handle(
               new GenericStatus(IStatus.ERROR, Activator.PLUGIN_ID, Messages.CORE.getString("updateConf.aborted.unknownCause"), e), StatusManager.BLOCK); //$NON-NLS-1$
      }
      DIRTY_AIRCRAFTS.clear();
   }

   // Save flight synthesis preferences
   public static synchronized void saveFlightSynthesisConfigurations() throws EntityNotFoundException, ConcurrentAccessException {
      IConfigurationBusiness configurationBusiness = getConfigurationBusiness();
      for (Aircraft aircraft : FLIGHT_SYNTHESIS_DIRTY_AIRCRAFTS) {
         Collection<String> usageParamIds = SELECTED_FLIGHT_SYNTHESIS_DATA.get(aircraft);
         configurationBusiness.setFlightSynthesisUsageParameters(aircraft.getId(), new ArrayList<>(usageParamIds));
      }
      FLIGHT_SYNTHESIS_DIRTY_AIRCRAFTS.clear();
   }

   // Save the UMS data preferences
   public static synchronized void saveUmsDataConfigurations() throws EntityNotFoundException, ConcurrentAccessException {
      IConfigurationBusiness configurationBusiness = getConfigurationBusiness();
      for (Entry<Aircraft, Collection<UmsData>> entry : EPC_UMS_DATA.asMap().entrySet()) {
         configurationBusiness.setUmsDatas(entry.getKey().getId(), new HashSet<>(entry.getValue()));
      }
   }

   public static void loadStores() {
      MGS_CONFIGURATION_PREFERENCE_STORE.load();
      USER_PREFERENCE_STORE.load();
   }

   public static synchronized void clearStores() {
      MGS_CONFIGURATION_PREFERENCE_STORE.clear();
      USER_PREFERENCE_STORE.clear();
   }

   public static synchronized void clearAircraftConfigurations() {
      AIRCRAFT_CONFIGURATIONS.clear();
      AIRCRAFT_CONFIGURATION_HISTORIES.clear();
      SELECTED_FLIGHT_SYNTHESIS_DATA.clear();
      EPC_UMS_DATA.clear();
   }

   public static synchronized <T extends Configuration> T getConfiguration(Aircraft aircraft, String configurationType, Class<T> className) throws EntityNotFoundException {
      Configuration configuration = getAircraftConfiguration(aircraft).getConfigurations().get(configurationType);
      if (configuration == null) {
         throw new EntityNotFoundException("No " + configurationType + " configuration found !"); //$NON-NLS-1$
      }
      return className.cast(configuration);
   }

   public static synchronized AircraftConfiguration getAircraftConfiguration(Aircraft aircraft) throws EntityNotFoundException {
      AircraftConfiguration aircraftConfiguration = AIRCRAFT_CONFIGURATIONS.get(aircraft);
      if (aircraftConfiguration == null) {
         aircraftConfiguration = getAircraftBusiness().getAircraftConfiguration(aircraft.getId());
         AIRCRAFT_CONFIGURATIONS.put(aircraft, aircraftConfiguration);
      }
      return aircraftConfiguration;
   }

   public static synchronized AircraftConfigurationHistoryDto getAircraftConfigurationDto(Aircraft aircraft) throws EntityNotFoundException {
      AircraftConfigurationHistoryDto aircraftConfigurationHistoryDto = AIRCRAFT_CONFIGURATION_HISTORIES.get(aircraft);
      if (aircraftConfigurationHistoryDto == null) {
         AircraftConfiguration aircraftConfiguration = getAircraftConfiguration(aircraft);
         aircraftConfigurationHistoryDto = new AircraftConfigurationHistoryDto(aircraftConfiguration.getId());
         AIRCRAFT_CONFIGURATION_HISTORIES.put(aircraft, aircraftConfigurationHistoryDto);
      }
      return aircraftConfigurationHistoryDto;
   }

   private static IAircraftBusiness getAircraftBusiness() {
      BundleContext healthBundleContext = FrameworkUtil.getBundle(IAircraftBusiness.class).getBundleContext();
      return healthBundleContext.getService(healthBundleContext.getServiceReference(IAircraftBusiness.class));
   }

   private static IConfigurationBusiness getConfigurationBusiness() {
      BundleContext bundleContext = FrameworkUtil.getBundle(IConfigurationBusiness.class).getBundleContext();
      return bundleContext.getService(bundleContext.getServiceReference(IConfigurationBusiness.class));
   }

   public static void markAsDirty(Aircraft aircraft) {
      DIRTY_AIRCRAFTS.add(aircraft);
   }

   public static void markFlightSynthesisDataChanged(Aircraft aircraft) {
      FLIGHT_SYNTHESIS_DIRTY_AIRCRAFTS.add(aircraft);
   }

   public static synchronized boolean wasLastSaveConfirmed() {
      return lastSaveConfirmed;
   }

   /**
    * BCR-6605 whether the applicable-flight popup was shown for the last save.
    *
    * @return true when the user was asked to choose a flight
    */
   public static synchronized boolean wasLastSavePrompted() {
      return lastSavePrompted;
   }
}

