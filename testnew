package com.eurocopter.mgs.health.presentation.dialog;

import org.eclipse.jface.dialogs.Dialog;
import org.eclipse.jface.dialogs.IDialogConstants;
import org.eclipse.swt.SWT;
import org.eclipse.swt.widgets.Button;
import org.eclipse.swt.widgets.Composite;
import org.eclipse.swt.widgets.Control;
import org.eclipse.swt.widgets.Display;
import org.eclipse.ui.PlatformUI;
import org.eclipse.ui.forms.widgets.FormToolkit;

import com.eurocopter.mgs.aircraft.presentation.utils.ColorUtils;
import com.eurocopter.mgs.core.presentation.i18n.Messages;
import com.eurocopter.mgs.datamodel.flight.Flight;
import com.eurocopter.mgs.health.presentation.composite.BatchMarkerCreationComposite;

/**
 * Batch marker creation dialog window.
 */
public class BatchMarkerCreationDialog extends Dialog {

   /** MarkerComposite. */
   private BatchMarkerCreationComposite composite;

   /** The toolkit. */
   private final FormToolkit toolkit;

   /**
    * Default constructor. Builds a MarkerDialog.
    * 
    * @param model
    *           the view model.
    */
   public BatchMarkerCreationDialog() {
      super(PlatformUI.getWorkbench().getDisplay().getActiveShell());
      PlatformUI.getWorkbench().getDisplay();
      toolkit = new FormToolkit(PlatformUI.getWorkbench().getDisplay());
   }

   public String getMarkerDescription() {
      return composite.getMarkerDescription();
   }

   public Flight getSelectedFlight() {
      return composite.getSelectedFlight();
   }

   /**
    * Create contents of the dialog.
    * 
    * @param parent
    *           the parent
    * @return container
    */
   @Override
   protected Control createDialogArea(Composite parent) {
      parent.setBackground(Display.getDefault().getSystemColor(SWT.COLOR_WHITE));
      parent.setBackgroundMode(SWT.INHERIT_FORCE);
      composite = new BatchMarkerCreationComposite(parent);
      toolkit.adapt(composite);
      toolkit.adapt(parent);
      composite.pack();
      ColorUtils.forceBackgroundColor(parent);
      return composite;
   }

   /**
    * Create contents of the button bar.
    * 
    * @param parent
    *           the parent
    */
   @Override
   protected void createButtonsForButtonBar(Composite parent) {
      toolkit.adapt(parent);
      Button okButton = createButton(parent, IDialogConstants.OK_ID, Messages.CORE.getMnemonicEscapedString("OK"), true);
      createButton(parent, IDialogConstants.CANCEL_ID, Messages.CORE.getMnemonicEscapedString("Cancel_Button_Label"), false);
      composite.setMarkerDialogOKButton(okButton);
      ColorUtils.forceBackgroundColor(parent);
   }
}












