public interface IHealthCommonBusiness {

   List<Accelerometer> getAccelerometers(String aircraftId) throws EntityNotFoundException;

   AircraftDisplayData getAircraftDisplayData(String aircraftId);

   List<HealthMechanicalComponent> getHealthMechanicalComponents(String aircraftId);

   FlightIndicatorValue getFlightIndicatorValue(String flightId, String indicatorId) throws EntityNotFoundException;

   /**
    * Update close monitoring status for the given list of alarms.
    *
    * @param aircraftId
    *           aircraft id
    * @param kept
    *           list of alarms kept in close monitoring
    * @param withdrawn
    *           list of alarms withdrawn from close monitoring
    */
   void updateCloseMonitoringStatus(String aircraftId, Set<String> kept, Set<String> withdrawn);

   Map<String, Object> getHealthParameters();

   Map<Indicator, IndicatorModel> getIndicatorModels(String userId, String aircraftId) throws EntityNotFoundException;

   IndicatorConfiguration getLatestIndicatorConfiguration(String aircraftId, String indicatorId) throws EntityNotFoundException;

   IndicatorConfiguration getIndicatorConfigurationForFlight(String flightId, String indicatorId) throws EntityNotFoundException;

   Map<String, Map<IndicatorValue, IAcquisition>> getIndicatorValues(String avionicName, String aircraftId, String flightId);

   HealthMonitoringConfiguration getLatestConfiguration(String aircraftId) throws EntityNotFoundException;

   void createRelearnThresholdRequests(String aircraftId, List<String> learnedThresholds, long historyLearningTime, String learningReason, String loginName)
         throws ConcurrentAccessException;

   void acknowledgeAircraftHealthAlarms(String aircraftId, HealthAcknowledgementDto paramDto, String userLogin) throws ConcurrentAccessException;

   void acknowledgeMechanicalComponentAlarms(String aircraftId, String mcPath, HealthAcknowledgementDto paramDto, String login) throws EntityNotFoundException, ConcurrentAccessException;

   Map<HealthAlarm, Flight> getNotAckHealthAlarms(String aircraftId);

   Set<AlarmIndicatorModel> getNotAckHealthAlarmModels(String aircraftId);

   Map<HealthAlarm, Flight> getHealthAlarmsByIndicator(String indicatorId, Boolean acknowledged);

   Map<Alarm, Flight> getNotAcknowledgedHealthAlarmsByHmc(String componentId);

   Map<? extends Alarm, Flight> getAcknowledgedGreyHealthAlarmsAndVpuAnomaliesByHmc(String componentId);

   void acknowledgeIndicatorAlarms(String aircraftId, String indicatorId, HealthAcknowledgementDto paramDto, String login) throws EntityNotFoundException, ConcurrentAccessException;

   void closeMonitorAircraftHealthAlarms(String aircraftId, HealthAcknowledgementDto paramDto, String userLogin) throws ConcurrentAccessException;

   void closeMonitorMechanicalComponentAlarms(String aircraftId, String path, HealthAcknowledgementDto paramDto, String userLogin) throws ConcurrentAccessException;

   void closeMonitorIndicatorAlarms(String aircraftId, String indicatorId, HealthAcknowledgementDto paramDto, String login) throws ConcurrentAccessException;

   List<LearnedThresholdConfiguration> getIndicatorLatestLearnedThresholds(String aircraftId, String indicatorId) throws EntityNotFoundException;

   boolean hasLearnedThresholds(String aircraftId, String indicatorId) throws EntityNotFoundException;

   Map<IndicatorMarker, String> getIndicatorMarkers(String aircraftId, String indicatorId);

   void createIndicatorMarker(IndicatorMarkerDto indicatorMarkerDto) throws EntityNotFoundException;

   void createBatchIndicatorMarkers(BatchIndicatorMarkerDto batchIndicatorMarkerDto) throws EntityNotFoundException;

   void removeIndicatorMarker(String indicatorValueId, String markerId) throws EntityNotFoundException;

   void removeAcknowledgementMarker(String alarmId) throws EntityNotFoundException;

   Map<String, HealthMechanicalComponentConfiguration> getMechanicalComponentConfigurationsForAircraft(String aircraftId, String mechanicalComponentId) throws EntityNotFoundException;

   Map<HealthMechanicalComponent, HealthMechanicalComponentConfiguration> getActiveComponentsAndConfiguration(String aircraftId);

   Accelerometer getAccelerometer(String indicatorId, String aircraftId);

   Map<SensorAnomaly, Flight> getSensorAnomaliesByIndicator(String indicatorId);

   Map<IndicatorInvalidity, Flight> getIndicatorInvaliditiesByIndicator(String indicatorId);

   Set<ThresholdConfiguration> getThresholdConfigurations(String thresholdId);

   boolean hasReadIndicators(String aircraftId, String mechanicalComponentId);
}
