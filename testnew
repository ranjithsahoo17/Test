package com.eurocopter.mgs.presentation.event;

public enum MgsEventType {

   /**
    * Show flight synthesis
    */
   FLIGHT_SYNTHESIS_VISIBILITY,

   /**
    * Show flight list component
    */
   FLIGHT_LIST_VISIBILITY,

   /**
    * Enable flight selection
    */
   FLIGHT_SELECTION_ACTIVENESS,

   /**
    * Flight selected
    */
   FLIGHT_SELECTION,

   /**
    * Flight highlighted
    */
   FLIGHT_HIGHLIGHTED,

   /**
    * Threshold learning refreshed
    */
   LEARNING_THRESHOLD_REFRESHED,

   /**
    * User properties changed
    */
   USER_CHANGED,

   /** The event fired when the current user has been updated */
   CURRENT_USER_UPDATED,

   MEDIA_DELETION_EVENT,

   DOWNLOAD_FINISHED_EVENT,

   INDICATOR_BACK_EVENT,

   CONNECTION_EVENT,

   /** The event fired when an aircraft other than the current one has been updated (through A/C management, download, ...) */
   AIRCRAFT_UPDATED,

   /** The event fired when the current aircraft has been updated (through A/C management, download, ...) */
   CURRENT_AIRCRAFT_UPDATED,

   /** The event fired when the a flight of the current aircraft has been deleted (during purge) */
   CURRENT_AIRCRAFT_FLIGHT_DELETED,

   /** The event fired when an aircraft has been deleted. */
   AIRCRAFT_REMOVED,

   /** The event fired when an aircraft has been created. */
   AIRCRAFT_ADDED,

   /** The event fired when a new aircraft has been selected (typically from the Tree View. but not from the fleet view) */
   AIRCRAFT_SELECTED_FROM_TREE_VIEW,

   /** The event fired when a new aircraft has been selected from the fleet view only */
   AIRCRAFT_SELECTED_FROM_FLEET_VIEW,

   /** View Closed (use MgsEvent#setProperty to set the name of the view closed) */
   HEALTH_SIGNAL_VIEW_CLOSED,

   BACKGROUND_TASK_CREATED,

   BACKGROUND_TASK_UPDATED,

   BACKGROUND_TASK_DONE
}


