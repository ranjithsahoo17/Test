   private IndicatorConfiguration getIndicatorConfiguration(String indicatorId, HealthMonitoringConfiguration healthConfiguration) throws EntityNotFoundException {
      for (Map.Entry<HealthMechanicalComponent, HealthMechanicalComponentConfiguration> mcEntry : healthConfiguration.getMechanicalComponentConfigurations().entrySet()) {
         for (Map.Entry<Indicator, IndicatorConfiguration> indicatorEntry : mcEntry.getValue().getIndicatorConfigurations().entrySet()) {
            if (indicatorEntry.getKey().getId().equals(indicatorId)) {
               return indicatorEntry.getValue();
            }
         }
      }
      throw new EntityNotFoundException("Missing indicator configuration");
   }
