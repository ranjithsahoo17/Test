/**
 * Handle the threshold learning process action.
 */
public class HealthTreeViewNodeLearnThresholdAction extends Action {

   /** Class logger. */
   private static final Logger LOGGER = LogManager.getLogger(HealthTreeViewNodeLearnThresholdAction.class);

   /** The name of the action. */
   private static final String ACTION_NAME = Messages.CORE.getMnemonicEscapedString("Health_treeview_node_contextualAction_learn_threshold"); //$NON-NLS-1$

   /** Health Monitoring business. */
   private final IHealthCommonBusiness healthBusiness;

   /** The node. */
   private final IHealthTreeViewNodeModel node;

   /** Health TreeView Node Action. */
   private final HealthTreeViewNodeAction healthTreeViewNodeAction;

   /**
    * Builds a HealthTreeViewNodeLearnThresholdAction.
    *
    * @param healthTreeViewNodeAction
    *           the health tree view node action
    * @param node
    *           the node
    */
   public HealthTreeViewNodeLearnThresholdAction(HealthTreeViewNodeAction healthTreeViewNodeAction,
         IHealthTreeViewNodeModel node) {
      super(ACTION_NAME);
      setDescription(Messages.CORE.getString("ClickLearnThresholdAction")); //$NON-NLS-1$
      this.node = node;
      this.healthTreeViewNodeAction = healthTreeViewNodeAction;
      final BundleContext healthMonitoringBundleContext = FrameworkUtil.getBundle(IHealthCommonBusiness.class).getBundleContext();
      healthBusiness = healthMonitoringBundleContext.getService(healthMonitoringBundleContext.getServiceReference(IHealthCommonBusiness.class));
   }

   /**
    * {@inheritDoc}
    *
    * @see org.eclipse.jface.action.Action#runWithEvent(org.eclipse.swt.widgets.Event)
    */
   @Override
   public void runWithEvent(Event event) {
      learnThreshold();
   }

   /**
    * {@inheritDoc}
    *
    * @see org.eclipse.jface.action.Action#run()
    */
   @Override
   public void run() {
      runWithEvent(null);
   }

   /**
    * Manage the threshold learning process.
    */
   private void learnThreshold() {
      if (LOGGER.isDebugEnabled()) {
         LOGGER.debug("Starting node '{}'  threshold learning.", node.getName()); //$NON-NLS-1$ //$NON-NLS-2$
      }
      LOGGER.info("displayThresholdLearningDialog for '{}' node.", node.toString()); //$NON-NLS-1$ //$NON-NLS-2$

      try {
         // get the learning thresholds
         List<LearnedThresholdConfiguration> learnedThresholds;
         if (node instanceof IndicatorNodeModel) {
            learnedThresholds = getLearnedThresholdConfs(((IndicatorHmcModel) node.getObject()).getIndicator());
         } else {
            learnedThresholds = getLearnedThresholdConfs((MechanicalComponentModel) node.getObject());
         }

         long maxLearningTime = 0L;
         List<String> learnedThresholdIds = new ArrayList<>();
         // get the learned thresholds of the indicator
         for (LearnedThresholdConfiguration threshold : learnedThresholds) {
            learnedThresholdIds.add(threshold.getId());
            if (maxLearningTime < threshold.getLearningTime()) {
               maxLearningTime = threshold.getLearningTime();
            }
         }

         ThresholdLearningDialog dialog = new ThresholdLearningDialog(maxLearningTime);
         if (dialog.open() == Window.OK) {
            ThresholdLearningModel model = dialog.getModel();
            // create the threshold learning requests
            healthBusiness.createRelearnThresholdRequests(MgsSession.getInstance().getAircraft().getId(), learnedThresholdIds,
                  model.getHistoryLearningTime(), model.getLearningReason(), MgsSession.getInstance().getUser().getLoginName());
         }

         // TODO MLAH TBC
         // update the Health tree node status and the mechanical component bitmap view
         healthTreeViewNodeAction.updateHealthNodesStatus();
         healthTreeViewNodeAction.updateHealthViews(node, true);
      } catch (AircraftConcurrentAccessException e) {
         StatusManager.getManager().handle(AircraftExceptionHandler.getStatusForAircraftException(e, "relearn", Activator.PLUGIN_ID), StatusManager.BLOCK); //$NON-NLS-1$
      } catch (AircraftFrozenException e) {
         StatusManager.getManager().handle(new GenericStatus(IStatus.ERROR, Activator.PLUGIN_ID, Messages.CORE.getString("relearn.aborted.aircraftFrozen"), e), StatusManager.BLOCK); //$NON-NLS-1$
      } catch (ServiceException e) {
         StatusManager.getManager().handle(new GenericStatus(IStatus.ERROR, Activator.PLUGIN_ID, Messages.CORE.getString("relearn.aborted"), e), StatusManager.BLOCK); //$NON-NLS-1$
      }

      // TODO MLAH TBC

      if (LOGGER.isDebugEnabled()) {
         LOGGER.debug("End of node '{}' threshold learning.", node.getName()); //$NON-NLS-1$ //$NON-NLS-2$
      }
   }

   /**
    * {@inheritDoc}
    *
    * @see java.lang.Object#toString()
    */
   @Override
   public String toString() {
      return getText();
   }

   /**
    * {@inheritDoc}
    *
    * @see org.eclipse.jface.action.Action#isEnabled()
    */
   @Override
   public boolean isEnabled() {

      if (MgsSession.getInstance().getAircraft().getAircraftState() == AircraftState.FROZEN) {
         // If aicraft is frozen, the action is not available
         return false;
      } else {
         // get the learning thresholds
         if (node instanceof IndicatorNodeModel) {
            return hasLearnedThresholdConfs(((IndicatorHmcModel) node.getObject()).getIndicator());
         }
         return hasLearnedThresholdConfs((MechanicalComponentModel) node.getObject());
      }
   }

   private boolean hasLearnedThresholdConfs(Indicator indicator) {
      try {
         return healthBusiness.hasLearnedThresholds(MgsSession.getInstance().getAircraft().getId(), indicator.getId());
      } catch (EntityNotFoundException e) {
         LOGGER.warn("Unable to retrieve learned thresholds", e);
         return false;
      }
   }

   private boolean hasLearnedThresholdConfs(MechanicalComponentModel mechanicalComponent) {
      if (mechanicalComponent instanceof HealthMechanicalComponentModel healthMechanicalComponent) {

         // get the thresholds of the current mechanical component
         Map<String, Indicator> indicators = healthMechanicalComponent.getHealthComponent().getIndicators();
         if (indicators != null) {
            for (Indicator indicator : indicators.values()) {
               if (hasLearnedThresholdConfs(indicator)) {
                  return true;
               }
            }
         }
         return false;
      }

      // get the thresholds for the sub-components
      List<MechanicalComponentModel> subComponents = mechanicalComponent.getSubComponents();
      if (subComponents != null) {
         for (MechanicalComponentModel subComponent : subComponents) {
            if (hasLearnedThresholdConfs(subComponent)) {
               return true;
            }
         }
      }
      return false;
   }

   /**
    * Return the learned thresholds of a mechanical component.
    *
    * @param mechanicalComponent
    *           the mechanical component
    * @return the learned thresholds of the mechanical component
    */
   private List<LearnedThresholdConfiguration> getLearnedThresholdConfs(MechanicalComponentModel mechanicalComponent) {
      List<LearnedThresholdConfiguration> learnedThresholds = new ArrayList<>();

      if (mechanicalComponent instanceof HealthMechanicalComponentModel healthMechanicalComponent) {

         // get the thresholds of the current mechanical component
         Map<String, Indicator> indicators = healthMechanicalComponent.getHealthComponent().getIndicators();
         if (indicators != null) {
            for (Indicator indicator : indicators.values()) {
               learnedThresholds.addAll(getLearnedThresholdConfs(indicator));
            }
         }
      }

      // get the thresholds for the sub-components
      List<MechanicalComponentModel> subComponents = mechanicalComponent.getSubComponents();
      if (subComponents != null) {
         for (MechanicalComponentModel subComponent : subComponents) {
            learnedThresholds.addAll(getLearnedThresholdConfs(subComponent));
         }
      }

      return learnedThresholds;
   }

   /**
    * Get the learned thresholds of an indicator.
    *
    * @param indicator
    *           the indicator
    * @param model
    * @return the learned thresholds of the indicator
    */
   private List<LearnedThresholdConfiguration> getLearnedThresholdConfs(Indicator indicator) {
      // Get the latest threshold of the indicator
      try {
         return healthBusiness.getIndicatorLatestLearnedThresholds(MgsSession.getInstance().getAircraft().getId(), indicator.getId());
      } catch (EntityNotFoundException e) {
         LOGGER.warn("Unable to retrieve learned thresholds", e);
      }
      return Collections.emptyList();

   }
}


