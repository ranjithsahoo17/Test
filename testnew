@Remote(IDownloadService.class)
@Stateless(mappedName = IDownloadService.EJB_NAME)
@TransactionManagement(TransactionManagementType.BEAN)
public class DownloadService implements IDownloadService {

   private static final Logger LOGGER = LogManager.getLogger(DownloadService.class);

   @EJB
   private CigalheResourceManager cigalheResourceManager;

   @EJB
   private MarmsResourceManager marmsResourceManager;

   @EJB
   private CigalheDownloadManager cigalheDownloadManager;

   @EJB
   private MarmsDownloadManager marmsDownloadManager;

   @EJB
   private ParameterManager parameterManager;

   @EJB
   private ProgressManager progressManager;

   @EJB
   private FeatureManager featureManager;

   @EJB
   private BackgroundOperationService backgroundOperationService;

   @Resource
   private UserTransaction transaction;

   /** The manager. */
   @PersistenceContext
   private EntityManager manager;

   @EJB
   private AsyncQueue asyncQueue;

   @Override
   @Asynchronous
   public Future<DownloadResult> download(DownloadDto download, TopicDto topicDto, TopicDto backgroundTopicDto, DownloadMode downloadMode, DataCollectionMode dataCollectionMode) {
      LOGGER.debug("Server received {} flight data", download.getAvionic().name());

      final Date downloadDate = Calendar.getInstance(TimeZone.getTimeZone("GMT")).getTime();
      final Multimap<String, String> downloadPerAircraft = ArrayListMultimap.create();
      final ExceptionHandler exceptionHandler = new ExceptionHandler();
      final SimpleDateFormat simpleDateFormat = new SimpleDateFormat(ResourceManager.DATE_FORMAT_PATTERN);
      simpleDateFormat.setTimeZone(TimeZone.getTimeZone("GMT"));
      final String folderName = simpleDateFormat.format(downloadDate);

      try {
         transaction.begin();

         // ====================================================================
         // DISK-FIX (Part 1): pre-check server disk space BEFORE any processing.
         // WHY: client already pre-checks its own disk (DownloadManager L116-127),
         // but client-side check is blind to the server's free space. In a
         // true client/server setup this is exactly the gap reported by AH.
         // If the server is short on space, fail fast with a CLEAN reason
         // that the client popup logic already knows how to display.
         // ====================================================================
         checkServerDiskSpace(download);

         Context context = progressManager.initContext(topicDto);

         switch (download.getAvionic()) {
            case CIGALHE -> processCigalheAnalysis(download, backgroundTopicDto, downloadDate, context, exceptionHandler, downloadPerAircraft, downloadMode);
            case MARMS -> processMarmsDownload(download, backgroundTopicDto, downloadDate, context, exceptionHandler, downloadPerAircraft, downloadMode);
            default -> throw new IllegalStateException(download.getAvionic().name());
         }

         progressManager.disposeContext();
         transaction.commit();
      } catch (Exception e) {
         try {
            if (e instanceof DownloadFailedException downloadFailedException) {
               if (downloadFailedException.getReason() == DownloadFailedReason.NOT_ENOUGH_DISK_SPACE) {
                  LOGGER.error("There is not enough space on MGS server for avionic {}. "
                        + "Needed: {}, available: {}.",
                        download.getAvionic().name(),
                        downloadFailedException.getNeededSpace(),
                        downloadFailedException.getUsableSpace(),
                        downloadFailedException);
               } else {
                  LOGGER.warn("Download failed: reason={}", downloadFailedException.getReason(), downloadFailedException);
               }
               exceptionHandler.setDownloadFailedException(downloadFailedException);
            } else if (e instanceof NotificationException notificationException) {
               exceptionHandler.setDownloadFailedException(new DownloadFailedException(DownloadFailedReason.UNEXPECTED_ERROR, notificationException));
            }
            transaction.rollback();
         } catch (IllegalStateException | SystemException | SecurityException e1) {
            LOGGER.warn("Unable to rollback transaction", e1);
         } finally {
            downloadPerAircraft.clear();
            removeTempDataCollectionFolder(folderName);
         }
      }

      final Multimap<Aircraft, Flight> downloadedFlights = ArrayListMultimap.create();
      try {
         transaction.begin();
         final boolean dataCollectionEnabled;
         if (dataCollectionMode == DataCollectionMode.ONLY_MANAGED_AIRCRAFTS) {
            boolean oneAircraftHasDataCollection = false;
            for (Entry<String, String> entry : downloadPerAircraft.entries()) {
               Aircraft aircraft = manager.find(Aircraft.class, entry.getKey());
               if (!oneAircraftHasDataCollection) {
                  oneAircraftHasDataCollection = hasFeatureEnable(aircraft, FeatureName.DATA_COLLECTION);
               }
            }
            // The "isEmpty" adds support for downloads containing only FDCR data on managed aircrafts
            dataCollectionEnabled = downloadPerAircraft.isEmpty() || oneAircraftHasDataCollection;

            removeAircraftNotManagedData(folderName, exceptionHandler.getAircraftErrors());
         } else if (dataCollectionMode == DataCollectionMode.ALL_AIRCRAFTS) {
            dataCollectionEnabled = true;
         } else {
            throw new IllegalStateException();
         }

         // The downloaded flights map is mostly used for automatically printing the MRP
         for (Entry<String, String> entry : downloadPerAircraft.entries()) {
            Aircraft aircraft = manager.find(Aircraft.class, entry.getKey());
            Download downloadEntity = manager.find(Download.class, entry.getValue());
            for (Flight flight : downloadEntity.getFlights()) {
               downloadedFlights.put(aircraft, flight);
            }
         }

         /* Data collection is carried out if feature is enabled for at least one downloaded A/C */
         if (dataCollectionEnabled) {
            asyncQueue.addTask(new DataCollectionRequest(DataCollectionType.USER_OPERATION_DATA_COLLECTION, downloadPerAircraft));
            asyncQueue.addTask(new DataCollectionRequest(DataCollectionType.FLIGHT_DATA_COLLECTION, downloadPerAircraft, folderName));
         } else {
            removeTempDataCollectionFolder(folderName);
         }

         if (isEngineDataCollectionEnabled(downloadPerAircraft)) {
            asyncQueue.addTask(new DataCollectionRequest(DataCollectionType.ENGINE_DATA_COLLECTION, downloadPerAircraft, folderName));
         }
         asyncQueue.addTask(new PurgeRequest(PurgeType.FLIGHT_AUTO, downloadPerAircraft));
         transaction.commit();
      } catch (Exception e) {
         try {
            DownloadFailedException dfe = translateIfDiskFull(e);
            if (dfe != null) {
               LOGGER.error("Server disk full during second-stage processing", e);
               exceptionHandler.setDownloadFailedException(dfe);
            }
            transaction.rollback();
         } catch (IllegalStateException | SystemException | SecurityException e1) {
            LOGGER.warn("Unable to rollback transaction", e1);
         } finally {
            downloadPerAircraft.clear();
         }
         // An error occurred, the data collection will never happen
         removeTempDataCollectionFolder(folderName);
      }

      DownloadResult downloadResult = exceptionHandler.buildDownloadResult(downloadedFlights.asMap());

      LOGGER.debug("Analysis completed on server.");
      return new AsyncResult<>(downloadResult);
   }

   private void removeTempDataCollectionFolder(final String folderName) {
      final File tempDataCollectionFolder = parameterManager.getTempDataCollectionFolder();
      final File sourceFolder = new File(new File(tempDataCollectionFolder, "data_collection"), folderName);
      if (sourceFolder.exists()) {
         FileUtils.deleteQuietly(sourceFolder);
      }
   }

   private void removeAircraftNotManagedData(String folderName, List<AircraftError> aircraftErrors) {
      final File tempDataCollectionFolder = parameterManager.getTempDataCollectionFolder();
      for (String dataCollectionFolderName : Arrays.asList("data_collection", "fdcr")) {
         final File dataFolder = new File(new File(tempDataCollectionFolder, dataCollectionFolderName), folderName);
         for (AircraftError error : aircraftErrors) {
            if (AircraftErrorType.AIRCRAFT_NOT_MANAGED != error.getAircraftErrorType()) {
               continue;
            }
            final String aircraftSubtype = error.getArgs()[0];
            final String aircraftSerialNumber = error.getArgs()[1];
            final File aircraftFolder = new File(dataFolder, aircraftSubtype + "_" + aircraftSerialNumber);
            if (aircraftFolder.exists()) {
               FileUtils.deleteQuietly(aircraftFolder);
            }
         }
      }
   }

   private boolean isEngineDataCollectionEnabled(Multimap<String, String> downloadPerAircraft) {
      boolean oneAircraftHasEngineDataCollection = false;
      for (Entry<String, String> entry : downloadPerAircraft.entries()) {
         Aircraft aircraft = manager.find(Aircraft.class, entry.getKey());
         if (!oneAircraftHasEngineDataCollection) {
            oneAircraftHasEngineDataCollection = hasFeatureEnable(aircraft, FeatureName.ENGINE_DATA_COLLECTION);
         }
      }
      // The "isEmpty" adds support for downloads containing only FDCR data on managed aircrafts
      return downloadPerAircraft.isEmpty() || oneAircraftHasEngineDataCollection;
   }

   private boolean hasFeatureEnable(Aircraft aircraft, FeatureName featureName) {
      for (AvionicVersion avionicVersion : aircraft.getAircraftType().getAvionicVersions().values()) {
         if (featureManager.isEnabled(avionicVersion, featureName)) {
            return true;
         }
      }
      return false;
   }

   private void processMarmsDownload(DownloadDto downloadDto, TopicDto backgroundTopicDto, Date downloadDate, Context context, ExceptionHandler exceptionHandler,
         final Multimap<String, String> downloadPerAircraft, DownloadMode downloadMode)
         throws NotificationException, DownloadFailedException {
      // Notify the start of FTP transfer
      progressManager.notifyProgress(context, null, Progress.SFTP_TRANSFER);

      MarmsDownloadBundle marmsDownloadBundle = marmsResourceManager.download(downloadDto.getUrl(), downloadDate, exceptionHandler);
      if (marmsDownloadBundle.getAircraftIds().isEmpty()) {
         throw new DownloadFailedException(DownloadFailedReason.NO_FLIGHTS_FOUND);
      }

      try {
         downloadPerAircraft.putAll(marmsDownloadManager.download(marmsDownloadBundle, context, downloadDate, exceptionHandler, downloadMode));
      } catch (RuntimeException e) {
         // DISK-FIX (Part 2): detect disk-full IOExceptions and surface them
         // cleanly instead of as UNEXPECTED_ERROR. Otherwise the client just
         // sees "Unexpected error" with no clue it's a disk-space issue.
         DownloadFailedException diskFull = translateIfDiskFull(e);
         if (diskFull != null) {
            LOGGER.error("Server disk full while downloading M'ARMS flights", e);
            throw diskFull;
         }
         LOGGER.warn("Exception while downloading flights: {}", e.getMessage(), e);
         throw new DownloadFailedException(DownloadFailedReason.UNEXPECTED_ERROR, e);
      }

      progressManager.notifyProgress(context, null, Progress.SFTP_TRANSFER);

      // Print the flight report now
      Context backgroundContext = progressManager.initContext(backgroundTopicDto);
      for (Map.Entry<String, String> entry : downloadPerAircraft.entries()) {
         String aircraftId = entry.getKey();
         String downloadId = entry.getValue();
         Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
         Download download = manager.find(Download.class, downloadId);
         if (download != null) {
            HashMap<Aircraft, Collection<Flight>> flights = new HashMap<>();
            Set<Flight> aircraftFlights = download.getFlights();
            aircraftFlights.size();
            flights.put(aircraft, aircraftFlights);
            progressManager.notifyProgress(backgroundContext, flights, Progress.END);
         }
      }
      progressManager.disposeContext();

   }

   private void processCigalheAnalysis(DownloadDto downloadDto, TopicDto backgroundTopicDto, Date downloadDate, Context context, ExceptionHandler exceptionHandler,
         final Multimap<String, String> downloadPerAircraft, DownloadMode modeDownload) throws NotificationException, DownloadFailedException {
      final String folderName;
      CigalheDownloadBundle cigalheDownloadBundle = retrieveFiles(downloadDto, downloadDate, context, exceptionHandler);
      try {
         downloadPerAircraft.putAll(cigalheDownloadManager.download(cigalheDownloadBundle, context, downloadDate, exceptionHandler, modeDownload));
      } catch (EJBTransactionRolledbackException e) {
         LOGGER.warn("Exception while downloading flights: flight(s) was (were) concurrently updated during the download: the analysis is cancelled.", e);
         throw new DownloadFailedException(DownloadFailedReason.FLIGHT_CONCURRENT_UPDATE, e);
      } catch (RuntimeException e) {
         // DISK-FIX (Part 2): same translation as the M'ARMS path.
         DownloadFailedException diskFull = translateIfDiskFull(e);
         if (diskFull != null) {
            LOGGER.error("Server disk full while downloading CIGALHE flights", e);
            throw diskFull;
         }
         LOGGER.warn("Exception while downloading flights: {}", e.getMessage(), e);
         throw new DownloadFailedException(DownloadFailedReason.UNEXPECTED_ERROR, e);
      }
      folderName = cigalheDownloadBundle.getFolder().getName();
      if (cigalheDownloadBundle.getFdcrFolder().exists()) {
         BackgroundOperation operation = new BackgroundOperation(UUID.randomUUID().toString(), Operation.FDCR_ANALYSIS, folderName);
         operation.setTopicId(backgroundTopicDto.getOperationId());
         for (Entry<String, String> entry : downloadPerAircraft.entries()) {
            operation.getDownloadIds().put(entry.getValue(), entry.getKey());
         }
         backgroundOperationService.create(operation);
         // Wait the end of FDCR analysis to print Flight Report
      } else {
         // Print the flight report now
         Context backgroundContext = progressManager.initContext(backgroundTopicDto);
         for (Map.Entry<String, String> entry : downloadPerAircraft.entries()) {
            String aircraftId = entry.getKey();
            String downloadId = entry.getValue();
            Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
            Download download = manager.find(Download.class, downloadId);
            if (download != null) {
               HashMap<Aircraft, Collection<Flight>> flights = new HashMap<>();
               Set<Flight> aircraftFlights = download.getFlights();
               aircraftFlights.size();
               flights.put(aircraft, aircraftFlights);
               progressManager.notifyProgress(backgroundContext, flights, Progress.END);
            }
         }
         progressManager.disposeContext();
      }
   }

   /**
    * Download and collect data for all aircraft
    * 
    * @param downloadDto
    * @param downloadDate
    * @param context
    * @param exceptionHandler
    * @return
    * @throws NotificationException
    * @throws DownloadFailedException
    */
   private CigalheDownloadBundle retrieveFiles(DownloadDto downloadDto, Date downloadDate, Context context, ExceptionHandler exceptionHandler) throws NotificationException,
         DownloadFailedException {
      // Notify the start of FTP transfer
      progressManager.notifyProgress(context, null, Progress.SFTP_TRANSFER);

      CigalheDownloadBundle cigalheDownloadBundle = cigalheResourceManager.download(downloadDto.getUrl(), downloadDate, exceptionHandler);
      if (cigalheDownloadBundle.getAircraftIds().isEmpty()) {
         throw new DownloadFailedException(DownloadFailedReason.NO_FLIGHTS_FOUND);
      }
      return cigalheDownloadBundle;
   }

   // =========================================================================
   // DISK-FIX: pre-check helper. (Part 1)
   //
   // Computes "needed = source-archive-size × DISK_SPACE_MULTIPLIER + margin"
   // and compares with the usable space in the server's working folder
   // (parameterManager.getTempDataCollectionFolder()).
   //
   // Failure modes:
   // • Cannot determine source size → log a warning and skip the pre-check.
   // The runtime catch (Part 2) will still surface a disk-full at the
   // moment the write actually fails.
   // • Not enough space → throw DownloadFailedException(NOT_ENOUGH_DISK_SPACE)
   // populated with usableSpace and neededSpace so the client popup shows
   // the actual numbers, exactly like the client-side pre-check does.
   // =========================================================================
   private void checkServerDiskSpace(DownloadDto downloadDto) throws DownloadFailedException {
      final String url = downloadDto.getUrl();
      if (url == null) {
         return; // nothing to check
      }

      final long sourceSize;
      try {
         sourceSize = getSourceFileSize(url);
         LOGGER.info("Get source file size (url={}) :" + sourceSize, url);
      } catch (IOException e) {
         LOGGER.warn("Could not determine source archive size for disk-space pre-check (url={}); skipping pre-check", url, e);
         return;
      }
      if (sourceSize <= 0) {
         // Unknown size — skip the pre-check, runtime catch will handle real failures.
         return;
      }

      final long neededSpace = sourceSize;
      final File workingFolder = parameterManager.getTempDataCollectionFolder();
      final long usableSpace = workingFolder != null ? workingFolder.getUsableSpace() : 0L;

      if (neededSpace > usableSpace) {
         DownloadFailedException dfe = new DownloadFailedException(DownloadFailedReason.NOT_ENOUGH_DISK_SPACE);
         dfe.setUsableSpace(FileUtils.byteCountToDisplaySize(usableSpace));
         dfe.setNeededSpace(FileUtils.byteCountToDisplaySize(neededSpace));
         LOGGER.error("Server pre-check failed: not enough disk space. Needed: {}, available: {} (working folder: {})",
               FileUtils.byteCountToDisplaySize(neededSpace),
               FileUtils.byteCountToDisplaySize(usableSpace),
               workingFolder);
         throw dfe;
      }
   }

   // =========================================================================
   // DISK-FIX: read the source archive size from the URL.
   // Supports both 'file:' (single-machine) and 'sftp:'/'http:' URLs returned
   // by DownloadDto.getUrl() — see client-side DownloadManager L211-217.
   // =========================================================================
   private long getSourceFileSize(String downloadUrl) throws IOException {

      long result = 0;

      int p = downloadUrl.indexOf(":/");
      String protocol = p > 0 ? downloadUrl.substring(0, p).toLowerCase() : "";

      if ("file".equalsIgnoreCase(protocol)) {
         result = new File(downloadUrl.substring(p + 2)).length();
      }

      if ("sftp".equals(protocol) && SftpTransfer.isSftp(downloadUrl)) {
         result = SftpTransfer.getRemoteFileSize(downloadUrl);
      }

      if ("ftp".equals(protocol)) {
         URLConnection conn = new URL(downloadUrl).openConnection();
         conn.connect();
         try {
            result = conn.getContentLengthLong();
         } finally {
            // Some connections need explicit close; URLConnection has no close(),
            // but reading getContentLengthLong is enough. No-op here for clarity.
         }
      }

      return result;

   }

   // =========================================================================
   // DISK-FIX: walk a Throwable chain and detect disk-full I/O failures.
   // Used by:
   // • Part 2 — runtime catch in processMarmsDownload / processCigalheAnalysis
   // • The second-tx catch above
   // Matches the typical messages on Linux ("No space left on device"),
   // Windows ("There is not enough space on the disk"), and a generic ENOSPC.
   // =========================================================================
   private DownloadFailedException translateIfDiskFull(Throwable t) {
      Throwable cause = t;
      while (cause != null) {
         String msg = cause.getMessage();
         if (msg != null && (msg.contains("No space left on device")
               || msg.contains("ENOSPC")
               || msg.contains("not enough space on the disk")
               || msg.toLowerCase().contains("disk full"))) {
            DownloadFailedException dfe = new DownloadFailedException(DownloadFailedReason.NOT_ENOUGH_DISK_SPACE, t);
            // Populate usable space if we can — gives the client popup something useful to show.
            File workingFolder = parameterManager.getTempDataCollectionFolder();
            if (workingFolder != null) {
               dfe.setUsableSpace(FileUtils.byteCountToDisplaySize(workingFolder.getUsableSpace()));
            }
            return dfe;
         }
         cause = cause.getCause();
      }
      return null;
   }

}

