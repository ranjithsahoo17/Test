package com.eurocopter.mgs.datamodel.health.monitoring;

import java.util.HashSet;
import java.util.Set;

import jakarta.persistence.CascadeType;
import jakarta.persistence.Column;
import jakarta.persistence.DiscriminatorValue;
import jakarta.persistence.Entity;
import jakarta.persistence.FetchType;
import jakarta.persistence.JoinColumn;
import jakarta.persistence.OneToMany;

/**
 * This class represents a Learned Threshold.
 */
@Entity
@DiscriminatorValue(value = "LEARNED")
public class LearnedThresholdConfiguration extends ThresholdConfiguration {

   private static final long serialVersionUID = 1L;

   /**
    * Learning time (in flight hours) for learned threshold.
    */
   @Column(name = "LEARNING_TIME")
   private long learningTime;

   /**
    * Minimum value of a learned threshold. (OPTIONAL)
    */
   @Column(name = "MINIMUM_THRESHOLD")
   private Double minimumThreshold;

   /**
    * Maximum value of a learned threshold.
    */
   @Column(name = "MAXIMUM_THRESHOLD")
   private double maximumThreshold;

   /**
    * Default value of the threshold.
    */
   @Column(name = "DEFAULT_VALUE")
   private Double value;

   /**
    * Mean factor for relearning value computation.
    */
   @Column(name = "MEAN_FACTOR")
   private Double meanFactor;

   /**
    * Deviation coefficient for relearning value computation.
    */
   @Column(name = "DEVIATION_COEFFICIENT")
   private Double deviationCoefficient;

   /**
    * Minimum deviation for relearning value computation.
    */
   @Column(name = "MINIMUM_DEVIATION")
   private Double minimumDeviation;

   /** The relearn requests. */
   @OneToMany(cascade = CascadeType.ALL, fetch = FetchType.EAGER, orphanRemoval = true)
   @JoinColumn(name = "THRESHOLD_CONFIGURATION_ID")
   private Set<RelearnThresholdRequest> relearnRequests = new HashSet<>();

   LearnedThresholdConfiguration() {
   }

   public LearnedThresholdConfiguration(String id) {
      super(id);
   }

   public long getLearningTime() {
      return learningTime;
   }

   public void setLearningTime(long learningTime) {
      this.learningTime = learningTime;
   }

   public Double getMinimumThreshold() {
      return minimumThreshold;
   }

   public void setMinimumThreshold(Double minimumThreshold) {
      this.minimumThreshold = minimumThreshold;
   }

   public double getMaximumThreshold() {
      return maximumThreshold;
   }

   public void setMaximumThreshold(double maximumThreshold) {
      this.maximumThreshold = maximumThreshold;
   }

   @Override
   public Double getValue() {
      return value;
   }

   public void setValue(Double defaultValue) {
      this.value = defaultValue;
   }

   public double getMeanFactor() {
      return meanFactor != null ? meanFactor : 1;
   }

   public void setMeanFactor(Double meanFactor) {
      this.meanFactor = meanFactor;
   }

   public Double getDeviationCoefficient() {
      return deviationCoefficient;
   }

   public void setDeviationCoefficient(Double deviationCoefficient) {
      this.deviationCoefficient = deviationCoefficient;
   }

   public Double getMinimumDeviation() {
      return minimumDeviation;
   }

   public void setMinimumDeviation(Double minimumDeviation) {
      this.minimumDeviation = minimumDeviation;
   }

   /**
    * Gets the relearn requests.
    *
    * @return the relearn requests
    */
   public Set<RelearnThresholdRequest> getRelearnRequests() {
      return relearnRequests;
   }

   /**
    * Sets the relearn requests.
    *
    * @param relearnRequest
    *           the new relearn requests
    */
   public void setRelearnRequests(Set<RelearnThresholdRequest> relearnRequest) {
      this.relearnRequests = relearnRequest;
   }

   @Override
   public String toString() {
      return "LearnedThreshold [learningTime=" + learningTime + ", maximumThreshold=" + maximumThreshold + ", defaultValue=" + value + ", toString()="
            + super.toString() + "]";
   }
}







