   @Override
   public void acknowledgeAircraftHealthAlarms(String aircraftId, HealthAcknowledgementDto paramDto, String login) throws ConcurrentAccessException {
      acknowledgementManager.acknowledgeAlarms(
            aircraftId, paramDto.getAlarmIds(), paramDto.getAckDate(), paramDto.getAckReason(), null, paramDto.isCreateMarker(), login);
   }

   @Override
   public void acknowledgeMechanicalComponentAlarms(String aircraftId, String mcPath, HealthAcknowledgementDto paramDto, String login)
         throws EntityNotFoundException, ConcurrentAccessException {
      List<HealthMechanicalComponent> healthMechanicalComponents = manager.createNamedQuery("findActiveHMCsByAircraftAndRootPath", HealthMechanicalComponent.class)
            .setParameter("aircraftId", aircraftId)
            .setParameter("prefix", mcPath + '%')
            .getResultList();
      final String changedComponentName;
      if (paramDto.isComponentChanged() && !healthMechanicalComponents.isEmpty()) {
         changedComponentName = healthMechanicalComponents.iterator().next().getName();
      } else {
         changedComponentName = null;
      }
      acknowledgementManager.acknowledgeAlarms(
            aircraftId, paramDto.getAlarmIds(), paramDto.getAckDate(), paramDto.getAckReason(), changedComponentName, paramDto.isCreateMarker(), login);
      if (paramDto.isComponentChanged()) {
         setThresholdInRelearningPhase(aircraftId, healthMechanicalComponents, paramDto.getRelearnReason(),
               paramDto.getHistoryLearningTime(), login);
      }
   }

   @Override
   public void acknowledgeIndicatorAlarms(String aircraftId, String indicatorId, HealthAcknowledgementDto paramDto, String login)
         throws EntityNotFoundException, ConcurrentAccessException {
      final String changedComponentName;
      if (paramDto.isComponentChanged()) {
         changedComponentName = manager.find(Indicator.class, indicatorId).getName();
      } else {
         changedComponentName = null;
      }
      acknowledgementManager.acknowledgeAlarms(
            aircraftId, paramDto.getAlarmIds(), paramDto.getAckDate(), paramDto.getAckReason(), changedComponentName, paramDto.isCreateMarker(), login);
      if (paramDto.isComponentChanged()) {
         // Mark sensor as changed.
         Indicator indicator = manager.find(Indicator.class, indicatorId);
         // Set all learned thresholds related to the sensor in re-learning phase.
         setThresholdInRelearningPhase(aircraftId, indicator, paramDto.getRelearnReason(), paramDto.getHistoryLearningTime(), login);
      }
   }

   @Override
   public void closeMonitorAircraftHealthAlarms(String aircraftId, HealthAcknowledgementDto paramDto, String login) throws ConcurrentAccessException {
      aircraftLockManager.throwExceptionIfAircraftLocked(aircraftId);
      List<HealthAlarm> alarms = manager.createNamedQuery("findHealthAlarmsByAircraft", HealthAlarm.class)
            .setParameter("aircraftId", aircraftId)
            .setParameter("status", AlarmStatus.NOTACK.name())
            .getResultList();
      acknowledgementManager.closeMonitorAlarms(aircraftId, alarms, paramDto.getAckDate(), paramDto.getAckReason(), paramDto.getCloseMonitoringDuration().getMillis(), login);
   }

   @Override
   public void closeMonitorMechanicalComponentAlarms(String aircraftId, String mcPath, HealthAcknowledgementDto paramDto, String login) throws ConcurrentAccessException {
      aircraftLockManager.throwExceptionIfAircraftLocked(aircraftId);
      List<HealthMechanicalComponent> healthMechanicalComponents = manager.createNamedQuery("findActiveHMCsByAircraftAndRootPath", HealthMechanicalComponent.class)
            .setParameter("aircraftId", aircraftId)
            .setParameter("prefix", mcPath + '%')
            .getResultList();
      ArrayList<String> ids = new ArrayList<>();
      for (HealthMechanicalComponent healthMechanicalComponent : healthMechanicalComponents) {
         ids.add(healthMechanicalComponent.getId());
      }
      List<HealthAlarm> alarms = manager.createNamedQuery("findHealthAlarmsByHealthMechanicalComponents", HealthAlarm.class)
            .setParameter("healthMechanicalComponentIds", ids)
            .setParameter("status", AlarmStatus.NOTACK.name())
            .getResultList();
      acknowledgementManager.closeMonitorAlarms(aircraftId, alarms, paramDto.getAckDate(), paramDto.getAckReason(), paramDto.getCloseMonitoringDuration().getMillis(), login);
   }

   @Override
   public void closeMonitorIndicatorAlarms(String aircraftId, String indicatorId, HealthAcknowledgementDto paramDto, String login) throws ConcurrentAccessException {
      aircraftLockManager.throwExceptionIfAircraftLocked(aircraftId);
      TypedQuery<HealthAlarm> query = manager.createNamedQuery("findHealthAlarmsByIndicator", HealthAlarm.class);
      List<HealthAlarm> alarms = query.setParameter("indicatorId", indicatorId).setParameter("status", AlarmStatus.NOTACK.name()).getResultList();
      acknowledgementManager.closeMonitorAlarms(aircraftId, alarms, paramDto.getAckDate(), paramDto.getAckReason(), paramDto.getCloseMonitoringDuration().getMillis(), login);
   }

   @Override
   public void removeAcknowledgementMarker(String alarmId) throws EntityNotFoundException {
      Alarm alarm = manager.find(Alarm.class, alarmId);
      if (alarm == null) {
         throw new EntityNotFoundException("Cannot find alarm with id " + alarmId);
      }
      alarm.setCreateMarker(false);
   }

   @Override
   public Accelerometer getAccelerometer(String indicatorId, String aircraftId) {
      final HealthMonitoringConfiguration healthConfiguration;
      try {
         healthConfiguration = healthDao.getLatestConfiguration(aircraftId);
      } catch (EntityNotFoundException e) {
         LOGGER.error("Entity not found", e);
         return null;
      }
      for (HealthMechanicalComponentConfiguration hmcc : healthConfiguration.getMechanicalComponentConfigurations().values()) {
         for (Entry<Indicator, IndicatorConfiguration> entry : hmcc.getIndicatorConfigurations().entrySet()) {
            if (entry.getKey().getId().equals(indicatorId)) {
               return entry.getValue().getAccelerometer();
            }
         }
      }
      return null;
   }

   private List<String> getIndicatorPath(Aircraft aircraft, Indicator indicator) {
      List<String> indicatorLocations = new ArrayList<>();
      for (HealthMechanicalComponent mechanicalComponent : aircraft.getHealthComponents()) {
         for (Entry<String, Indicator> entry : mechanicalComponent.getIndicators().entrySet()) {
            if (entry.getValue() == indicator) {
               indicatorLocations = Arrays.asList(mechanicalComponent.getPath().split(":"));
            }
         }
      }
      return indicatorLocations;
   }

   private void setThresholdInRelearningPhase(String aircraftId, List<HealthMechanicalComponent> healthComponents, String description, long historyLearningTime, String login)
         throws EntityNotFoundException {
      Date lastFlightDate = healthDao.getLastFlightDate(aircraftId);
      Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      for (HealthMechanicalComponent healthComponent : healthComponents) {
         for (Indicator indicator : healthComponent.getIndicators().values()) {
            for (LearnedThresholdConfiguration threshold : healthDao.getIndicatorLatestLearnedThresholds(aircraftId, indicator)) {
               List<String> indicatorLocations = Arrays.asList(healthComponent.getPath().split(":"));

               Calendar calendar = Calendar.getInstance(TimeZone.getTimeZone("GMT"));
               healthDao.createRelearnThresholdRequest(aircraft, threshold, calendar.getTime(), lastFlightDate, historyLearningTime, description, login, indicator, indicatorLocations);
            }
         }
      }
   }

   private void setThresholdInRelearningPhase(String aircraftId, Indicator indicator, String description, long historyLearningTime, String login) throws EntityNotFoundException {
      Date lastFlightDate = healthDao.getLastFlightDate(aircraftId);
      Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      for (LearnedThresholdConfiguration learnedThreshold : healthDao.getIndicatorLatestLearnedThresholds(aircraftId, indicator)) {
         List<String> indicatorLocations = getIndicatorPath(aircraft, indicator);
         Calendar calendar = Calendar.getInstance(TimeZone.getTimeZone("GMT"));
         healthDao.createRelearnThresholdRequest(aircraft, learnedThreshold, calendar.getTime(), lastFlightDate, historyLearningTime, description, login, indicator, indicatorLocations);
      }
   }

   private Map<Alarm, Flight> extractAlarmMapFromQueryResult(TypedQuery<Object[]> query) {
      Map<Alarm, Flight> alarms = new HashMap<>();
      for (Object[] row : query.getResultList()) {
         Alarm alarm = (Alarm) row[0];
         Flight flight = (Flight) row[1];
         alarms.put(alarm, flight);
      }
      return alarms;
   }
