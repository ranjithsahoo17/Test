   public List<IndicatorDeviation> findActive(List<String> indicatorConfigurationIds) {
      if (indicatorConfigurationIds.isEmpty()) {
         return new ArrayList<>();
      }
      TypedQuery<IndicatorDeviation> q = manager.createNamedQuery(
            "findActiveDeviationsByIndicatorConfigurations", IndicatorDeviation.class);
      q.setParameter("indicatorConfigurationIds", indicatorConfigurationIds);
      return q.getResultList();
   }

   public List<IndicatorDeviation> findHistory(List<String> indicatorConfigurationIds) {
      if (indicatorConfigurationIds.isEmpty()) {
         return new ArrayList<>();
      }
      TypedQuery<IndicatorDeviation> q = manager.createNamedQuery(
            "findDeviationHistoryByIndicatorConfigurations", IndicatorDeviation.class);
      q.setParameter("indicatorConfigurationIds", indicatorConfigurationIds);
      return q.getResultList();
   }
