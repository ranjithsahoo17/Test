-- Table: public.indicator_configuration

-- DROP TABLE IF EXISTS public.indicator_configuration;

CREATE TABLE IF NOT EXISTS public.indicator_configuration
(
    id character varying(255) COLLATE pg_catalog."default" NOT NULL,
    filtering_law character varying(255) COLLATE pg_catalog."default",
    algorithm character varying(255) COLLATE pg_catalog."default",
    invalidity_threshold double precision,
    invalidity_work_card character varying(255) COLLATE pg_catalog."default",
    max_points_per_hour integer,
    max_sensor double precision,
    min_sensor double precision,
    multiplier double precision,
    reference character varying(255) COLLATE pg_catalog."default",
    reference_indicator character varying(255) COLLATE pg_catalog."default",
    sensor_anomaly_successive_points integer,
    sensor_anomaly_work_card character varying(255) COLLATE pg_catalog."default",
    sliding_median integer,
    accelerometer_id character varying(255) COLLATE pg_catalog."default",
    indicator_id character varying(255) COLLATE pg_catalog."default" NOT NULL,
    health_mechanical_component_configuration_id character varying(255) COLLATE pg_catalog."default",
    CONSTRAINT indicator_configuration_pkey PRIMARY KEY (id),
    CONSTRAINT fk_indicator_configuration_accelerometer_id FOREIGN KEY (accelerometer_id)
        REFERENCES public.accelerometer (id) MATCH SIMPLE
        ON UPDATE NO ACTION
        ON DELETE NO ACTION,
    CONSTRAINT fk_indicator_configuration_indicator_id FOREIGN KEY (indicator_id)
        REFERENCES public.indicator (id) MATCH SIMPLE
        ON UPDATE NO ACTION
        ON DELETE NO ACTION,
    CONSTRAINT indicatorconfigurationhealthmechanicalcomponentconfiguration_id FOREIGN KEY (health_mechanical_component_configuration_id)
        REFERENCES public.health_mechanical_component_configuration (id) MATCH SIMPLE
        ON UPDATE NO ACTION
        ON DELETE NO ACTION
)

TABLESPACE pg_default;

ALTER TABLE IF EXISTS public.indicator_configuration
    OWNER to postgres;
-- Index: ix_ind_con_indicator_id

-- DROP INDEX IF EXISTS public.ix_ind_con_indicator_id;

CREATE INDEX IF NOT EXISTS ix_ind_con_indicator_id
    ON public.indicator_configuration USING btree
    (indicator_id COLLATE pg_catalog."default" ASC NULLS LAST)
    TABLESPACE pg_default;
-- Index: ix_indcon_hea_mec_com_con_id

-- DROP INDEX IF EXISTS public.ix_indcon_hea_mec_com_con_id;

CREATE INDEX IF NOT EXISTS ix_indcon_hea_mec_com_con_id
    ON public.indicator_configuration USING btree
    (health_mechanical_component_configuration_id COLLATE pg_catalog."default" ASC NULLS LAST)
    TABLESPACE pg_default;
-- Index: ix_indicator_con_acc_id

-- DROP INDEX IF EXISTS public.ix_indicator_con_acc_id;

CREATE INDEX IF NOT EXISTS ix_indicator_con_acc_id
    ON public.indicator_configuration USING btree
    (accelerometer_id COLLATE pg_catalog."default" ASC NULLS LAST)
    TABLESPACE pg_default;
