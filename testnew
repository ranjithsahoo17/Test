/**
 * Preference store for health alarms.
 */
public class HealthAlarmsPreferenceStore extends MgsPreferenceStore {

   private static final Logger LOGGER = LogManager.getLogger(HealthAlarmsPreferenceStore.class);
   /** data. */
   private Map<Aircraft, WCMechanicalComponentModel> data = new HashMap<>();

   /**
    * List of MCModels
    */
   private WCMechanicalComponentModel rootMechanicalComponents;

   // field, beside lawNameToId
   private final Map<String, String> indicatorDisplayNames = new HashMap<>();

   private final Map<String, String> lawNameToId = new HashMap<>();

   /** Composite parent. */
   private final HealthAlarmsComposite parent;

   private final BundleContext healthBundleContext = FrameworkUtil.getBundle(IHealthCommonBusiness.class)
         .getBundleContext();
   private final IHealthCommonBusiness healthBusiness = healthBundleContext
         .getService(healthBundleContext.getServiceReference(IHealthCommonBusiness.class));

   private final List<String> lastSavedDeviationIndicatorNames = new ArrayList<>();

   private static final Comparator<Severity> SEVERITY_COMPARATOR = (severity1, severity2) -> {
      if (severity1 == severity2) {
         return 0;
      }
      if (severity1 == Severity.RED) {
         return -1;
      }
      return 1;
   };

   /**
    * Constructor with argument. Builds a HealthAlarmsPreferenceStore.
    */
   public HealthAlarmsPreferenceStore(HealthAlarmsComposite parent) {
      this.parent = parent;
   }

   /**
    * Initialize the original mechanical component data.
    * 
    * @param aircraft
    *           the aircraft model
    */
   public void initMechanicalComponentData(Aircraft aircraft) {
      retrieveAircraftMechanicalComponents(aircraft);
   }

   @Override
   public boolean needsSaving() {
      return !data.isEmpty();
   }

   @Override
   public void innerLoad() {
   }

   @Override
   public void innerSave() {

      for (Entry<Aircraft, WCMechanicalComponentModel> modelEntry : data.entrySet()) {
         Aircraft aircraft = modelEntry.getKey();
         HealthMonitoringConfiguration configuration;
         AircraftConfigurationHistoryDto aircraftConfigurationHistoryDto;
         try {
            configuration = getConfiguration(aircraft);
            aircraftConfigurationHistoryDto = MgsPreferenceStoreManager.getAircraftConfigurationDto(aircraft);
         } catch (EntityNotFoundException e) {
            LOGGER.warn("Entity not found exception", e);
            AircraftConcurrentAccessException wrapper = new AircraftConcurrentAccessException(aircraft, true);
            StatusManager.getManager().handle(AircraftExceptionHandler.getStatusForAircraftException(wrapper, "update", Activator.PLUGIN_ID), StatusManager.SHOW);
            continue;
         }
         // Retrieve the root node element
         WCMechanicalComponentModel wcModel = modelEntry.getValue();

         // Create maps to associate JPA entities with WC* instances
         Map<HealthMechanicalComponent, WCHealthMechanicalComponentModel> wcMechanicalComponentModels = new HashMap<>();
         Map<Indicator, Set<WCThresholdModel>> thresholdModels = new HashMap<>();
         getModels(wcModel, wcMechanicalComponentModels, thresholdModels);

         for (Map.Entry<HealthMechanicalComponent, HealthMechanicalComponentConfiguration> mcEntry : configuration.getMechanicalComponentConfigurations().entrySet()) {
            HealthMechanicalComponent mechanicalComponent = mcEntry.getKey();
            MechanicalComponentConfigurationDto mechanicalComponentConfigurationDto = new MechanicalComponentConfigurationDto(mechanicalComponent.getId());
            WCHealthMechanicalComponentModel mechanicalComponentModel = wcMechanicalComponentModels.get(mechanicalComponent);
            mechanicalComponentConfigurationDto.setWorkcardReference(mechanicalComponentModel.getWorkcardReference());
            mechanicalComponentConfigurationDto.setMaxTimeWOAcquisition(mechanicalComponentModel.getMaxtimeWithoutAcquitision());

            for (Map.Entry<Indicator, IndicatorConfiguration> indicatorEntry : mcEntry.getValue().getIndicatorConfigurations().entrySet()) {
               Indicator indicator = indicatorEntry.getKey();
               if (!thresholdModels.containsKey(indicator)) {
                  // This indicator is likely inactive and has no current configuration to copy continue;
               }
               Set<WCThresholdModel> indicatorThresholdModels = thresholdModels.get(indicator);
               IndicatorConfigurationDto indicatorConfigurationDto = new IndicatorConfigurationDto(indicator.getId());
               for (WCThresholdModel wcThresholdModel : indicatorThresholdModels) {
                  if (wcThresholdModel.isEnabled()) {
                     // BCR-6605 deviation fields from the baseline, configuration fields as edited
                     final WCThresholdBaseline baseline = wcThresholdModel.getBaseline() != null
                           ? wcThresholdModel.getBaseline()
                           : new WCThresholdBaseline(wcThresholdModel, wcThresholdModel.getFilteringLawName());
                     final ThresholdConfigurationDto thresholdConfigurationDto;
                     if (baseline.getType() == ThresholdType.FIXED) {
                        thresholdConfigurationDto = new ThresholdConfigurationDto(
                              wcThresholdModel.getSeverity(), baseline.getLevel(), baseline.getType(),
                              baseline.getDefaultValue(),
                              wcThresholdModel.getNbSuccessivePoints(),
                              wcThresholdModel.getMinimumEngineOilTemperature());
                     } else {
                        thresholdConfigurationDto = new ThresholdConfigurationDto(
                              wcThresholdModel.getSeverity(), baseline.getLevel(), baseline.getType(),
                              wcThresholdModel.getLearningTime(),
                              baseline.getMinValue(), baseline.getMaxValue(),
                              baseline.getDefaultValue(), wcThresholdModel.getMinimumDeviation(),
                              wcThresholdModel.getMeanFactor(), wcThresholdModel.getDeviationCoefficient(),
                              wcThresholdModel.getNbSuccessivePoints(),
                              wcThresholdModel.getMinimumEngineOilTemperature());
                     }
                     thresholdConfigurationDto.setWorkcard(baseline.getWorkCardReference());
                     indicatorConfigurationDto.getThresholdConfigurationDtos().add(thresholdConfigurationDto);
                  }
               }

               mechanicalComponentConfigurationDto.getIndicatorConfigurationDtos().add(indicatorConfigurationDto);
            }
            aircraftConfigurationHistoryDto.getMechanicalComponentConfigurations()
                  .add(mechanicalComponentConfigurationDto);
         }

         aircraftConfigurationHistoryDto.setIndicatorConfigurationUpdated(true);
      }
   }

   private void getModels(WCMechanicalComponentModel wcModel,
         Map<HealthMechanicalComponent, WCHealthMechanicalComponentModel> mechanicalComponents,
         Map<Indicator, Set<WCThresholdModel>> thresholdModels) {
      for (WCMechanicalComponentModel subModel : wcModel.getSubHealthWCModel()) {
         getModels(subModel, mechanicalComponents, thresholdModels);
      }
      for (WCHealthMechanicalComponentModel healthMechanicalComponentModel : wcModel.getHealthComponentModels()) {
         mechanicalComponents.put(healthMechanicalComponentModel.getHealthMechanicalComponent(),
               healthMechanicalComponentModel);
         for (WCThresholdModel wcThresholdModel : healthMechanicalComponentModel.getThresholdModels()) {
            if (!thresholdModels.containsKey(wcThresholdModel.getIndicator())) {
               thresholdModels.put(wcThresholdModel.getIndicator(), new HashSet<>());
            }
            thresholdModels.get(wcThresholdModel.getIndicator()).add(wcThresholdModel);
         }
      }
   }

   private HealthMonitoringConfiguration getConfiguration(Aircraft aircraft) throws EntityNotFoundException {
      try {
         return MgsPreferenceStoreManager.getConfiguration(aircraft, HealthMonitoringConfiguration.TYPE,
               HealthMonitoringConfiguration.class);
      } catch (EntityNotFoundException e) {
         LOGGER.error("Could not load health configuration for aircraft. Register number - Serial number = {}",
               aircraft.getRegisterNumber(), e);
         throw e;
      }
   }

   /**
    * Load data.
    * 
    * @param aircraft
    *           the specified aircraft
    * @return a list of health data
    */
   public WCMechanicalComponentModel loadHealthModels(Aircraft aircraft) {
      emptyData();
      retrieveAircraftMechanicalComponents(aircraft);
      // save it
      data.put(aircraft, rootMechanicalComponents);
      rootMechanicalComponents.setName(Messages.CORE.getString("Label.HealthComponents"));
      WCMechanicalComponentModel all = new WCMechanicalComponentModel();
