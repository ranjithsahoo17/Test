   public void createAircraft(AircraftDto aircraftDto, AircraftConfigurationBean aircraftConfigurationDto, TopicDto topicDto)
         throws InvalidArgumentException, EntityNotFoundException,
         AircraftAlreadyExistsException, NotificationException {
      Context context = progressManager.initContext(topicDto);

      AircraftType aircraftType = aircraftTypeDao.findByName(aircraftDto.getAircraftType());

      Aircraft aircraft = new Aircraft(UUID.randomUUID().toString());
      aircraft.setAircraftType(aircraftType);
      aircraft.setAircraftId(aircraftDto.getAircraftId());
      aircraft.setAircraftSerialNumber(aircraftDto.getAircraftSerialNumber());
      aircraft.setDataTransferType(aircraftDto.getDataTransferType());
      aircraft.setRegisterNumber(aircraftDto.getRegisterNumber());
      aircraft.setDescription(aircraftDto.getDescription());

      Aircraft aircraftForProgressNotif = new Aircraft(aircraft.getId());
      aircraftForProgressNotif.setAircraftType(aircraft.getAircraftType());
      aircraftForProgressNotif.setAircraftId(aircraft.getAircraftId());
      aircraftForProgressNotif.setAircraftSerialNumber(aircraft.getAircraftSerialNumber());
      aircraftForProgressNotif.setDataTransferType(aircraft.getDataTransferType());
      aircraftForProgressNotif.setRegisterNumber(aircraft.getRegisterNumber());
      aircraftForProgressNotif.setDescription(aircraft.getDescription());

      progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.START);

      // SRS_UC_ACM_0102 Step 5
      // The system initializes the A/C Base name to current base (base name of the current running MGS).
      GroundStation groundStation = groundStationDao.getLocalGroundStation();
      aircraft.setGroundStation(groundStation);

      // Set default values for state and status.
      aircraft.setAircraftState(AircraftState.ACTIVE);
      aircraft.setAircraftStatus(AircraftStatus.GREEN);

      // Attachment date should be null at creation time.
      aircraft.setAttachmentDate(null);

      AvionicVersion avionicVersion = manager.find(AvionicVersion.class, aircraftDto.getAvionicVersion());

      // Create aircraft configuration
      AircraftConfiguration aircraftConfiguration = new AircraftConfiguration(UUID.randomUUID().toString());
      aircraftConfiguration.setAircraft(aircraft);
      aircraftConfiguration.setAvionicVersion(avionicVersion);
      // M'arms A/C or Cigalhe without health
      if (aircraftDto.getDmauVersion() != null) {
         DmauVersion dmauVersion = manager.find(DmauVersion.class, aircraftDto.getDmauVersion());
         aircraftConfiguration.setDmauVersion(dmauVersion);
      }
      aircraftConfiguration.setSerialNumber(0);
      aircraftConfiguration.setApplicableDate(new Date(0));

      boolean dmauVersionWithHealthData = aircraftConfiguration.getDmauVersion() != null && aircraftConfiguration.getDmauVersion().hasHealthData();
      boolean hasHealth = aircraftConfiguration.getDmauVersion() == null || dmauVersionWithHealthData;
      try {
         if (aircraftConfigurationDto.getHealthConfiguration() != null && hasHealth) {
            Map<String, Map<String, Unit>> unitsByPhysicalQuantity = getUnitMap();
            if (featureManager.isEnabled(avionicVersion, FeatureName.HEALTH_SIGNAL_ANALYSIS) || featureManager.isEnabled(avionicVersion, FeatureName.HEALTH_MONITORING)) {
               healthDelegate.createHealthSignalAnalysis(aircraft, aircraftConfigurationDto.getHealthConfiguration());
            }

            if (featureManager.isEnabled(avionicVersion, FeatureName.HEALTH_MONITORING)) {
               Map<String, byte[]> images = new CaseInsensitiveMap<>(aircraftConfigurationDto.getImages());
               healthDelegate.createHealthMonitoring(aircraft, aircraftConfigurationDto.getHealthConfiguration(), images, unitsByPhysicalQuantity);
               healthDelegate.createHealthMonitoringConfiguration(aircraftConfiguration, aircraftConfigurationDto.getHealthConfiguration(),
                     Collections.emptyMap());
            }
         }

         progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.HEALTH);

         if (aircraftConfigurationDto.getUsageConfiguration() != null) {
            usageDelegate.createUsageConfiguration(aircraftConfiguration, aircraftConfigurationDto.getUsageConfiguration());
         }

         progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.USAGE);

         if (aircraftConfigurationDto.getSfmConfiguration() != null && featureManager.isEnabled(avionicVersion, FeatureName.SYSTEM_FAILURE_MANAGEMENT)) {
            sfmDelegate.createSystemFailureMonitoring(aircraft, aircraftConfigurationDto.getSfmConfiguration());
            sfmDelegate.createSystemFailureConfiguration(aircraftConfiguration, aircraftConfigurationDto.getSfmConfiguration());
         }

         if (aircraftConfigurationDto.getLocalDiagnosisConfiguration() != null && featureManager.isEnabled(avionicVersion, FeatureName.LOCAL_DIAGNOSIS)) {
            localDiagnosisDelegate.createLocalDiagnosisConfiguration(aircraftConfiguration, aircraftConfigurationDto.getLocalDiagnosisConfiguration());
         }

         progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.SFM);

         if (aircraftConfigurationDto.getFdcrConfiguration() != null && featureManager.isEnabled(avionicVersion, FeatureName.FDCR)) {
            fdcrDelegate.createFdcrConfiguration(parameterManager.getFdcrDisplayPreference(aircraftConfiguration.getAvionicVersion().getId()),
                  aircraftConfiguration, aircraftConfigurationDto.getFdcrConfiguration());
         }

         progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.FDCR);

         if (featureManager.isEnabled(avionicVersion, FeatureName.ROTOR_TRACK_BALANCE) && hasHealth) {
            RtbConfiguration rtbConfiguration = avionicVersion.getRtbConfiguration();

            if (aircraftConfigurationDto.getRtbConfiguration() != null) {
               rtbDelegate.createRotorCharacteristics(aircraft, aircraftConfigurationDto.getRtbConfiguration());
               rtbConfiguration = aircraft.getRtbConfiguration();
            } else {
               if (rtbConfiguration == null || rtbConfiguration.getMainRotorCharacteristics() == null || rtbConfiguration.getTailRotorCharacteristics() == null) {
                  rtbConfiguration = rtbDelegate.loadDefaultRotorCharacteristics(avionicVersion, parameterManager.getRtbParametersByAvionicVersion(avionicVersion.getId()),
                        parameterManager.getRtbNeuralNetworksByAvionicVersion(avionicVersion.getId()));
               }
            }
            if (aircraftConfigurationDto.getRtbTunings() != null) {
               rtbDelegate.createRtbTunings(aircraftConfiguration, aircraftConfigurationDto.getRtbTunings());
            } else {
               // Create default tunings
               rtbConfiguration.setOriginal(true);
               rtbDelegate.createDefaultRtbTunings(aircraft, rtbConfiguration);
            }
         }

         if (featureManager.isEnabled(avionicVersion, FeatureName.FAILURE_CONTEXT_MONITORING) && aircraftConfigurationDto.getFailureMonitoringConfiguration() != null) {
            failureContextMonitoringDelegate.createConfiguration(aircraftConfiguration, aircraftConfigurationDto.getFailureMonitoringConfiguration());
         }

         if (featureManager.isEnabled(avionicVersion, FeatureName.DMAU_FAILURES) && aircraftConfigurationDto.getDmauFailureConfiguration() != null && hasHealth) {
            dmauFailuresDelegate.createDmauFailureConfiguration(aircraftConfiguration, aircraftConfigurationDto.getDmauFailureConfiguration());
         }

         if (featureManager.isEnabled(avionicVersion, FeatureName.VPU_FAILURES) && aircraftConfigurationDto.getVpuFailureConfiguration() != null) {
            vpuFailuresDelegate.createVpuFailureConfiguration(aircraftConfiguration, aircraftConfigurationDto.getVpuFailureConfiguration());
         }

         if (featureManager.isEnabled(avionicVersion, FeatureName.RAW_DATA_FILTERING) && aircraftConfigurationDto.getRawDataFilteringConfiguration() != null
               && aircraftConfigurationDto.getRawDataFilteringConfiguration().hasWordsToRemove()) {
            rawDataFilteringDelegate.createRawDataFilteringConfiguration(aircraftConfiguration, aircraftConfigurationDto.getRawDataFilteringConfiguration());
         }
      } catch (DelegateException e) {
         LOGGER.error("Aircraft creation error.", e);
         throw new InvalidArgumentException(e.getMessage());
      }

      progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.RTB);

      aircraftDao.create(aircraft);
      configurationDao.create(aircraftConfiguration);

      progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.END);

      manager.flush();
      manager.clear();

      aircraft = manager.find(Aircraft.class, aircraft.getId());
      // Initialize accelerometers (used by the client)
      aircraft.getAccelerometers().size();

      notificationService.notifyAction(AircraftCloner.clone(aircraft), Action.CREATION);

      AircraftConfiguration aircraftConfForNotif = new AircraftConfiguration(aircraftConfiguration.getId());
      aircraftConfForNotif.setAircraft(aircraft);
      aircraftConfForNotif.setAvionicVersion(aircraftConfiguration.getAvionicVersion());
      aircraftConfForNotif.setDmauVersion(aircraftConfiguration.getDmauVersion());
      aircraftConfForNotif.setSerialNumber(aircraftConfiguration.getSerialNumber());
      aircraftConfForNotif.setApplicableDate(aircraftConfiguration.getApplicableDate());

      notificationService.notifyAction(aircraftConfForNotif, Action.CREATION);

      progressManager.disposeContext();
   }

   public AircraftIdentificationDetails updateAircraft(AircraftDto aircraftDto, AircraftConfigurationBean aircraftConfigurationDto, String applicableFlightId, TopicDto topicDto) throws InvalidArgumentException,
         EntityNotFoundException, NotificationException, ConcurrentAccessException {
      Context context = progressManager.initContext(topicDto);

      Aircraft aircraft = aircraftDao.findById(aircraftDto.getId());
      Aircraft aircraftForProgressNotif = new Aircraft(aircraft.getId());
      aircraftForProgressNotif.setAircraftType(aircraft.getAircraftType());
      aircraftForProgressNotif.setAircraftId(aircraft.getAircraftId());

      // Abort if the aircraft is being used
      String aircraftId = aircraft.getId();
      aircraftLockManager.throwExceptionIfAircraftLocked(aircraftId);
      aircraftLockManager.throwExceptionIfBackgroundTask(aircraftId);

      // Abort if the aircraft is frozen
      if (aircraft.getAircraftState() == AircraftState.FROZEN) {
         throw new ConcurrentAccessException("The aircraft has been modified by an other user.");
      }
      if (aircraft.getAircraftState() == AircraftState.DELETED) {
         throw new ConcurrentAccessException("The aircraft is being deleted.");
      }

      progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.START);
      
      AircraftIdentificationDetails aircraftIdentificationDetails = new AircraftIdentificationDetails();
      aircraftIdentificationDetails.setPreviousAircraftId(aircraft.getAircraftId());
      aircraftIdentificationDetails.setPreviousSerialNumber(aircraft.getAircraftSerialNumber());
      
      // SRS_UC_ACM_0104
      // Aircraft type, serial number and ground station are immutable
      // register number, description, aircraft serial number, data transfer type may be modified.
      if (hasAircraftIdChanged(aircraft.getAircraftId(), aircraftDto.getAircraftId())) {
         LOGGER.info("Aircraft ID is updated");
         aircraft.setAircraftId(aircraftDto.getAircraftId());
         aircraftIdentificationDetails.setCurrentAircraftId(aircraftDto.getAircraftId());
      } else {
         aircraftIdentificationDetails.setCurrentAircraftId(aircraftIdentificationDetails.getPreviousAircraftId());
      }
      
      if (!aircraft.getRegisterNumber().equals(aircraftDto.getRegisterNumber())) {
         LOGGER.info("Register number is updated");
         aircraft.setRegisterNumber(aircraftDto.getRegisterNumber());
      }
      
      if (hasDescriptionChanged(aircraft.getDescription(), aircraftDto.getDescription())) {
         LOGGER.info("Description is updated");
         aircraft.setDescription(aircraftDto.getDescription());
      }
      
      if (hasAircraftSerialNumberChanged(aircraft.getAircraftSerialNumber(), aircraftDto.getAircraftSerialNumber())) {
         LOGGER.info("Aircraft Serial Number is updated");
         aircraft.setAircraftSerialNumber(aircraftDto.getAircraftSerialNumber());
         aircraftIdentificationDetails.setCurrentSerialNumber(aircraftDto.getAircraftSerialNumber());
      } else {
         aircraftIdentificationDetails.setCurrentSerialNumber(aircraftIdentificationDetails.getPreviousSerialNumber());
      }
      
      if (hasDataTransferTypeChanged(aircraft.getDataTransferType(), aircraftDto.getDataTransferType())) {
         LOGGER.info("Aircraft Data Transfer Type is updated");
         aircraft.setDataTransferType(aircraftDto.getDataTransferType());
         if (aircraftDto.getDataTransferType().equals(DataTransferType.DTU)) {
            aircraft.setAircraftSerialNumber(null);
            aircraftIdentificationDetails.setCurrentSerialNumber(null);
         }
      }
      aircraftForProgressNotif.setRegisterNumber(aircraft.getRegisterNumber());
      aircraftForProgressNotif.setDescription(aircraft.getDescription());
      aircraftForProgressNotif.setAircraftSerialNumber(aircraft.getAircraftSerialNumber());
      aircraftForProgressNotif.setDataTransferType(aircraft.getDataTransferType());

      // SRS_UC_ACM_0104 Step 5
      // If there already was a configuration with an applicable date in the future, it is removed and replaced by the new A/C configuration.

      // SRS_UC_ACM_0104 Step 2.1
      // If aircraft version is updated and some alarms are still not acknowledged for the related A/C, then the system shall inform the user that all the alarms shall be acknowledged before
      // changing
      // the aircraft version.

      AvionicVersion avionicVersion = manager.find(AvionicVersion.class, aircraftDto.getAvionicVersion());

      AircraftConfiguration latestAircraftConfiguration = configurationDao.getLatestConfiguration(aircraftId);
      Map<String, Configuration> configurations = latestAircraftConfiguration.getConfigurations();

      final Date applicableDate;
      if (applicableFlightId != null) {
         final Flight flight = manager.find(Flight.class, applicableFlightId);
         applicableDate = flight.getUsageStartDate();
      } else {
         applicableDate = new Date(0);
      }

      AircraftConfiguration aircraftConfiguration = new AircraftConfiguration(UUID.randomUUID().toString());
      aircraftConfiguration.setAircraft(aircraft);
      aircraftConfiguration.setAvionicVersion(avionicVersion);
      if (!latestAircraftConfiguration.getAvionicVersion().getId().equals(aircraftDto.getAvionicVersion())) {
         LOGGER.info("Avionic version is updated");
      }
      if (aircraft.getAircraftType().getAvionic() == Avionic.CIGALHE && aircraftDto.getDmauVersion() != null) {
         DmauVersion dmauVersion = manager.find(DmauVersion.class, aircraftDto.getDmauVersion());
         aircraftConfiguration.setDmauVersion(dmauVersion);
         if (!latestAircraftConfiguration.getDmauVersion().getId().equals(aircraftDto.getDmauVersion())) {
            LOGGER.info("DMAU version is updated");
         }
      }
      int serialNumber = configurationDao.getNextSerialNumber(aircraftId);
      aircraftConfiguration.setSerialNumber(serialNumber);
      aircraftConfiguration.setApplicableDate(applicableDate);

      try {
         boolean hasDmauWithHealth = aircraftConfiguration.getDmauVersion() != null && aircraftConfiguration.getDmauVersion().hasHealthData();
         boolean hasHealth = hasDmauWithHealth || aircraftConfiguration.getDmauVersion() == null;
         if (aircraftConfigurationDto.getHealthConfiguration() != null && hasHealth) {
            LOGGER.info("Health configuration is updated");
            // SRS_UC_ACM_0104 Step 4.1
            // If the mechanical components and health indicators have been changed, added or removed, the system updates the Health sub nodes of the Tree View accordingly: Tree View must display
            // the A/C current mechanical components and indicators under the Health node.
            // Note: if an indicator or mechanical component has been removed, the system must remove this indicator or component in the Tree View. So if it exists some not acknowledged alarms
            // related to this indicator then these alarms are no more highlighted in the tree view.

            Map<String, Map<String, Unit>> units = getUnitMap();
            Map<String, byte[]> images = new CaseInsensitiveMap<>(aircraftConfigurationDto.getImages());
            final Map<Threshold, Set<RelearnThresholdRequest>> relearnRequests;
            if (configurations.containsKey(HealthMonitoringConfiguration.TYPE)) {
               relearnRequests = healthDelegate.getRelearnRequestsByThreshold((HealthMonitoringConfiguration) configurations.get(HealthMonitoringConfiguration.TYPE));
            } else {
               relearnRequests = Collections.emptyMap();
            }
            healthDelegate.updateHealthMonitoring(aircraft, aircraftConfigurationDto.getHealthConfiguration(), images, units);
            healthDelegate.createHealthMonitoringConfiguration(aircraftConfiguration, aircraftConfigurationDto.getHealthConfiguration(), relearnRequests);
         } else if (hasHealth
               && configurations.containsKey(HealthMonitoringConfiguration.TYPE)) {
            aircraftConfiguration.getConfigurations().put(HealthMonitoringConfiguration.TYPE, cloneConfiguration(configurations.get(HealthMonitoringConfiguration.TYPE)));
         }

         progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.HEALTH);

         if (aircraftConfigurationDto.getUsageConfiguration() != null) {
            LOGGER.info("Usage configuration is updated");
            usageDelegate
                  .createUsageConfiguration(aircraftConfiguration, aircraftConfigurationDto.getUsageConfiguration());
         } else if (configurations.containsKey(UsageConfiguration.TYPE)) {
            aircraftConfiguration.getConfigurations().put(UsageConfiguration.TYPE, cloneConfiguration(configurations.get(UsageConfiguration.TYPE)));
         }

         progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.USAGE);

         if (aircraftConfigurationDto.getSfmConfiguration() != null) {
            LOGGER.info("SFM configuration is updated");
            sfmDelegate.updateSystemFailureMonitoring(aircraft, aircraftConfigurationDto.getSfmConfiguration());
            sfmDelegate.createSystemFailureConfiguration(aircraftConfiguration, aircraftConfigurationDto.getSfmConfiguration());
         } else if (configurations.containsKey(SfmConfiguration.TYPE)) {
            aircraftConfiguration.getConfigurations().put(SfmConfiguration.TYPE, cloneConfiguration(configurations.get(SfmConfiguration.TYPE)));
         }

         if (aircraftConfigurationDto.getLocalDiagnosisConfiguration() != null) {
            LOGGER.info("Local Diagnosis configuration is updated");
            localDiagnosisDelegate.createLocalDiagnosisConfiguration(aircraftConfiguration, aircraftConfigurationDto.getLocalDiagnosisConfiguration());
         } else if (configurations.containsKey(LocalDiagnosisConfiguration.TYPE)) {
            aircraftConfiguration.getConfigurations().put(LocalDiagnosisConfiguration.TYPE, cloneConfiguration(configurations.get(LocalDiagnosisConfiguration.TYPE)));
         }

         if (aircraftConfigurationDto.getDmauFailureConfiguration() != null && hasHealth) {
            LOGGER.info("DMAU Failure configuration is updated");
            dmauFailuresDelegate.createDmauFailureConfiguration(aircraftConfiguration, aircraftConfigurationDto.getDmauFailureConfiguration());
         } else if (hasHealth && configurations.containsKey(DmauFailureConfiguration.TYPE) && !aircraftConfigurationDto.isMarmsSystemStatusConfigurationDefined()) {
            aircraftConfiguration.getConfigurations().put(DmauFailureConfiguration.TYPE, cloneConfiguration(configurations.get(DmauFailureConfiguration.TYPE)));
         }

         if (aircraftConfigurationDto.getVpuFailureConfiguration() != null) {
            LOGGER.info("VPU Failure configuration is updated");
            vpuFailuresDelegate.createVpuFailureConfiguration(aircraftConfiguration, aircraftConfigurationDto.getVpuFailureConfiguration());
         } else if (configurations.containsKey(VpuFailureConfiguration.TYPE) && !aircraftConfigurationDto.isMarmsSystemStatusConfigurationDefined()) {
            aircraftConfiguration.getConfigurations().put(VpuFailureConfiguration.TYPE, cloneConfiguration(configurations.get(VpuFailureConfiguration.TYPE)));
         }

         if (aircraftConfigurationDto.getFailureMonitoringConfiguration() != null) {
            LOGGER.info("Failure Monitoring configuration is updated");
            failureContextMonitoringDelegate.createConfiguration(aircraftConfiguration, aircraftConfigurationDto.getFailureMonitoringConfiguration());
         } else if (configurations.containsKey(FailureContextMonitoringConfiguration.TYPE)) {
            aircraftConfiguration.getConfigurations().put(FailureContextMonitoringConfiguration.TYPE, cloneConfiguration(configurations.get(FailureContextMonitoringConfiguration.TYPE)));
         }

         progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.SFM);

         if (aircraftConfigurationDto.getFdcrConfiguration() != null) {
            LOGGER.info("FDCR configuration is updated");
            fdcrDelegate.updateFdcrConfiguration(parameterManager.getFdcrDisplayPreference(aircraftConfiguration.getAvionicVersion().getId()),
                  aircraftConfiguration, aircraftConfigurationDto.getFdcrConfiguration());
         } else if (configurations.containsKey(FdcrConfiguration.TYPE)) {
            aircraftConfiguration.getConfigurations().put(FdcrConfiguration.TYPE, cloneConfiguration(configurations.get(FdcrConfiguration.TYPE)));
         }

         progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.FDCR);

         boolean hasRtb = false;
         for (Feature f : avionicVersion.getFeatures()) {
            if (f.getFeature() == FeatureName.ROTOR_TRACK_BALANCE && FeatureState.OK == f.getState()) {
               hasRtb = true;
            }
         }
         if (hasRtb && hasHealth) {
            RtbConfiguration rtbConfiguration = avionicVersion.getRtbConfiguration();
            if (aircraftConfigurationDto.getRtbConfiguration() != null) {
               LOGGER.info("RTB configuration is updated");
               rtbDelegate.createRotorCharacteristics(aircraft, aircraftConfigurationDto.getRtbConfiguration());
               rtbConfiguration = aircraft.getRtbConfiguration();
            } else {
               if (rtbConfiguration == null || rtbConfiguration.getMainRotorCharacteristics() == null || rtbConfiguration.getTailRotorCharacteristics() == null) {
                  rtbConfiguration = rtbDelegate.loadDefaultRotorCharacteristics(avionicVersion, parameterManager.getRtbParametersByAvionicVersion(avionicVersion.getId()),
                        parameterManager.getRtbNeuralNetworksByAvionicVersion(avionicVersion.getId()));
               }
            }
            if (aircraftConfigurationDto.getRtbTunings() != null) {
               LOGGER.info("RTB tuning parameters are updated");
               rtbDelegate.createRtbTunings(aircraftConfiguration, aircraftConfigurationDto.getRtbTunings());
               if (aircraft.getRtbConfiguration() != null) {
                  aircraft.getRtbConfiguration().setOriginal(false);
               } else {
                  avionicVersion.getRtbConfiguration().setOriginal(false);
               }
            } else if (aircraft.getMainRotorTuning() == null || aircraft.getTailRotorTuning() == null) {
               // Create default tunings
               if (aircraft.getRtbConfiguration() != null) {
                  aircraft.getRtbConfiguration().setOriginal(true);
               } else {
                  avionicVersion.getRtbConfiguration().setOriginal(true);
               }
               rtbDelegate.createDefaultRtbTunings(aircraft, rtbConfiguration);
            }
         }

         if (aircraftConfigurationDto.getRawDataFilteringConfiguration() != null) {
            LOGGER.info("Raw Data filtering configuration is updated");
            if (aircraftConfigurationDto.getRawDataFilteringConfiguration().hasWordsToRemove()) {
               rawDataFilteringDelegate.createRawDataFilteringConfiguration(aircraftConfiguration, aircraftConfigurationDto.getRawDataFilteringConfiguration());
            }
            // No else-clause, nothing to do
         } else if (configurations.containsKey(RawDataFilteringConfiguration.TYPE)) {
            aircraftConfiguration.getConfigurations().put(RawDataFilteringConfiguration.TYPE, cloneConfiguration(configurations.get(RawDataFilteringConfiguration.TYPE)));
         }
      } catch (DelegateException e) {
         LOGGER.error("Aircraft creation error.", e);
         throw new InvalidArgumentException(e.getMessage());
      }

      progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.RTB);

      configurationDao.create(aircraftConfiguration);

      progressManager.notifyProgress(context, aircraftForProgressNotif, Progress.END);

      manager.flush();
      manager.clear();

      aircraft = manager.find(Aircraft.class, aircraft.getId());
      // Initialize accelerometers (used by the client)
      aircraft.getAccelerometers().size();

      notificationService.notifyAction(AircraftCloner.clone(aircraft), Action.UPDATE);

      AircraftConfiguration aircraftConfForNotif = new AircraftConfiguration(aircraftConfiguration.getId());
      aircraftConfForNotif.setAircraft(aircraft);
      aircraftConfForNotif.setAvionicVersion(aircraftConfiguration.getAvionicVersion());
      aircraftConfForNotif.setDmauVersion(aircraftConfiguration.getDmauVersion());
      aircraftConfForNotif.setSerialNumber(aircraftConfiguration.getSerialNumber());
      aircraftConfForNotif.setApplicableDate(aircraftConfiguration.getApplicableDate());

      notificationService.notifyAction(aircraftConfForNotif, Action.CREATION);

      progressManager.disposeContext();
      
      return aircraftIdentificationDetails;
   }

   public AircraftConfiguration cloneAircraftConfiguration(AircraftConfiguration aircraftConfiguration) {
      int serialNumber = configurationDao.getNextSerialNumber(aircraftConfiguration.getAircraft().getId());
      AircraftConfiguration newAircraftConfiguration = new AircraftConfiguration(UUID.randomUUID().toString());
      newAircraftConfiguration.setAircraft(aircraftConfiguration.getAircraft());
      newAircraftConfiguration.setSerialNumber(serialNumber);
      newAircraftConfiguration.setAvionicVersion(aircraftConfiguration.getAvionicVersion());
      newAircraftConfiguration.setDmauVersion(aircraftConfiguration.getDmauVersion());
      for (Entry<String, Configuration> entry : aircraftConfiguration.getConfigurations().entrySet()) {
         Configuration configuration = cloneConfiguration(entry.getValue());
         newAircraftConfiguration.getConfigurations().put(entry.getKey(), configuration);
      }
      return newAircraftConfiguration;
   }

   public Configuration cloneConfiguration(Configuration configuration) {
      Configuration clone = ConfigurationCloner.cloneConfiguration(configuration);
      if (clone instanceof FailureContextMonitoringConfiguration failureContextMonitoringConfiguration) {
         // Workaround for a bug where created FdcrGroup are not attached to the configuration itself
         // Without that, two FdcrGroups are created:
         // - One with a failure_monitoring_context_configuration_id attached, but not linked to ATA groups
         // - Another without failure_monitoring_context_configuration_id, but linked to ATA groups
         Map<String, FdcrGroup> fdcrGroups = new HashMap<>();
         for (FdcrGroup fdcrGroup : failureContextMonitoringConfiguration.getFdcrGroup()) {
            fdcrGroups.put(fdcrGroup.getName(), fdcrGroup);
         }

         Map<String, AtaChapter> ataChapterByCode = new HashMap<>();
         for (AtaChapter ataChapter : failureContextMonitoringConfiguration.getAtaChapter()) {
            if (ataChapter.getFdcrGroup() != null) {
               // Replace the FdcrGroup attached to the AtaChapter
               ataChapter.setFdcrGroup(fdcrGroups.get(ataChapter.getFdcrGroup().getName()));
            }
            ataChapterByCode.put(ataChapter.getCode(), ataChapter);
         }

         for (FailureCodeInformation failureCodeInformation : failureContextMonitoringConfiguration.getFailureCodeInformation()) {
            // Replace the AtaChapter attached to the FailureCodeInformation
            failureCodeInformation.setAtaChapter(ataChapterByCode.get(failureCodeInformation.getAtaChapter().getCode()));
         }
      }
      return clone;
   }

   private Map<String, Map<String, Unit>> getUnitMap() {
      Map<String, Map<String, Unit>> unitsByPhysicalQuantity = new HashMap<>();
      for (PhysicalQuantity physicalQuantity : parameterManager.getUnitDefinitions().getPhysicalQuantities()) {
         Map<String, Unit> units = new HashMap<>();
         for (Unit unit : physicalQuantity.getAllUnits()) {
            units.put(unit.getSymbol(), unit);
         }
         unitsByPhysicalQuantity.put(physicalQuantity.getName(), units);
      }
      return unitsByPhysicalQuantity;
   }

   private boolean hasDescriptionChanged(String oldDescription, String newDescription) {
      if (oldDescription == null) {
         return newDescription != null;
      }
      if (newDescription == null) {
         return true;
      }
      return !oldDescription.equals(newDescription);
   }

   private boolean hasAircraftSerialNumberChanged(String oldAircraftSerialNumber, String newAircraftSerialNumber) {
      if (oldAircraftSerialNumber == null) {
         return newAircraftSerialNumber != null;
      }
      if (newAircraftSerialNumber == null) {
         return true;
      }
      return !oldAircraftSerialNumber.equals(newAircraftSerialNumber);
   }

   private boolean hasDataTransferTypeChanged(DataTransferType oldDataTransferType, DataTransferType newDataTransferType) {
      if (oldDataTransferType == null) {
         return newDataTransferType != null;
      }
      if (newDataTransferType == null) {
         return true;
      }
      return !oldDataTransferType.equals(newDataTransferType);
   }

   private boolean hasAircraftIdChanged(String oldAircraftId, String newAircraftId) {
      if (oldAircraftId == null) {
         return newAircraftId != null;
      }
      if (newAircraftId == null) {
         return true;
      }
      return !oldAircraftId.equals(newAircraftId);
   }
