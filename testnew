4. HealthCommonBusiness — gather the ids
The interface keeps String aircraftId; only the body changes.

java
   @Override
   public List<IndicatorDeviationDto> findActiveDeviations(String aircraftId)
         throws EntityNotFoundException {
      return toDtos(healthCommonService.findActiveDeviations(getIndicatorConfigurationIds(aircraftId)));
   }

   @Override
   public List<IndicatorDeviationDto> findDeviationHistory(String aircraftId)
         throws EntityNotFoundException {
      return toDtos(healthCommonService.findDeviationHistory(getIndicatorConfigurationIds(aircraftId)));
   }

   private List<String> getIndicatorConfigurationIds(String aircraftId) throws EntityNotFoundException {
      List<String> ids = new ArrayList<>();
      HealthMonitoringConfiguration configuration = getLatestConfiguration(aircraftId);
      for (HealthMechanicalComponentConfiguration mcc :
            configuration.getMechanicalComponentConfigurations().values()) {
         for (IndicatorConfiguration ic : mcc.getIndicatorConfigurations().values()) {
            ids.add(ic.getId());
         }
      }
      return ids;
   }
