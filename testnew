      form.getBody().setLayout(new GridLayout());
      formToolkit.paintBordersFor(form);
      initAircraftConfigurations(form.getBody(), formToolkit);
   }

   public ConfigurationDto getAircraftConfigurationModel() {
      return aircraftConfigurationModel;
   }

   public void bindValidation(final Button okButton) {
      IChangeListener listener = event -> {
         DmauVersion oldDmauVersion = getCurrentDmauVersion();
         if (aircraftDetailsComposite.isUpdate() && healthEnabled && oldDmauVersion != null && !oldDmauVersion.hasHealthData() && aircraftConfigurationModel.getHealthConfigurationFile() == null) {
            okButton.setEnabled(false);
         } else if (aircraftDetailsComposite.isUpdate() && aircraftConfigurationModel.hasOneConfigurationFile()) {
            okButton.setEnabled(true);
         } else if ((healthEnabled && aircraftConfigurationModel.getHealthConfigurationFile() == null)
               || (sfmEnabled && aircraftConfigurationModel.getSfmConfigurationFile() == null)
               || aircraftConfigurationModel.getUsageConfigurationFile() == null) {
            okButton.setEnabled(false);
         } else {
            okButton.setEnabled(true);
         }
      };
      for (AircraftConfigurationSection section : aircraftConfigurationSections) {
         WidgetProperties.text(SWT.Modify).observe(section.getFullFilePath()).addChangeListener(listener);
      }
      listener.handleChange(null);
   }

   /**
    * Initialize the aircraft configurations.
    *
    * @param parent
    *           The parent
    * @param pFormToolkit
    *           The form toolkit
    */
   private void initAircraftConfigurations(Composite parent, FormToolkit pFormToolkit) {
      Composite top = pFormToolkit.createComposite(parent);
      top.setLayoutData(new GridData(SWT.FILL, SWT.TOP, true, true, 1, 1));
      top.setLayout(GridLayoutFactory.fillDefaults().numColumns(1).create());

      // get the whole list of extensions
      AvionicVersion avionicVersion = aircraftDetailsComposite.getAircraftModel().getAvionicVersion();

      BundleContext bundleContext = FrameworkUtil.getBundle(ICoreBusiness.class).getBundleContext();
      ICoreBusiness coreBusiness = bundleContext.getService(bundleContext.getServiceReference(ICoreBusiness.class));
      List<FeatureName> featureNames = coreBusiness.getEnabledFeatureNames(avionicVersion.getId());

      DmauVersion dmauVersion = aircraftDetailsComposite.getAircraftModel().getDmauVersion();
      DmauVersion oldDmauVersion = getCurrentDmauVersion();

      AircraftConfigurationSection section;

      if (((dmauVersion != null && dmauVersion.hasHealthData()) || dmauVersion == null)
            && (featureNames.contains(FeatureName.HEALTH_MONITORING) || featureNames.contains(FeatureName.HEALTH_SIGNAL_ANALYSIS))) {
         section = new AircraftConfigurationSection(top, pFormToolkit, Messages.CORE.getString("HealthConf"), "*.zip",
               (oldDmauVersion != null && !oldDmauVersion.hasHealthData()) || !aircraftDetailsComposite.isUpdate(),
               lastFilePath);
         section.setLayoutData(GridDataFactory.fillDefaults().grab(true, false).create());
         bindSection(section, aircraftConfigurationModel, "healthConfigurationFile");
         aircraftConfigurationSections.add(section);
      } else {
         healthEnabled = false;
      }

      if (featureNames.contains(FeatureName.EXCEEDANCE) || featureNames.contains(FeatureName.COUNTER_AND_CYCLE) || featureNames.contains(FeatureName.ENGINE_POWER_CHECKS)) {
         section = new AircraftConfigurationSection(top, pFormToolkit, Messages.CORE.getString("UsageConf"), "*.xml", !aircraftDetailsComposite.isUpdate(), lastFilePath);
         section.setLayoutData(GridDataFactory.fillDefaults().grab(true, false).create());
         bindSection(section, aircraftConfigurationModel, "usageConfigurationFile");
         aircraftConfigurationSections.add(section);
      }

      if (dmauVersion != null && dmauVersion.hasHealthData() && featureNames.contains(FeatureName.DMAU_FAILURES)) {
         section = new AircraftConfigurationSection(top, pFormToolkit, Messages.CORE.getString("SystemStatusConf"), "*.xml", false, lastFilePath);
         section.setLayoutData(GridDataFactory.fillDefaults().grab(true, false).create());
         bindSection(section, aircraftConfigurationModel, "dmauFailuresConfigurationFile");
         aircraftConfigurationSections.add(section);
      }

      if (featureNames.contains(FeatureName.FAILURE_CONTEXT_MONITORING)) {
         section = new AircraftConfigurationSection(top, pFormToolkit, Messages.CORE.getString("FailureContextMonitoringConf"), "*.zip", false, lastFilePath);
         section.setLayoutData(GridDataFactory.fillDefaults().grab(true, false).create());
         bindSection(section, aircraftConfigurationModel, "failureContextMonitoringConfigurationFile");
         aircraftConfigurationSections.add(section);
      }

      if (featureNames.contains(FeatureName.LOCAL_DIAGNOSIS)) {
         section = new AircraftConfigurationSection(top, pFormToolkit, Messages.CORE.getString("LocalDiagnosisConf"), "*.zip", false, lastFilePath);
         section.setLayoutData(GridDataFactory.fillDefaults().grab(true, false).create());
         bindSection(section, aircraftConfigurationModel, "localDiagnosisConfigurationFile");
         aircraftConfigurationSections.add(section);
      }

      if (featureNames.contains(FeatureName.SYSTEM_FAILURE_MANAGEMENT)) {
         section = new AircraftConfigurationSection(top, pFormToolkit, Messages.CORE.getString("FailureDescriptionConf"), "*.xml", !aircraftDetailsComposite.isUpdate(), lastFilePath);
         section.setLayoutData(GridDataFactory.fillDefaults().grab(true, false).create());
         bindSection(section, aircraftConfigurationModel, "sfmConfigurationFile");
         aircraftConfigurationSections.add(section);
      } else {
         sfmEnabled = false;
      }

      if (featureNames.contains(FeatureName.VPU_FAILURES)) {
         section = new AircraftConfigurationSection(top, pFormToolkit, Messages.CORE.getString("MarmsSystemStatusConf"), "*.xml", false, lastFilePath);
         section.setLayoutData(GridDataFactory.fillDefaults().grab(true, false).create());
         bindSection(section, aircraftConfigurationModel, "marmsSystemStatusConfigurationFile");
         aircraftConfigurationSections.add(section);
      }

      if (featureNames.contains(FeatureName.FDCR)) {
         section = new AircraftConfigurationSection(top, pFormToolkit, Messages.CORE.getString("FDCRConfiguration"), "*.zip", false, lastFilePath);
         section.setLayoutData(GridDataFactory.fillDefaults().grab(true, false).create());
         bindSection(section, aircraftConfigurationModel, "fdcrConfigurationFile");
         aircraftConfigurationSections.add(section);
      }

      if (((dmauVersion != null && dmauVersion.hasHealthData()) || dmauVersion == null) && featureNames.contains(FeatureName.ROTOR_TRACK_BALANCE)) {
         section = new AircraftConfigurationSection(top, pFormToolkit, Messages.CORE.getString("RTBParametersConf"), "*.zip", false, lastFilePath);
         section.setLayoutData(GridDataFactory.fillDefaults().grab(true, false).create());
         bindSection(section, aircraftConfigurationModel, "rtbParameterFile");
         aircraftConfigurationSections.add(section);
      }

      if (featureNames.contains(FeatureName.RAW_DATA_FILTERING)) {
         section = new AircraftConfigurationSection(top, pFormToolkit, Messages.CORE.getString("RawDataFilteringConfiguration"), "*.xml", false, lastFilePath);
         section.setLayoutData(GridDataFactory.fillDefaults().grab(true, false).create());
         bindSection(section, aircraftConfigurationModel, "rawDataFilteringConfigurationFile");
         aircraftConfigurationSections.add(section);
      }

      pFormToolkit.adapt(top);
   }

   private DmauVersion getCurrentDmauVersion() {
      BundleContext aircraftBundleContext = FrameworkUtil.getBundle(IAircraftBusiness.class).getBundleContext();
      IAircraftBusiness aircraftBusiness = aircraftBundleContext.getService(aircraftBundleContext.getServiceReference(IAircraftBusiness.class));

      DmauVersion currentDmauVersion = null;
      if (aircraftDetailsComposite.isUpdate()) {
         try {
            currentDmauVersion = aircraftBusiness.getDmauVersion(aircraftDetailsComposite.getAircraftModel().getAircraft().getId());
         } catch (EntityNotFoundException e) {
            LOGGER.warn("Unable to retrieve DMAU version.", e);
         }
      }

      return currentDmauVersion;
   }

   private void bindSection(final AircraftConfigurationSection section, Object object, String attributName) {
      UpdateValueStrategy<String, File> strategy = new UpdateValueStrategy<>();
      strategy.setConverter(new Converter<>(String.class, File.class) {

         @Override
         public File convert(String fromObject) {
            String path = fromObject;
            if (path.isEmpty()) {
               return null;
            }
            return new File(path);
         }
      });
      IObservableValue<String> descriptionObserveWidget = WidgetProperties.text(SWT.Modify).observe(section.getFullFilePath());
      IObservableValue<File> descriptionObserveValue = PojoProperties.value(attributName, File.class).observe(object);
      localbindingContext.bindValue(descriptionObserveWidget, descriptionObserveValue, strategy, null);
   }
}

