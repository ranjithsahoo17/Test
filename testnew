   public List<String> getFilteringLawNames(Aircraft aircraft) {
      List<String> names = new ArrayList<>();
      lawNameToId.clear();
      try {
         for (FilteringLawDto dto : healthBusiness.getFilteringLaws(aircraft.getId())) {
            names.add(dto.getName());
            lawNameToId.put(dto.getName(), dto.getId());
         }
      } catch (Exception e) {
         LOGGER.warn("Could not load filtering laws", e);
      }
      names.sort(String::compareTo);
      return names;
   }

   public String getFilteringLawId(String name) {
      return lawNameToId.get(name);
   }

   public void saveDeviations() {
      List<IndicatorDeviationDto> newDeviations = new ArrayList<>();
      Date now = new Date();

      LOGGER.info("BCR-6605 saveDeviations: data has {} aircraft", data.size());

      for (Entry<Aircraft, WCMechanicalComponentModel> entry : data.entrySet()) {

         Multimap<Indicator, WCThresholdModel> thresholds = getComponentThresholds(entry.getValue());

         LOGGER.info("BCR-6605 {} thresholds after isEnabled filter", thresholds.size());

         for (WCThresholdModel model : thresholds.values()) {
            LOGGER.info("BCR-6605 {} deviated={} deviationId={} icId={} te={}", model.getIndicator().getName(), model.isDeviated(), model.getDeviationId(), model.getIndicatorConfigurationId(),
                  model.getTeReference());
            if (!model.isDeviated() || model.getDeviationId() != null) {
               continue;
            }
            newDeviations.add(toDeviationDto(model, now));

         }
      }
      if (!newDeviations.isEmpty()) {

         LOGGER.info("BCR-6605 sending {} deviations", newDeviations.size());

         try {
            healthBusiness.createDeviations(newDeviations);
         } catch (Exception e) {
            LOGGER.error("Could not save deviations", e);
         }
      }
   }

   private IndicatorDeviationDto toDeviationDto(WCThresholdModel model, Date now) {
      IndicatorDeviationDto dto = new IndicatorDeviationDto();
      dto.setIndicatorConfigurationId(model.getIndicatorConfigurationId());
      dto.setFilteringLawId(getFilteringLawId(model.getFilteringLawName()));
      dto.setTeReference(model.getTeReference());
      dto.setStartDate(now);
      dto.setSeverity(model.getSeverity().name());
      dto.setThresholdLevel(model.getLevel().name());
      dto.setThresholdType(model.getType().name());
      dto.setThresholdValue(model.getDefaultValue());
      dto.setMinValue(model.getMinValue());
      dto.setMaxValue(model.getMaxValue());
      dto.setLearningTime(model.getLearningTime());
      dto.setWorkcard(model.getWorkCardReference());
      dto.setMinimumDeviation(model.getMinimumDeviation());
      dto.setMeanFactor(model.getMeanFactor());
      dto.setDeviationCoefficient(model.getDeviationCoefficient());
      dto.setNbSuccessivePoints(model.getNbSuccessivePoints());
      return dto;
   }

}
