   @Override
   public boolean hasActiveDeviationOnThresholds(String aircraftId, List<String> thresholdIds) throws EntityNotFoundException {
      if (thresholdIds == null || thresholdIds.isEmpty()) {
         return false;
      }
      // The indicators those thresholds belong to
      Set<String> indicatorIds = new HashSet<>();
      HealthMonitoringConfiguration configuration = getLatestConfiguration(aircraftId);
      for (HealthMechanicalComponentConfiguration mcc : configuration.getMechanicalComponentConfigurations().values()) {
         for (IndicatorConfiguration ic : mcc.getIndicatorConfigurations().values()) {
            for (ThresholdConfiguration threshold : ic.getThresholdConfigurations()) {
               if (thresholdIds.contains(threshold.getId())) {
                  indicatorIds.add(ic.getIndicator().getId());
               }
            }
         }
      }
      if (indicatorIds.isEmpty()) {
         return false;
      }
      for (IndicatorDeviationDto dto : findActiveDeviations(aircraftId)) {
         if (indicatorIds.contains(dto.getIndicatorId())) {
            return true;
         }
      }
      return false;
   }
