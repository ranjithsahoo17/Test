   /**
    * Notification received when an the first association with the server is performed.
    *
    * @return
    */
   public List<ActionNotificationDto> onSynchronization() {
      LOGGER.debug("Synchronize aircraft types, aircrafts...");

      synchronizationManager.setEntityManager(persistenceManager.getEntityManager());

      Map<Object, Object> entityMap = createEntityMap();

      mergeUsageFormats(entityMap);
      mergeAircraftTypes(entityMap);
      mergeDmauVersions(entityMap);
      return mergeAircrafts(entityMap);
   }

   /**
    * Notification received when a new aircraft is added on the server.
    *
    * @param aircraft
    *           the aircraft
    */
   public void onAircraftCreation(Aircraft aircraft) {
      try {
    	 EntityManager em = persistenceManager.getEntityManager();
         Aircraft localAircraft = new Aircraft(aircraft.getId());
         synchronizationManager.setEntityManager(em);
         Map<Object, Object> entityMap = createEntityMap();
         // Add local folders in entity map, so they are not persisted again
         Set<Folder> folders = new HashSet<>(em.createQuery("SELECT f FROM Folder f", Folder.class).getResultList());
         for (Folder folder : folders) {
            entityMap.put(folder, folder);
         }
         synchronizationManager.merge(localAircraft, aircraft, entityMap);
         localAircraft.setGroundStation(em.merge(aircraft.getGroundStation()));
         em.persist(localAircraft);
         LOGGER.info("Local aircraft : " + localAircraft.getRegisterNumber() + " created !");
      } catch (IllegalArgumentException e) {
         LOGGER.error("Could not create local aircraft", e);
      }
   }

   /**
    * Notification received when an aircraft is updated on the server.
    *
    * @param aircraft
    *           the aircraft
    */
   public void onAircraftUpdate(Aircraft aircraft) {
      Aircraft localAircraft;
      try {
         localAircraft = getAircraft(aircraft.getId());
      } catch (EntityNotFoundException e) {
         LOGGER.error("Could not update local aircraft", e);
         localAircraft = null;
      }

      if (localAircraft == null) {
         return;
      }

      Set<Flight> localFlights = new HashSet<>(localAircraft.getFlights());
      synchronizationManager.setEntityManager(persistenceManager.getEntityManager());
      synchronizationManager.merge(localAircraft, aircraft, createEntityMap());

      // Delete signal from deleted flights, if any
      localFlights.removeAll(localAircraft.getFlights());
   }

   /**
    * Notification received when an aircraft is deleted from the server.
    *
    * @param aircraft
    *           the aircraft
    */
   public void onAircraftDeletion(Aircraft aircraft) {
      TypedQuery<AircraftConfiguration> query = persistenceManager.getEntityManager().createNamedQuery("findAircraftConfigurations", AircraftConfiguration.class);
      query.setParameter("aircraftId", aircraft.getId());
      for (AircraftConfiguration configuration : query.getResultList()) {
         persistenceManager.getEntityManager().remove(configuration);
      }
      Aircraft localAircraft;
      try {
         localAircraft = getAircraft(aircraft.getId());
      } catch (EntityNotFoundException e) {
         LOGGER.error("Could not delete local aircraft", e);
         localAircraft = null;
      }
      if (localAircraft == null) {
         return;
      }
      persistenceManager.getEntityManager().remove(localAircraft);

   }

   /**
    * Notification received when a new configuration is added on the server.
    *
    * @param aircraftConfiguration
    *           the aircraft configuration
    */
   public void onConfigurationCreation(AircraftConfiguration aircraftConfiguration) {
      AircraftConfiguration aircraftConfigurationLocal = persistenceManager.getEntityManager().find(AircraftConfiguration.class, aircraftConfiguration.getId());
      if (aircraftConfigurationLocal == null) {
         try {
            AircraftConfiguration localAircraftConfiguration = new AircraftConfiguration(aircraftConfiguration.getId());
            Map<Object, Object> entityMap = createEntityMap();
            try {
               Aircraft localAircraft = getAircraft(aircraftConfiguration.getAircraft().getId());
               entityMap.put(localAircraft, localAircraft);
            } catch (EntityNotFoundException e) {
               LOGGER.info("Aicraft creation message has not been received", e);
               Aircraft serverAircraft = aircraftService.getAircraft(aircraftConfiguration.getAircraft().getId());
               onAircraftCreation(serverAircraft);
               entityMap.put(serverAircraft, serverAircraft);
            }
            synchronizationManager.setEntityManager(persistenceManager.getEntityManager());
            synchronizationManager.merge(localAircraftConfiguration, aircraftConfiguration, entityMap);
            persistenceManager.getEntityManager().persist(localAircraftConfiguration);
         } catch (EntityNotFoundException e) {
            LOGGER.error("Could not retrive local aircraft", e);
         } catch (IllegalArgumentException e) {
            LOGGER.error("Could not create local aircraft configuration", e);
         }
      }
   }

