
package com.eurocopter.mgs.health.presentation.dialog;

import org.eclipse.jface.dialogs.Dialog;
import org.eclipse.jface.dialogs.IDialogConstants;
import org.eclipse.swt.SWT;
import org.eclipse.swt.widgets.Button;
import org.eclipse.swt.widgets.Composite;
import org.eclipse.swt.widgets.Control;
import org.eclipse.swt.widgets.Display;

import com.eurocopter.mgs.core.presentation.i18n.Messages;
import com.eurocopter.mgs.health.presentation.composite.ThresholdLearningComposite;
import com.eurocopter.mgs.health.presentation.model.ThresholdLearningModel;

/**
 * Threshold learning dialog window.
 */
public class ThresholdLearningDialog extends Dialog {

   /** Content composite of the dialog window. */
   private ThresholdLearningComposite composite;

   /** Threshold learning model. */
   private final ThresholdLearningModel model;

   private final long defaultHistoryDuration;

   /**
    * Builds a ThresholdLearningDialog.
    *
    * @param model
    *           the threshold learning model
    */
   public ThresholdLearningDialog(long defaultHistoryDuration) {
      super(Display.getCurrent().getActiveShell());
      this.model = new ThresholdLearningModel();
      this.defaultHistoryDuration = defaultHistoryDuration;
   }

   /**
    * {@inheritDoc}
    *
    * @see org.eclipse.jface.dialogs.Dialog#createDialogArea(org.eclipse.swt.widgets.Composite)
    */
   @Override
   protected Control createDialogArea(Composite parent) {
      parent.setBackground(Display.getDefault().getSystemColor(SWT.COLOR_WHITE));
      parent.setBackgroundMode(SWT.INHERIT_FORCE);
      composite = new ThresholdLearningComposite(parent, model, defaultHistoryDuration);
      composite.pack();
      return composite;
   }

   /**
    * {@inheritDoc}
    *
    * @see org.eclipse.jface.dialogs.Dialog#createButtonsForButtonBar(org.eclipse.swt.widgets.Composite)
    */
   @Override
   protected void createButtonsForButtonBar(Composite parent) {
      Button okButton = createButton(parent, IDialogConstants.OK_ID, Messages.CORE.getMnemonicEscapedString("OK"), true);
      createButton(parent, IDialogConstants.CANCEL_ID, Messages.CORE.getMnemonicEscapedString("Cancel_Button_Label"), false);
      composite.setLearningThresholdDialogOKButton(okButton);
   }

   public ThresholdLearningModel getModel() {
      return model;
   }
}
