import jakarta.transaction.UserTransaction;

@Singleton
@TransactionManagement(TransactionManagementType.BEAN)
public class PurgeDataManager {

   private static final Logger LOGGER = LogManager.getLogger(PurgeDataManager.class);

   private static final long MILLIS_PER_HOUR = 3600000L;

   private static final long MEGA_BYTES = 1048576L;

   @EJB
   private ParameterManager parameterManager;

   @Resource
   private UserTransaction transaction;

   @PersistenceContext
   private EntityManager manager;

   @EJB
   private INotificationService notificationService;

   @EJB
   private AircraftDao aircraftDao;

   @EJB
   private ConfigurationDao configurationDao;

   @EJB
   private AircraftLockManager aircraftLockManager;

   @Lock(LockType.WRITE)
   public void handleOperation(BackgroundOperation operation, ITaskProgressCallback mainTaskCallback) {
      try {
         Map<String, String> downloadAsMap = operation.getDownloadIds();

         Map<String, Collection<String>> downloadMultimap = new HashMap<>();
         for (Entry<String, String> entry : downloadAsMap.entrySet()) {
            if (!downloadMultimap.containsKey(entry.getValue())) {
               downloadMultimap.put(entry.getValue(), new HashSet<>());
            }
            downloadMultimap.get(entry.getValue()).add(entry.getKey());
         }

         if (!downloadMultimap.isEmpty()) {
            for (Entry<String, Collection<String>> entry : downloadMultimap.entrySet()) {
               if (entry.getValue() != null && !entry.getValue().isEmpty()) {
                  final String aircraftId = entry.getKey();
                  Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
                  if (aircraft != null && aircraft.getAircraftState() == AircraftState.ACTIVE) {
                     aircraftLockManager.lock(aircraftId, LockCause.AIRCRAFT_PURGE);
                     try {
                        Set<Flight> flightsToIgnore = new HashSet<>();
                        for (String downloadId : entry.getValue()) {
                           Download download = manager.find(Download.class, downloadId);
                           if (download != null) {
                              // Download may be null in case another purge has been launched
                              flightsToIgnore.addAll(download.getFlights());
                           }
                        }

                        switch (operation.getOperation()) {
                           case FDCR_PURGE -> purgeFdcrData(aircraftId, flightsToIgnore, mainTaskCallback);
                           case FLIGHT_AUTO_PURGE -> processPurge(aircraftId, true, mainTaskCallback);
                           case FLIGHT_MANUAL_PURGE -> processPurge(aircraftId, false, mainTaskCallback);
                           default -> {
                           }
                        }
                     } finally {
                        aircraftLockManager.unlock(aircraftId);
                     }
                  }
               }
            }
         } else {
            Set<Flight> flightsToIgnore = new HashSet<>();
            String aircraftId = operation.getAircraftId();
            Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
            if (aircraft != null && aircraft.getAircraftState() == AircraftState.ACTIVE) {
               switch (operation.getOperation()) {
                  case FDCR_PURGE -> purgeFdcrData(aircraftId, flightsToIgnore, mainTaskCallback);
                  case FLIGHT_AUTO_PURGE -> processPurge(aircraftId, true, mainTaskCallback);
                  case FLIGHT_MANUAL_PURGE -> processPurge(aircraftId, false, mainTaskCallback);
                  default -> {
                  }
               }
            }
         }
      } catch (Exception e) {
         LOGGER.error(e.getMessage(), e);
      }
   }

   public void purgeAllFlights(String aircraftId) {
      TypedQuery<Flight> flightQuery = manager.createNamedQuery("findAllFlightsByAircraft", Flight.class);
      flightQuery.setParameter("aircraftId", aircraftId);
      List<String> aircraftFlightIds = new ArrayList<>();
      for (Flight flight : flightQuery.getResultList()) {
         aircraftFlightIds.add(flight.getId());
      }
      purgeFlights(aircraftId, aircraftFlightIds, new MainTaskProgressCallback());

      LOGGER.debug("Notify history update");
      try {
         notificationService.notifyFolderActions(new ArrayList<>(manager.find(Aircraft.class, aircraftId).getFolders()), Action.DELETION);
      } catch (NotificationException e) {
         LOGGER.error("Error while notifying folder deletion", e);
      }
   }

   private void purgeFdcrData(String aircraftId, Set<Flight> flightsToIgnore, ITaskProgressCallback progressCallback) {
      long start = System.currentTimeMillis();
      LOGGER.info("Start purge fdcr data operation ...");
      try {
         String purgeType = parameterManager.getConfigurationProperty(MgsConfigurationKey.FDCR_PURGE_AUTO.getKey());

         FdcrPurgeMode value = FdcrPurgeMode.valueOf(purgeType);
         LOGGER.info("Initializing FDCR purge: {}", value);
         if (value == FdcrPurgeMode.SIZE || value == FdcrPurgeMode.DATE_AND_SIZE) {
            purgeFdcrDataBySize(aircraftId, flightsToIgnore, progressCallback);
         }
         if (value == FdcrPurgeMode.DATE || value == FdcrPurgeMode.DATE_AND_SIZE) {
            purgeFdcrDataByDate(aircraftId, flightsToIgnore, progressCallback);
         }
         long end = System.currentTimeMillis();
         LOGGER.info("End purge fdcr data operation in {} ms.", (end - start));
      } catch (Exception e) {
         rollbackAndThrow(e);
         LOGGER.info("End purge fdcr data operation with error");
      }
   }

   private void processPurge(String aircraftId, boolean autoPurge, ITaskProgressCallback progressCallback) {
      long maxDurationAllowed;
      try {
         if (autoPurge) {
            maxDurationAllowed = Integer.parseInt(parameterManager.getConfigurationProperty(MgsConfigurationKey.PURGE_AUTO.getKey())) * MILLIS_PER_HOUR;
         } else {
            maxDurationAllowed = Integer.parseInt(parameterManager.getConfigurationProperty(MgsConfigurationKey.PURGE_MANUAL.getKey())) * MILLIS_PER_HOUR;
         }
         purgeFlights(aircraftId, getFlightToDeleteIds(aircraftId, maxDurationAllowed), progressCallback);
         purgeAcknowledgedDeviations(maxDurationAllowed);
      } catch (NumberFormatException e) {
         LOGGER.warn("Could not parse purge date", e);
      }
   }

   private void purgeFlights(String aircraftId, List<String> flightIds, ITaskProgressCallback progressCallback) {
      long start;
      long end;
      start = System.currentTimeMillis();
      LOGGER.info("Start purge flight data operation ...");
      try {
         progressCallback.forecastSteps(flightIds.size());
         for (String flightId : flightIds) {
            purgeFlight(aircraftId, flightId);
            notifyAircraftIfNecessary(aircraftId, Action.FLIGHT_DELETION);
            progressCallback.stepDone();
         }
         notifyAircraftIfNecessary(aircraftId, Action.UPDATE);
         end = System.currentTimeMillis();
         LOGGER.info("End purge flight data operation in {} ms.", (end - start));
      } catch (Exception e) {
         LOGGER.warn("Could not purge flight data", e);
         LOGGER.info("End purge flight data operation with error");
      }
   }

   private void notifyAircraftIfNecessary(String aircraftId, Action action) throws NotificationException {
      Aircraft aircraftForNotification = manager.find(Aircraft.class, aircraftId);
      if (aircraftForNotification.getAircraftState() != AircraftState.DELETED) {
         aircraftDao.updateAircraftStatus(aircraftId);
         aircraftForNotification = manager.find(Aircraft.class, aircraftId);
         aircraftForNotification.getAccelerometers().size();
         notificationService.notifyAction(AircraftCloner.clone(aircraftForNotification), action);
      }
   }

   private List<String> getFlightToDeleteIds(String aircraftId, long maxDurationAllowed) {
      TypedQuery<PurgedFlight> purgedFlightsQuery = manager.createNamedQuery("getPurgedFlightsByAircraftId", PurgedFlight.class);
      purgedFlightsQuery.setParameter("aircraftId", aircraftId);
      purgedFlightsQuery.setMaxResults(1);
      List<PurgedFlight> purgedFlights = purgedFlightsQuery.getResultList();
      final Date lastPurgedFlightDate;
      if (purgedFlights.isEmpty()) {
         lastPurgedFlightDate = null;
      } else {
         lastPurgedFlightDate = purgedFlights.get(0).getDate();
      }

      TypedQuery<Flight> flightQuery = manager.createNamedQuery("findFlightsByAircraftOrderByDate", Flight.class);
      flightQuery.setParameter("aircraftId", aircraftId);
      List<Flight> purgeCandidates = new ArrayList<>();

      List<String> flightToDeleteIds = new ArrayList<>();

      long sumMillis = 0;
      boolean eligibleForPurge = true;

      for (Flight flight : flightQuery.getResultList()) {
         TypedQuery<Alarm> closeMonitoredAlarmQuery = manager.createNamedQuery("findAlarmsByAircraftFlightAndStatus", Alarm.class);
         closeMonitoredAlarmQuery.setParameter("aircraftId", aircraftId);
         closeMonitoredAlarmQuery.setParameter("flightId", flight.getFlightId());
         closeMonitoredAlarmQuery.setParameter("status", AlarmStatus.CLOSEMONITORED.name());

         boolean hasCloseMonitoredAlarm = !closeMonitoredAlarmQuery.getResultList().isEmpty();

         if (hasCloseMonitoredAlarm) {
            // We can't chose the current flight, but we don't want to create "holes" in the flight list, so we cannot just
            // ignore this one and jump to the next one.
            // Starting from the current one, flights are no longer eligible for purge.
            eligibleForPurge = false;
         }

         if (lastPurgedFlightDate != null && flight.getDate().before(lastPurgedFlightDate)) {
            // This flight shall be purged anyway, otherwise we will have a "hole" in the flight list
            // We don't want to count it in the flight duration total, though.
            flightToDeleteIds.add(flight.getId());
         } else {
            if (eligibleForPurge) {
               purgeCandidates.add(flight);
            }

            sumMillis += flight.getFlightDuration();
         }
      }

      if (sumMillis <= maxDurationAllowed) {
         // The threshold is not exceeded anyway, no need to iterate on the flight list again
         return flightToDeleteIds;
      }

      for (Flight flight : purgeCandidates) {
         sumMillis = sumMillis - flight.getFlightDuration();
         flightToDeleteIds.add(flight.getId());
         if (sumMillis <= maxDurationAllowed) {
            // Threshold not exceeded, no need to purge more flights
            break;
         }
      }
      return flightToDeleteIds;
   }

   private void purgeFlight(String aircraftId, String flightId) throws SystemException {
      try {
         LOGGER.info("Flight to be purged: {}", flightId);
         Flight flight = manager.find(Flight.class, flightId);
         if (flight == null) {
            return;
         }
         // Usage flight data can be null. This type of flight is used for MGS computing error.
         // In order to use the same process of 'normal' flight deletion (same SQL queries), usageFlightDataId is replaced by the flight ID
         String usageFlightDataId = flight.hasUsageData() ? flight.getUsageFlightData().getId() : flight.getId();
         purgeFlightData(flight.getId(), usageFlightDataId);
         transaction.begin();
         LOGGER.info("Delete flight #{}.", flight.getFlightId());
         Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
         aircraft.getFlights().remove(flight);
         LOGGER.info("Delete download.");
         for (Download download : new ArrayList<>(aircraft.getDownloads())) {
            download.getFlights().remove(flight);
            if (download.getFlights().isEmpty()) {
               aircraft.getDownloads().remove(download);
            }
         }
         LOGGER.info("Clean SFTP folder.");
         DataManagerUtils.cleanSftpFolders(flight);
         transaction.commit();
         manager.clear();
         LOGGER.info("Flight {} purged", flightId);
      } catch (Exception e1) {
         LOGGER.error("Cannot purge flight: {}", flightId, e1);
         try {
            transaction.rollback();
         } catch (Exception e2) {
            LOGGER.error("Rollback problem", e2);
         }
      }
   }

   private void purgeFlightData(String flightTechnicalId, String usageFlightDataId)
         throws NotSupportedException, SystemException, RollbackException, HeuristicMixedException, HeuristicRollbackException {
      transaction.begin();
      FlightDeletionManager flightDeletionManager = new FlightDeletionManager(manager);
      flightDeletionManager.recordFlightDeletion(flightTechnicalId);
      flightDeletionManager.processFlightDeletion(flightTechnicalId, usageFlightDataId);
      transaction.commit();
      manager.clear();
   }

   private void purgeFdcrDataByDate(String aircraftId, Set<Flight> flightsToIgnore, ITaskProgressCallback progressCallback)
         throws NotSupportedException, SystemException, RollbackException, HeuristicMixedException, HeuristicRollbackException {
      String property = parameterManager.getConfigurationProperty(MgsConfigurationKey.FDCR_PURGE_DATE.getKey());
      int dayCount;
      try {
         dayCount = Integer.parseInt(property);
      } catch (NumberFormatException e) {
         LOGGER.warn("Could not parse FDCR purge date", e);
         return;
      }

      // No matter which flight has just been downloaded, the reference date
      // is the last flight performed by the aircraft
      Optional<Flight> optionalLastFlight = aircraftDao.getLastFlight(aircraftId);
      if (optionalLastFlight.isEmpty()) {
         // No flight?! => nothing to purge!
         return;
      }
      final Flight lastFlight = optionalLastFlight.get();

      Calendar calendar = Calendar.getInstance(TimeZone.getTimeZone("GMT"));
      calendar.setTime(lastFlight.getUsageStartDate());
      calendar.add(Calendar.DAY_OF_MONTH, -dayCount);
      Date thresholdDate = calendar.getTime();

      TypedQuery<Flight> query = manager.createNamedQuery("findFlightsByAircraftOlderThanDate", Flight.class);
      query.setParameter("date", thresholdDate);
      query.setParameter("aircraftId", aircraftId);
      Set<Flight> flightsToPurge = new HashSet<>(query.getResultList());

      // Just in case the setting has been set to "0", make sure the last flight is NEVER purged
      flightsToPurge.remove(lastFlight);
      flightsToPurge.removeAll(flightsToIgnore);
      if (!flightsToPurge.isEmpty()) {
         processFdcrPurge(flightsToPurge, progressCallback);
      }
   }

   private void purgeFdcrDataBySize(String aircraftId, Set<Flight> flightsToIgnore, ITaskProgressCallback progressCallback)
         throws NotSupportedException, SystemException, RollbackException, HeuristicMixedException, HeuristicRollbackException {
      String property = parameterManager.getConfigurationProperty(MgsConfigurationKey.FDCR_PURGE_SIZE.getKey());

      long sizeMax;
      try {
         sizeMax = Long.parseLong(property) * MEGA_BYTES;
      } catch (NumberFormatException e) {
         LOGGER.warn("Could not parse FDCR purge size", e);
         return;
      }

      Query query = manager.createNamedQuery("sumFdcrDataSizeByAircraft");
      query.setParameter("aircraftId", aircraftId);

      long totalSize = 0;
      if (query.getSingleResult() != null) {
         totalSize = (Long) query.getSingleResult();
      }

      LOGGER.info("purgeFdcrDataBySize: Total size = {} (limit is {})", totalSize, sizeMax);

      // If the size is greater than the maximum size => purge
      if (totalSize > sizeMax) {
         TypedQuery<Flight> flightQuery = manager.createNamedQuery("findFlightsByAircraftOrderByDate", Flight.class);
         flightQuery.setParameter("aircraftId", aircraftId);
         List<Flight> flights = flightQuery.getResultList();

         Set<Flight> flightsToPurge = new HashSet<>();
         for (Flight flight : flights) {
            if (flightsToIgnore.contains(flight)) {
               continue;
            }
            Object sizeObject = manager.createNativeQuery("SELECT SUM(LENGTH(value)) FROM fdcr_dataset WHERE flight_id = ?").setParameter(1, flight.getId()).getSingleResult();
            if (sizeObject != null) {
               long size = ((Number) sizeObject).longValue();
               if (size > 0) {
                  flightsToPurge.add(flight);
                  totalSize -= size;
                  if (totalSize <= sizeMax) {
                     break;
                  }
               }
            }
         }
         // Never purge FDCR data from the latest flight
         TypedQuery<Flight> queryLastFlight = manager.createNamedQuery("findFlightsOrderByDateDesc", Flight.class);
         queryLastFlight.setParameter("aircraftId", aircraftId);
         queryLastFlight.setMaxResults(1);
         final Flight lastFlight;
         try {
            lastFlight = queryLastFlight.getSingleResult();
         } catch (NoResultException e) {
            LOGGER.warn("Missing flight", e);
            // No flight?! => nothing to purge!
            return;
         }
         flightsToPurge.remove(lastFlight);
         processFdcrPurge(flightsToPurge, progressCallback);
      }
   }

   private void rollbackAndThrow(Exception e) {
      try {
         transaction.rollback();
      } catch (Exception e2) {
         // Better throw the original exception
         LOGGER.warn("Unable to rollback transaction", e2);
      }
      throw new UnmanagedTransactionException(e);
   }

   private void processFdcrPurge(Set<Flight> flightsToPurge, ITaskProgressCallback progressCallback)
         throws NotSupportedException, SystemException, RollbackException, HeuristicMixedException, HeuristicRollbackException {
      progressCallback.forecastSteps(flightsToPurge.size());
      for (Flight flight : flightsToPurge) {
         transaction.begin();
         LOGGER.info("Purge flight: {}", flight.getFlightId());
         manager.createNativeQuery("TRUNCATE TABLE fdcr_dataset_" + flight.getId().replace('-', '_')).executeUpdate();
         manager.createNativeQuery("DELETE FROM fdcr_data WHERE flight_id = ?").setParameter(1, flight.getId()).executeUpdate();
         transaction.commit();
         manager.clear();
         progressCallback.stepDone();
      }
   }

   private void purgeAcknowledgedDeviations(long maxDurationAllowed) {
      long start = System.currentTimeMillis();
      LOGGER.info("Start purge deviation data operation .......");
      try {
         final Date limit = new Date(start - maxDurationAllowed);
         transaction.begin();
         int deleted = manager
               .createNativeQuery("DELETE FROM indicator_deviation WHERE end_date IS NOT NULL AND end_date < ?")
               .setParameter(1, limit)
               .executeUpdate();
         transaction.commit();
         manager.clear();
         LOGGER.info("End purge deviation data operation in {} ms, {} deviation(s) deleted.",
               (System.currentTimeMillis() - start), deleted);
      } catch (Exception e1) {
         LOGGER.error("Cannot purge deviations", e1);
         try {
            transaction.rollback();
         } catch (Exception e2) {
            LOGGER.error("Rollback problem", e2);
         }
      }
   }
}

