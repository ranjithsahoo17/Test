   private BearingData buildBearingData(final List<Double> parameters) {
      final double bearingDiameter = parameters.get(1);
      final double rollingElementDiameter = parameters.get(2);
      final int rollingElementNumber = parameters.get(3).intValue();
      final double contactAngle = parameters.get(4);
      final double internalRingRotationFrequency = parameters.get(5);
      final double externalRingRotationFrequency = parameters.get(6);
      return new BearingData(bearingDiameter, rollingElementDiameter,
            rollingElementNumber, contactAngle, internalRingRotationFrequency,
            externalRingRotationFrequency);
   }

   private void addMechanicalComponentAcquisition(final Flight flight, final HealthMechanicalComponent healthMechanicalComponent, String source, final IHealthAcquisition acq) {
      final MarmsMechanicalComponentAcquisition acquisition = new MarmsMechanicalComponentAcquisition(UUID.randomUUID().toString());
      acquisition.setMechanicalComponent(healthMechanicalComponent);
      acquisition.setAcquisitionName(source);
      acquisition.setStartDate(acq.getStartDate());
      // No accelerometer for M'ARMS acquisition (and a single signal)
      final Signal signal = acq.getAccelerometerSignals().get(IHealthAcquisition.NULL_ACCELEROMETER);
      signal.setFlightId(flight.getId());
      acquisition.setSamplingSize(signal.getValue().length / 8);
      acquisition.setSamplingFrequency(acq.getSamplingFrequency());
      acquisition.setSignal(signal);
      flight.getMechanicalComponentAcquisitions().add(acquisition);
   }

   private double[] computeResidualSignal(final HealthAlgorithm algorithm, final List<Double> parameters, final double[] averageSignal) throws AnalysisException {
      if (averageSignal == null) {
         throw new AnalysisException("Algorithm " + algorithm + " not applicable: no average signal");
      }
      double[][] rawFft = HEALTH_ALGORITHMS.rawFFT(averageSignal);
      int[] lines = new int[parameters.size()];
      for (int i = 0; i < parameters.size(); i++) {
         lines[i] = parameters.get(i).intValue();
      }
      final int size = rawFft[1].length;
      for (int i = size / 2; i < size; ++i) {
         rawFft[1][i] *= -1;
      }
      double[][] residual = HEALTH_ALGORITHMS.residualComplex(rawFft, lines);
      return HEALTH_ALGORITHMS.inverseFFTComplex(residual);
   }

   private double computeBearingIndicator(final HealthAlgorithm algorithm, final SignalType signalType, final List<Double> parameters,
         final double[] rawSignal, final SignalEnvelopeCache envelopeCache, final boolean internal) throws AnalysisException {
      if (rawSignal == null) {
         throw new AnalysisException("Algorithm " + algorithm + " not applicable: no raw signal");
      }
      final double rotations = parameters.get(0);
      final BearingData bearingData = buildBearingData(parameters);
      final double[] envelope = envelopeCache.get(rawSignal);
      if (internal) {
         return BEARING_ALGORITHMS.internalBearingIndicator(envelope, rotations, bearingData) * signalType.getCoefficient();
      } else {
         return BEARING_ALGORITHMS.externalBearingIndicator(envelope, rotations, bearingData) * signalType.getCoefficient();
      }
   }
