@Remote(IHealthAlarmService.class)
@Stateless(mappedName = IHealthAlarmService.EJB_NAME)
public class HealthAlarmService implements IHealthAlarmService {

   private static final Logger LOGGER = LogManager.getLogger(HealthAlarmService.class);

   @EJB
   private AcknowledgementManager acknowledgementManager;

   @EJB
   private AircraftLockManager aircraftLockManager;

   @EJB
   private HealthDao healthDao;

   @PersistenceContext
   private EntityManager manager;

   @Override
   public Set<AlarmIndicatorModel> getNotAckHealthAlarms(String aircraftId) {
      TypedQuery<Object[]> query = manager.createNamedQuery("findNotAckHealthAlarmsAndFlightByAircraft", Object[].class);
      query.setParameter("aircraftId", aircraftId);
      Set<AlarmIndicatorModel> alarmModels = new HashSet<>();
      for (Object[] row : query.getResultList()) {
         HealthAlarm alarm = (HealthAlarm) row[0];
         Flight flight = (Flight) row[1];
         alarmModels.add(new AlarmIndicatorModel(alarm, flight));
      }
      return alarmModels;
   }

   @Override
   public void updateCloseMonitoringStatus(String aircraftId, Set<String> kept, Set<String> withdrawn) {
      if (!kept.isEmpty()) {
         acknowledgementManager.keepCloseMonitoringStatus(kept);
      }
      if (!withdrawn.isEmpty()) {
         acknowledgementManager.cancelCloseMonitoringStatus(withdrawn);
      }
      acknowledgementManager.updateAircraftStatusAndNotify(manager.find(Aircraft.class, aircraftId));
   }

   @Override
   public Map<HealthAlarm, Flight> getHealthAlarmsByIndicator(String indicatorId, Boolean acknowledged) {
      TypedQuery<Object[]> query = manager.createNamedQuery("findHealthAlarmsAndFlightByIndicator", Object[].class);
      query.setParameter("indicatorId", indicatorId);
      Map<HealthAlarm, Flight> alarms = new HashMap<>();
      for (Object[] row : query.getResultList()) {
         HealthAlarm alarm = (HealthAlarm) row[0];
         if (acknowledged == null || alarm.getAlarmStatus() == AlarmStatus.ACK == acknowledged) {
            // Take all alarms if acknowledge is null
            // alarms whose status is ACK if acknowledged is true
            // alarms whose status is not ACK (i.e NOTACK and CLOSEMONITORED) if acknowledged is false
            Flight flight = (Flight) row[1];
            alarms.put(alarm, flight);
         }
      }
      return alarms;
   }

   @Override
   public Map<SensorAnomaly, Flight> getSensorAnomaliesByIndicator(String indicatorId) {
      TypedQuery<Object[]> query = manager.createNamedQuery("findSensorAnomaliesAndFlightByIndicator", Object[].class);
      query.setParameter("indicatorId", indicatorId);
      Map<SensorAnomaly, Flight> alarms = new HashMap<>();
      for (Object[] row : query.getResultList()) {
         SensorAnomaly alarm = (SensorAnomaly) row[0];
         if (alarm.getAlarmStatus() == AlarmStatus.ACK) {
            // Take all alarms if acknowledge is null
            // alarms whose status is ACK if acknowledged is true
            // alarms whose status is not ACK (i.e NOTACK and CLOSEMONITORED) if acknowledged is false
            Flight flight = (Flight) row[1];
            alarms.put(alarm, flight);
         }
      }
      return alarms;
   }

