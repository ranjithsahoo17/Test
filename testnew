   @Override
   public Map<IndicatorMarker, String> getIndicatorMarkers(String aircraftId, String indicatorId) {
      Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      Indicator indicator = manager.find(Indicator.class, indicatorId);

      Map<IndicatorMarker, String> markers = new HashMap<>();
      for (Flight flight : aircraft.getFlights()) {
         List<IndicatorMarker> resultList = manager.createNamedQuery("findIndicatorMarkersByFlightAndIndicator", IndicatorMarker.class)
               .setParameter("indicator", indicator)
               .setParameter("flight", flight)
               .getResultList();
         for (IndicatorMarker indicatorMarker : resultList) {
            markers.put(indicatorMarker, flight.getId());
         }
      }
      return markers;
   }

   @Override
   public void createIndicatorMarker(IndicatorMarkerDto indicatorMarkerDto) throws EntityNotFoundException {
      FlightIndicatorValue flightIndicatorValue = getFlightIndicatorValue(indicatorMarkerDto.getFlightId(), indicatorMarkerDto.getIndicatorId());
      if (flightIndicatorValue == null) {
         // Fix PR 7894 : Create flight indicator value to add marker even if flight has no value for this indicator
         Flight flight = manager.find(Flight.class, indicatorMarkerDto.getFlightId());
         Indicator indicator = manager.find(Indicator.class, indicatorMarkerDto.getIndicatorId());
         if (indicator == null) {
            throw new EntityNotFoundException("Cannot find indicator with id " + indicatorMarkerDto.getIndicatorId());
         }
         flightIndicatorValue = new FlightIndicatorValue(UUID.randomUUID().toString());
         flight.getFlightIndicatorValues().add(flightIndicatorValue);
         flightIndicatorValue.setIndicator(indicator);
      }
      IndicatorMarker marker = new IndicatorMarker(UUID.randomUUID().toString());
      marker.setDateValue(indicatorMarkerDto.getDateValue());
      marker.setDescription(indicatorMarkerDto.getDescription());
      marker.setCreationDate(new Date());

      flightIndicatorValue.getMarkers().add(marker);
   }

   @Override
   public void createBatchIndicatorMarkers(BatchIndicatorMarkerDto batchIndicatorMarkerDto) throws EntityNotFoundException {
      Flight flight = manager.find(Flight.class, batchIndicatorMarkerDto.getFlightId());
      if (flight == null) {
         throw new EntityNotFoundException("Cannot find flight with id " + batchIndicatorMarkerDto.getFlightId());
      }
      Set<String> indicatorIds = batchIndicatorMarkerDto.getIndicatorIds();
      for (String indicatorId : indicatorIds) {
         TypedQuery<FlightIndicatorValue> flightIndicatorValueQuery = manager.createNamedQuery("findFlightIndicatorValueByFlightAndIndicator", FlightIndicatorValue.class);
         flightIndicatorValueQuery.setParameter("flightId", flight.getId());
         flightIndicatorValueQuery.setParameter("indicatorId", indicatorId);
         List<FlightIndicatorValue> matchingFlightIndicatorValues = flightIndicatorValueQuery.getResultList();
         final FlightIndicatorValue flightIndicatorValue;
         if (matchingFlightIndicatorValues.isEmpty()) {
            Indicator indicator = manager.find(Indicator.class, indicatorId);
            if (indicator == null) {
               throw new EntityNotFoundException("Cannot find indicator with id " + indicatorId);
            }
            flightIndicatorValue = new FlightIndicatorValue(UUID.randomUUID().toString());
            flight.getFlightIndicatorValues().add(flightIndicatorValue);
            flightIndicatorValue.setIndicator(indicator);
         } else {
            flightIndicatorValue = matchingFlightIndicatorValues.iterator().next();
         }

         TypedQuery<HealthMechanicalComponent> componentQuery = manager.createNamedQuery("findHMCByIndicator", HealthMechanicalComponent.class);
         componentQuery.setParameter("indicatorId", indicatorId);
         HealthMechanicalComponent healthMechanicalComponent = componentQuery.getSingleResult();

         IndicatorMarker marker = new IndicatorMarker(UUID.randomUUID().toString());
         // According to the parent health mechanical component flag,
         // the marker date is different, because "end of flight" means two different things
         if (healthMechanicalComponent.isGroundAcquisition()) {
            if (flight.getHealthEndDate() == null) {
               // That flight is not selectable through UI anyway...
               LOGGER.debug("Ignoring marker creation on flight {}, on-ground acquisitions without end date", flight.getFlightId());
               continue;
            }
            marker.setDateValue(flight.getHealthEndDate());
         } else {
            FlightHourData flightHourData = flight.getFlightHourData();
            if (flightHourData == null) {
               // "in flight" acquisitions, so the current flight will not be displayed anyway
               LOGGER.debug("Ignoring marker creation on flight {}, in-flight acquisitions without flight hour data", flight.getFlightId());
               continue;
            }
            // This weird computation comes from the marker storage in database
            // The associated date is in fact relative to the flight start date on the chart (= first take-off in that case)
            marker.setDateValue(new Date(flightHourData.getFirstTakeoffDateTime().getTime() + flightHourData.getDuration()));
         }
         marker.setDescription(batchIndicatorMarkerDto.getDescription());
         marker.setCreationDate(new Date());

         flightIndicatorValue.getMarkers().add(marker);
      }
   }

   @Override
