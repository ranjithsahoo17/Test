   public void analyze(TopicDto topicDto, String downloadFolder, Multimap<String, String> downloadPerAircraft, ITaskProgressCallback mainTaskCallback)
         throws IOException, NotificationException {
      final File tempDataCollectionFolder = parameterManager.getTempDataCollectionFolder();
      final File sourceFolder = new File(new File(tempDataCollectionFolder, "fdcr"), downloadFolder);
      if (!sourceFolder.exists()) {
         // Folder has been deleted => no need to retry
         return;
      }

      // Do not delete files in case an EJB Exception has been raised
      boolean gotEjbException = false;

      mainTaskCallback.forecastSubtask(FDCR_TASK.AIRCRAFTS_ANALYSIS.id, 96);
      mainTaskCallback.forecastSubtask(FDCR_TASK.DATA_COLLECTION.id, 2);
      mainTaskCallback.forecastSubtask(FDCR_TASK.DELETE_FILES.id, 1);

      Context context = null;
      try {
         context = progressManager.initContext(topicDto);

         Map<String, Resource> resources = new FileResourceMap(sourceFolder);
         Map<AircraftIdentifier, Map<PartitionId, Map<String, Resource>>> organizedResources = resourceOrganizer.organizeByAircraftAndPartition(resources);

         final Map<String, String> aircraftFoldersForRawFileDataCollection = getAircraftFoldersForRawFileDataCollection(organizedResources);
         final Set<String> aicraftFoldersForRawDataCollectionSet = aircraftFoldersForRawFileDataCollection.keySet();
         if (!aicraftFoldersForRawDataCollectionSet.isEmpty()) {
            mainTaskCallback.forecastSubtask(FDCR_TASK.RAW_DATA_COLLECTION.id, 2);
            try {
               final File dataCollectionFolder = parameterManager.getDataCollectionFolder();
               final File targetFolder = new File(dataCollectionFolder, "fdcr_raw_files");
               ITaskProgressCallback rawDataCollectionCallback = mainTaskCallback.startSubtask(FDCR_TASK.RAW_DATA_COLLECTION.id);
               performDataCollection(sourceFolder, targetFolder, aicraftFoldersForRawDataCollectionSet, rawDataCollectionCallback);
            } catch (Exception e) {
               if (isServerShutdownException(e)) {
                  gotEjbException = true;
               }
               LOGGER.warn("FDCR analysis: unable to perform FDCR raw files data collection", e);
            } finally {
               mainTaskCallback.endSubtask();
            }
         }

         Set<Entry<AircraftIdentifier, Map<PartitionId, Map<String, Resource>>>> organizedResourcesSet = organizedResources.entrySet();

         try {
            ITaskProgressCallback analyseAircraftsCallback = mainTaskCallback.startSubtask(FDCR_TASK.AIRCRAFTS_ANALYSIS.id);
            int taskId = 0;

            for (Entry<AircraftIdentifier, Map<PartitionId, Map<String, Resource>>> aircraftData : organizedResourcesSet) {
               int resourceCount = 0;
               for (Map<String, Resource> partitionResources : aircraftData.getValue().values()) {
                  resourceCount += partitionResources.size();
               }
               analyseAircraftsCallback.forecastSubtask(taskId, resourceCount);
               taskId++;
            }

            taskId = 0;
            for (Entry<AircraftIdentifier, Map<PartitionId, Map<String, Resource>>> aircraftData : organizedResourcesSet) {
               ITaskProgressCallback analyseAircraftCallback = analyseAircraftsCallback.startSubtask(taskId);
               FdcrAnalysisResult aircraftResult = analyzeAircraft(aircraftData.getKey(), aircraftData.getValue(), downloadPerAircraft, sourceFolder, aircraftFoldersForRawFileDataCollection.keySet(),
                     analyseAircraftCallback);
               gotEjbException |= aircraftResult.ejbExceptionPresent;
               analyseAircraftsCallback.endSubtask();
               taskId++;
            }
         } catch (Exception e) {
            if (isServerShutdownException(e)) {
               gotEjbException = true;
            }
            LOGGER.warn("FDCR analysis: an error occurred", e);
         } finally {
            mainTaskCallback.endSubtask();
         }

         try {
            final File targetFolder = new File(tempDataCollectionFolder, "data_collection");
            ITaskProgressCallback dataCollectionCallback = mainTaskCallback.startSubtask(FDCR_TASK.DATA_COLLECTION.id);
            performDataCollection(sourceFolder, targetFolder, null, dataCollectionCallback);
         } catch (Exception e) {
            if (isServerShutdownException(e)) {
               gotEjbException = true;
            }
            LOGGER.warn("FDCR analysis: unable to perform FDCR data collection", e);
         } finally {
            mainTaskCallback.endSubtask();
         }

         for (Entry<String, String> entry : downloadPerAircraft.entries()) {
            String aircraftId = entry.getKey();
            String downloadId = entry.getValue();
            Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
            Download download = manager.find(Download.class, downloadId);
            if (download != null) {
               HashMap<Aircraft, Collection<Flight>> flights = new HashMap<>();
               Set<Flight> aircraftFlights = download.getFlights();
               aircraftFlights.size();
               flights.put(aircraft, aircraftFlights);
               progressManager.notifyProgress(context, flights, Progress.END);
            }
         }
      } finally {
         mainTaskCallback.startSubtask(FDCR_TASK.DELETE_FILES.id);
         if (gotEjbException) {
            LOGGER.warn("Skipping folder deletion due to EJB Exception encountered");
         } else {
            FileUtils.forceDelete(sourceFolder);
         }
         if (context != null) {
            progressManager.disposeContext();
         }
         mainTaskCallback.endSubtask();
      }
      asyncQueue.addTask(new PurgeRequest(PurgeType.FDCR, downloadPerAircraft));
   }

   /**
    * This method tries to guess if an exception comes from server shutdown in progress.
    * 
    * @param e
    *           Exception raised
    * @return <code>true</code> if the error is generated by server shutdown, <code>false</code> otherwise.
    */
   private boolean isServerShutdownException(Exception e) {
      if (e instanceof EJBException) {
         return true;
      }
      if (e instanceof IllegalStateException) {
         return e.getMessage().contains("closed EntityManager");
      }
      if (e instanceof DatabaseException) {
         e.getMessage().contains("has been closed");
      }
      if (e.getCause() instanceof Exception) {
         return isServerShutdownException((Exception) e.getCause());
      }
      return false;
   }

   private Map<String, String> getAircraftFoldersForRawFileDataCollection(Map<AircraftIdentifier, Map<PartitionId, Map<String, Resource>>> organizedResources) {
      final Map<String, String> managedAicraftFolders = new HashMap<>();

      for (Entry<AircraftIdentifier, Map<PartitionId, Map<String, Resource>>> aircraftData : organizedResources.entrySet()) {
         AircraftIdentifier aircraftId = aircraftData.getKey();
         Map<PartitionId, Map<String, Resource>> resourceMap = aircraftData.getValue();

         Aircraft aircraft;
         try {
            aircraft = findAircraftBySubtype(aircraftId.aircraftSubtype(), aircraftId.aircraftId(), resourceMap.keySet().iterator().next().startDate());
         } catch (final EntityNotFoundException e) {
            LOGGER.warn("FDCR raw files data collection: A/C not managed. Data will not be data collected.", e);
            continue;
         }

         if (aircraft.getAircraftState() == AircraftState.DELETED) {
            LOGGER.warn("FDCR raw files data collection: A/C deleted. Data will not be data collected.");
            continue;
         }

         Optional<AircraftConfiguration> lastConfiguration = configurationDao.findLatestConfiguration(aircraft.getId());
         final AircraftConfiguration latestConfiguration;
         if (lastConfiguration.isPresent()) {
            latestConfiguration = lastConfiguration.get();
         } else {
            LOGGER.warn("FDCR raw files data collection: cannot find latest A/C configuration {}. Data will not be data collected.", aircraft);
            continue;
         }

         final AvionicVersion lastAvionicVersion = latestConfiguration.getAvionicVersion();
         if (!hasFdcrFeature(lastAvionicVersion)) {
            LOGGER.warn("FDCR raw files data collection: no FDCR for {}. Data will not be data collected.", lastAvionicVersion.getId());
            continue;
         }

         final FdcrDecPreferenceBean fdcrRemovedParametersPreference = parameterManager.getFdcrRemovedParametersPreference(lastAvionicVersion.getId());
         if (fdcrRemovedParametersPreference == null || fdcrRemovedParametersPreference.getStructures().isEmpty()) {
            continue;
         }

         managedAicraftFolders.put(getAircraftFolderName(aircraftId), aircraft.getId());
      }

      return managedAicraftFolders;
   }

   private String getAircraftFolderName(AircraftIdentifier aircraftId) {
      return aircraftId.aircraftSubtype() + "_" + aircraftId.aircraftId();
   }

   private FdcrAnalysisResult analyzeAircraft(AircraftIdentifier aircraftId, Map<PartitionId, Map<String, Resource>> resourceMap, Multimap<String, String> downloadPerAircraft,
         File sourceFolder, Set<String> aircraftFoldersForRawFileDataCollection, ITaskProgressCallback progressCallback) throws EntityNotFoundException {
      Aircraft aircraft;
      try {
         aircraft = findAircraftBySubtype(aircraftId.aircraftSubtype(), aircraftId.aircraftId(), resourceMap.keySet().iterator().next().startDate());
      } catch (final EntityNotFoundException e) {
         LOGGER.warn("FDCR analysis: A/C not managed", e);
         return new FdcrAnalysisResult(false);
      }

      final AircraftConfiguration latestConfiguration = configurationDao.getLatestConfiguration(aircraft.getId());
      if (!hasFdcrFeature(latestConfiguration.getAvionicVersion())) {
         LOGGER.warn("FDCR analysis: no FDCR for {}. Data will not be analyzed.", latestConfiguration.getAvionicVersion().getId());
         return new FdcrAnalysisResult(false);
      }

      if (aircraft.getAircraftState() == AircraftState.DELETED) {
         LOGGER.warn("FDCR analysis: A/C deleted");
         return new FdcrAnalysisResult(false);
      }

      final String aircraftFolderName = getAircraftFolderName(aircraftId);

      if (aircraft.getAircraftState() == AircraftState.FROZEN) {
         LOGGER.warn("FDCR analysis: A/C frozen");
         return new FdcrAnalysisResult(false);
      }

      // Start dates of the different flights.
      Map<Integer, Date> flightStartDates = new HashMap<>();
      for (PartitionId partitionId : resourceMap.keySet()) {
         flightStartDates.put(partitionId.flightId(), partitionId.startDate());
      }

      Map<Integer, String> flightIds = new HashMap<>();
      Map<String, String> downloads = new HashMap<>();

      Collection<String> downloadIds = downloadPerAircraft.asMap().get(aircraft.getId());
      if (downloadIds != null) {
         // In some cases, the download can be missing (when data-collecting residual files)
         for (String downloadId : downloadIds) {
            Download download = manager.find(Download.class, downloadId);
            if (download == null) {
               continue;
            }
            for (Flight flight : download.getFlights()) {
               flightIds.put(flight.getFlightId(), flight.getId());
               downloads.put(flight.getId(), download.getId());
            }
         }
      }

      boolean gotEjbException = false;
      try {
         // Resources reorganized by flight, by feature and by path for the current aircraft.
         Map<Integer, Map<FeatureId, Map<String, Resource>>> reorganized = resourceOrganizer.reorganize(resourceMap);

         // Loop over all aircraft flights.
         final boolean hasDataToRemove = aircraftFoldersForRawFileDataCollection.contains(aircraftFolderName);

         Set<Entry<Integer, Map<FeatureId, Map<String, Resource>>>> reorganizedSet = reorganized.entrySet();

         for (Entry<Integer, Map<FeatureId, Map<String, Resource>>> flightData : reorganizedSet) {
            int resourceCount = 0;
            for (Map<String, Resource> flightResources : flightData.getValue().values()) {
               resourceCount += flightResources.size();
            }
            progressCallback.forecastSubtask(flightData.getKey(), resourceCount);
         }

         for (Entry<Integer, Map<FeatureId, Map<String, Resource>>> flightData : reorganizedSet) {
            int flightNumber = flightData.getKey();
            ITaskProgressCallback flightAnalysisCallback = progressCallback.startSubtask(flightNumber);
            final Map<String, Resource> fdcrResources = new HashMap<>(flightData.getValue().get(FeatureId.FDCR));
            final FlightInformationHandler flightInfo;
            String flightTechnicalId = flightIds.get(flightNumber);
            if (flightTechnicalId != null) {
               Flight flight = manager.find(Flight.class, flightTechnicalId);
               if (flight != null) {
                  String downloadTechnicalId = downloads.get(flight.getId());
                  Download download = manager.find(Download.class, downloadTechnicalId);
                  final AircraftConfiguration applicableConfiguration = configurationDao.findConfigurationByFlight(flight.getId());
                  flightInfo = new ActualFlightInformationHandler(download, flight, applicableConfiguration, latestConfiguration);
               } else {
                  LOGGER.warn("FDCR analysis: cannot find flight: {}", flightTechnicalId);
                  flightInfo = new SimulatedFlightInformationHandler(flightNumber, flightStartDates.get(flightNumber), latestConfiguration);
               }
            } else {
               LOGGER.warn("FDCR analysis: cannot find flight id for flight number: {}", flightNumber);
               flightInfo = new SimulatedFlightInformationHandler(flightNumber, flightStartDates.get(flightNumber), latestConfiguration);
            }
            FdcrAnalysisResult flightAnalysisResult = analyzeFlight(aircraft, flightInfo, fdcrResources, sourceFolder, aircraftFolderName, flightAnalysisCallback);
            gotEjbException |= flightAnalysisResult.ejbExceptionPresent;
            prepareForLocalDiagnosisIfNecessary(aircraft, hasDataToRemove, fdcrResources, flightInfo);
            progressCallback.endSubtask();
         }
      } finally {
         // In case of error, local diagnosis must be processed without FDCR data
         try {
            setAllNotYetStartedDiagnosisToReady(aircraft.getId(), flightIds.values());
         } catch (Exception e) {
            LOGGER.warn("FDCR analysis: unexpected error while updating Local Diagnosis statuses", e);
            gotEjbException |= isServerShutdownException(e);
         }
      }

      return new FdcrAnalysisResult(gotEjbException);
   }

   private void prepareForLocalDiagnosisIfNecessary(Aircraft aircraft, final boolean hasDataToRemove, final Map<String, Resource> fdcrResources, FlightInformationHandler flightInfo) {
      AircraftConfiguration applicableConfiguration = flightInfo.getApplicableConfiguration();
      final LocalDiagnosisConfiguration localDiagnosisConfiguration = (LocalDiagnosisConfiguration) applicableConfiguration.getConfigurations().get(LocalDiagnosisConfiguration.TYPE);
      final boolean hasLocalDiag = featureManager.isEnabled(applicableConfiguration.getAvionicVersion(), FeatureName.LOCAL_DIAGNOSIS) && localDiagnosisConfiguration != null;
      final DiagnosisData diagnosisData = getDiagnosisByAircraftAndFlight(aircraft.getId(), flightInfo.getTechnicalId());
      final boolean hasMntData = diagnosisData != null;
      if (hasLocalDiag && hasMntData && hasDataToRemove && localDiagnosisConfiguration.isFdcrDataNeeded()) {
         copyFdcrDataForLocalDiag(flightInfo, applicableConfiguration.getAvionicVersion().getId(), fdcrResources, diagnosisData.getFolderName());
         diagnosisData.setStatus(diagnosisData.mustBeStartedImmediately() ? DiagnosisStatus.READY : DiagnosisStatus.PENDING);
      }
   }

   private void setAllNotYetStartedDiagnosisToReady(String aircraftId, Collection<String> flightIds) {
      for (String flightId : flightIds) {
         final DiagnosisData diagnosisData = getDiagnosisByAircraftAndFlight(aircraftId, flightId);
         if (diagnosisData == null) {
            continue;
         }
         if (DiagnosisStatus.NOT_YET_STARTED.equals(diagnosisData.getStatus())) {
            diagnosisData.setStatus(diagnosisData.mustBeStartedImmediately() ? DiagnosisStatus.READY : DiagnosisStatus.PENDING);
         }
      }
   }

   private void copyFdcrDataForLocalDiag(FlightInformationHandler flightInfo, String avionicVersionId, Map<String, Resource> flightFdcrResources, String destinationFolderName) {
      ISftpService sftpService;
      try {
         sftpService = (ISftpService) new InitialContext().lookup(ISftpService.class.getName() + "#" + ISftpService.class.getName());
      } catch (NamingException e) {
         LOGGER.error("Unable to find FTP service", e);
         addError(MgsComputingErrorReason.LOCAL_DIAG_FTP_SERVICE_UNREACHABLE, flightInfo, avionicVersionId);
         // Call local diag without FDCR files
         return;
      }

      try {
         if (flightFdcrResources != null && !flightFdcrResources.isEmpty()) {
            sftpService.store(flightFdcrResources, destinationFolderName, "FDCR");
         }
      } catch (IOException | URISyntaxException e) {
         LOGGER.error("An internal error has occurred. Local diagnosis will be processed without FDCR data", e);
         addError(MgsComputingErrorReason.LOCAL_DIAG_FTP_SERVICE_UNREACHABLE, flightInfo, avionicVersionId);
      }
   }

   private DiagnosisData getDiagnosisByAircraftAndFlight(String aircraftId, String flightId) {
      TypedQuery<DiagnosisData> diagnosesQuery = manager.createNamedQuery("findDiagnosisByAircraftAndFlight", DiagnosisData.class);
      diagnosesQuery.setParameter("aircraftId", aircraftId);
      diagnosesQuery.setParameter("flightId", flightId);
      return diagnosesQuery.getResultList().isEmpty() ? null : diagnosesQuery.getResultList().get(0);
   }

   private FdcrAnalysisResult analyzeFlight(Aircraft aircraft, FlightInformationHandler flightInfo, Map<String, Resource> fdcrResources, File sourceFolder, String aircraftFolderName,
         ITaskProgressCallback progressCallback) {
      final AircraftConfiguration latestConfiguration = flightInfo.getLatestConfiguration();
      final AvionicVersion lastAvionicVersion = latestConfiguration.getAvionicVersion();
      final FdcrDecPreferenceBean fdcrRemovedParametersPreference = parameterManager.getFdcrRemovedParametersPreference(lastAvionicVersion.getId());

      if (fdcrRemovedParametersPreference == null || (fdcrResources == null || fdcrResources.isEmpty())) {
         // Nothing to do
         return new FdcrAnalysisResult(false);
      }
      Map<String, Resource> filteredResources = filterFdcrResources(fdcrResources);
      if (!fdcrRemovedParametersPreference.getStructures().isEmpty()) {
         // Delete unused channel files from temp_data_collection folder in case of FDCR data removal
         Map<String, Resource> resourcesToDelete = new HashMap<>();
         for (Entry<String, Resource> entry : fdcrResources.entrySet()) {
            if (!filteredResources.containsKey(entry.getKey())) {
               resourcesToDelete.put(entry.getKey(), entry.getValue());
            }
         }
         deleteFdcrDataForFlight(sourceFolder, aircraftFolderName, resourcesToDelete);
      }
      fdcrResources.clear();
      fdcrResources.putAll(filteredResources);
      if (fdcrResources.isEmpty()) {
         LOGGER.warn("No FDCR resources to process for flight {}", flightInfo.getFlightId());
         // Nothing to do
         return new FdcrAnalysisResult(false);
      }

      try {
         LOGGER.info("Begin analysis of flight {}", flightInfo.getFlightId());
         return processFdcr(aircraft, flightInfo, fdcrResources, sourceFolder, aircraftFolderName, progressCallback);
      } catch (final Exception e) {
         LOGGER.error("Exception when processing FDCR", e);
         if (isServerShutdownException(e)) {
            return new FdcrAnalysisResult(true);
         }
         String avionicVersionId = latestConfiguration.getAvionicVersion().getId();
         MgsComputingErrorReason reason = MgsComputingErrorReason.FDCR_DECODING_ERROR;
         if (e instanceof MgsComputingException mgsComputingException) {
            // More accurate reason
            reason = mgsComputingException.getReason();
         }
         addError(reason, flightInfo, avionicVersionId);
      } finally {
         final FdcrConfiguration fdcrConfiguration = (FdcrConfiguration) flightInfo.getApplicableConfiguration().getConfigurations().get(FdcrConfiguration.TYPE);
         if (fdcrConfiguration != null) {
            flightInfo.setFdcrDataPresent(true);
         }
         manager.flush();
         manager.clear();
         LOGGER.info("End analysis of flight {}", flightInfo.getFlightId());
      }
      return new FdcrAnalysisResult(false);
   }

   private Map<String, Resource> filterFdcrResources(Map<String, Resource> fdcrResources) {
      ChannelParameters channelParameters = parameterManager.getChannelParameters();
      ChannelResourceOrganizer channelResourceOrganizer = new ChannelResourceOrganizer();
      Map<String, Map<String, Resource>> resourcesByChannel = channelResourceOrganizer.organizeByChannel(fdcrResources);
      for (ChannelBean channel : channelParameters.getChannels()) {
         if (resourcesByChannel.get(channel.getName()) != null && !resourcesByChannel.get(channel.getName()).isEmpty()) {
            return resourcesByChannel.get(channel.getName());
         }
      }

      if (resourcesByChannel.get(ChannelResourceOrganizer.EMPTY_CHANNEL) != null) {
         return resourcesByChannel.get(ChannelResourceOrganizer.EMPTY_CHANNEL);
      }
      return Collections.emptyMap();
   }

   private void performDataCollection(File sourceFolder, File targetFolder, Set<String> aircraftFolderFilter, ITaskProgressCallback taskCallback) throws IOException {
      List<File> fdcrFolders = FeatureIdUtils.getFoldersByFeatureId(sourceFolder, FeatureId.FDCR);
      taskCallback.forecastSteps(fdcrFolders.size());
      for (File fdcrFolder : fdcrFolders) {
         if (fdcrFolder.isDirectory() && fdcrFolder.list().length == 0) {
            taskCallback.stepDone();
            continue;
         }
         File flightNumberFolder = fdcrFolder.getParentFile();
         File aircraftFolder = flightNumberFolder.getParentFile();
         if (aircraftFolderFilter != null && !aircraftFolderFilter.contains(aircraftFolder.getName())) {
            taskCallback.stepDone();
            continue;
         }
         String targetPath = targetFolder.getAbsolutePath() + "/" + sourceFolder.getName() + "/" + aircraftFolder.getName();
         File targetDirectory = new File(targetPath, flightNumberFolder.getName());
         if (!targetDirectory.exists() && !targetDirectory.mkdirs()) {
            LOGGER.warn("Unable to create directory {}. FDCR data for Aircraft {} and Flight {} will not be data collected.",
                  targetDirectory, aircraftFolder.getName(), flightNumberFolder.getName());
            taskCallback.stepDone();
            continue; // Others FDCR folders must be data collected
         }
         ZipUtils.zipUncompressed(new File(targetDirectory, FeatureId.FDCR.getFeatureFolder() + ".zip"), fdcrFolder);
         taskCallback.stepDone();
      }
   }

   /**
    * Process fdcr.
    * 
    * @param resources
    *           the resources
    * @throws EntityNotFoundException
    *            the entity not found exception
    * @throws NotificationException
    */
   private FdcrAnalysisResult processFdcr(final Aircraft aircraft, final FlightInformationHandler flightInfo, final Map<String, Resource> resources, final File sourceFolder,
         String aircraftFolderName, ITaskProgressCallback progressCallback)
         throws MgsComputingException {
      final AircraftConfiguration applicableConfiguration = flightInfo.getApplicableConfiguration();
      final AircraftConfiguration latestConfiguration = flightInfo.getLatestConfiguration();
      final AvionicVersion avionicVersion = applicableConfiguration.getAvionicVersion();
      final AvionicVersion lastAvionicVersion = latestConfiguration.getAvionicVersion();
      final FdcrConfiguration fdcrConfiguration = (FdcrConfiguration) applicableConfiguration.getConfigurations().get(FdcrConfiguration.TYPE);
      final DmauVersion dmauVersion = latestConfiguration.getDmauVersion();

      final FdcrDecPreferenceBean fdcrRemovedParametersPreference = parameterManager.getFdcrRemovedParametersPreference(lastAvionicVersion.getId());

      if (fdcrConfiguration == null) {
         if (fdcrRemovedParametersPreference != null && !fdcrRemovedParametersPreference.getStructures().isEmpty()) {
            deleteFdcrDataForFlight(sourceFolder, aircraftFolderName, resources);
         }
         return new FdcrAnalysisResult(false);
      }

      // Check software version
      final Map<Integer, List<String>> fdcrSwVersions = parameterManager.getSoftwareVersions(lastAvionicVersion.getId()).getFdcrSwVersions();

      final IObservable<FdcrMessage> fdcrData;
      final IFdcrCigalheDecoder decoder;
      try {
         decoder = processorFactory.getProcessor(lastAvionicVersion, IFdcrCigalheDecoder.class);
         fdcrData = decoder.decode(resources, fdcrConfiguration, fdcrRemovedParametersPreference, aircraft.getFdcrPartitions(), fdcrSwVersions);
      } catch (final DecodingException e) {
         LOGGER.error("Decoding error", e);
         throw new MgsComputingException(MgsComputingErrorReason.FDCR_DECODING_ERROR, e);
      }

      if (flightInfo.acceptFdcrData()) {
         final IFdcrAnalyzer analyzer = analyzerFactory.getAnalyzer(IFdcrAnalyzer.class);
         analyzer.analyze(aircraft, flightInfo.getUnderlyingFlight(), fdcrData, fdcrConfiguration, fdcrDataWriter);
      }

      if (flightInfo.acceptHfdmDataCollection()) {
         final boolean active = Boolean.parseBoolean(parameterManager.getConfigurationProperty(MgsConfigurationKey.FDCR_HFDM_ENABLED.getKey()));
         if (active) {
            try {
               hfdmCollectionManager.collect(aircraft, avionicVersion, fdcrConfiguration, flightInfo.getFlightId(), flightInfo.getFlightDate(), fdcrData);
            } catch (final FolderDataCollectionException e) {
               LOGGER.error("HFDM error", e);
               throw new MgsComputingException(MgsComputingErrorReason.FDCR_DATA_COLLECTION_ERROR, e);
            }
         }
      }

      if (flightInfo.acceptEngineDataCollection()) {
         final boolean active = Boolean.parseBoolean(parameterManager.getConfigurationProperty(MgsConfigurationKey.ENGINE_DATA_COLLECTION_ACTIVATION.getKey()));
         if (active && featureManager.isEnabled(avionicVersion, FeatureName.ENGINE_DATA_COLLECTION) && dmauVersion != null && dmauVersion.hasEngineData()) {
            DataContext engineDataContext = engineDataCollectionManager.initDataContext(aircraft, flightInfo.getFlightId(), flightInfo.getFlightDate(), flightInfo.getDownloadDate());
            try {
               FdcrDecPreferenceBean dataCollectionPreferences = parameterManager.getEngineDataCollectionFdcrPreference(avionicVersion.getId());
               engineDataCollectionManager.collectFdcr(engineDataContext, avionicVersion, fdcrData, dataCollectionPreferences, fdcrConfiguration);
            } catch (final FolderDataCollectionException e) {
               LOGGER.warn("Unable to perform engine data collection", e);
            }
         }
      }

      try {
         fdcrData.loop(progressCallback);
         if (!decoder.needToDataCollect()) {
            deleteFdcrDataForFlight(sourceFolder, aircraftFolderName, resources);
         }
      } catch (final Exception ex) {
         if (isServerShutdownException(ex)) {
            return new FdcrAnalysisResult(true);
         }
         LOGGER.error("FDCR analysis: error while decoding FDCR data", ex);
         addError(MgsComputingErrorReason.FDCR_DECODING_ERROR, flightInfo, lastAvionicVersion.getId());
         if (fdcrRemovedParametersPreference != null && !fdcrRemovedParametersPreference.getStructures().isEmpty()) {
            deleteFdcrDataForFlight(sourceFolder, aircraftFolderName, resources);
         }
      }
      return new FdcrAnalysisResult(false);
   }

   private void deleteFdcrDataForFlight(File sourceFolder, String aircraftFolderName, Map<String, Resource> flightFdcrResources) {
      Set<String> filesToDelete = flightFdcrResources.keySet();
      for (File file : FileUtils.listFiles(new File(sourceFolder, aircraftFolderName), new String[] { "fdc" }, true)) {
         // The key in fdcrResources Map is as follow: folder name in upper case + "/" + file name in original case
         // We have to follow this naming in order to correctly remove entry in fdcrResources Map
         // @see ResourceOganizer#organizeByAircraftAndPartition() for more information
         String fileToDelete = file.getParentFile().getName().toUpperCase() + "/" + file.getName();
         for (String path : filesToDelete) {
            if (!path.equalsIgnoreCase(fileToDelete)) {
               continue;
            }
            FileUtils.deleteQuietly(file);
            flightFdcrResources.remove(fileToDelete);
            if (file.getParentFile().isDirectory() && file.getParentFile().list().length == 0) {
               FileUtils.deleteQuietly(file.getParentFile());
            }
            break;
         }
      }
   }

   private Aircraft findAircraftBySubtype(String subtype, String aircraftId, Date date) throws EntityNotFoundException {
      final TypedQuery<Aircraft> aircraft = manager.createNamedQuery("findAircraftByFileName", Aircraft.class);
      aircraft.setParameter("subtype", subtype);
      aircraft.setParameter("aircraftId", aircraftId);
      aircraft.setParameter("date", date);
      List<Aircraft> result = aircraft.getResultList();
      if (result == null || result.isEmpty()) {
         throw new EntityNotFoundException("Unknown aircraft: subtype=" + subtype + ", aircraftId=" + aircraftId);
      }
      return result.get(0);
   }

   private void addError(MgsComputingErrorReason reason, FlightInformationHandler flightInfo, String avionicVersionId) {
      if (flightInfo.acceptAlarms()) {
         mgsComputingUtils.createAlarmIfNotAlreadyExists(reason.getErrorCode(), flightInfo.getUnderlyingFlight(), avionicVersionId);
      }
   }

   private boolean hasFdcrFeature(AvionicVersion avionicVersion) {
      for (Feature feature : avionicVersion.getFeatures()) {
         if (feature.getFeature().equals(FeatureName.FDCR)) {
            return true;
         }
      }
      return false;
   }

   private static final class FdcrAnalysisResult {

      private final boolean ejbExceptionPresent;

      public FdcrAnalysisResult(boolean ejbExceptionPresent) {
         this.ejbExceptionPresent = ejbExceptionPresent;
      }
   }
}

