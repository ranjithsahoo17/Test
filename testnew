
package com.eurocopter.mgs.presentation.configuration.preferences.healthalarms;

import org.eclipse.swt.SWT;
import org.eclipse.swt.layout.GridData;
import org.eclipse.swt.layout.GridLayout;
import org.eclipse.swt.widgets.Composite;
import org.eclipse.swt.widgets.Control;
import org.eclipse.ui.IWorkbench;

import com.eurocopter.mgs.core.presentation.i18n.Messages;
import com.eurocopter.mgs.presentation.configuration.preferences.pages.MgsPreferencePage;
import com.eurocopter.mgs.presentation.configuration.store.MgsPreferenceStoreComposer;

/**
 *
 * Health Alarm Preference Page in the Work Cards.
 * <P>
 *
 */
public class HealthAlarmsPreferencePage extends MgsPreferencePage {

   private HealthAlarmsComposite hac;

   /** Store. */
   private final MgsPreferenceStoreComposer store = new MgsPreferenceStoreComposer();

   /**
    * Default constructor. Builds a HealthAlarmsPreferencePage.
    */
   public HealthAlarmsPreferencePage() {
      super(Messages.CORE.getMnemonicEscapedString("AircraftConfigurationSection_health"), GRID);
   }

   @Override
   protected Control createContents(Composite parent) {
      Composite composite = new Composite(parent, SWT.NONE);
      composite.setLayout(new GridLayout(1, false));
      composite.setLayoutData(new GridData(SWT.FILL, SWT.FILL, true, true, 1, 1));

      composite.setLayout(new GridLayout(1, false));
      composite.setLayoutData(new GridData(SWT.FILL, SWT.FILL, true, true, 1, 1));

      hac = new HealthAlarmsComposite(store, composite);
      setTitle(Messages.CORE.getString(getTitle()));
      return hac;
   }

   @Override
   public void init(IWorkbench workbench) {
      setPreferenceStore(store);
   }

   @Override
   public void performDefaults() {
      if (hac.isValidData()) {
         hac.performDefaults();
         super.performDefaults();
      }
   }

   @Override
   public boolean performCancel() {
      hac.performCancel();
      return super.performCancel();
   }

   @Override
   public void performApply() {
      if (hac.isValidData()) {
         hac.performApply();
         super.performApply();
      }
   }

   @Override
   public boolean performOk() {
      boolean result = false;
      if (hac.isValidData()) {
         result = super.performOk();
      }
      return result;
   }

   @Override
   public void checkState() {
      setValid(true);
      super.checkState();
   }
}
