   @Override
   public boolean hasReadIndicators(String aircraftId, String mechanicalComponentId) {
      HealthMonitoringConfiguration healthConfiguration;
      try {
         healthConfiguration = healthDao.getLatestConfiguration(aircraftId);
      } catch (EntityNotFoundException e) {
         return false;
      }
      HealthMechanicalComponent healthMechanicalComponent = manager.find(HealthMechanicalComponent.class, mechanicalComponentId);
      if (!healthConfiguration.getMechanicalComponentConfigurations().containsKey(healthMechanicalComponent)) {
         return false;
      }
      HealthMechanicalComponentConfiguration mechanicalComponentConfiguration = healthConfiguration.getMechanicalComponentConfigurations().get(healthMechanicalComponent);
      for (IndicatorConfiguration indicatorConfiguration : mechanicalComponentConfiguration.getIndicatorConfigurations().values()) {
         if (indicatorConfiguration.getHealthAlgorithm() == HealthAlgorithm.Read) {
            return true;
         }
      }
      return false;
   }

   private Set<String> getActiveThresholdIds(String aircraftId) throws EntityNotFoundException {
      Set<String> result = new HashSet<>();
      for (HealthMechanicalComponentConfiguration mcc : getLatestConfiguration(aircraftId).getMechanicalComponentConfigurations().values()) {
         for (IndicatorConfiguration ic : mcc.getIndicatorConfigurations().values()) {
            for (ThresholdConfiguration tc : ic.getThresholdConfigurations()) {
               result.add(tc.getId());
            }
         }
      }
      return result;
   }

   private Map<Indicator, String> getIndicatorFromThreshold(Aircraft aircraft, Threshold threshold) {
      Map<Indicator, String> indicatorPath = new HashMap<>(1);
      for (HealthMechanicalComponent component : aircraft.getHealthComponents()) {
         for (Entry<String, Indicator> entry : component.getIndicators().entrySet()) {
            if (entry.getValue().getThresholds().contains(threshold)) {
               indicatorPath.put(entry.getValue(), component.getPath());
            }
         }
      }
      return indicatorPath;
   }

   private Set<HealthConfigurationBounds> getConfigurationBounds(String aircraftId) {
      Date maxDate = null;
      Set<HealthConfigurationBounds> boundSet = new HashSet<>();

      TypedQuery<Object[]> query = manager.createNamedQuery("findConfigurationByType", Object[].class);
      query.setParameter("id", aircraftId);
      query.setParameter("type", HealthMonitoringConfiguration.class);
      List<Object[]> configurations = query.getResultList();
      for (Object[] configurationArray : configurations) {
         HealthMonitoringConfiguration configuration = (HealthMonitoringConfiguration) configurationArray[0];
         AircraftConfiguration aircraftConfiguration = (AircraftConfiguration) configurationArray[1];
         Date applicableDate = aircraftConfiguration.getApplicableDate();

         HealthConfigurationBounds bounds = new HealthConfigurationBounds();
         bounds.setHealthMonitoringConfiguration(configuration);
         if (maxDate == null) {
            // Last configuration (= first iteration)
            bounds.setStartDate(applicableDate);
            bounds.setEndDate(null);
            boundSet.add(bounds);
            maxDate = applicableDate;
         } else if (applicableDate.before(maxDate)) {
            bounds.setStartDate(applicableDate);
            bounds.setEndDate(maxDate);
            boundSet.add(bounds);
            maxDate = applicableDate;
         }
      }
      return boundSet;
   }

