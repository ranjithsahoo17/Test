@Local
@Stateless
public class MarmsDownloadManager extends DownloadManager {

   /** Class logger. */
   private static final Logger LOGGER = LogManager.getLogger(MarmsDownloadManager.class);

   @EJB
   private ParameterManager parameterManager;

   @EJB
   private ProgressManager progressManager;

   @EJB
   private FeatureManager featureManager;

   @EJB
   private AsyncQueue asyncQueue;

   @EJB
   private AircraftLockManager aircraftLockManager;

   private final FlightDecoder flightDecoder = new FlightDecoder();

   private final AnalyzerFactory analyzerFactory = new AnalyzerFactory();

   private final RtbDelegate rtbDelegate = new RtbDelegate();

   @SuppressWarnings({ "deprecation" })
   public Multimap<String, String> download(final MarmsDownloadBundle bundle, final Context context, Date downloadDate, ExceptionHandler exceptionHandler, DownloadMode downloadMode)
         throws NotificationException {
      Aircraft lastAircraft = null;
      Multimap<String, String> aircraftDownloads = ArrayListMultimap.create();

      for (final AircraftIdentifier aircraftKey : bundle.getAircraftIds()) {
         final Optional<Aircraft> optionalAircraft = aircraftDao.findByAircraftIdAndSerialNumber(aircraftKey.aircraftType(), aircraftKey.aircraftId(), aircraftKey.aircraftSerialNumber())
               .or(() -> aircraftDao.findByAircraftSerialNumber(aircraftKey.aircraftType(), aircraftKey.aircraftSerialNumber()))
               .or(() -> aircraftDao.findByAircraftId(aircraftKey.aircraftType(), aircraftKey.aircraftId()));
         if (optionalAircraft.isEmpty()) {
            exceptionHandler.addAircraftError(new AircraftError(null, AircraftErrorType.AIRCRAFT_NOT_MANAGED, aircraftKey.aircraftType(), aircraftKey.aircraftId()));
            // If the A/C is not managed, go straight to the next aircraft
            continue;
         }

         Aircraft aircraft = optionalAircraft.get();
         if (aircraft.getAircraftState() == AircraftState.DELETED) {
            exceptionHandler.addAircraftError(new AircraftError(null, AircraftErrorType.AIRCRAFT_NOT_MANAGED, aircraftKey.aircraftType(), aircraftKey.aircraftId()));
            continue;
         }

         if (aircraft.getAircraftState() == AircraftState.FROZEN) {
            exceptionHandler.addAircraftError(new AircraftError(aircraft, AircraftErrorType.AIRCRAFT_FROZEN, aircraft.getRegisterNumber()));
            // If the A/C is frozen, go straight to the next aircraft
            continue;
         }

         // Lock the A/C while the download unfolds
         final String aircraftId = aircraft.getId();
         try {
            aircraftLockManager.lock(aircraftId, LockCause.DOWNLOAD);
         } catch (final AircraftConcurrentAccessException e) {
            LOGGER.debug("Aircraft locked", e);
            String lockCause = e.getAircraftLock() != null && e.getAircraftLock().getLockCause() != null ? e.getAircraftLock().getLockCause().name() : LockCause.NONE.name();
            exceptionHandler.addAircraftError(new AircraftError(aircraft, AircraftErrorType.AIRCRAFT_LOCKED, lockCause));
            // If the A/C is locked, go straight to the next aircraft
            continue;
         }

         final List<Folder> folders = new ArrayList<>();

         // "try-finally" block to unlock the A/C for sure once the download has ended
         try {
            final Download download = new Download(UUID.randomUUID().toString());
            download.setDownloadDate(downloadDate);
            // Save the download operation in database
            aircraft.getDownloads().add(download);

            final String downloadId = download.getId();

            manager.flush();
            manager.clear();

            LOGGER.info("Download flights for A/C: {}", aircraft.getRegisterNumber());
            AircraftExceptionHandler handler = exceptionHandler.getExceptionHandler(aircraft);

            Map<Integer, FlightData> flightDataMap = new HashMap<>();

            long startTime = System.currentTimeMillis();

            Set<String> rawDataFilenames = new HashSet<>();

            AircraftConfiguration lastAircraftConfiguration = null;
            MarmsOrganizedResources organizedResources = bundle.getResources(aircraftKey);
            List<MarmsResource> resources = organizedResources.resources();
            resources.stream()
                  .filter(r -> r.getType() == MarmsResourceType.RAW)
                  .map(MarmsResource::getName)
                  .forEach(rawDataFilenames::add);

            List<AcmsResource> acmsResources = resources.stream()
                  .filter(r -> r.getType() == MarmsResourceType.ACMS)
                  .map(AcmsResource.class::cast)
                  .toList();
            for (AcmsResource acmsResource : acmsResources) {
               AcmsHeader header = acmsResource.header();

               Optional<AircraftConfiguration> optionalLastAircraftConfiguration = configurationDao.findLatestConfiguration(aircraftId);
               if (optionalLastAircraftConfiguration.isPresent()) {
                  lastAircraftConfiguration = optionalLastAircraftConfiguration.get();
               } else {
                  handler.addDownloadError(
                        new DownloadError(AnalysisStep.INIT, Avionic.MARMS,
                              createFlightForDownloadError(header.getSessionNumber(), header.getDate()),
                              "Aircraft Configuration not found for aircraft id: " + aircraft.getId()));
                  // There is nothing else that can be done, we have to stop flight analysis at this point
                  continue;
               }

               // Check ACMS Version
               String currentAcmsVersion = header.getAvionicVersion();
               String correspondingAcmsVersion = null;
               for (AcmsVersionJaxb acmsVersion : parameterManager.getAcmsVersion(aircraft.getAircraftType().getName()).getSupportedVersion()) {
                  if (currentAcmsVersion.compareTo(acmsVersion.getMinVersion()) >= 0 && currentAcmsVersion.compareTo(acmsVersion.getMaxVersion()) <= 0) {
                     correspondingAcmsVersion = acmsVersion.getVersion();
                     break;
                  }
               }
               if (correspondingAcmsVersion == null) {
                  String avionicVersionId = header.getAircraftType() + "-" + currentAcmsVersion.replaceAll("^0*", "").replaceAll("0*$", "").replace("0", ".");
                  String errorMessage = "Invalid ACMS version (binary file is " + avionicVersionId + " while MGS known version is " + lastAircraftConfiguration.getAvionicVersion().getId() + ")";
                  LOGGER.error(errorMessage);
                  handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.MARMS_UNSUPPORTED_ACMS_VERSION, Avionic.MARMS,
                        getOrCreateFlightForComputingError(aircraft.getId(), header.getSessionNumber(), header.getDate(), download.getId()),
                        errorMessage, true));
                  continue;
               }

               // Check Avionic Version
               String avionicVersionId = header.getAircraftType() + "-" + correspondingAcmsVersion;
               if (!lastAircraftConfiguration.getAvionicVersion().getId().equals(avionicVersionId)) {
                  String errorMessage = "Invalid ACMS version (binary file is " + avionicVersionId + " while MGS known version is " + lastAircraftConfiguration.getAvionicVersion().getId() + ")";
                  LOGGER.error(errorMessage);
                  handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.MARMS_INVALID_ACMS_VERSION, Avionic.MARMS,
                        getOrCreateFlightForComputingError(aircraft.getId(), header.getSessionNumber(), header.getDate(), download.getId()),
                        errorMessage, true));
                  continue;
               }

               final DownloadData downloadDatum;
               try {
                  downloadDatum = flightDecoder.decode(acmsResource.resource(), header, lastAircraftConfiguration.getAvionicVersion().getId());
               } catch (final CrcCheckException e) {
                  String msg = "CRC check failed in MARMS data";
                  LOGGER.error(msg, e);
                  handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.MARMS_CRC_DECODING_ERROR, Avionic.MARMS,
                        getOrCreateFlightForComputingError(aircraft.getId(), header.getSessionNumber(), header.getDate(), download.getId()),
                        "CRC check failed in MARMS data", true));
                  manager.flush();
                  continue;
               } catch (final ConversionException e) {
                  String msg = "Could not decode MARMS data";
                  LOGGER.error(msg, e);
                  handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.MARMS_DATA_DECODING_ERROR, Avionic.MARMS,
                        getOrCreateFlightForComputingError(aircraft.getId(), header.getSessionNumber(), header.getDate(), download.getId()),
                        "Could not decode MARMS data", true));
                  manager.flush();
                  continue;
               }

               for (final FlightData flightData : downloadDatum.flights()) {
                  LOGGER.info("Download flight: {} ({})", flightData.flightId(), flightData.startDate());
                  FlightData otherFlightData = flightDataMap.get(flightData.flightId());
                  if (otherFlightData != null && otherFlightData.startDate().equals(flightData.startDate())) {
                     // At least one flight is an SNDE flight
                     // The doubloon check for the non SNDE flights is make by the client
                     String details = String.format("SNDE flight %1s is duplicated for aircraft %2s", flightData.flightId(), aircraft.getRegisterNumber());
                     LOGGER.error(details);
                     handler.addMgsComputingError(new MgsComputingError(
                           MgsComputingErrorReason.DUPLICATED_SNDE_FLIGHT, Avionic.MARMS,
                           getOrCreateFlightForComputingError(aircraft.getId(), header.getSessionNumber(), header.getDate(), download.getId()),
                           details, true));
                     continue;
                  }
                  flightDataMap.put(flightData.flightId(), flightData);
                  processFlight(aircraftId, flightData, downloadId, context, handler);
               }

               manager.flush();
               manager.clear();
            }

            if (!rawDataFilenames.isEmpty() && lastAircraftConfiguration != null && featureManager.isEnabled(lastAircraftConfiguration.getAvionicVersion(), FeatureName.RAW_DATA_FILTERING)
                  && lastAircraftConfiguration.getConfigurations().containsKey(RawDataFilteringConfiguration.TYPE)) {
               asyncQueue.addTask(new RawDataFilteringRequest(aircraftId, bundle.getFolder().getName(), rawDataFilenames));
            }

            List<MgsComputingError> mgsComputingErrors = handler.buildComputingError();
            if (!mgsComputingErrors.isEmpty()) {
               processMgsComputingErrors(aircraftId, downloadId, mgsComputingErrors, handler);
            }

            long endTime = System.currentTimeMillis();

            if (handler.buildComputingError().isEmpty() && handler.buildResult().isEmpty()) {
               LOGGER.info("Download flights completed without error in {}ms", (endTime - startTime));
            } else {
               LOGGER.info("Download flights completed with error in {}ms", (endTime - startTime));
               LOGGER.info("MGS computing error(s) {}", handler.buildComputingError());
               LOGGER.info("MGS download error(s) {}", handler.buildResult());
            }

            aircraft = manager.find(Aircraft.class, aircraftId);
            aircraft.getFolders().size();
            for (String folderName : organizedResources.parentFolderNames()) {
               Folder folder = new Folder(UUID.randomUUID().toString());
               folder.setName(folderName);
               folder.setDownloadMode(downloadMode);
               folder.setAircraftId(aircraft.getId());
               aircraft.getFolders().add(folder);
               folders.add(folder);
            }
            manager.persist(aircraft);
            manager.flush();
            manager.clear();

            // Update aircraft status according to raised alarms
            aircraftDao.updateAircraftStatus(aircraftId);

            manager.flush();
            manager.clear();

            notifyAircraftUpdated(aircraft.getId());
            notificationService.notifyFolderActions(folders, Action.CREATION);

            aircraftDownloads.put(aircraftId, downloadId);
            lastAircraft = aircraft;
         } finally {
            // Unlock the A/C after the download has ended
            aircraftLockManager.unlock(aircraftId);
         }
      }

      progressManager.notifyProgress(context, new DownloadProgressDto(lastAircraft, null), Progress.END);

      return aircraftDownloads;
   }

   private void processFlight(final String aircraftId, final FlightData flightDto, final String downloadId, final Context context, final AircraftExceptionHandler handler)
         throws NotificationException {
      Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      Download download = getDownload(aircraft, downloadId);
      final Flight existingFlight = findFlight(aircraft, flightDto.flightId(), flightDto.startDate());
      final Optional<AircraftConfiguration> optionalAircraftConfiguration = configurationDao.findConfiguration(aircraftId, flightDto.startDate());

      // Retrieve the last aircraft configuration
      final AircraftConfiguration latestAircraftConfiguration = configurationDao.findLatestConfiguration(aircraftId).get();

      final AircraftConfiguration applicableAircraftConfiguration;
      final AvionicVersion applicableAvionicVersion;
      if (optionalAircraftConfiguration.isPresent()) {
         applicableAircraftConfiguration = optionalAircraftConfiguration.get();

         applicableAvionicVersion = applicableAircraftConfiguration.getAvionicVersion();
         AvionicVersion latestAvionicVersion = latestAircraftConfiguration.getAvionicVersion();
         if (!latestAvionicVersion.equals(applicableAvionicVersion)) {
            String errorMessage = "Applicable configuration does not match the current one (applicable = " + applicableAvionicVersion.getId() + ", current = " + latestAvionicVersion.getId() + ")";
            LOGGER.error(errorMessage);
            handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.INVALID_APPLICABLE_CONFIGURATION, Avionic.MARMS,
                  getOrCreateFlightForComputingError(aircraft.getId(), flightDto.flightId(), flightDto.startDate(), download.getId()),
                  errorMessage, true));
            // There is nothing else that can be done, we have to stop flight analysis at this point
            return;
         }
      } else {
         DateFormat dateTimeFormat = DateFormat.getDateTimeInstance(DateFormat.SHORT, DateFormat.DEFAULT);
         dateTimeFormat.setTimeZone(TimeZone.getTimeZone("GMT"));
         String errorMessage = "Flight date may be invalid (" + dateTimeFormat.format(flightDto.startDate()) + ")";
         LOGGER.error("Error while downloading flight {}: {}", flightDto.flightId(), errorMessage);
         handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.INVALID_FLIGHT_DATE, Avionic.MARMS,
               getOrCreateFlightForComputingError(aircraft.getId(), flightDto.flightId(), flightDto.startDate(), download.getId()),
               errorMessage, true));
         // There is nothing else that can be done, we have to stop flight analysis at this point
         return;
      }

      Flight flight;
      try {
         flight = addOrReplaceFlight(aircraft, flightDto, download);
      } catch (MgsComputingException e) {
         LOGGER.error("Error during deletion of previous flight", e);
         handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.FLIGHT_DELETION_ERROR,
               Avionic.MARMS, getOrCreateFlightForComputingError(aircraft.getId(), flightDto.flightId(), flightDto.startDate(), download.getId()),
               e.getCause() != null ? e.getCause().getMessage() : e.getMessage()));
         return;
      }

      flight.setConfigurationSerialNumber(applicableAircraftConfiguration.getSerialNumber());

      String tableName = "signal_" + flight.getId().replace('-', '_');
      manager.createNativeQuery("CREATE TABLE IF NOT EXISTS " + tableName + " PARTITION OF signal FOR VALUES IN ('" + flight.getId() + "')").executeUpdate();

      final String flightTechnicalId = flight.getId();

      try {
         manager.flush();
         manager.clear();
      } catch (Exception e) {
         LOGGER.debug("Unable to flush entity manager", e);
         handler.addDownloadError(new DownloadError(AnalysisStep.INIT, Avionic.CIGALHE, flight, "An error occurred during database transaction."));
         return;
      }

      if (flightDto.unloaded()) {
         progressManager.notifyProgress(context, new DownloadProgressDto(aircraft, flight), Progress.USAGE);
      }
      boolean usageAnalysisFailed = false;

      long startTime = System.currentTimeMillis();
      try {
         processUsage(aircraftId, flightDto, flightTechnicalId, applicableAircraftConfiguration);
         manager.flush();
      } catch (final Exception e) {
         LOGGER.error("Exception when processing usage", e);
         MgsComputingErrorReason reason = MgsComputingErrorReason.USAGE_PROCESSING_ERROR;
         if (e instanceof MgsComputingException) {
            // More accurate reason
            reason = ((MgsComputingException) e).getReason();
         }
         handler.addMgsComputingError(new MgsComputingError(reason, Avionic.MARMS, flight, e.getCause() != null ? e.getCause().getMessage() : e.getMessage(), true));
         usageAnalysisFailed = true;
      } finally {
         long endTime = System.currentTimeMillis();
         LOGGER.debug("Usage processing done in {}ms", (endTime - startTime));
         manager.clear();
      }

      if (usageAnalysisFailed) {
         // When usage analysis fails, abort the whole flight analysis
         LOGGER.error("Error during usage processing: abort flight download");
         aircraft = manager.find(Aircraft.class, aircraftId);
         if (existingFlight == null) {
            aircraft.getFlights().remove(flight);
         }
         download = getDownload(aircraft, downloadId);
         download.getFlights().remove(flight);
         manager.flush();
         return;
      }

      // Usage analysis succeeded so downloaded flight is OK --> update last download date
      flight = manager.find(Flight.class, flightTechnicalId);
      flight.setLastDownloadDate(download.getDownloadDate());

      if (flightDto.unloaded()) {
         progressManager.notifyProgress(context, new DownloadProgressDto(aircraft, flight), Progress.HEALTH);
         if (featureManager.isHealthEnabled(applicableAvionicVersion)) {
            boolean healthAnalysisFailed = false;

            startTime = System.currentTimeMillis();
            try {
               processHealth(aircraftId, flightDto, flightTechnicalId, applicableAircraftConfiguration);
               manager.flush();
            } catch (final Exception e) {
               LOGGER.error("Exception when processing health", e);
               MgsComputingErrorReason reason = MgsComputingErrorReason.HEALTH_PROCESSING_ERROR;
               if (e instanceof MgsComputingException) {
                  // More accurate reason
                  reason = ((MgsComputingException) e).getReason();
               }
               handler.addMgsComputingError(new MgsComputingError(reason, Avionic.MARMS, flight, e.getCause() != null ? e.getCause().getMessage() : e.getMessage()));
               healthAnalysisFailed = true;
            } finally {
               long endTime = System.currentTimeMillis();
               LOGGER.debug("Health processing done in {}ms", (endTime - startTime));
               manager.clear();
            }

            if (healthAnalysisFailed) {
               LOGGER.error("Error during health processing: process 'grey alarms'");

               startTime = System.currentTimeMillis();
               try {
                  processGreyAlarms(aircraftId, flightTechnicalId, applicableAircraftConfiguration, handler);
                  manager.flush();
               } catch (final RuntimeException e) {
                  LOGGER.debug("Unable to process grey alarms", e);
                  handler.addMgsComputingError(new MgsComputingError(MgsComputingErrorReason.GREY_ALARM_PROCESSING_ERROR, Avionic.MARMS,
                        flight, e.getCause() != null ? e.getCause().getMessage() : e.getMessage()));
               } finally {
                  long endTime = System.currentTimeMillis();
                  LOGGER.debug("Health 'grey alarms' processing done in {}ms", (endTime - startTime));
                  manager.clear();
               }
            }
         }
      }

      if (flightDto.unloaded()) {
         progressManager.notifyProgress(context, new DownloadProgressDto(aircraft, flight), Progress.RTB);
      }

      if (flightDto.unloaded()) {
         progressManager.notifyProgress(context, new DownloadProgressDto(aircraft, flight), Progress.SFM);
      }
      boolean sfmEnabled = featureManager.isEnabled(applicableAvionicVersion, FeatureName.SYSTEM_FAILURE_MANAGEMENT);
      boolean vpuEnabled = featureManager.isEnabled(applicableAvionicVersion, FeatureName.VPU_FAILURES);
      if (sfmEnabled || vpuEnabled) {
         startTime = System.currentTimeMillis();
         try {
            processSfm(aircraftId, flightDto, flightTechnicalId, applicableAircraftConfiguration);
            manager.flush();
         } catch (final Exception e) {
            LOGGER.error("Exception when processing SFM", e);
            MgsComputingErrorReason reason = MgsComputingErrorReason.SFM_PROCESSING_ERROR;
            if (e instanceof MgsComputingException) {
               // More accurate reason
               reason = ((MgsComputingException) e).getReason();
            }
            handler.addMgsComputingError(new MgsComputingError(reason, Avionic.MARMS, flight, e.getCause() != null ? e.getCause().getMessage() : e.getMessage()));
         } finally {
            long endTime = System.currentTimeMillis();
            LOGGER.debug("SFM processing done in {}ms", (endTime - startTime));
            manager.clear();
         }
      }

      boolean dmauEnabled = featureManager.isEnabled(applicableAvionicVersion, FeatureName.DMAU_FAILURES);
      if (dmauEnabled) {
         startTime = System.currentTimeMillis();
         try {
            processDmau(aircraftId, flightDto, flightTechnicalId, applicableAircraftConfiguration);
            manager.flush();
         } catch (final Exception e) {
            LOGGER.error("Exception when processing DMAU failures", e);
            MgsComputingErrorReason reason = MgsComputingErrorReason.DMAU_FAILURE_DECODING_ERROR;
            handler.addMgsComputingError(new MgsComputingError(reason, Avionic.MARMS, flight, e.getCause() != null ? e.getCause().getMessage() : e.getMessage()));
         } finally {
            long endTime = System.currentTimeMillis();
            LOGGER.debug("DMAU failures processing done in {}ms", (endTime - startTime));
            manager.clear();
         }
      }
   }

   private Flight addOrReplaceFlight(final Aircraft aircraft, final FlightData flightDto, final Download download) throws MgsComputingException {
      int flightId = flightDto.flightId();
      Date date = flightDto.startDate();

      Flight existingFlight = findFlight(aircraft, flightId, date);
      if (existingFlight != null) {
         processExistingFlightDeletion(existingFlight);
      }

      Flight flight = new Flight(UUID.randomUUID().toString());
      flight.setFlightId(flightId);
      flight.setDate(date);
      flight.setUnloaded(flightDto.unloaded());

      deleteExistingPurgedFlightIfAny(aircraft, flight);

      aircraft.getFlights().add(flight);
      download.getFlights().add(flight);

      return flight;
   }

   private void processUsage(final String aircraftId, final FlightData flightDto, final String flightTechnicalId, final AircraftConfiguration applicableAircraftConfiguration)
         throws MgsComputingException {
      final Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      final Flight flight = getFlight(aircraft, flightTechnicalId);

      IUsageSession usageData;
      try {
         final UsageConverter usageConverter = new UsageConverter();
         usageData = usageConverter.convert(flightDto, applicableAircraftConfiguration.getAvionicVersion().getUsageFormat());
      } catch (final ConversionException e) {
         LOGGER.error("Could not decode Usage data", e);
         throw new MgsComputingException(MgsComputingErrorReason.USAGE_PROCESSING_ERROR, e);
      }

      List<String> deactivatedAlarms = new ArrayList<>();

      try {
         deactivatedAlarms = parameterManager.getDeactivatedAlarms(applicableAircraftConfiguration.getAvionicVersion().getUsageFormat().getId());
      } catch (final Exception e) {
         LOGGER.error("Error while fetching the deactivated alarms.", e);
         throw new MgsComputingException(MgsComputingErrorReason.USAGE_PROCESSING_ERROR, e);
      }

      try {
         final IUsageAnalyzer usageCigalheAnalyzer = analyzerFactory.getAnalyzer(IUsageAnalyzer.class);
         usageCigalheAnalyzer.analyze(aircraft, flight, applicableAircraftConfiguration, usageData, null, deactivatedAlarms);
      } catch (final AnalysisException e) {
         LOGGER.error("Could not analyze Usage data", e);
         throw new MgsComputingException(MgsComputingErrorReason.USAGE_PROCESSING_ERROR, e);
      }
   }

   private void processHealth(final String aircraftId, final FlightData flightDto, final String flightTechnicalId, final AircraftConfiguration applicableAircraftConfiguration)
         throws MgsComputingException, EntityNotFoundException {
      final Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      final Flight flight = getFlight(aircraft, flightTechnicalId);

      AvionicVersion avionicVersion = applicableAircraftConfiguration.getAvionicVersion();
      if (featureManager.isEnabled(avionicVersion, FeatureName.HEALTH_MONITORING)) {
         IHealthSession healthData;
         try {
            final HealthConverter healthConverter = new HealthConverter();
            healthData = healthConverter.convert(flightDto, avionicVersion);
         } catch (final ConversionException e) {
            LOGGER.error("Could not decode Health data", e);
            throw new MgsComputingException(MgsComputingErrorReason.HEALTH_MONITORING_ANALYSIS_ERROR, e);
         }

         flight.setHealthStartDate(new Date(flight.getUsageStartDate().getTime() + healthData.getGroundStartOffset()));
         flight.setHealthEndDate(new Date(flight.getUsageStartDate().getTime() + healthData.getGroundStartOffset() + healthData.getGroundDuration()));

         HealthErrorHandler errorHandler = new HealthErrorHandler();
         HealthSubsequentFlightHandler healthSubsequentFlightHandler = new HealthSubsequentFlightHandler();

         final Map<HealthMechanicalComponent, HealthMechanicalComponentConfiguration> latestHealthConfig = configurationDao.getLatestHealthMechanicalComponentConfigurations(aircraftId);
         final Map<Indicator, HealthAlarm> latestCloseMonitoredAlarms = findLatestCloseMonitoredAlarms(aircraft);
         try {
            final IHealthMonitoringAnalyzer healthMonitoringAnalyzer = analyzerFactory.getAnalyzer(IHealthMonitoringAnalyzer.class);
            healthMonitoringAnalyzer.analyze(aircraft, flight, applicableAircraftConfiguration, healthData,
                  new HealthHistoryProvider(manager, aircraft, latestCloseMonitoredAlarms, latestHealthConfig),
                  parameterManager.getHealthMonitoringParameters(), errorHandler, healthSubsequentFlightHandler);
         } catch (final AnalysisException e) {
            LOGGER.error("Analysis error while processing health data", e);
            throw new MgsComputingException(MgsComputingErrorReason.HEALTH_PROCESSING_ERROR, e);
         }
      }

      if (featureManager.isEnabled(avionicVersion, FeatureName.ROTOR_TRACK_BALANCE)) {
         Double tailRotorRatio = parameterManager.getRtbCommonParameters().getTailRotorRatio(avionicVersion);
         final RtbConverter converter = new RtbConverter();
         Set<IRtbAcquisition> rtbData = new HashSet<>(converter.convert(flightDto, avionicVersion, tailRotorRatio));

         final IRtbAnalyzer rtbAnalyzer = analyzerFactory.getAnalyzer(IRtbAnalyzer.class);
         RtbConfiguration rtbDefaultConfiguration = configurationDao.getLatestConfiguration(aircraftId).getAvionicVersion().getRtbConfiguration();
         if (rtbDefaultConfiguration == null || rtbDefaultConfiguration.getMainRotorCharacteristics() == null || rtbDefaultConfiguration.getTailRotorCharacteristics() == null) {
            try {
               final AvionicVersion aVersion = manager.find(AvionicVersion.class, avionicVersion.getId());
               rtbDefaultConfiguration = rtbDelegate.loadDefaultRotorCharacteristics(aVersion,
                     parameterManager.getRtbParametersByAvionicVersion(avionicVersion.getId()),
                     parameterManager.getRtbNeuralNetworksByAvionicVersion(avionicVersion.getId()));
               rtbDefaultConfiguration.setOriginal(true);
            } catch (Exception e) {
               LOGGER.error("RTB Configuration error:{}", e.getMessage(), e);
               throw new MgsComputingException(MgsComputingErrorReason.RTB_CONFIGURATION_ERROR, e);
            }
         }
         rtbAnalyzer.analyze(aircraft, flight, rtbData, rtbDefaultConfiguration);
      }
   }

   private void processGreyAlarms(final String aircraftId, final String flightId, final AircraftConfiguration applicableAircraftConfiguration, final AircraftExceptionHandler handler) {
      final Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      final Flight flight = getFlight(aircraft, flightId);

      final IHealthMonitoringAnalyzer healthMonitoringAnalyzer = analyzerFactory.getAnalyzer(IHealthMonitoringAnalyzer.class);
      try {
         healthMonitoringAnalyzer.analyzeGreyAlarms(aircraft, applicableAircraftConfiguration, flight, new HealthHistoryProvider(manager, aircraft));
      } catch (final Exception e) {
         LOGGER.debug("Unable to analyze grey alarms", e);
         handler.addMgsComputingError(
               new MgsComputingError(MgsComputingErrorReason.GREY_ALARM_PROCESSING_ERROR, Avionic.MARMS, flight, e.getCause() != null ? e.getCause().getMessage() : e.getMessage()));
      }
   }

   private void processSfm(final String aircraftId, final FlightData flightDto, final String flightTechnicalId, final AircraftConfiguration applicableAircraftConfiguration)
         throws MgsComputingException {
      final Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      final Flight flight = getFlight(aircraft, flightTechnicalId);

      final SfmConverter sfmConverter = new SfmConverter();
      SfmSession sfmSession = sfmConverter.convert(flightDto);

      boolean sfmEnabled = featureManager.isEnabled(applicableAircraftConfiguration.getAvionicVersion(), FeatureName.SYSTEM_FAILURE_MANAGEMENT);
      if (sfmEnabled && applicableAircraftConfiguration.getConfigurations().containsKey(SfmConfiguration.TYPE)) {
         FailureRegroupingMode failureRegroupingMode = FailureRegroupingMode.APPEARANCE_TIME_MODE;
         final String regroupingModeValue = parameterManager.getConfigurationProperty(MgsConfigurationKey.FAILURE_CODE_REGROUPING_MODE.getKey());
         if (regroupingModeValue.equals(FailureRegroupingMode.DISAPPEARANCE_TIME_MODE.name())) {
            failureRegroupingMode = FailureRegroupingMode.DISAPPEARANCE_TIME_MODE;
         }

         try {
            final ISfmAnalyzer sfmAnalyzer = analyzerFactory.getAnalyzer(ISfmAnalyzer.class);
            sfmAnalyzer.analyze(flight, applicableAircraftConfiguration, sfmSession.failureOccurrences(), failureRegroupingMode);
         } catch (final AnalysisException e) {
            LOGGER.error("Could not analyze SFM data", e);
            throw new MgsComputingException(MgsComputingErrorReason.SFM_PROCESSING_ERROR, e);
         }
      }

      boolean vpuEnabled = featureManager.isEnabled(applicableAircraftConfiguration.getAvionicVersion(), FeatureName.VPU_FAILURES);
      if (vpuEnabled && applicableAircraftConfiguration.getConfigurations().containsKey(VpuFailureConfiguration.TYPE)) {
         final IVpuFailureAnalyzer vpuFailureAnalyzer = analyzerFactory.getAnalyzer(IVpuFailureAnalyzer.class);
         vpuFailureAnalyzer.analyze(flight, applicableAircraftConfiguration, sfmSession);
      }
   }

   private void processDmau(final String aircraftId, final FlightData flightDto, final String flightTechnicalId, final AircraftConfiguration applicableAircraftConfiguration) {
      final Aircraft aircraft = manager.find(Aircraft.class, aircraftId);
      final Flight flight = getFlight(aircraft, flightTechnicalId);

      final FailureConverter failureConverter = new FailureConverter();
      IFailureSession failureSession = failureConverter.convertFailures(flightDto);

      if (applicableAircraftConfiguration.getConfigurations().containsKey(DmauFailureConfiguration.TYPE)) {
         IDmauFailureAnalyzer dmauFailureAnalyzer = analyzerFactory.getAnalyzer(IDmauFailureAnalyzer.class);
         dmauFailureAnalyzer.analyze(flight, failureSession, (DmauFailureConfiguration) applicableAircraftConfiguration.getConfigurations().get(DmauFailureConfiguration.TYPE));
      }
   }

