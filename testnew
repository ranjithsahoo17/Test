   private void initContextualParameters() {
      final BundleContext aircraftBundleContext = FrameworkUtil.getBundle(IAircraftBusiness.class).getBundleContext();
      final IAircraftBusiness aircraftBusiness = aircraftBundleContext.getService(aircraftBundleContext.getServiceReference(IAircraftBusiness.class));
      Aircraft aircraft = MgsSession.getInstance().getAircraft();
      String healthVersion;
      try {
         healthVersion = aircraftBusiness.getHealthVersion(aircraft);
      } catch (EntityNotFoundException e) {
         throw new RuntimeException(e);
      }
      final BundleContext healthBundleContext = FrameworkUtil.getBundle(IHealthSignalBusiness.class).getBundleContext();
      IHealthSignalBusiness healthSignalBusiness = healthBundleContext.getService(healthBundleContext.getServiceReference(IHealthSignalBusiness.class));
      contextualParameters = healthSignalBusiness.getContextualParameterByHealthVersion(healthVersion);
   }

   private void removeSelectionIfNecessary(ChartElementModel<Double> model) {
      if (model.getData() instanceof IndicatorChartModelData icmd) {
         IndicatorHmcModel indicator = icmd.getIndicator();
         IndicatorHmcModel selectedIndicator = view.getSelectFFTSampleAction().getIndicator();
         if (selectedIndicator != null && selectedIndicator.equals(indicator)) {
            // The curve with a selected point has been removed, unselect the point
            view.unselectSample();
         }
      }
   }

   private void uncheckIndicator(ChartElementModel<Double> model) {
      if (model.getData() instanceof IndicatorChartModelData indicatorChartModelData) {
         Indicator indicator = indicatorChartModelData.getIndicator().getIndicator();
         IHealthTreeViewNodeModel node = HealthTreeViewNodeAction.getNodeOf(indicator);
         if (node instanceof CheckableTreeViewNodeElement) {
            ((CheckableTreeViewNodeElement) node).setChecked(false);
            NodeChangeEvent event = new NodeChangeEvent(EventType.UPDATE, node, false);
            node.notifyListeners(event);
         }
      }
   }
