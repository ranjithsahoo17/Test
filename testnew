   @Override
   public void innerSave() {
      for (Entry<Aircraft, WCMechanicalComponentModel> modelEntry : data.entrySet()) {
         Aircraft aircraft = modelEntry.getKey();
         HealthMonitoringConfiguration configuration;
         AircraftConfigurationHistoryDto aircraftConfigurationHistoryDto;
         try {
            configuration = getConfiguration(aircraft);
            aircraftConfigurationHistoryDto = MgsPreferenceStoreManager.getAircraftConfigurationDto(aircraft);
         } catch (EntityNotFoundException e) {
            LOGGER.warn("Entity not found exception", e);
            AircraftConcurrentAccessException wrapper = new AircraftConcurrentAccessException(aircraft, true);
            StatusManager.getManager().handle(
                  AircraftExceptionHandler.getStatusForAircraftException(wrapper, "update", Activator.PLUGIN_ID), //$NON-NLS-1$
                  StatusManager.SHOW);
            continue;
         }
         // Retrieve the root node element
         WCMechanicalComponentModel wcModel = modelEntry.getValue();

         // Create maps to associate JPA entities with WC* instances
         Map<HealthMechanicalComponent, WCHealthMechanicalComponentModel> wcMechanicalComponentModels = new HashMap<>();
         Map<Indicator, Set<WCThresholdModel>> thresholdModels = new HashMap<>();
         getModels(wcModel, wcMechanicalComponentModels, thresholdModels);

         for (Map.Entry<HealthMechanicalComponent, HealthMechanicalComponentConfiguration> mcEntry : configuration
               .getMechanicalComponentConfigurations().entrySet()) {
            HealthMechanicalComponent mechanicalComponent = mcEntry.getKey();
            MechanicalComponentConfigurationDto mechanicalComponentConfigurationDto = new MechanicalComponentConfigurationDto(
                  mechanicalComponent.getId());
            WCHealthMechanicalComponentModel mechanicalComponentModel = wcMechanicalComponentModels
                  .get(mechanicalComponent);
            mechanicalComponentConfigurationDto
                  .setWorkcardReference(mechanicalComponentModel.getWorkcardReference());
            mechanicalComponentConfigurationDto
                  .setMaxTimeWOAcquisition(mechanicalComponentModel.getMaxtimeWithoutAcquitision());

            for (Map.Entry<Indicator, IndicatorConfiguration> indicatorEntry : mcEntry.getValue()
                  .getIndicatorConfigurations().entrySet()) {
               Indicator indicator = indicatorEntry.getKey();
               if (!thresholdModels.containsKey(indicator)) {
                  // This indicator is likely inactive and has no current configuration to copy
                  continue;
               }
               Set<WCThresholdModel> indicatorThresholdModels = thresholdModels.get(indicator);
               IndicatorConfigurationDto indicatorConfigurationDto = new IndicatorConfigurationDto(indicator.getId());

               // BCR-6605 the filtering law is held per indicator, not per threshold        // <<< BCR-6605
               if (!indicatorThresholdModels.isEmpty()) {                                    // <<< BCR-6605
                  indicatorConfigurationDto.setFilteringLaw(                                 // <<< BCR-6605
                        indicatorThresholdModels.iterator().next().getFilteringLawName());   // <<< BCR-6605
               }                                                                             // <<< BCR-6605

               for (WCThresholdModel wcThresholdModel : indicatorThresholdModels) {
                  if (wcThresholdModel.isEnabled()) {
                     final ThresholdConfigurationDto thresholdConfigurationDto;
                     if (wcThresholdModel.getType() == ThresholdType.FIXED) {
                        thresholdConfigurationDto = new ThresholdConfigurationDto(
                              wcThresholdModel.getSeverity(), wcThresholdModel.getLevel(),
                              wcThresholdModel.getType(), wcThresholdModel.getDefaultValue(),
                              wcThresholdModel.getNbSuccessivePoints(),
                              wcThresholdModel.getMinimumEngineOilTemperature());
                     } else {
                        thresholdConfigurationDto = new ThresholdConfigurationDto(
                              wcThresholdModel.getSeverity(), wcThresholdModel.getLevel(),
                              wcThresholdModel.getType(), wcThresholdModel.getLearningTime(),
                              wcThresholdModel.getMinValue(), wcThresholdModel.getMaxValue(),
                              wcThresholdModel.getDefaultValue(), wcThresholdModel.getMinimumDeviation(),
                              wcThresholdModel.getMeanFactor(), wcThresholdModel.getDeviationCoefficient(),
                              wcThresholdModel.getNbSuccessivePoints(),
                              wcThresholdModel.getMinimumEngineOilTemperature());
                     }
                     thresholdConfigurationDto.setWorkcard(wcThresholdModel.getWorkCardReference());

                     // BCR-6605 deviation. Keep the existing start date so it survives          // <<< BCR-6605
                     // the rebuild done by HealthDelegate.updateHealthConfiguration;            // <<< BCR-6605
                     // stamp a new date only when the deviation is created now.                // <<< BCR-6605
                     thresholdConfigurationDto.setTeReference(wcThresholdModel.getTeReference());// <<< BCR-6605
                     thresholdConfigurationDto.setDeviationStartDate(                            // <<< BCR-6605
                           wcThresholdModel.getDeviationStartDate() != null                      // <<< BCR-6605
                                 ? wcThresholdModel.getDeviationStartDate()                      // <<< BCR-6605
                                 : (wcThresholdModel.isDeviated() ? new Date() : null));         // <<< BCR-6605
                     thresholdConfigurationDto.setDeviationEndDate(                              // <<< BCR-6605
                           wcThresholdModel.getDeviationEndDate());                              // <<< BCR-6605

                     indicatorConfigurationDto.getThresholdConfigurationDtos().add(thresholdConfigurationDto);
                  }
               }
               mechanicalComponentConfigurationDto.getIndicatorConfigurationDtos().add(indicatorConfigurationDto);
            }
            aircraftConfigurationHistoryDto.getMechanicalComponentConfigurations()
                  .add(mechanicalComponentConfigurationDto);
         }

         aircraftConfigurationHistoryDto.setIndicatorConfigurationUpdated(true);
      }
   }





























   private WCThresholdModel[] getThresholds(HealthMechanicalComponent mechanicalComponent, Indicator indicator,
         HealthMonitoringConfiguration healthMonitoringConfiguration) {
      Set<ThresholdConfiguration> latestThresholdConfigs;
      IndicatorConfiguration indicatorConfig = healthMonitoringConfiguration.getMechanicalComponentConfigurations()
            .get(mechanicalComponent).getIndicatorConfigurations().get(indicator);
      if (indicatorConfig != null) {
         latestThresholdConfigs = indicatorConfig.getThresholdConfigurations();
      } else {
         latestThresholdConfigs = new HashSet<>();
      }

      List<WCThresholdModel> existingThresholdModels = new ArrayList<>();

      for (ThresholdConfiguration existingThresholdConfig : latestThresholdConfigs) {

         WCThresholdModel thresholdModel = new WCThresholdModel(indicator, mechanicalComponent.getFunctionalId());
         existingThresholdModels.add(thresholdModel);

         // update data with the existing threshold values
         thresholdModel.setSeverity(existingThresholdConfig.getThreshold().getSeverity());
         thresholdModel.setEnabled(Boolean.TRUE);
         thresholdModel.setLevel(existingThresholdConfig.getThresholdLevel());
         thresholdModel.setWorkCardReference(existingThresholdConfig.getWorkcard());
         thresholdModel.setNbSuccessivePoints(existingThresholdConfig.getNbSuccessivePoints());
         thresholdModel.setMinimumEngineOilTemperature(existingThresholdConfig.getMinimumEngineOilTemperature());

         // BCR-6605 load the stored deviation. This is the only place deviated is         // <<< BCR-6605
         // set from persisted data - never from the configuration file.                   // <<< BCR-6605
         thresholdModel.setTeReference(existingThresholdConfig.getTeReference());          // <<< BCR-6605
         thresholdModel.setDeviationStartDate(                                             // <<< BCR-6605
               existingThresholdConfig.getDeviationStartDate());                           // <<< BCR-6605
         thresholdModel.setDeviationEndDate(existingThresholdConfig.getDeviationEndDate());// <<< BCR-6605
         thresholdModel.setDeviated(existingThresholdConfig.isDeviationActive());          // <<< BCR-6605

         if (existingThresholdConfig instanceof LearnedThresholdConfiguration learnedConfiguration) {
            thresholdModel.setType(ThresholdType.LEARNED);
            // default value
            thresholdModel.setDefaultValue(learnedConfiguration.getValue() != null ? learnedConfiguration.getValue() : null);
            // max value
            thresholdModel.setMaxValue(Double.valueOf(learnedConfiguration.getMaximumThreshold()));
            // min value
            if (learnedConfiguration.getMinimumThreshold() != null) {
               thresholdModel.setMinValue(learnedConfiguration.getMinimumThreshold());
            }
            // learning time
            thresholdModel.setLearningTime(learnedConfiguration.getLearningTime());
            thresholdModel.setDeviationCoefficient(learnedConfiguration.getDeviationCoefficient());
            thresholdModel.setMeanFactor(learnedConfiguration.getMeanFactor());
            thresholdModel.setMinimumDeviation(learnedConfiguration.getMinimumDeviation());
         } else if (existingThresholdConfig instanceof FixedThresholdConfiguration fixedThreshold) {
            thresholdModel.setType(ThresholdType.FIXED);
            // default value
            thresholdModel.setDefaultValue(fixedThreshold.getValue());
         }
      }
      return existingThresholdModels.toArray(new WCThresholdModel[0]);
   }
