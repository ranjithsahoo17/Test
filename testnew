package com.eurocopter.mgs.presentation.configuration.store;

import java.util.ArrayList;
import java.util.List;

public class MgsPreferenceStoreComposer extends MgsPreferenceStore {

   /** list of stores */
   private List<MgsPreferenceStore> stores = new ArrayList<>();

   /**
    * Add a store to the list.
    *
    * @param store
    *           a store
    */
   public void addStore(MgsPreferenceStore store) {
      if (!stores.contains(store)) {
         stores.add(store);
      }
   }

   /**
    * {@inheritDoc}
    * 
    * @see com.eurocopter.mgs.configuration.presentation.preferences.store.MgsPreferenceStore#needsSaving()
    */
   @Override
   public boolean needsSaving() {
      boolean result = false;
      if (!stores.isEmpty()) {
         int i = 0;
         while (i < stores.size() && !stores.get(i).needsSaving()) {
            i++;
         }
         // check loop not finished
         if (i < stores.size()) {
            result = true;
         }
      }
      return result;
   }

   /**
    * {@inheritDoc}
    * 
    * @see com.eurocopter.mgs.configuration.presentation.preferences.store.MgsPreferenceStore#innerLoad()
    */
   @Override
   public void innerLoad() {
      for (MgsPreferenceStore element : stores) {
         element.load();
      }
   }

   /**
    * {@inheritDoc}
    * 
    * @see com.eurocopter.mgs.configuration.presentation.preferences.store.MgsPreferenceStore#innerSave()
    */
   @Override
   public void innerSave() {
      for (MgsPreferenceStore element : stores) {
         // check again for each store
         if (element.needsSaving()) {
            element.save();
         }
      }
   }
}
