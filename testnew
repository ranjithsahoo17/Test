   @Override
   public void unfreezeAircraft(String aircraftId) throws EntityNotFoundException, NotificationException, AircraftConcurrentAccessException {
      // Abort if the aircraft is locked
      aircraftLockManager.throwExceptionIfBackgroundTask(aircraftId);
      aircraftLockManager.throwExceptionIfAircraftLocked(aircraftId);

      long start = System.currentTimeMillis();
      Aircraft aircraft = aircraftDao.findById(aircraftId);
      LOGGER.info("Start unfreezing aircraft {}, SN : {}", aircraft.getAircraftType().getName(), aircraft.getAircraftId());
      aircraft.setAircraftState(AircraftState.ACTIVE);

      // Flush here to increment version number before notification
      aircraftDao.flush();

      // Notify aircraft update
      notificationService.notifyAction(AircraftCloner.clone(aircraft), Action.UPDATE);
      long end = System.currentTimeMillis();
      LOGGER.info("End unfreezing aircraft {}, SN : {} in {} ms", aircraft.getAircraftType().getName(), aircraft.getAircraftId(), end - start);
   }

   @Override
   public void deleteAircraft(String aircraftId, TopicDto topicDto) throws NotificationException, AircraftConcurrentAccessException {
      Aircraft aircraft;
      long start = System.currentTimeMillis();
      try {
         aircraft = aircraftDao.findById(aircraftId);
         LOGGER.info("Start deleting aircraft {}, SN : {} ", aircraft.getAircraftType().getName(), aircraft.getAircraftId());
      } catch (EntityNotFoundException e) {
         LOGGER.debug("The aircraft was already deleted.", e);
         // This means the aircraft does not exist anymore in the application.
         // So, in a way, the operation succeeded : do nothing
         return;
      }
      Context context = progressManager.initContext(topicDto);
      progressManager.notifyProgress(context, AircraftCloner.clone(aircraft), Progress.START);

      // Lock the aircraft
      aircraftLockManager.throwExceptionIfBackgroundTask(aircraftId);
      aircraftLockManager.lock(aircraftId, LockCause.DELETE);

      aircraftDeletionManager.processDeletion(aircraftId);
      notificationService.notifyAction(AircraftCloner.clone(aircraft), Action.DELETION);

      progressManager.notifyProgress(context, AircraftCloner.clone(aircraft), Progress.END);
      long end = System.currentTimeMillis();
      long duration = end - start;
      LOGGER.info("End deleting aircraft {}, SN : {} in {} ms", aircraft.getAircraftType().getName(), aircraft.getAircraftId(), duration);
   }

   private void prepareFtpClient(AircraftManagementDto exportAircraftDto, FTPClient client) throws IOException {
      // FTP keeps a java.net.URL: the JDK has an ftp protocol handler (only sftp is unsupported).
      final URL url = new URL(exportAircraftDto.getUrl());
      String[] userInfo = url.getUserInfo().split(":");
      client.connect(url.getHost(), url.getPort());
      client.login(userInfo[0], userInfo[1]);
      client.setFileType(FTP.BINARY_FILE_TYPE, FTP.BINARY_FILE_TYPE);
      client.setFileTransferMode(FTP.BINARY_FILE_TYPE);
      client.setBufferSize(1024000);
   }

   private File getAircraftConfigurationFolder(String aircraftType, String aircraftId, String aircraftSerialNumber) throws DataCollectionException {
      final String aircraftConfigurationFolderPath = parameterManager.getConfigurationProperty(MgsConfigurationKey.CUSTOMIZED_AIRCRAFT_DEFINITION_FILES.getKey());
      final AircraftConfigurationFolderUtils acfu = new AircraftConfigurationFolderUtils();
      final String folderName = acfu.getAircraftConfigurationFolderName(aircraftType, aircraftId, aircraftSerialNumber);
      final File aircraftFolder = new File(aircraftConfigurationFolderPath, folderName);
      if (!aircraftFolder.exists() && !aircraftFolder.mkdirs()) {
         throw new DataCollectionException("Aircraft configuration folder does not exist: " + aircraftFolder.getAbsolutePath());
      }
      return aircraftFolder;
   }

   private void throwExceptionIfAircraftsExist(File tempFile, boolean override) throws AircraftAlreadyExistsException, IOException, AircraftManagementException {
      Map<String, Object> aircraftProperties = readAircraftPropertiesInZip(tempFile);

      // Check if aircraft exists
      String aircraftTypeName = aircraftProperties.get("aircraft_type_id").toString();
      String aircraftFunctionalId = aircraftProperties.get("aircraft_id") != null ? aircraftProperties.get("aircraft_id").toString() : null;
      String aircraftSerialNumber = aircraftProperties.get("aircraft_serial_number") != null ? aircraftProperties.get("aircraft_serial_number").toString() : null;

      Optional<Aircraft> optionalAircraftByAircraftIdAndSerialNumber = aircraftDao.findByAircraftIdAndSerialNumber(aircraftTypeName, aircraftFunctionalId, aircraftSerialNumber);
      if (optionalAircraftByAircraftIdAndSerialNumber.isPresent() && !override) {
         throw new AircraftAlreadyExistsException("Aircraft " + optionalAircraftByAircraftIdAndSerialNumber.get().getId() + " already exists");
      } else if (!optionalAircraftByAircraftIdAndSerialNumber.isPresent()) {
         Optional<Aircraft> optionalAircraftBySerialNumber = aircraftDao.findByAircraftSerialNumber(aircraftTypeName, aircraftSerialNumber);
         Optional<Aircraft> optionalAircraftByAircraftId = aircraftDao.findByAircraftId(aircraftTypeName, aircraftFunctionalId);
         if (optionalAircraftBySerialNumber.isPresent() && optionalAircraftByAircraftId.isPresent()) {
            Aircraft aircraftBySerialNumber = optionalAircraftBySerialNumber.get();
            Aircraft aircraftByAircraftId = optionalAircraftByAircraftId.get();
            if (!aircraftBySerialNumber.getId().equals(aircraftByAircraftId.getId())) {
               // import not possible: two aircraft match
               throw new AircraftManagementException("There are two aircrafts in the station matching an aircraft to be imported (A/C type: " + aircraftTypeName + ", ID: "
                     + aircraftByAircraftId.getAircraftId() + ", SN: " + aircraftBySerialNumber.getAircraftSerialNumber() + ")");
            }
         }
      }
   }

   private void throwExceptionIfNewerAircraftExists(File tempFile) throws AircraftAlreadyExistsException, IOException {
      Map<String, Object> aircraftProperties = readAircraftPropertiesInZip(tempFile);

      // Check if aircraft exists
      String aircraftTypeName = aircraftProperties.get("aircraft_type_id").toString();
      String aircraftFunctionalId = aircraftProperties.get("aircraft_id") != null ? aircraftProperties.get("aircraft_id").toString() : null;
      String aircraftSerialNumber = aircraftProperties.get("aircraft_serial_number") != null ? aircraftProperties.get("aircraft_serial_number").toString() : null;
      Optional<Aircraft> optionalAircraft = aircraftDao.findByAircraftIdAndSerialNumber(aircraftTypeName, aircraftFunctionalId, aircraftSerialNumber)
            .or(() -> aircraftDao.findByAircraftSerialNumber(aircraftTypeName, aircraftSerialNumber))
            .or(() -> aircraftDao.findByAircraftId(aircraftTypeName, aircraftFunctionalId));
      if (optionalAircraft.isEmpty()) {
         return;
      }

      Aircraft existingAircraft = optionalAircraft.get();
      int aircraftOldness = existingAircraft.getOldVersion();
      int packageOldness = ((Number) aircraftProperties.get("version")).intValue();
      if (packageOldness < aircraftOldness) {
         // Ask for confirmation when attaching old data
         throw new AircraftAlreadyExistsException("Aircraft already exists");
      }

   }

   private Map<String, Object> readAircraftPropertiesInZip(File tempFile) throws IOException {
      try (ZipFile zipFile = new ZipFile(tempFile)) {
         ZipArchiveEntry aircraftJsonEntry = zipFile.getEntry("aircraft.json");
         InputStream is = zipFile.getInputStream(aircraftJsonEntry);
         String aircraftJsonContent = IOUtils.toString(is, StandardCharsets.UTF_8);
         return JsonUtils.readMap(aircraftJsonContent);
      }

   }
