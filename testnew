   @Override
   protected void contributeButtons(Composite parent) {
      GridLayout layout = (GridLayout) parent.getLayout();
      layout.numColumns++;
      layout.makeColumnsEqualWidth = false;

      Button manageLaws = new Button(parent, SWT.PUSH);
      manageLaws.setText(Messages.CORE.getString("filteringLawManageButton"));
      manageLaws.addListener(SWT.Selection, e -> hac.openFilteringLawDialog());
      setButtonLayoutData(manageLaws);
   }
