   @Override
   public Map<Indicator, IndicatorModel> getIndicatorModels(String userId, String aircraftId) throws EntityNotFoundException {
      Map<Indicator, HealthMechanicalComponent> indicatorMechanicalComponents = new HashMap<>();

      Map<Indicator, IndicatorDisplay> resultMap = new HashMap<>();
      List<HealthMechanicalComponent> healthMechanicalComponents = healthCommonService.getHealthMechanicalComponents(aircraftId);
      for (HealthMechanicalComponent comp : healthMechanicalComponents) {
         for (Indicator indicator : comp.getIndicators().values()) {
            indicatorMechanicalComponents.put(indicator, comp);
            resultMap.put(indicator, indicator.getDisplay());
         }
      }

      resultMap.putAll(userService.getIndicatorDisplays(userId, aircraftId));

      // Load the health monitoring configuration
      HealthMonitoringConfiguration healthConfig = getLatestConfiguration(aircraftId);
      Map<Indicator, IndicatorModel> indicatorModels = new HashMap<>(resultMap.size());
      for (Entry<Indicator, IndicatorDisplay> entry : resultMap.entrySet()) {
         Indicator indicator = entry.getKey();
         IndicatorDisplay indicatorDisplay = entry.getValue();
         if (indicatorMechanicalComponents.get(indicator) != null) {
            Object[] availableUnit = parameterManager.getUnitDefinitions().getPhysicalQuantityFor(indicatorDisplay.getUnitName()).getAllUnits().toArray(new Unit[0]);
            WCThresholdModel[] thresholdModels = getThresholds(indicatorMechanicalComponents.get(indicator), indicator, healthConfig);
            indicatorModels.put(entry.getKey(), new IndicatorModel(indicator, indicatorDisplay, availableUnit, thresholdModels));
         }
      }

      return indicatorModels;
   }

