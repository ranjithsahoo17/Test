    * 
    * @param deselectAllIndicatorNodesAction
    *           the action.
    */
   public void setDeselectAllIndicatorNodesAction(DeselectAllIndicatorNodesAction deselectAllIndicatorNodesAction) {
      if (deselectAllIndicatorNodesAction != null) {
         IObservableValue<Boolean> deselectAllIndicatorNodesActionEnabledObserveValue = JFaceProperties
               .<DeselectAllIndicatorNodesAction, Boolean> value(DeselectAllIndicatorNodesAction.class, IAction.ENABLED, IAction.ENABLED)
               .observe(deselectAllIndicatorNodesAction);
         IObservableValue<Boolean> btnRemoveAllObserveEnabledObserveWidget = WidgetProperties.enabled().observe(btnRemoveAll);
         IObservableValue<Boolean> btnZoomOutObserveEnabledObserveWidget = WidgetProperties.enabled().observe(btnZoomOut);

         if (fdcrDataAvailable) {
            IObservableValue<Boolean> btnSelectFdcrDataObserveEnabledObserveWidget = WidgetProperties.enabled().observe(btnSelectFdcrData);
            IObservableValue<Boolean> btnDisplayFdcrDataObserveEnabledObserveWidget = WidgetProperties.enabled().observe(btnDisplayFdcrData);
            if (deselectAllBinding3 != null) {
               deselectAllBinding3.dispose();
            }
            if (deselectAllBinding4 != null) {
               deselectAllBinding4.dispose();
            }
            deselectAllBinding3 = bindingContext.bindValue(btnSelectFdcrDataObserveEnabledObserveWidget,
                  deselectAllIndicatorNodesActionEnabledObserveValue);
            deselectAllBinding4 = bindingContext.bindValue(btnDisplayFdcrDataObserveEnabledObserveWidget,
                  deselectAllIndicatorNodesActionEnabledObserveValue);
         }

         if (deselectAllBinding != null) {
            deselectAllBinding.dispose();
         }
         if (deselectAllBinding2 != null) {
            deselectAllBinding2.dispose();
         }

         deselectAllBinding = bindingContext.bindValue(btnRemoveAllObserveEnabledObserveWidget,
               deselectAllIndicatorNodesActionEnabledObserveValue, null, null);
         deselectAllBinding2 = bindingContext.bindValue(btnZoomOutObserveEnabledObserveWidget,
               deselectAllIndicatorNodesActionEnabledObserveValue, null, null);

         if (fdcrDataAvailable && !deselectAllIndicatorNodesAction.isEnabled()) {
            clearFdcrData();
         }
      }

      this.deselectAllIndicatorNodesAction = deselectAllIndicatorNodesAction;
   }

   @Override
   public void dispose() {
      bindingContext.dispose();
      toolkit.dispose();
      eventManager.unregisterEventListener(this);
      if (this.deselectAllIndicatorNodesAction != null) {
         this.deselectAllIndicatorNodesAction.dispose();
      }
      if (this.chart != null) {
         chart.getPlotManager().removeDomainAxisChangeListener(domainAxisChangeListener);
         chart.removeFlightBackgroundChangeListener(flightBackgroundChangeListener);
         chart.removeChartPlotClickedOnCurveListener(curveClickListener);
         chart.removeChartElementAddedListener(chartElementAddedListener);
         chart.removeChartElementSelectedistener(chartElementSelectedListener);
         chart.removeChartElementRemoveListener(chartElementRemovedListener);
         chart.removeChartTooltipListener(toolTipListener);
         chart.getMainChartPanel().setRightClickMouseListener(null);

         this.chart.getMainChartPanel().dispose();
         this.chart.getPlotManager().dispose();

         this.chart = null;
      }
   }

