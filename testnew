
package com.eurocopter.mgs.presentation.configuration.store.dialog;

import org.eclipse.jface.dialogs.Dialog;
import org.eclipse.jface.dialogs.IDialogConstants;
import org.eclipse.swt.SWT;
import org.eclipse.swt.widgets.Composite;
import org.eclipse.swt.widgets.Control;
import org.eclipse.swt.widgets.Display;
import org.eclipse.swt.widgets.Shell;
import org.eclipse.ui.PlatformUI;
import org.eclipse.ui.forms.widgets.FormToolkit;

import com.eurocopter.mgs.aircraft.presentation.utils.ColorUtils;
import com.eurocopter.mgs.core.presentation.i18n.Messages;

public class MgsPreferenceDialog extends Dialog {

   private MgsPreferenceDialogModel model;

   /** The toolkit. */
   private final FormToolkit toolkit;

   private MgsPreferenceDialog(Shell parentShell) {
      super(parentShell);
      toolkit = new FormToolkit(PlatformUI.getWorkbench().getDisplay());
   }

   public MgsPreferenceDialog(MgsPreferenceDialogModel model) {
      this(PlatformUI.getWorkbench().getDisplay().getActiveShell());
      this.model = model;
   }

   /**
    * Create contents of the dialog.
    *
    * @param parent
    *           the parent
    * @return container
    */
   @Override
   protected Control createDialogArea(Composite parent) {
      parent.setBackground(Display.getDefault().getSystemColor(SWT.COLOR_WHITE));
      parent.setBackgroundMode(SWT.INHERIT_FORCE);
      MgsPreferenceDialogComposite composite = createComposite(parent, model);
      toolkit.adapt(composite);
      toolkit.adapt(parent);
      composite.pack();
      ColorUtils.forceBackgroundColor(parent);
      return composite;
   }

   /**
    * Create composite.
    *
    * @param parent
    *           composite parent
    * @param style
    *           SWT style
    * @param model
    *           marker model
    * @return the composite
    */
   private MgsPreferenceDialogComposite createComposite(Composite parent, MgsPreferenceDialogModel model) {
      return new MgsPreferenceDialogComposite(parent, model);
   }

   /**
    * Create contents of the button bar.
    *
    * @param parent
    *           the parent
    */
   @Override
   protected void createButtonsForButtonBar(Composite parent) {
      toolkit.adapt(parent);
      createButton(parent, IDialogConstants.OK_ID, Messages.CORE.getMnemonicEscapedString("OK"), true);
      createButton(parent, IDialogConstants.CANCEL_ID,
            Messages.CORE.getMnemonicEscapedString("Cancel_Button_Label"), false);
      ColorUtils.forceBackgroundColor(parent);
   }
}
