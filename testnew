   /**
    * Instantiates a new aircraft details composite.
    * 
    * @param parent
    *           The parent composite
    * @param style
    *           The style
    * @param model
    *           The A/C details model
    * @param aircaftTypes
    * @param update
    */
   public AircraftDetailsComposite(
         Composite parent, AircraftDetailsModel model, List<AircraftType> aircaftTypes, boolean update) {
      super(parent, SWT.NONE);
      this.update = update;
      setLayout(new GridLayout(1, true));
      setLayoutData(new GridData(SWT.FILL, SWT.FILL, true, true));
      aircraftModel = model;

      Group mainSection = new Group(this, SWT.NONE);
      mainSection.setLayout(new GridLayout(1, true));
      GridData data = new GridData(SWT.FILL, SWT.FILL, true, true);
      mainSection.setLayoutData(data);
      mainSection.setText(Messages.CORE.getMnemonicEscapedString("aircraftDetailsDialogIdentificationTitle"));

      Composite composite = new Composite(mainSection, SWT.NONE);
      composite.setLayoutData(new GridData(SWT.FILL, SWT.BEGINNING, true, false));
      GridLayout glcomposite = new GridLayout(2, true);
      glcomposite.marginWidth = 0;
      glcomposite.marginHeight = 5;
      glcomposite.verticalSpacing = 5;
      composite.setLayout(glcomposite);
      initDetailsField(composite, aircaftTypes);
      if (update && DeviationWarningUtils.hasActiveDeviations(aircraftModel.getAircraft().getId())) {
         Label deviationWarning = new Label(this, SWT.WRAP);
         deviationWarning.setText(Messages.CORE.getString("deviationConfigUpdateWarning"));
         deviationWarning.setForeground(getDisplay().getSystemColor(SWT.COLOR_DARK_RED));
         GridData warningData = new GridData(SWT.FILL, SWT.BEGINNING, true, false);
         warningData.widthHint = 440;
         deviationWarning.setLayoutData(warningData);
      }

      // Dispose resources
      addDisposeListener(e -> {
         localbindingContext.dispose();
         localbindingContext = null;
      });
   }

